{
  "$comment": "Each feature's expected surfaces, read by tools/scripts/check-feature-surfaces.js, which documents the format. Built from the features shipped 2026-10-08 and 2026-10-09; a new feature adds its entry in the pull request that ships its first surface. A gap names what is missing; `unclaimed` lists surfaces that belong to no feature, each with the reason.",
  "unclaimed": {
    "routes": {
      "GET /healthz": "liveness probe for the orchestrator, not a product surface",
      "GET /readyz": "readiness probe for the orchestrator, not a product surface",
      "GET /.well-known/intutic-trace-signing.json": "the public key verifiers fetch; documented under trace integrity, owned by no single feature",
      "POST /v1/messages": "the proxy's provider pass-through: every feature that governs model traffic rides it",
      "POST /v1/chat/completions": "the proxy's provider pass-through: every feature that governs model traffic rides it",
      "POST /v1/responses": "the proxy's provider pass-through: every feature that governs model traffic rides it",
      "GET /health": "the proxy's liveness probe",
      "GET /": "the proxy's root banner",
      "GET /intutic/egress": "loopback diagnostics of the local proxy",
      "GET /intutic/spend": "loopback diagnostics of the local proxy",
      "GET /intutic/instance": "loopback diagnostics of the local proxy",
      "GET /intutic/probes": "loopback diagnostics of the local proxy",
      "POST /intutic/attest-sandbox": "loopback endpoint the sandbox entrypoint calls; part of sandboxed execution, which predates this manifest"
    }
  },
  "features": [
