  "cases": [
    {
      "name": "a v2 root, under the key it names",
      "root": "v2Chained",
      "set": {},
      "delete": [],
      "jwks": "published",
      "expect": "valid"
    },
    {
      "name": "a workspace's first root, which names no predecessor",
      "root": "v2First",
      "set": {},
      "delete": [],
      "jwks": "published",
      "expect": "valid"
    },
    {
      "name": "a previous_root the server omitted reads as an explicit null",
      "root": "v2First",
      "set": {},
      "delete": [
        "previous_root"
      ],
      "jwks": "published",
      "expect": "valid"
    },
    {
      "name": "a v1 root sealed under a key since rotated out, still published",
      "root": "v1RetiredKey",
      "set": {},
      "delete": [],
      "jwks": "published",
      "expect": "valid"
    },
    {
      "name": "an absent signing_preimage_version means 1, as a pre-113 control plane serves it",
      "root": "v1RetiredKey",
      "set": {},
      "delete": [
        "signing_preimage_version"
      ],
      "jwks": "published",
      "expect": "valid"
    },
    {
      "name": "the rotated-out key dropped from the published set: unverifiable, never invalid",
      "root": "v1RetiredKey",
      "set": {},
      "delete": [],
      "jwks": "activeOnly",
      "expect": "unverifiable"
    },
    {
      "name": "no key was configured at seal time",
      "root": "unsigned",
      "set": {},
      "delete": [],
      "jwks": "published",
      "expect": "unsigned"
    },
    {
      "name": "no signing key id recorded",
      "root": "v2Chained",
      "set": {
        "signing_key_id": null
      },
      "delete": [],
      "jwks": "published",
      "expect": "unsigned"
    },
    {
      "name": "the published keys could not be fetched",
      "root": "v2Chained",
      "set": {},
      "delete": [],
      "jwks": "none",
      "expect": "keys_unavailable"
    },
    {
      "name": "nothing published at all",
      "root": "v2Chained",
      "set": {},
      "delete": [],
      "jwks": "empty",
      "expect": "unverifiable"
    },
    {
      "name": "a relinked chain: previous_root is in the v2 signature",
