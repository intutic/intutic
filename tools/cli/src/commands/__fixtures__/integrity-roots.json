        "previous_root": "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"
      },
      "delete": [],
      "jwks": "published",
      "expect": "invalid"
    },
    {
      "name": "a predecessor of the empty string is not the same claim as none",
      "root": "v2First",
      "set": {
        "previous_root": ""
      },
      "delete": [],
      "jwks": "published",
      "expect": "invalid"
    },
    {
      "name": "the signature does not carry to another workspace",
