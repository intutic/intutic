        "signing_key_id": "_CS2wQmotWYO4H-OjOuPcEJw7bOkoKbhIC5NW71lIE8"
      },
      "delete": [],
      "jwks": "published",
      "expect": "invalid"
    },
    {
      "name": "a preimage version this verifier cannot rebuild",
      "root": "v2Chained",
      "set": {
        "signing_preimage_version": 3
      },
      "delete": [],
      "jwks": "published",
      "expect": "unverifiable"
    },
    {
      "name": "an algorithm this verifier cannot check",
