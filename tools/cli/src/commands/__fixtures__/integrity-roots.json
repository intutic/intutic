      "set": {
        "workspace_id": "ws_other"
      },
      "delete": [],
      "jwks": "published",
      "expect": "invalid"
    },
    {
      "name": "nor to another loop run, or none",
      "root": "v2Chained",
      "set": {
        "loop_run_id": null
      },
      "delete": [],
      "jwks": "published",
      "expect": "invalid"
    },
    {
      "name": "a changed merkle root",
