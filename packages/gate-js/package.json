{
  "name": "@intutic/gate",
  "version": "0.1.0",
  "description": "Intutic pre-execution tool gate for JS/TS agent frameworks without a shipped Intutic harness (Mastra, the Vercel AI SDK, LangChain.js, dsh, and hand-rolled agent loops)",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/intutic/intutic",
    "directory": "packages/gate-js"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./mastra": {
      "import": "./dist/mastra.js",
      "types": "./dist/mastra.d.ts"
    },
    "./vercel": {
      "import": "./dist/vercel.js",
      "types": "./dist/vercel.d.ts"
    },
    "./dsh": {
      "import": "./dist/dsh.js",
      "types": "./dist/dsh.d.ts"
    }
  },
  "typesVersions": {
    "*": {
      "mastra": ["src/mastra.ts"],
      "vercel": ["src/vercel.ts"],
      "dsh": ["src/dsh.ts"]
    }
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "lint": "eslint src",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@ai-sdk/openai": "^4.0.43",
    "@mastra/core": "^1.59.0",
    "@deepseek-ai/cordis": "^4.0.1",
    "@types/node": "^22",
    "ai": "^7.0.68",
    "typescript": "^5.5",
    "vitest": "^3"
  },
  "engines": {
    "node": ">=18"
  }
}
