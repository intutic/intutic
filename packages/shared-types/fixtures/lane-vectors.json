 "holdPatterns": [
  {
   "token": "action:deploy",
   "id": "sop.lane.reversible_wide.action:deploy",
   "patterns": [
    {
     "subject": "phrase",
     "source": "git push|kubectl apply|kubectl rollout|helm upgrade|helm install|terraform apply|docker push|serverless deploy|fly deploy|vercel deploy|gcloud run deploy|aws deploy|aws s3 sync|eb deploy",
     "ignoreCase": true
    }
   ]
  },
  {
   "token": "action:destroy",
   "id": "sop.lane.irreversible.action:destroy",
   "patterns": [
    {
     "subject": "phrase",
     "source": "terraform destroy|kubectl delete|helm uninstall|helm delete|drop table|drop database|drop schema|truncate |aws s3 rb|aws s3 rm",
     "ignoreCase": true
    },
    {
     "subject": "action",
     "source": " (action:destroy) ",
     "ignoreCase": true
    }
   ]
  },
  {
   "token": "action:force_push",
   "id": "sop.lane.irreversible.action:force_push",
   "patterns": [
    {
     "subject": "action",
     "source": " (action:force_push) ",
     "ignoreCase": true
    },
    {
     "subject": "phrase",
     "source": "git push --force|git push -f",
     "ignoreCase": true
    }
   ]
  },
  {
   "token": "action:payment",
   "id": "sop.lane.irreversible.action:payment",
   "patterns": [
    {
     "subject": "phrase",
     "source": "api.stripe.com/v1/charges|api.stripe.com/v1/payment_intents|api.stripe.com/v1/transfers|api.stripe.com/v1/payouts|api.stripe.com/v1/refunds|stripe charges create|stripe payment_intents create|stripe transfers create|stripe payouts create|api-m.paypal.com/v2/payments|api.paypal.com/v1/payments",
     "ignoreCase": true
    }
   ]
  },
  {
   "token": "action:prod_write",
   "id": "sop.lane.reversible_wide.action:prod_write",
   "patterns": [
    {
     "subject": "phrase",
     "source": "--prod|rails_env=production|node_env=production|--context prod|--namespace production|-n production|--environment production|--stage prod",
     "ignoreCase": true
    }
   ]
  },
  {
   "token": "action:secret_read",
   "id": "sop.lane.reversible_contained.action:secret_read",
   "patterns": [
    {
     "subject": "action",
     "source": " (action:secret_read) ",
     "ignoreCase": true
    }
   ]
  }
 ],
