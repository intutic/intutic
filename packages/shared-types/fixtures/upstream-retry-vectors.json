        "maxBackoffMs": 4000,
        "budgetMs": 60000,
        "onStatus": [
          429,
          500,
          502,
          503,
          504,
          529
        ],
        "fallbacks": {}
      }
    },
    {
      "name": "fallback targets by model, provider, or both",
      "setting": {
        "fallbacks": {
          "claude-opus-4-1": [
            {
              "model": "claude-sonnet-4-5"
            },
            {
              "model": "deepseek-chat",
              "provider": "deepseek"
            }
          ],
          "gpt-4o": [
            {
              "provider": "openrouter"
            }
          ]
        }
      },
      "schemaValid": true,
      "effective": {
        "enabled": true,
        "maxAttempts": 3,
        "initialBackoffMs": 500,
        "maxBackoffMs": 8000,
        "budgetMs": 30000,
        "onStatus": [
          429,
          500,
          502,
          503,
          504,
          529
        ],
        "fallbacks": {
