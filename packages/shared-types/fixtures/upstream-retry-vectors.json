{
  "$comment": "The workspace `upstreamRetry` setting as both readers see it: `schemaValid` is what the control plane's UpstreamRetrySettingsSchema accepts on write; `effective` is what the Rust proxy runs with after laying the setting over its built-in defaults (routing/retry.rs WorkspaceRetry::apply). Values the schema refuses can still reach the proxy from an older control plane or a hand-edited row, so the proxy's reading of them is pinned too.",
  "cases": [
    {
      "name": "an empty setting keeps every default",
      "setting": {},
      "schemaValid": true,
      "effective": {
        "enabled": true,
        "maxAttempts": 3,
        "initialBackoffMs": 500,
        "maxBackoffMs": 8000,
        "budgetMs": 30000,
        "onStatus": [
          429,
          500,
          502,
          503,
          504,
          529
        ],
        "fallbacks": {}
      }
    },
    {
      "name": "one knob changes only that knob",
      "setting": {
        "maxAttempts": 5
      },
      "schemaValid": true,
      "effective": {
        "enabled": true,
        "maxAttempts": 5,
        "initialBackoffMs": 500,
        "maxBackoffMs": 8000,
        "budgetMs": 30000,
        "onStatus": [
          429,
          500,
          502,
          503,
          504,
          529
        ],
        "fallbacks": {}
      }
    },
    {
      "name": "retries can be switched off",
      "setting": {
        "enabled": false
      },
      "schemaValid": true,
      "effective": {
        "enabled": false,
        "maxAttempts": 3,
        "initialBackoffMs": 500,
        "maxBackoffMs": 8000,
        "budgetMs": 30000,
        "onStatus": [
          429,
          500,
          502,
          503,
          504,
          529
        ],
        "fallbacks": {}
      }
    },
    {
      "name": "the status list is replaced, not merged",
