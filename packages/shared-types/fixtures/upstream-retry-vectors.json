        "onStatus": [
          503,
          529
        ]
      },
      "schemaValid": true,
      "effective": {
        "enabled": true,
        "maxAttempts": 3,
        "initialBackoffMs": 500,
        "maxBackoffMs": 8000,
        "budgetMs": 30000,
        "onStatus": [
          503,
          529
        ],
        "fallbacks": {}
      }
    },
    {
      "name": "timing knobs",
      "setting": {
