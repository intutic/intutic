{
  "name": "@intutic/mcp-governance-proxy",
  "version": "3.2.0",
  "description": "Intutic MCP Governance Proxy \u2014 transparent stdio proxy that intercepts all tools/call JSON-RPC messages and applies workspace SOP policy before forwarding to real MCP servers",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/intutic/intutic",
    "directory": "packages/mcp-proxy"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "intutic-mcp-proxy": "./bin/mcp-proxy.js",
    "intutic-mcp-daemon": "./bin/mcp-daemon.js"
  },
  "files": [
    "dist/",
    "bin/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "lint": "eslint src",
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:load": "vitest run --config vitest.load.config.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@intutic/id": "workspace:*",
    "@intutic/logger": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/context-async-hooks": "^3.1.0",
    "@opentelemetry/core": "^3.1.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.301.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.0",
    "@opentelemetry/instrumentation": "^0.301.0",
    "@opentelemetry/instrumentation-http": "^0.301.0",
    "@opentelemetry/instrumentation-ioredis": "^0.73.0",
    "@opentelemetry/instrumentation-runtime-node": "^0.38.0",
    "@opentelemetry/instrumentation-undici": "^0.35.0",
    "@opentelemetry/resources": "^3.1.0",
    "@opentelemetry/sdk-metrics": "^3.1.0",
    "@opentelemetry/sdk-trace": "^3.1.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@intutic/shared-types": "workspace:*",
    "ioredis": "^5",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4",
    "typescript": "^5.5",
    "vitest": "^4"
  },
  "engines": {
    "node": ">=22.15.0"
  }
}
