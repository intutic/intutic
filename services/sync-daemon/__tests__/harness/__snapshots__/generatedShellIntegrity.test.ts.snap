exports[`generated hook scripts > antigravity > matches the recorded output byte for byte 1`] = `
{
  ".intutic/hooks/antigravity-check.sh": "#!/usr/bin/env bash
# Intutic Antigravity (Gemini CLI) PreToolUse governance gate.
# Auto-generated by intutic sync-daemon. DO NOT EDIT.
# Proxy: http://127.0.0.1:4000
# Generated: <TIMESTAMP>
# Workspace: ws_test
set -euo pipefail

# ── Intutic fail-closed prelude v23 ─────────────────────────────
# Any exit status other than the two deliberate verdicts (0 = allow, 2 = block)
# means this gate crashed rather than decided. The harness would read exit 1 as
# "hook errored" and run the tool anyway, so a crash is converted into a block.
# EXIT rather than ERR: ERR is unreliable across shells for set -u deaths, and
# it fires on benign non-zero intermediates; the final status cannot lie.
# A post-tool invocation (--event post, gate body v23) records a tool's result
# and never refuses: the tool has already run, and some harnesses read a
# post-tool exit 2 as text to feed back to the model. So in post mode every
# exit, a crash and the deadline included, is 0.
INTUTIC_POST_MODE=0
if [ "\${1:-}" = "--event" ] && [ "\${2:-}" = "post" ]; then INTUTIC_POST_MODE=1; fi
intutic_fail_closed() {
  _intutic_exit_rc=$?
  # The trap must not itself die on an unset variable or a failed command —
  # that would replace the exit status it exists to correct.
  set +eu
  trap - EXIT
  [ -n "\${INTUTIC_WATCHDOG_PID:-}" ] && kill "$INTUTIC_WATCHDOG_PID" 2>/dev/null
  if [ "\${INTUTIC_POST_MODE:-0}" = "1" ]; then exit 0; fi
  # A chaos run's record of a call the gate refused, held or crashed on (the
  # gate body records an allowed one where it ends). It cannot change the
  # exit status: everything it prints is discarded.
  if [ "$_intutic_exit_rc" != "0" ] && [ "\${INTUTIC_CHAOS_ACTIVE:-0}" = "1" ] && command -v intutic_chaos_decide >/dev/null 2>&1; then
    intutic_chaos_decide "\${_intutic_chaos_decision:-deny}" >/dev/null 2>&1
  fi
  if [ "$_intutic_exit_rc" = "0" ] || [ "$_intutic_exit_rc" = "2" ]; then
    exit "$_intutic_exit_rc"
  fi
  echo "[Intutic Governance] BLOCKED: gate crashed (exit \${_intutic_exit_rc}) — failing closed rather than allowing an unevaluated call." >&2
  if command -v log_event >/dev/null 2>&1; then
    log_event "tool_blocked" "\${TOOL:-unknown}" "gate crashed (exit \${_intutic_exit_rc}) — failing closed" || true
  fi
  exit 2
}
trap intutic_fail_closed EXIT

# ── Internal deadline ────────────────────────────────────────────────────────
# Most harnesses run a call whose hook outlives their timeout as if the hook had
# allowed it. So this gate refuses at 9 s from its own start, inside the
# hook timeout gemini-cli applies (gateLimits.ts): a watchdog, detached so it holds none of
# the harness's pipes, stops the gate's children (a grep or python3 still
# matching) and signals it; the trap below refuses. Every built-in rule is
# linear; a workspace's own WHERE pattern need not be.
intutic_deadline() {
  trap - USR1
  if [ "\${INTUTIC_POST_MODE:-0}" = "1" ]; then exit 0; fi
  echo "[Intutic Governance] BLOCKED: GATE_DEADLINE — the gate did not finish evaluating this call within 9 s, and refuses it rather than let the hook timeout allow it." >&2
  if command -v log_event >/dev/null 2>&1; then
    log_event "tool_blocked" "\${TOOL:-unknown}" "GATE_DEADLINE — the gate did not finish within 9 s" || true
  fi
  exit 2
}
trap intutic_deadline USR1
INTUTIC_GATE_PID=$$
INTUTIC_WATCHDOG_PID="$( { ( sleep 9; pkill -P "$INTUTIC_GATE_PID" 2>/dev/null; kill -USR1 "$INTUTIC_GATE_PID" 2>/dev/null ) </dev/null >/dev/null 2>&1 & } ; echo $! )"

INPUT="$(cat)"

if ! command -v python3 >/dev/null 2>&1; then
  # A post-tool invocation records nothing without python3, and never refuses.
  if [ "\${INTUTIC_POST_MODE:-0}" = "1" ]; then exit 0; fi
  echo "[Intutic Governance] BLOCKED: python3 is required to evaluate tool calls and was not found on PATH." >&2
  echo "[Intutic Governance] Install python3, or unset the Intutic hooks to run ungoverned." >&2
  exit 2
fi

# The phrase matcher and the hold classifier (GATE_PY_LIB in gateBody.ts),
# for the extractor below and for phrase-subject rules. A quoted heredoc, so
# the shell expands nothing in it; read stops at end of input and returns 1.
IFS= read -r -d '' INTUTIC_PY_LIB <<'INTUTIC_PY_LIB_END' || true
"""Phrase matching for shell commands and SQL in linear time.

A transliteration of packages/shared-types/src/phrases.ts; read that module's
docstring for what counts as a separator and why no regex searches the input.
The rules are the same; the walk is organised for CPython, which is slow per
step: runs of ordinary characters, spaces and backslashes are consumed by
anchored character-class matches (one pass each, nothing to backtrack into),
and a phrase is checked only at the words that can start it.

Every classifier runs the shared vectors in
packages/proxy/src/plugins/anomaly/action_vectors.json, and the hook gates
emit this file verbatim (services/sync-daemon/src/lib/phrasesPy.ts holds a
byte-identical copy, which a test compares). It must stay self-contained: the
standard library only, no module state beyond the constants below, and no
backtick or dollar-brace, which the TypeScript copy cannot hold.
"""

import re
from bisect import bisect_left

_SPACE_CHARS = (
    " \\t\\n\\r\\v\\f\\u00a0\\u1680\\u2000\\u2001\\u2002\\u2003\\u2004\\u2005\\u2006\\u2007"
    "\\u2008\\u2009\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff"
)
_SPACES = frozenset(_SPACE_CHARS)
_WORD = frozenset("abcdefghijklmnopqrstuvwxyz0123456789_")
# One anchored match per piece of the text. Every alternative starts with a
# character no other alternative can start with, so exactly one can match at
# a position and it matches one run of its class: nothing to backtrack into.
_PIECE = re.compile(
    "(?P<plain>[^" + _SPACE_CHARS + "\\\\\\\\/;&|-]+)"
    "|(?P<space>[" + _SPACE_CHARS + "]+)"
    "|(?P<dash>-+)"
    "|(?P<backslash>\\\\\\\\+)"
    "|(?P<other>[/;&|])"
)
# A run of words that need no decision, each followed by one plain space:
# ordinary characters, after at most a leading run of dashes. Consumed in one
# match and split in C — most of a long command is this.
_BULK = re.compile("(?:(?:[^" + _SPACE_CHARS + "\\\\\\\\/;&|-]+|-+[^" + _SPACE_CHARS + "\\\\\\\\/;&|-]*) )+")
_BULK_NO_COMMENT = re.compile("(?:(?:[^" + _SPACE_CHARS + "\\\\\\\\;&|-]+|-+[^" + _SPACE_CHARS + "\\\\\\\\;&|-]*) )+")
# A run of line continuations or escaped spaces between words: one break.
_CONTINUATIONS = re.compile("(?:\\\\\\\\[" + _SPACE_CHARS + "])+")
# The same once no "*/" is left in the text: no "/*" can open a comment, so a
# slash is an ordinary character.
_PIECE_NO_COMMENT = re.compile(
    "(?P<plain>[^" + _SPACE_CHARS + "\\\\\\\\;&|-]+)"
    "|(?P<space>[" + _SPACE_CHARS + "]+)"
    "|(?P<dash>-+)"
    "|(?P<backslash>\\\\\\\\+)"
    "|(?P<other>[;&|])"
)


class PhraseText:
    """A text cut into words, ready for any number of has_phrase calls."""

    __slots__ = ("raw", "joined", "toks", "sep", "nl", "eol", "dash", "bar", "tail", "memo")

    def __init__(self):
        self.raw = ""
        self.joined = ""
        self.toks = []
        self.sep = []
        self.nl = []
        self.eol = []
        self.dash = []
        self.bar = []
        self.tail = False
        self.memo = {}


def phrase_text(value):
    """Cut value into words in one pass (see phraseText in phrases.ts)."""
    s = ("" if value is None else str(value)).lower()
    n = len(s)
    t = PhraseText()
    t.raw = s
    toks, sep, nl, eol, dash, bar = t.toks, t.sep, t.nl, t.eol, t.dash, t.bar
    start = -1
    tok_bar = False
    pend_sep = pend_nl = pend_eol = False
    close = -2 if "*/" in s else -1  # the next "*/" at or after the last search; -1 once none is left
    piece = _PIECE if close != -1 else _PIECE_NO_COMMENT
    bulk = _BULK if close != -1 else _BULK_NO_COMMENT
    i = 0
    while i < n:
        if start < 0:
            m = bulk.match(s, i)
            if m is not None:
                words = m.group().split(" ")
                words.pop()
                rest = len(words) - 1
                toks.extend(words)
                sep.append(pend_sep)
                sep.extend([True] * rest)
                nl.append(pend_nl)
                nl.extend([False] * rest)
                eol.append(pend_eol)
                eol.extend([False] * rest)
                dash.extend([w.startswith("--") for w in words])
                bar.extend([False] * (rest + 1))
                pend_sep = True
                pend_nl = pend_eol = False
                i = m.end()
                continue
            m = _CONTINUATIONS.match(s, i)
            if m is not None:
                pend_sep = True
                i = m.end()
                continue
        m = piece.match(s, i)
        kind = m.lastgroup
        j = m.end()
        if kind == "plain":
            if start < 0:
                start = i
            i = j
            continue
        word_break = False
        newline = eol_here = False
        nxt = j
        if kind == "space":
            newline = eol_here = "\\n" in m.group()
            word_break = True
        elif kind == "dash":
            # A "--" inside a word starts a new one, glued to it: it can open a
            # comment or an option run but cannot stand for a plain gap.
            if j - i > 1 and start >= 0:
                toks.append(s[start:i])
                sep.append(pend_sep)
                nl.append(pend_nl)
                eol.append(pend_eol)
                dash.append(s.startswith("--", start))
                bar.append(tok_bar)
                start = -1
                tok_bar = False
                pend_sep = pend_nl = pend_eol = False
            if start < 0:
                start = i
            i = j
            continue
        elif kind == "backslash":
            # Every backslash but the last is followed by a backslash: a
            # literal character. The last one decides.
            last = j - 1
            d = s[j] if j < n else ""
            if d in ("n", "t", "r") or (d != "" and d in _SPACES):
                if last > i and start < 0:
                    start = i
                word_break = True
                eol_here = d == "n"
                nxt = j + 1
                if last > i:
                    # the literal backslashes end the word before the escape
                    toks.append(s[start:last])
                    sep.append(pend_sep)
                    nl.append(pend_nl)
                    eol.append(pend_eol)
                    dash.append(s.startswith("--", start))
                    bar.append(tok_bar)
                    start = -1
                    tok_bar = False
                    pend_sep = pend_nl = pend_eol = False
            else:
                if start < 0:
                    start = i
                i = j
                continue
        else:
            c = s[i]
            if c == "/" and j < n and s[j] == "*" and close != -1:
                if close < i + 2:
                    close = s.find("*/", i + 2)
                    if close == -1:
                        piece = _PIECE_NO_COMMENT
                        bulk = _BULK_NO_COMMENT
                if close != -1:
                    word_break = True
                    nxt = close + 2
            if not word_break:
                if start < 0:
                    start = i
                if c != "/":
                    tok_bar = True
                i = j
                continue
        if start >= 0:
            toks.append(s[start:i])
            sep.append(pend_sep)
            nl.append(pend_nl)
            eol.append(pend_eol)
            dash.append(s.startswith("--", start))
            bar.append(tok_bar)
            start = -1
            tok_bar = False
            pend_sep = pend_nl = pend_eol = False
        pend_sep = True
        if newline:
            pend_nl = True
        if eol_here:
            pend_eol = True
        i = nxt
    if start >= 0:
        toks.append(s[start:n])
        sep.append(pend_sep)
        nl.append(pend_nl)
        eol.append(pend_eol)
        dash.append(s.startswith("--", start))
        bar.append(tok_bar)
        pend_sep = False
    t.tail = pend_sep
    t.joined = " ".join(toks)
    return t


def _next_index(t):
    """Per word x: the first word at or after x containing ;&|, with a real
    newline before it, and with any newline before it. Built once per text."""
    ix = t.memo.get("#next")
    if ix is None:
        T = len(t.toks)
        nb = [T] * (T + 1)
        nn = [T] * (T + 1)
        ne = [T] * (T + 1)
        b = n_ = e = T
        bar, nl, eol = t.bar, t.nl, t.eol
        for x in range(T - 1, -1, -1):
            if bar[x]:
                b = x
            if nl[x]:
                n_ = x
            if eol[x]:
                e = x
            nb[x] = b
            nn[x] = n_
            ne[x] = e
        ix = (nb, nn, ne)
        t.memo["#next"] = ix
    return ix


def has_phrase(t, needle, bounded=False):
    """Whether t contains needle (see hasPhrase in phrases.ts)."""
    words = needle.lower().split(" ")
    if len(words) == 1:
        return words[0] in t.raw
    trailing_gap = words[-1] == ""
    if trailing_gap:
        words.pop()
    for w in words:
        if w == "" or w not in t.joined:
            return False
    toks, sep, dash, tail = t.toks, t.sep, t.dash, t.tail
    T = len(toks)
    k = len(words)

    def positions(i):
        """The words that word i of the phrase can be, by its position."""
        w = words[i]
        first = i == 0
        last = i == k - 1 and not trailing_gap
        key = ("f" if first else "") + ("l" if last else "") + ("b" if bounded else "") + ":" + w
        hit = t.memo.get(key)
        if hit is not None:
            return hit
        lw = len(w)
        if first:
            out = [q for q, tok in enumerate(toks) if tok.endswith(w)]
        elif last:
            out = [q for q, tok in enumerate(toks) if tok.startswith(w)]
        else:
            out = [q for q, tok in enumerate(toks) if tok == w]
        if bounded:
            kept = []
            for q in out:
                tok = toks[q]
                if first and len(tok) > lw and tok[len(tok) - lw - 1] in _WORD:
                    continue
                if last and len(tok) > lw and (tok[lw] in _WORD or tok[lw] == "."):
                    continue
                kept.append(q)
            out = kept
        t.memo[key] = out
        return out

    # The words at which the rest of the phrase matches, ascending.
    ok = positions(k - 1)
    if trailing_gap:
        kept = []
        for q in ok:
            r = q + 1
            if r < T:
                if sep[r] or (dash[r] and not t.bar[r] and (r + 1 < T or tail)):
                    kept.append(q)
            elif tail:
                kept.append(q)
        ok = kept
    if k == 1:
        return bool(ok)
    nb, nn, ne = _next_index(t)
    for i in range(k - 2, -1, -1):
        ok_sep = [q for q in ok if sep[q]]
        ok_set = set(ok_sep)
        memo = {}

        def option(r):
            # An option run reaches any word before a ;&| word or a real newline.
            j = bisect_left(ok_sep, r + 1)
            return j < len(ok_sep) and ok_sep[j] <= min(nb[r], nn[r + 1], T - 1)

        def reach(r):
            # The gap that starts at word r leads into the rest of the phrase:
            # directly, after an option run, or after -- comments, each of
            # which runs to the next newline.
            path = []
            cur = r
            while True:
                if cur >= T:
                    val = False
                    break
                if cur in memo:
                    val = memo[cur]
                    break
                if cur in ok_set or (dash[cur] and option(cur)):
                    val = memo[cur] = True
                    break
                if not dash[cur]:
                    val = memo[cur] = False
                    break
                path.append(cur)
                cur = ne[cur + 1]
            for x in path:
                memo[x] = val
            return val

        ok = [p for p in positions(i) if reach(p + 1)]
        if not ok:
            return False
    return bool(ok)


"""The MCP server registry and allowlist decisions, read from the policy snapshot.

A transliteration of packages/shared-types/src/mcpRegistryRecord.ts: the
registry decision (evaluateMcpRegistry), the allowlist decision
(evaluateMcpAllowlist), and the snapshot's @mcp_registry and @mcp_allowlist
records. The control plane's hook gate, the MCP proxy and the JavaScript hook
gates run the TypeScript; the bash hook gates and this package run this file,
and every one of them runs packages/shared-types/fixtures/mcp-registry-vectors.json,
so all of them refuse a call with the same code, rule id and reason.

The bash gates emit this file verbatim (services/sync-daemon/src/lib/mcpRegistryPy.ts
holds a byte-identical copy, which a test compares). It must stay
self-contained: the standard library only, no module state beyond the
constants below, and no backtick or dollar-brace, which the TypeScript copy
cannot hold.

Both records sit inside the snapshot's digest. A gate that finds the snapshot
unverified (its digest broken or missing, or another workspace's) trusts
neither: it refuses every MCP call with unverified_refusal, at block, in an
observe-only workspace too.
"""

import base64
import json

MCP_REGISTRY_RECORD_TAG = "@mcp_registry"
MCP_ALLOWLIST_RECORD_TAG = "@mcp_allowlist"


def split_mcp_tool_name(tool):
    """(server, tool) for a harness name mcp__<server>__<tool>, else None.

    The server is the part before the first double underscore; the tool, the
    rest, may hold more of them.
    """
    if not isinstance(tool, str) or not tool.startswith("mcp__"):
        return None
    rest = tool[len("mcp__"):]
    sep = rest.find("__")
    if sep <= 0:
        return None
    return rest[:sep], rest[sep + 2:]


def _strings(value):
    return [v for v in value if isinstance(v, str)] if isinstance(value, list) else []


def parse_registry(value):
    """The registry as the control plane sends it, or None for a non-object.

    Wrong-typed lists read as empty, and any default but deny as allow.
    """
    if not isinstance(value, dict):
        return None
    disabled = {}
    if isinstance(value.get("disabledTools"), dict):
        for server, tools in value["disabledTools"].items():
            names = _strings(tools)
            if names:
                disabled[server] = names
    return {
        "defaultPolicy": "deny" if value.get("defaultPolicy") == "deny" else "allow",
        "approvedServers": _strings(value.get("approvedServers")),
        "blockedServers": _strings(value.get("blockedServers")),
        "heldServers": _strings(value.get("heldServers")),
        "disabledTools": disabled,
    }


def decode_registry_record(line):
    """The @mcp_registry line's registry; None for another line or a damaged one."""
    parts = line.split("\\t")
    if len(parts) != 2 or parts[0] != MCP_REGISTRY_RECORD_TAG or not parts[1]:
        return None
    try:
        return parse_registry(json.loads(base64.b64decode(parts[1], validate=True).decode("utf-8")))
    except Exception:
        return None


def evaluate_registry(registry, server, tool):
    """(code, rule_id, reason) refusing one MCP call, or None to let it continue.

    A blocked server, then a held one, then (under deny) one not approved,
    then a disabled tool.
    """
    if server in registry["blockedServers"]:
        return (
            "SERVER_BLOCKED",
            "mcp_registry." + server,
            "MCP server \\"" + server + "\\" is blocked in this workspace's MCP server registry. "
            "An owner or admin can change that on the MCP Servers page.",
        )
    if server in registry["heldServers"]:
        return (
            "SERVER_HELD",
            "mcp_registry." + server,
            "MCP server \\"" + server + "\\" changed its tools in a way scored high risk, and this workspace "
            "holds such a server until it is approved again. It is waiting in the approval queue on the MCP "
            "Servers page for an owner or admin.",
        )
    if registry["defaultPolicy"] == "deny" and server not in registry["approvedServers"]:
        return (
            "SERVER_NOT_APPROVED",
            "mcpDefaultPolicy",
            "MCP server \\"" + server + "\\" is not approved in this workspace's MCP server registry, "
            "and the workspace refuses unapproved servers (mcpDefaultPolicy: deny). It is waiting in "
            "the approval queue on the MCP Servers page for an owner or admin.",
        )
    if tool in registry["disabledTools"].get(server, []):
        return (
            "TOOL_DISABLED",
            "mcp_registry." + server + "." + tool,
            "Tool \\"" + tool + "\\" is disabled on MCP server \\"" + server + "\\" in this workspace's "
            "MCP server registry. An owner or admin can re-enable it on the MCP Servers page.",
        )
    return None


def decode_allowlist_record(line):
    """The @mcp_allowlist line as {"severity", "servers"}; None for another line.

    A severity other than shadow reads as block, so a damaged one refuses.
    """
    parts = line.split("\\t")
    if len(parts) != 3 or parts[0] != MCP_ALLOWLIST_RECORD_TAG:
        return None
    return {
        "severity": "shadow" if parts[1] == "shadow" else "block",
        "servers": [s for s in parts[2].split(",") if s],
    }


def evaluate_allowlist(allowlist, server):
    """(code, rule_id, reason) for a server the allowlist does not name, else None.

    Under shadow the caller records the refusal instead of enforcing it.
    """
    if server in allowlist["servers"]:
        return None
    return (
        "SERVER_NOT_ALLOWED",
        "mcp_allowlist",
        "MCP server \\"" + server + "\\" is not on the MCP server allowlist for this workspace",
    )


def unverified_refusal(server):
    """(code, rule_id, reason) refusing an MCP call on an unverified snapshot.

    Neither the registry's approvals nor the allowlist's servers can be
    vouched for, and a deleted record looks like one never set, so the
    snapshot admits no MCP server at all.
    """
    return (
        "POLICY_SNAPSHOT_UNVERIFIED",
        "policy_snapshot",
        "MCP server \\"" + server + "\\" is refused because the policy snapshot on this machine failed its "
        "integrity check, so its MCP server registry and allowlist admit no server until the sync daemon "
        "restores a verified snapshot",
    )


"""Did the tests pass? The deciding function behind the qualified ordering rule
requires_before: action:run_tests[ok] -> action:deploy, and the
per-session state a gate keeps of it.

A transliteration of packages/shared-types/src/testOutcome.ts; read that
module's docstring for the steps. In short, decide_test_outcome says failed
for a non-zero exit code, an error flag, a false success flag, a runner
summary with failures, or a summary saying no tests ran; ok for exit code 0,
or, with no exit code, a summary that counts a pass; and unknown otherwise,
which leaves a qualified rule unmet as a failure does.

Every port runs packages/shared-types/fixtures/test-outcome-vectors.json. The
bash hook gates emit this file verbatim, so it must stay self-contained: the
standard library only, no module state beyond the constants below, and no
backtick or dollar-brace, which a TypeScript copy cannot hold.

Inputs and states are plain dicts with the TypeScript field names
(exitCode, isError, success, output; {"v": 1, "outcomes":
{...}}), so a gate can read and write the same state file.
"""

import json
import re

OUTCOME_TOKENS = ("action:run_tests",)
OUTCOME_QUALIFIERS = ("ok",)
TEST_OUTPUT_TAIL_BYTES = 65536
TEST_OUTPUT_LINE_BYTES = 1024
TEST_OUTPUT_JSON_MAX_CHARS = 1048576
OUTCOME_STATE_TTL_MS = 86400000
_MAX_SAFE_INTEGER = 9007199254740991

_ANSI = re.compile(r"\\x1b\\[[0-9;?]*[A-Za-z]")
_EXIT_CODE = re.compile(r"exit code:? (-?[0-9]{1,9})\\Z", re.IGNORECASE | re.ASCII)
_EXIT_STATUS = re.compile(r"exit status ([0-9]{1,9})\\Z")
_EXITED = re.compile(r"(?:Process|Command) exited with code (-?[0-9]{1,9})")
_COUNT = re.compile(r"([0-9]{1,9}) ([a-z]+)")
_PYTEST_NONE = re.compile(r"=+ no tests ran")
_PYTEST = re.compile(r"=+ (.+) in [0-9.]+s.* =+\\Z")
_JEST = re.compile(r"Tests:[ \\t]+(.+)\\Z")
_VITEST = re.compile(r"[ \\t]*Tests[ \\t]+(.+)\\Z")
_GO_OK = re.compile(r"ok[ \\t]+[^ \\t]+")
_GO_FAIL = re.compile(r"FAIL(?:[ \\t]|\\Z)")
_GO_FAIL_TEST = re.compile(r"--- FAIL:")
_CARGO = re.compile(r"test result: (ok|FAILED)\\. ([0-9]{1,9}) passed; ([0-9]{1,9}) failed;")
_MOCHA_PASS = re.compile(r"[ \\t]*([0-9]{1,9}) passing")
_MOCHA_FAIL = re.compile(r"[ \\t]*([0-9]{1,9}) failing")
_RSPEC = re.compile(r"([0-9]{1,9}) examples?, ([0-9]{1,9}) failures?")


def _utf8_len(ch):
    cp = ord(ch)
    if cp < 0x80:
        return 1
    if cp < 0x800:
        return 2
    if cp < 0x10000:
        return 3
    return 4


def _utf8_tail(s, max_bytes):
    """The last max_bytes bytes of s as UTF-8, starting on a character."""
    total = 0
    i = len(s)
    while i > 0:
        n = _utf8_len(s[i - 1])
        if total + n > max_bytes:
            break
        total += n
        i -= 1
    return s[i:]


def _utf8_head(s, max_bytes):
    """The first max_bytes bytes of s as UTF-8, ending on a character."""
    total = 0
    i = 0
    while i < len(s):
        n = _utf8_len(s[i])
        if total + n > max_bytes:
            break
        total += n
        i += 1
    return s[:i]


def _lines(text):
    """The lines of text, each cut to 1 KiB, without carriage returns or ANSI sequences."""
    return [_ANSI.sub("", _utf8_head(raw, TEST_OUTPUT_LINE_BYTES).replace("\\r", "")) for raw in text.split("\\n")]


def _integer_or_none(v):
    """A JSON integer exit code, or None."""
    if isinstance(v, bool):
        return None
    if isinstance(v, int) and abs(v) <= _MAX_SAFE_INTEGER:
        return v
    if isinstance(v, float) and v.is_integer() and abs(v) <= _MAX_SAFE_INTEGER:
        return int(v)
    return None


def extract_exit_code(output):
    """The exit code a run's text reports, or None. See testOutcome.ts extractExitCode."""
    if not isinstance(output, str) or output == "":
        return None
    trimmed = output.strip()
    if len(trimmed) <= TEST_OUTPUT_JSON_MAX_CHARS and trimmed[:1] == "{" and trimmed[-1:] == "}":
        try:
            parsed = json.loads(trimmed)
        except ValueError:
            parsed = None
        if isinstance(parsed, dict):
            meta = parsed.get("metadata")
            if isinstance(meta, dict):
                m = _integer_or_none(meta.get("exit_code"))
                if m is not None:
                    return m
            for key in ("exit_code", "exitCode"):
                v = _integer_or_none(parsed.get(key))
                if v is not None:
                    return v
    head = _utf8_head(output, TEST_OUTPUT_TAIL_BYTES)
    parts = [head] if len(head) == len(output) else [head, _utf8_tail(output[len(head):], TEST_OUTPUT_TAIL_BYTES)]
    for part in parts:
        for raw in _lines(part):
            line = raw.lstrip(" \\t").rstrip(" \\t")
            m = _EXIT_CODE.match(line) or _EXIT_STATUS.match(line) or _EXITED.match(line)
            if m:
                return int(m.group(1))
    return None


def _counts(text):
    """'N word' pieces of a summary, split on ',' and '|': the count of each word."""
    counts = {}
    for piece in re.split(r"[,|]", text):
        m = _COUNT.match(piece.lstrip(" \\t"))
        if m:
            counts[m.group(2)] = counts.get(m.group(2), 0) + int(m.group(1))
    return counts


def parse_test_summaries(output):
    """The runner summaries in the last 64 KiB of output, in order (go and mocha folded into one each)."""
    if not isinstance(output, str) or output == "":
        return []
    out = []
    go = None
    mocha = None
    for line in _lines(_utf8_tail(output, TEST_OUTPUT_TAIL_BYTES)):
        if _PYTEST_NONE.match(line):
            out.append({"runner": "pytest", "passed": 0, "failed": 0, "noTests": True})
            continue
        m = _PYTEST.match(line)
        if m:
            c = _counts(m.group(1))
            if not any(k in c for k in ("passed", "failed", "error", "errors")):
                continue
            out.append({"runner": "pytest", "passed": c.get("passed", 0),
                        "failed": c.get("failed", 0) + c.get("error", 0) + c.get("errors", 0),
                        "noTests": c.get("passed") == 0})
            continue
        m = _JEST.match(line)
        if m:
            c = _counts(m.group(1))
            out.append({"runner": "jest", "passed": c.get("passed", 0), "failed": c.get("failed", 0),
                        "noTests": c.get("passed") == 0 or c.get("total") == 0})
            continue
        m = _VITEST.match(line)
        if m:
            c = _counts(m.group(1))
            if "passed" not in c and "failed" not in c:
                continue
            out.append({"runner": "vitest", "passed": c.get("passed", 0), "failed": c.get("failed", 0),
                        "noTests": c.get("passed") == 0})
            continue
        if _GO_OK.match(line):
            if go is None:
                go = {"runner": "go", "passed": 0, "failed": 0, "noTests": False}
                out.append(go)
            go["passed"] += 1
            continue
        if _GO_FAIL.match(line) or _GO_FAIL_TEST.match(line):
            if go is None:
                go = {"runner": "go", "passed": 0, "failed": 0, "noTests": False}
                out.append(go)
            go["failed"] += 1
            continue
        m = _CARGO.match(line)
        if m:
            passed, failed = int(m.group(2)), int(m.group(3))
            out.append({"runner": "cargo", "passed": passed,
                        "failed": 1 if m.group(1) == "FAILED" and failed == 0 else failed,
                        "noTests": passed == 0})
            continue
        m = _MOCHA_PASS.match(line)
        if m:
            if mocha is None:
                mocha = {"runner": "mocha", "passed": 0, "failed": 0, "noTests": False}
                out.append(mocha)
            mocha["passed"] += int(m.group(1))
            if int(m.group(1)) == 0:
                mocha["noTests"] = True
            continue
        m = _MOCHA_FAIL.match(line)
        if m:
            if mocha is None:
                mocha = {"runner": "mocha", "passed": 0, "failed": 0, "noTests": False}
                out.append(mocha)
            mocha["failed"] += int(m.group(1))
            continue
        m = _RSPEC.match(line)
        if m:
            examples, failures = int(m.group(1)), int(m.group(2))
            out.append({"runner": "rspec", "passed": max(0, examples - failures), "failed": failures,
                        "noTests": examples == 0})
    return out


def decide_test_outcome(inp):
    """The outcome of one test run, as {"outcome": ok|failed|unknown, "why": ...}.

    'inp' carries any of exitCode, isError, success and output.
    """
    exit_code = inp.get("exitCode")
    if isinstance(exit_code, bool) or not isinstance(exit_code, (int, float)) or _integer_or_none(exit_code) is None:
        exit_code = None
    else:
        exit_code = int(exit_code)
    if exit_code is not None and exit_code != 0:
        return {"outcome": "failed", "why": "exit_code"}
    if inp.get("isError") is True:
        return {"outcome": "failed", "why": "is_error"}
    if inp.get("success") is False:
        return {"outcome": "failed", "why": "success_false"}
    passed = 0
    no_tests = False
    for s in parse_test_summaries(inp.get("output")):
        if s["failed"] > 0:
            return {"outcome": "failed", "why": "summary_failed"}
        passed += s["passed"]
        if s["noTests"]:
            no_tests = True
    if passed == 0 and no_tests:
        return {"outcome": "failed", "why": "no_tests"}
    if exit_code == 0:
        return {"outcome": "ok", "why": "exit_zero"}
    if passed >= 1:
        return {"outcome": "ok", "why": "summary_passed"}
    return {"outcome": "unknown", "why": "no_signal"}


def ordering_qualifier_error(side, left):
    """Why one side of an ordering rule cannot carry its qualifier, or None."""
    if "[" not in side and "]" not in side:
        return None
    if left and side == "action:run_tests[ok]":
        return None
    return json.dumps(side, ensure_ascii=False) + ": [ok] qualifies only action:run_tests, on the left of ->"


def split_qualifier(token):
    """action:run_tests[ok] as ("action:run_tests", "ok"); any other token unqualified."""
    return ("action:run_tests", "ok") if token == "action:run_tests[ok]" else (token, None)


def empty_outcome_state():
    return {"v": 1, "outcomes": {}}


def outcome_state_file_name(harness, session_id, sha256_hex):
    """The first 32 hex of sha256(harness NUL session_id), and .json."""
    return sha256_hex(harness + "\\0" + session_id)[:32] + ".json"


def parse_outcome_state(text):
    """A state file's text as a state, or None when it is not one."""
    try:
        v = json.loads(text)
    except ValueError:
        return None
    if not isinstance(v, dict) or v.get("v") != 1 or isinstance(v.get("v"), bool) or not isinstance(v.get("outcomes"), dict):
        return None
    outcomes = {}
    for key, e in v["outcomes"].items():
        if not isinstance(e, dict):
            return None
        at = e.get("at")
        if e.get("o") not in ("ok", "failed", "unknown") or isinstance(at, bool) or not isinstance(at, (int, float)):
            return None
        if at != at or at in (float("inf"), float("-inf")):
            return None
        if "why" in e and not isinstance(e["why"], str):
            return None
        if "changed" in e and e["changed"] is not True:
            return None
        if "later" in e and e["later"] is not True:
            return None
        outcomes[key] = e
    return {"v": 1, "outcomes": outcomes}


def record_test_outcome(state, token, decision, at_ms):
    """state with token's outcome replaced by this run's."""
    outcomes = dict(state["outcomes"])
    outcomes[token] = {"o": decision["outcome"], "at": at_ms, "why": decision["why"]}
    return {"v": 1, "outcomes": outcomes}


def note_completed_call(state, changed_files):
    """state after another call completed: none adjacent any more, and stale after a file change."""
    outcomes = {}
    for key, e in state["outcomes"].items():
        nxt = {"o": e["o"], "at": e["at"]}
        if "why" in e:
            nxt["why"] = e["why"]
        if e.get("changed") or changed_files:
            nxt["changed"] = True
        nxt["later"] = True
        outcomes[key] = nxt
    return {"v": 1, "outcomes": outcomes}


def prerequisite_case(state, token, adjacent, now_ms):
    """(case, why): met only for an ok younger than a day that no file change followed
    (and, adjacent, no other call)."""
    e = None if state is None else state["outcomes"].get(token)
    if e is None or not (now_ms - e["at"] < OUTCOME_STATE_TTL_MS) or e["at"] > now_ms:
        return ("none", None)
    if e["o"] == "failed":
        return ("failed", e.get("why"))
    if e["o"] == "unknown":
        return ("unknown", e.get("why"))
    if e.get("changed"):
        return ("changed", None)
    if adjacent and e.get("later"):
        return ("not_adjacent", None)
    return ("met", None)


def prerequisite_unmet_reason(first, then, case, why, harness):
    """The PREREQUISITE_UNMET reason for every case but met, byte for byte as every port words it."""
    head = then + " needs a passing " + first + " first; "
    if case == "none":
        return head + "none ran in this session"
    if case == "failed":
        return head + "the last " + first + " failed (" + (why if why is not None else "failed") + ")"
    if case == "unknown":
        return head + "the result of the last " + first + " could not be read; rerun the tests so their summary is visible"
    if case == "changed":
        return head + "files changed after the last passing " + first + "; rerun the tests"
    if case == "not_adjacent":
        return head + then + " must come directly after it, and another call came between"
    if case == "not_observable":
        return head + harness + " reports no tool results Intutic can read, so a passing run cannot be observed here"
    if case == "no_session":
        return head + harness + " sent no session id, so test results cannot be tied to this session"
    return ""


"""Scope and plan semantics, ported from the proxy so every surface answers
"is this change inside the scope?" and "is this run on its plan?" the same way
.

A transliteration of packages/shared-types/src/scopeMatch.ts; read that
module's docstring for each function's port of origin (detectors.rs,
sops.rs, manifest.rs). Every port runs
packages/shared-types/fixtures/scope-plan-vectors.json.

The bash hook gates emit this file after the phrase matcher's (phrases.py),
which is_file_write_call calls: imported here as a module, and found in the
emitting script's scope when it is not one. Otherwise the standard library
only, and no backtick or dollar-brace, which a TypeScript copy cannot hold.
"""

try:
    from .phrases import has_phrase, phrase_text
except (ImportError, KeyError):  # embedded in a bash gate (exec without __name__), beside the phrase matcher's source
    pass

PLAN_DEVIATION_TOLERANCE = 0.4
NARROWED_TO_NOTHING = "<none: workspace list disjoint from org ceiling>"

SCOPE_WRITE_TOOLS = ("write", "write_file", "writefile", "create_file", "createfile")
SCOPE_EDIT_TOOLS = ("edit", "edit_file", "editfile", "multiedit", "apply_patch", "str_replace", "notebookedit")
SCOPE_DELETE_TOOLS = ("delete_file", "deletefile", "remove_file", "rm_file")
SCOPE_MOVE_TOOLS = ("move_file", "movefile", "rename_file", "rename")
SCOPE_EDITOR_TOOLS = ("str_replace_editor", "text_editor", "texteditor", "str_replace_based_edit_tool")
SCOPE_PATH_KEYS = ("file_path", "filepath", "path", "filename", "target_file", "notebook_path")
SCOPE_COMMAND_KEYS = ("command", "cmd", "script")
SCOPE_SHELL_TOOLS = ("bash", "shell", "run_command", "runcommand", "execute_command", "run_shell_command",
                     "terminal", "execute", "exec")
SCOPE_READ_TOOLS = ("read", "readfile", "view", "cat", "open_file")
SCOPE_MOVE_FROM_KEYS = ("source", "source_path", "from", "old_path")
SCOPE_MOVE_TO_KEYS = ("destination", "destination_path", "to", "new_path")
SCOPE_TARGET_MAX_BYTES = 512
PLAN_EXEMPT_TOOLS = ("read", "readfile", "view", "cat", "open_file", "glob", "grep", "ls", "list_dir", "search",
                     "todowrite")
FILE_WRITE_SHELL_PHRASES = ("sed -i", "perl -i", "perl -pi", "git apply", "git am", "git checkout", "git switch",
                            "git restore", "git reset", "git merge", "git pull", "git rebase", "git cherry-pick",
                            "git revert", "git stash pop", "git stash apply", "patch -p")


def _ascii_lower(s):
    return "".join(chr(ord(c) + 32) if "A" <= c <= "Z" else c for c in s)


def _tool_is(name, group):
    lower = name.lower()
    return any(lower == t or lower.endswith(t) for t in group)


def _keyed(inp, keys):
    if not isinstance(inp, dict):
        return None
    for k in keys:
        v = inp.get(k)
        if isinstance(v, str) and v != "":
            return v
    return None


def _utf8_len(ch):
    cp = ord(ch)
    return 1 if cp < 0x80 else 2 if cp < 0x800 else 3 if cp < 0x10000 else 4


def _clip(s):
    total = 0
    for i, ch in enumerate(s):
        n = _utf8_len(ch)
        if total + n > SCOPE_TARGET_MAX_BYTES:
            return s[:i] + "…"
        total += n
    return s


def _norm_scope(s):
    t = s
    while t[:2] == "./":
        t = t[2:]
    t = t.lstrip("/").rstrip("/")
    return _ascii_lower(t)


def is_within_scope(target, scopes):
    """Segment-prefix match of target against scopes, ignoring ASCII case and leading ./ or /."""
    t = _norm_scope(target)
    for raw in scopes:
        s = _norm_scope(raw)
        if s == "" or t == s or t[:len(s) + 1] == s + "/":
            return True
    return False


def sop_applies_to_role(roles, role):
    if not roles:
        return True
    if role == "":
        return False
    return _ascii_lower(role) in roles


def collect_scope_paths(sops, role):
    """The path scope in force for role (sops.rs collect_scope_paths), org ceiling included."""
    workspace, org = [], []
    for s in sops:
        if not sop_applies_to_role(s["roles"], role):
            continue
        (org if s["scope"] == "org" else workspace).extend(s["scopePaths"])
    if not org:
        out = workspace
    elif not workspace:
        out = org
    else:
        out = [w for w in workspace if is_within_scope(w, org)] or [NARROWED_TO_NOTHING]
    return sorted(set(out))


def collect_plan_steps(sops, role):
    """The plan in force for role (sops.rs collect_plan_steps), org ceiling included."""
    workspace, org = [], []
    for s in sops:
        if not sop_applies_to_role(s["roles"], role):
            continue
        (org if s["scope"] == "org" else workspace).extend(s["planSteps"])
    if not org:
        return workspace
    if not workspace:
        return org
    allowed = {_ascii_lower(o) for o in org}
    return [w for w in workspace if _ascii_lower(w) in allowed] or [NARROWED_TO_NOTHING]


def plan_off_steps(sequence, plan_steps, tolerance):
    """{"offPlan", "ratio"}: the off-plan names, sorted and deduplicated, when their share is over tolerance."""
    if not plan_steps or not sequence:
        return {"offPlan": [], "ratio": 0}
    plan = {_ascii_lower(p) for p in plan_steps}
    off = [t for t in sequence if _ascii_lower(t) not in plan]
    if not off:
        return {"offPlan": [], "ratio": 0}
    ratio = len(off) / len(sequence)
    if ratio <= tolerance:
        return {"offPlan": [], "ratio": ratio}
    return {"offPlan": sorted(set(off)), "ratio": min(1, ratio)}


def change_targets(tool, inp):
    """The mutations one tool call makes, as the proxy's change manifest records them."""
    if _tool_is(tool, SCOPE_MOVE_TOOLS):
        src = _keyed(inp, SCOPE_MOVE_FROM_KEYS)
        dst = _keyed(inp, SCOPE_MOVE_TO_KEYS)
        if src is not None or dst is not None:
            return [{"op": "move", "target": _clip(t)} for t in (src, dst) if t is not None]
    op = None
    if _tool_is(tool, SCOPE_EDITOR_TOOLS):
        command = inp.get("command") if isinstance(inp, dict) else None
        command = _ascii_lower(command) if isinstance(command, str) else ""
        if command == "view":
            return []
        op = "write" if command == "create" else "edit"
    elif _tool_is(tool, SCOPE_WRITE_TOOLS):
        op = "write"
    elif _tool_is(tool, SCOPE_EDIT_TOOLS):
        op = "edit"
    elif _tool_is(tool, SCOPE_DELETE_TOOLS):
        op = "delete"
    if op is None:
        return []
    target = _keyed(inp, SCOPE_PATH_KEYS)
    return [] if target is None else [{"op": op, "target": _clip(target)}]


def _diff_path(raw, prefix):
    p = raw
    tab = p.find("\\t")
    if tab != -1:
        p = p[:tab]
    p = p.strip(" ")
    if len(p) >= 2 and p[0] == '"' and p[-1] == '"':
        p = p[1:-1]
    if p in ("/dev/null", ""):
        return None
    if prefix and p[:len(prefix)] == prefix:
        p = p[len(prefix):]
    return p or None


def diff_changed_paths(diff):
    """The paths a diff changes, in the order first seen, each once."""
    out = []

    def add(p):
        if p is not None and p not in out:
            out.append(p)

    for raw in diff.split("\\n"):
        line = raw[:-1] if raw.endswith("\\r") else raw
        if line[:11] == "diff --git ":
            rest = line[11:]
            if rest[:2] != "a/":
                continue
            first = rest.find(" b/")
            if first == -1:
                continue
            if rest.find(" b/", first + 1) == -1:
                add(_diff_path(rest[:first], "a/"))
                add(_diff_path(rest[first + 1:], "b/"))
            elif (len(rest) - 5) % 2 == 0:
                n = (len(rest) - 5) // 2
                a = rest[2:2 + n]
                if rest[2 + n:5 + n] == " b/" and rest[5 + n:] == a:
                    add(_diff_path(a, ""))
        elif line[:4] == "--- ":
            add(_diff_path(line[4:], "a/"))
        elif line[:4] == "+++ ":
            add(_diff_path(line[4:], "b/"))
        elif line[:12] == "rename from ":
            add(_diff_path(line[12:], ""))
        elif line[:10] == "rename to ":
            add(_diff_path(line[10:], ""))
    return out


def _normalise_path(p):
    parts = []
    for seg in p.split("/"):
        if seg in ("", "."):
            continue
        if seg == "..":
            if parts:
                parts.pop()
        else:
            parts.append(seg)
    return "/" + "/".join(parts)


def scope_relative_path(target, cwd, root):
    """target relative to the workspace root, or None when outside it, under ~, or unresolvable."""
    if target == "" or target[:1] == "~" or cwd[:1] != "/" or root[:1] != "/":
        return None
    absolute = _normalise_path(target if target[:1] == "/" else cwd + "/" + target)
    base = _normalise_path(root)
    if absolute == base:
        return ""
    head = "/" if base == "/" else base + "/"
    return absolute[len(head):] if absolute[:len(head)] == head else None


def is_plan_exempt_tool(tool):
    """Whether plan_approval: lets tool run before approval: a PLAN_EXEMPT_TOOLS name, bare or mcp__<server>__<name>."""
    lower = tool.lower()
    return any(lower == t or lower[-(len(t) + 2):] == "__" + t for t in PLAN_EXEMPT_TOOLS)


def is_file_write_call(tool, inp):
    """Whether the call changed files: a mutation, or a shell command with a FILE_WRITE_SHELL_PHRASES phrase."""
    if change_targets(tool, inp):
        return True
    if not _tool_is(tool, SCOPE_SHELL_TOOLS):
        return False
    command = _keyed(inp, SCOPE_COMMAND_KEYS)
    if command is None:
        return False
    words = phrase_text(command)
    return any(has_phrase(words, p) for p in FILE_WRITE_SHELL_PHRASES)


# The lane phrases rule_record.py names (lanes.ts LANE_PHRASES).
LANE_PHRASES = {"action:deploy":["git push","kubectl apply","kubectl rollout","helm upgrade","helm install","terraform apply","docker push","serverless deploy","fly deploy","vercel deploy","gcloud run deploy","aws deploy","aws s3 sync","eb deploy"],"action:publish":["npm publish","pnpm publish","yarn publish","cargo publish","twine upload","poetry publish","gem push","docker manifest push"],"action:release":["gh release create","git tag","npm version","cargo release","goreleaser release","semantic-release"],"action:db_write":["insert into","update ","delete from","drop table","drop database","drop schema","truncate ","alter table"],"action:http_post":["curl -x post","curl --request post","curl -d ","curl --data","wget --post","http post"],"action:run_tests":["npm test","npm run test","pnpm test","pnpm run test","yarn test","cargo test","go test","pytest","python -m pytest","vitest","jest","mocha","rspec","phpunit","make test","gradle test","mvn test","dotnet test","bazel test","tox"],"action:migrate":["prisma migrate deploy","prisma db push","alembic upgrade","alembic downgrade","rails db:migrate","rake db:migrate","manage.py migrate","flyway migrate","liquibase update","knex migrate:latest","sequelize db:migrate"],"action:prod_write":["--prod","rails_env=production","node_env=production","--context prod","--namespace production","-n production","--environment production","--stage prod"],"action:destroy":["terraform destroy","kubectl delete","helm uninstall","helm delete","drop table","drop database","drop schema","truncate ","aws s3 rb","aws s3 rm"],"action:force_push":["git push --force","git push -f"],"action:payment":["api.stripe.com/v1/charges","api.stripe.com/v1/payment_intents","api.stripe.com/v1/transfers","api.stripe.com/v1/payouts","api.stripe.com/v1/refunds","stripe charges create","stripe payment_intents create","stripe transfers create","stripe payouts create","api-m.paypal.com/v2/payments","api.paypal.com/v1/payments"]}

"""Rule records in the policy snapshot: the @rule record, its
fallback line, and how a gate that reads it decides a call (Tier R).

A transliteration of packages/shared-types/src/gateRuleRecord.ts (the
reader's half: the writers are the daemon, the CLI and the control plane).
A record is five tab-separated columns: @rule, the fallback line's id or
-, the kind, the rollout, and base64 of the canonical JSON of its
payload, {v, ref, sopTitle, ...kind fields}. A record that does not
decode leaves its fallback line in force, which refuses. Kinds:
requires_outcome (a qualified requires_before), scope_paths (under
scope_paths_mode: enforce) and plan_approval.

Every port runs packages/shared-types/fixtures/rule-record-vectors.json. The
bash hook gates emit this file after test_outcome.py, scope_match.py and the
lane phrases, whose names it uses: imported here as modules, and found in the
emitting script's scope when it is not one. Otherwise the standard library
only, and no backtick or dollar-brace, which a TypeScript copy cannot hold.
"""

import base64
import binascii
import json
import re

try:
    from .actions import LANE_PHRASES
    from .scope_match import (
        SCOPE_DELETE_TOOLS, SCOPE_EDIT_TOOLS, SCOPE_EDITOR_TOOLS, SCOPE_MOVE_TOOLS, SCOPE_SHELL_TOOLS,
        SCOPE_WRITE_TOOLS, change_targets, is_plan_exempt_tool, is_within_scope, scope_relative_path,
    )
    from .test_outcome import prerequisite_case, prerequisite_unmet_reason
except (ImportError, KeyError):  # embedded in a bash gate (exec without __name__), beside the sources it needs
    pass

RULE_RECORD_TAG = "@rule"
RULE_SNAPSHOT_FORMAT = 3
RULE_SOP_TITLE_MAX_CHARS = 80
RULE_SCOPE_PATHS_MAX = 64
RULE_SCOPE_PATH_MAX_CHARS = 512
GATE_RULE_KINDS = ("requires_outcome", "scope_paths", "plan_approval")
V22_ACTION_TOKENS = ("action:deploy", "action:publish", "action:release", "action:db_write")

# The payload fields of each kind, sorted; the kind, fallback id and rollout are columns.
_FIELDS = {
    "requires_outcome": ["adjacent", "first", "qualifier", "ref", "sopTitle", "then", "v"],
    "scope_paths": ["ref", "scopePaths", "sopTitle", "v"],
    "plan_approval": ["mode", "ref", "sopTitle", "v"],
}
_REF = re.compile(r"^[^\\n\\r\\u2028\\u2029]+#([a-z_]+):([1-9][0-9]{0,5})\\Z")
_TOKEN = re.compile(r"^[A-Za-z][A-Za-z0-9_.:-]{0,63}\\Z")
_LINE_BREAK = re.compile(r"[\\t\\r\\n]")


def _from_base64(b64):
    """Standard base64 back to UTF-8 text; raises on anything but the canonical encoding."""
    raw = base64.b64decode(b64, validate=True)
    text = raw.decode("utf-8")
    if base64.b64encode(raw).decode("ascii") != b64:
        raise ValueError("not canonical base64")
    return text


def _text(v, max_chars, min_chars):
    return isinstance(v, str) and not _LINE_BREAK.search(v) and min_chars <= len(v) <= max_chars


def decode_gate_rule_record(line):
    """An @rule line as a record dict (payload fields plus kind, fallbackId and rollout), or None."""
    f = line.split("\\t")
    if len(f) != 5 or f[0] != RULE_RECORD_TAG or not f[4]:
        return None
    kind = f[2]
    if kind not in _FIELDS:
        return None
    try:
        r = json.loads(_from_base64(f[4]))
    except (ValueError, binascii.Error, UnicodeDecodeError):
        return None
    if not isinstance(r, dict) or sorted(r.keys()) != _FIELDS[kind]:
        return None
    if f[3] not in ("shadow", "enforce"):
        return None
    r = dict(r, kind=kind, fallbackId=None if f[1] == "-" else f[1], rollout=f[3])
    if r["v"] != 1 or isinstance(r["v"], bool):
        return None
    if not _text(r["sopTitle"], RULE_SOP_TITLE_MAX_CHARS, 0) or not isinstance(r["ref"], str):
        return None
    m = _REF.match(r["ref"])
    if not m or m.group(1) != kind:
        return None
    if r["rollout"] == "enforce":
        fid = r["fallbackId"]
        if not isinstance(fid, str) or not re.match(r"^" + kind + "-fallback:" + m.group(2) + r"@[0-9a-f]{12}\\Z", fid):
            return None
    elif r["fallbackId"] is not None:
        return None
    if kind == "requires_outcome":
        if r["first"] != "action:run_tests" or r["qualifier"] != "ok" or not isinstance(r["adjacent"], bool):
            return None
        if not isinstance(r["then"], str) or not _TOKEN.match(r["then"]) or r["then"] == "action:run_tests":
            return None
    elif kind == "scope_paths":
        paths = r["scopePaths"]
        if not isinstance(paths, list) or not 1 <= len(paths) <= RULE_SCOPE_PATHS_MAX:
            return None
        if any(not _text(p, RULE_SCOPE_PATH_MAX_CHARS, 1) for p in paths):
            return None
    elif r["mode"] not in ("required", "strict"):
        return None
    return r


def gate_rule_fallback_reason(kind, sop_title):
    if kind == "requires_outcome":
        return ("Qualified requires_before (" + sop_title + "): this gate cannot read test results, so the call "
                "it gates is refused; upgrade the Intutic gate")
    if kind == "scope_paths":
        return ("scope_paths_mode: enforce (" + sop_title + "): this gate cannot check a change against the "
                "scope, so every file change is refused; upgrade the Intutic gate")
    return ("plan_approval (" + sop_title + "): this gate cannot check plan approval, so every call is refused; "
            "upgrade the Intutic gate")


def _escape(s):
    return re.sub(r"([.*+?^(){}$|\\[\\]\\\\])", r"\\\\\\1", s)


def gate_rule_fallback(record):
    """The fallback line an older gate refuses with in the record's place, or None for a shadow record."""
    if record["fallbackId"] is None:
        return None
    base = {"id": record["fallbackId"], "severity": "block", "reason": gate_rule_fallback_reason(record["kind"], record["sopTitle"])}
    if record["kind"] == "plan_approval":
        return dict(base, subject="tool", source=" [^ ]+ ", ignoreCase=False)
    if record["kind"] == "scope_paths":
        tools = SCOPE_WRITE_TOOLS + SCOPE_EDIT_TOOLS + SCOPE_DELETE_TOOLS + SCOPE_MOVE_TOOLS + SCOPE_EDITOR_TOOLS
        return dict(base, subject="tool", source=" [^ ]*(" + "|".join(_escape(t) for t in tools) + ") ", ignoreCase=True)
    then = record["then"]
    if then in V22_ACTION_TOKENS:
        return dict(base, subject="action", source=" (" + _escape(then) + ") ", ignoreCase=True)
    if then.startswith("action:"):
        phrases = LANE_PHRASES.get(then) or []
        if phrases:
            return dict(base, subject="phrase", source="|".join(phrases), ignoreCase=True)
        return dict(base, subject="tool", source=" [^ ]*(" + "|".join(_escape(t) for t in SCOPE_SHELL_TOOLS) + ") ",
                    ignoreCase=True)
    return dict(base, subject="tool", source=" (" + _escape(then) + ") ", ignoreCase=False)


def gate_rule_plan_from_response(status, body):
    """The session's plan from GET /api/v1/plans/session/:id ({"status": approved|none|unavailable})."""
    if status == 404:
        return {"status": "none"}
    if status != 200 or not isinstance(body, dict):
        return {"status": "unavailable"}
    if body.get("lifecycleState") not in ("APPROVED", "EXECUTING"):
        return {"status": "none"}
    tools = []
    steps = body.get("steps")
    for step in steps if isinstance(steps, list) else []:
        if not isinstance(step, dict):
            continue
        tool = step.get("tool") if isinstance(step.get("tool"), str) else step.get("toolName")
        if isinstance(tool, str) and tool.strip() and tool.strip() not in tools:
            tools.append(tool.strip())
    return {"status": "approved", "tools": tools}


def _plan_finding(records, call):
    if not records or is_plan_exempt_tool(call["tool"]):
        return None
    rec = next((r for r in records if r["mode"] == "strict"), records[0])
    rule_id = "plan_approval." + rec["sopTitle"]
    scope = {"tools": [call["tool"]]}
    head = "plan_approval: " + rec["mode"] + " (" + rec["sopTitle"] + "): "
    if call["sessionId"] == "":
        return {"code": "PLAN_NOT_APPROVED", "ruleId": rule_id, "scope": scope, "ref": rec["ref"],
                "reason": head + call["harness"] + " sent no session id, so no approved plan can be found for this session"}
    plan = call["plan"]
    if plan["status"] != "approved":
        why = "this session has no approved plan" if plan["status"] == "none" else "the approved plans could not be read"
        return {"code": "PLAN_NOT_APPROVED", "ruleId": rule_id, "scope": scope, "ref": rec["ref"],
                "reason": head + why + "; get the plan approved, then retry"}
    if rec["mode"] == "strict":
        tool = call["tool"].lower()
        if not any(t.lower() == tool for t in plan["tools"]):
            return {"code": "OFF_PLAN", "ruleId": rule_id, "scope": scope, "ref": rec["ref"],
                    "reason": call["tool"] + " is not a step of this session's approved plan (plan_approval: strict, "
                    + rec["sopTitle"] + ")"}
    return None


def _requires_finding(records, call):
    tool = call["tool"].lower()
    for rec in records:
        if rec["then"] not in call["actions"] and rec["then"].lower() != tool:
            continue
        why = None
        if not call["observable"]:
            case = "not_observable"
        elif call["sessionId"] == "":
            case = "no_session"
        else:
            case, why = prerequisite_case(call["outcomes"], rec["first"], rec["adjacent"], call["nowMs"])
        if case == "met":
            continue
        return {
            "code": "PREREQUISITE_UNMET",
            "ruleId": "requires_before." + rec["first"] + "[ok]" + ("~>" if rec["adjacent"] else "->") + rec["then"],
            "reason": prerequisite_unmet_reason(rec["first"], rec["then"], case, why, call["harness"]),
            "scope": {"tools": [rec["then"]], "step": rec["first"]},
            "ref": rec["ref"],
        }
    return None


def _scope_finding(records, call):
    if not records:
        return None
    targets = change_targets(call["tool"], call["input"])
    if not targets:
        return None
    scopes = []
    for r in records:
        for p in r["scopePaths"]:
            if p not in scopes:
                scopes.append(p)
    outside = []
    for t in targets:
        rel = scope_relative_path(t["target"], call["cwd"], call["root"])
        if (rel is None or not is_within_scope(rel, scopes)) and t["target"] not in outside:
            outside.append(t["target"])
    if not outside:
        return None
    rec = records[0]
    return {
        "code": "OUT_OF_SCOPE",
        "ruleId": "scope_paths." + rec["sopTitle"],
        "reason": "Changes outside the declared file scope: " + ", ".join(outside) + " (scope: " + ", ".join(scopes) + ")",
        "scope": {"paths": outside},
        "ref": rec["ref"],
    }


def _findings(records, call):
    out = []
    for finding in (
        _plan_finding([r for r in records if r["kind"] == "plan_approval"], call),
        _requires_finding([r for r in records if r["kind"] == "requires_outcome"], call),
        _scope_finding([r for r in records if r["kind"] == "scope_paths"], call),
    ):
        if finding is not None:
            out.append(finding)
    return out


def evaluate_gate_rule_records(records, call):
    """Tier R: {"refusal": the first enforcing finding or None, "shadow": the shadow records' findings}.

    'call' carries tool, input, actions, cwd, root, sessionId, harness,
    outcomes (a state dict or None), observable, plan and nowMs, as in
    gateRuleRecord.ts GateRuleCall.
    """
    enforce = _findings([r for r in records if r["rollout"] == "enforce"], call)
    return {"refusal": enforce[0] if enforce else None,
            "shadow": _findings([r for r in records if r["rollout"] == "shadow"], call)}


"""What a refusal says about where to retry: its scope (paths,
tools, step, detector, rule) and its evidence (what the refuser saw),
bounded the same way on every surface.

A transliteration of packages/shared-types/src/refusalDetail.ts: each list
holds at most 8 items and each string at most 256 code points, with C0
control characters (U+0000 to U+001F) removed first; a string empty after
that is dropped, an empty list left out, and a scope with nothing left is
None. In an OPAQUE workspace both are dropped, and so is the stderr retry
line. Every port runs packages/shared-types/fixtures/refusal-detail-vectors.json.

Self-contained (the standard library only), so the bash hook gates can emit
it verbatim; no backtick or dollar-brace, which a TypeScript copy cannot hold.
"""

import re

REFUSAL_DETAIL_MAX_ITEMS = 8
REFUSAL_DETAIL_MAX_CHARS = 256
RETRY_SCOPE_PREFIX = "[Intutic] Retry scope: "

_C0 = re.compile("[\\u0000-\\u001f]")


def _detail_text(s):
    """s without C0 control characters, cut to 256 code points; None when nothing is left or it is not a string."""
    if not isinstance(s, str):
        return None
    clean = _C0.sub("", s)
    return clean[:REFUSAL_DETAIL_MAX_CHARS] if clean else None


def _detail_list(v):
    if not isinstance(v, list):
        return None
    out = []
    for item in v:
        if len(out) >= REFUSAL_DETAIL_MAX_ITEMS:
            break
        t = _detail_text(item)
        if t is not None:
            out.append(t)
    return out or None


def bound_refusal_scope(scope):
    """A scope bounded as the module says, keys in a fixed order; None when nothing is left."""
    if not isinstance(scope, dict):
        return None
    out = {}
    for key in ("paths", "tools"):
        v = _detail_list(scope.get(key))
        if v:
            out[key] = v
    for key in ("step", "detector", "rule"):
        v = _detail_text(scope.get(key))
        if v is not None:
            out[key] = v
    return out or None


def bound_refusal_evidence(evidence):
    """Evidence bounded: at most 8 items, each with a kind and a detail that survive bounding."""
    out = []
    if not isinstance(evidence, list):
        return out
    for item in evidence:
        if len(out) >= REFUSAL_DETAIL_MAX_ITEMS:
            break
        if not isinstance(item, dict):
            continue
        kind, detail = _detail_text(item.get("kind")), _detail_text(item.get("detail"))
        if kind is not None and detail is not None:
            out.append({"kind": kind, "detail": detail})
    return out


def refusal_detail_for_mode(mode, scope, evidence):
    """The detail a refusal carries in an intervention mode: nothing in OPAQUE, else the bounded scope and evidence."""
    if mode == "OPAQUE":
        return {}
    out = {}
    s = bound_refusal_scope(scope)
    if s:
        out["scope"] = s
    e = bound_refusal_evidence(evidence)
    if e:
        out["evidence"] = e
    return out


def retry_scope_line(mode, scope):
    """'[Intutic] Retry scope: <paths, else tools>', or None when neither, and in OPAQUE."""
    if mode == "OPAQUE":
        return None
    s = bound_refusal_scope(scope) or {}
    items = s.get("paths") or s.get("tools")
    return RETRY_SCOPE_PREFIX + ", ".join(items) if items else None


_INTUTIC_ACTION_NEEDLES = [["action:deploy",["git push","kubectl apply","kubectl rollout","helm upgrade","helm install","terraform apply","docker push","serverless deploy","fly deploy","vercel deploy","gcloud run deploy","aws deploy","aws s3 sync","eb deploy"]],["action:publish",["npm publish","pnpm publish","yarn publish","cargo publish","twine upload","poetry publish","gem push","docker manifest push"]],["action:release",["gh release create","git tag","npm version","cargo release","goreleaser release","semantic-release"]],["action:db_write",["insert into","update ","delete from","drop table","drop database","drop schema","truncate ","alter table"]],["action:run_tests",["npm test","npm run test","pnpm test","pnpm run test","yarn test","cargo test","go test","pytest","python -m pytest","vitest","jest","mocha","rspec","phpunit","make test","gradle test","mvn test","dotnet test","bazel test","tox"]],["action:http_post",["curl -x post","curl --request post","curl -d ","curl --data","wget --post","http post"]],["action:migrate",["prisma migrate deploy","prisma db push","alembic upgrade","alembic downgrade","rails db:migrate","rake db:migrate","manage.py migrate","flyway migrate","liquibase update","knex migrate:latest","sequelize db:migrate"]],["action:prod_write",["--prod","rails_env=production","node_env=production","--context prod","--namespace production","-n production","--environment production","--stage prod"]],["action:destroy",["terraform destroy","kubectl delete","helm uninstall","helm delete","drop table","drop database","drop schema","truncate ","aws s3 rb","aws s3 rm"]],["action:payment",["api.stripe.com/v1/charges","api.stripe.com/v1/payment_intents","api.stripe.com/v1/transfers","api.stripe.com/v1/payouts","api.stripe.com/v1/refunds","stripe charges create","stripe payment_intents create","stripe transfers create","stripe payouts create","api-m.paypal.com/v2/payments","api.paypal.com/v1/payments"]]]
_INTUTIC_ACTION_TOOLS = ["bash","shell","run_command","runcommand","execute_command","run_shell_command","terminal","execute","exec"]
_INTUTIC_FORCE_FLAGS = [" --force "," -f "]

_INTUTIC_RM_SEGMENT = re.compile(r"[;&|()\\n]")
_INTUTIC_RM_GAP = re.compile(r"[ \\t\\r\\f\\v]+")


def _intutic_removes_outside_tree(args):
    # removes_outside_tree (intutic_clawde actions.py, gate-js actions.ts):
    # rm -rf / -fr / -r -f / --recursive --force with a target that is
    # absolute, under ~, or contains "..". rm -rf build/ is not one.
    for segment in _INTUTIC_RM_SEGMENT.split(args):
        words = [w for w in _INTUTIC_RM_GAP.split(segment) if w != ""]
        at = next((i for i, w in enumerate(words) if w == "rm" or w.endswith("/rm")), -1)
        if at == -1:
            continue
        recursive = force = False
        flags = True
        targets = []
        for w in words[at + 1:]:
            if flags and w == "--":
                flags = False
            elif flags and w.startswith("--"):
                if w == "--recursive":
                    recursive = True
                if w == "--force":
                    force = True
            elif flags and w.startswith("-") and len(w) > 1:
                lower = w.lower()
                if "r" in lower:
                    recursive = True
                if "f" in lower:
                    force = True
            else:
                targets.append(w.strip("\\"'"))
        if recursive and force and any(t.startswith("/") or t.startswith("~") or ".." in t for t in targets):
            return True
    return False


def intutic_actions(tool, command):
    if str(tool or "").lower() not in _INTUTIC_ACTION_TOOLS:
        return " "
    words = phrase_text(command)
    out = " "
    for action, needles in _INTUTIC_ACTION_NEEDLES:
        if any(has_phrase(words, n) for n in needles):
            out += action + " "
    # A recursive, forced remove outside the working tree is destroy too
    # (Q3); no phrase can say "outside the tree", so it is a predicate.
    if " action:destroy " not in out and _intutic_removes_outside_tree(str(command or "")):
        out += "action:destroy "
    # The force-push compound: the git push phrase and a whole-word flag.
    if has_phrase(words, "git push"):
        padded = " " + " ".join(str(command or "").lower().split()) + " "
        if any(f in padded for f in _INTUTIC_FORCE_FLAGS):
            out += "action:force_push "
    return out


def _intutic_records(records_text, kind):
    out = []
    for line in str(records_text or "").split("\\n"):
        r = decode_gate_rule_record(line) if line else None
        if r is not None and r["kind"] == kind:
            out.append(r)
    return out


def intutic_rule_skip(records_text, kinds_csv):
    # The fallback line ids a decoded, enforcing record names, one per line,
    # for the kinds this gate evaluates. Any other fallback line stays.
    kinds = [k for k in str(kinds_csv).split(",") if k]
    out = []
    for line in str(records_text or "").split("\\n"):
        r = decode_gate_rule_record(line) if line else None
        if r is not None and r["fallbackId"] and r["kind"] in kinds:
            out.append(r["fallbackId"])
    return "\\n".join(out)


def _intutic_now_ms():
    import time
    return int(time.time() * 1000)


def _intutic_state_path(harness, session):
    import hashlib, os
    base = os.environ.get("INTUTIC_OUTCOME_STATE_DIR") or os.path.join(
        os.path.expanduser("~"), ".intutic", "hooks", "state", "outcomes")
    return os.path.join(base, outcome_state_file_name(str(harness), str(session),
                                                      lambda t: hashlib.sha256(t.encode("utf-8")).hexdigest()))


def _intutic_state_read(path):
    # (exists, state): a missing file is an empty state; one that does not
    # read is None, which leaves every qualified rule unmet.
    import os
    if not os.path.exists(path):
        return False, empty_outcome_state()
    try:
        with open(path, "r", encoding="utf-8") as fh:
            return True, parse_outcome_state(fh.read())
    except Exception:
        return True, None


def _intutic_state_write(path, state):
    import json, os
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        tmp = path + ".tmp." + str(os.getpid())
        with open(tmp, "w", encoding="utf-8") as fh:
            json.dump(state, fh, separators=(",", ":"))
        os.replace(tmp, path)
    except Exception:
        pass


def _intutic_verdict(r, code, rid, reason, scope):
    return "\\t".join(["block" if r["rollout"] == "enforce" else "shadow", code, rid, " ".join(reason.split()),
                      retry_scope_line("TRANSPARENT", scope) or ""])


def intutic_outcome_check(harness, observable, tool, actions, session, records_text, tool_input_json):
    import json
    try:
        ti = json.loads(tool_input_json or "{}")
    except ValueError:
        ti = {}
    recs = _intutic_records(records_text, "requires_outcome")
    path = _intutic_state_path(harness, session) if session else None
    exists, state = _intutic_state_read(path) if path else (False, empty_outcome_state())
    shadow = ""
    for r in recs:
        then = r["then"]
        if (" " + then + " ") not in str(actions) and then.lower() != str(tool).lower():
            continue
        why = None
        if observable != "1":
            case = "not_observable"
        elif not session:
            case = "no_session"
        else:
            case, why = prerequisite_case(state, r["first"], r["adjacent"], _intutic_now_ms())
        if case == "met":
            continue
        rid = "requires_before." + r["first"] + "[ok]" + ("~>" if r["adjacent"] else "->") + then
        line = _intutic_verdict(r, "PREREQUISITE_UNMET", rid, prerequisite_unmet_reason(r["first"], then, case, why, harness),
                                {"tools": [then], "step": r["first"]})
        if r["rollout"] == "enforce":
            return line
        shadow = shadow or line
    # Bookkeeping, on a call this tier lets through: no outcome is adjacent
    # to what comes next any more, and a call that changes files (a mutation
    # tool, or a shell write such as sed -i or git checkout) makes a pass
    # before it stale (Q1).
    if path and exists and state is not None:
        _intutic_state_write(path, note_completed_call(state, is_file_write_call(tool, ti)))
    return shadow


def intutic_post_record(harness, payload_text):
    # A post-tool payload: a shell call that ran tests records its outcome;
    # a file change marks an earlier [ok] stale. Never refuses.
    import json
    try:
        d = json.loads(payload_text or "{}")
    except ValueError:
        return ""
    if not isinstance(d, dict):
        return ""
    session = str(d.get("session_id") or d.get("sessionId") or "")
    if not session:
        return ""
    tool = str(d.get("tool_name") or d.get("toolName") or "")
    ti = d.get("tool_input") if isinstance(d.get("tool_input"), dict) else {}
    command = ""
    for k in ("command", "cmd", "script", "shell_command"):
        if isinstance(ti.get(k), str) and ti.get(k):
            command = ti[k]
            break
    actions = intutic_actions(tool, command)
    path = _intutic_state_path(harness, session)
    exists, state = _intutic_state_read(path)
    if " action:run_tests " in actions:
        resp = d.get("tool_response")
        output = ""
        if isinstance(resp, dict):
            v = resp.get("llmContent")
            output = v if isinstance(v, str) else json.dumps(v)
            # Gemini CLI prefixes the command's output with "Output: ".
            if output.startswith("Output: "):
                output = output[len("Output: "):]
        elif isinstance(resp, str):
            output = resp
        decision = decide_test_outcome({"exitCode": extract_exit_code(output), "output": output})
        _intutic_state_write(path, record_test_outcome(state if state is not None else empty_outcome_state(),
                                                       "action:run_tests", decision, _intutic_now_ms()))
    elif exists and state is not None and is_file_write_call(tool, ti):
        _intutic_state_write(path, note_completed_call(state, True))
    return ""


def _intutic_real(path):
    import os
    return os.path.realpath(path)


def _intutic_repo_root(cwd):
    import os
    d = _intutic_real(cwd or os.getcwd())
    while True:
        if os.path.exists(os.path.join(d, ".git")):
            return d
        parent = os.path.dirname(d)
        if parent == d:
            return _intutic_real(cwd or os.getcwd())
        d = parent


def _intutic_approved_plan(session, workspace_id):
    import hashlib, json, os, datetime
    path = os.environ.get("INTUTIC_APPROVED_PLANS") or os.path.join(
        os.path.expanduser("~"), ".intutic", "hooks", "approved-plans.jsonl")
    try:
        with open(path, "r", encoding="utf-8") as fh:
            lines = fh.read().split("\\n")
    except Exception:
        return None
    digest = ws = expires = ""
    body = []
    for line in lines:
        if line.startswith("#digest "):
            digest = line[8:].strip()
        elif line.startswith("#workspace "):
            ws = line[11:].strip()
        elif line.startswith("#expires "):
            expires = line[9:].strip()
        elif line and not line.startswith("#"):
            body.append(line)
    if hashlib.sha256("\\n".join(body).encode("utf-8")).hexdigest()[:32] != digest:
        return None
    if ws and workspace_id and ws != workspace_id:
        return None
    try:
        exp = datetime.datetime.fromisoformat(expires.replace("Z", "+00:00"))
    except Exception:
        return None
    if datetime.datetime.now(datetime.timezone.utc) >= exp:
        return None
    tools = None
    for line in body:
        try:
            e = json.loads(line)
        except ValueError:
            continue
        if not isinstance(e, dict) or e.get("sessionId") != session or e.get("state") not in ("APPROVED", "EXECUTING"):
            continue
        tools = (tools or []) + [str(t).lower() for t in (e.get("tools") or []) if isinstance(t, str)]
    return None if tools is None else {"tools": tools}


def intutic_trajectory_check(harness, tool, session, records_text, tool_input_json, payload_cwd, workspace_id):
    import json, os
    try:
        ti = json.loads(tool_input_json or "{}")
    except ValueError:
        ti = {}
    shadow = ""
    scopes = _intutic_records(records_text, "scope_paths")
    targets = [t["target"] for t in change_targets(tool, ti)] if scopes else []
    if targets:
        cwd = payload_cwd or os.getcwd()
        root = _intutic_repo_root(cwd)
        rels = []
        for t in targets:
            absolute = _intutic_real(os.path.join(_intutic_real(cwd), t))
            rel = os.path.relpath(absolute, root)
            rels.append((t, None if rel == ".." or rel.startswith(".." + os.sep) or os.path.isabs(rel) else rel.replace(os.sep, "/")))
        for rollout in ("enforce", "shadow"):
            group = [r for r in scopes if r["rollout"] == rollout]
            if not group:
                continue
            union = [s for r in group for s in r["scopePaths"]]
            bad = [t for t, rel in rels if rel is None or not is_within_scope(rel, union)]
            if bad:
                r = group[0]
                line = _intutic_verdict(r, "OUT_OF_SCOPE", "scope_paths." + r["sopTitle"],
                                        ", ".join(bad) + " is outside scope_paths (" + ", ".join(union) + ")", {"paths": bad})
                if rollout == "enforce":
                    return line
                shadow = shadow or line
    plans = _intutic_records(records_text, "plan_approval")
    if plans and not is_plan_exempt_tool(str(tool)):
        for rollout in ("enforce", "shadow"):
            group = [r for r in plans if r["rollout"] == rollout]
            if not group:
                continue
            strict = [r for r in group if r["mode"] == "strict"]
            r = strict[0] if strict else group[0]
            level = r["mode"]
            rid = "plan_approval." + r["sopTitle"]
            line = ""
            if not session:
                line = _intutic_verdict(r, "PLAN_NOT_APPROVED", rid, "plan_approval: " + level + " - " + harness + " sent no session id, so no approved plan can be found for this call", {"tools": [str(tool)]})
            else:
                plan = _intutic_approved_plan(session, workspace_id)
                if plan is None:
                    line = _intutic_verdict(r, "PLAN_NOT_APPROVED", rid, "plan_approval: " + level + " - this session has no APPROVED or EXECUTING plan; get its plan approved, then retry", {"tools": [str(tool)]})
                elif level == "strict" and str(tool).lower() not in plan["tools"]:
                    line = _intutic_verdict(r, "OFF_PLAN", rid, "plan_approval: strict - " + str(tool) + " is not a step of the approved plan", {"tools": [str(tool)]})
            if line and rollout == "enforce":
                return line
            shadow = shadow or line
    return shadow


def intutic_phrase_rule(source, command):
    words = phrase_text(command)
    return any(has_phrase(words, p, True) for p in source.split("|"))


def intutic_mcp_registry(record_b64, tool):
    # The registry decision for one mcp__<server>__<tool> call, from the
    # snapshot's @mcp_registry record: "code<TAB>ruleId<TAB>reason", or "" to
    # let the call continue.
    call = split_mcp_tool_name(tool)
    registry = decode_registry_record(MCP_REGISTRY_RECORD_TAG + "\\t" + record_b64)
    if call is None or registry is None:
        return ""
    refusal = evaluate_registry(registry, call[0], call[1])
    return "\\t".join(refusal) if refusal else ""


def intutic_mcp_unverified(tool):
    # The refusal of an mcp__<server>__<tool> call on a snapshot that failed
    # its integrity check, as "code<TAB>ruleId<TAB>reason"; "" for a call that
    # is not an MCP call.
    call = split_mcp_tool_name(tool)
    return "\\t".join(unverified_refusal(call[0])) if call else ""


"""Fault injection in the hook gates, for chaos runs (intutic chaos run).

A transliteration of packages/shared-types/src/chaosGate.ts; read that
module's docstring for the counter files and why every count lives on disk.
In short: a gate is a new process per tool call, so the plan is decoded on
each call, plan_loaded is reported by whichever gate first creates
EVENTS.gate-plan-loaded, and each fault's seen and hit counts are numbered
empty files in EVENTS.gate-counters/, each number claimed with an exclusive
create (O_CREAT | O_EXCL), which exactly one process wins. A permission fault
never sleeps: it holds the call as an approval hold does, in a
FAULT.held.KEY.G file whose modification time is when, and the identical
retry is held again until delay_s has passed, then allowed (delay) or denied
(hold_then_deny) by the one retry that creates FAULT.released.KEY.G.

The bash gates emit this file verbatim (services/sync-daemon/src/lib/chaosPy.ts
holds a byte-identical copy, which a test compares), intutic_clawde.gate's
Gate.guard runs it in process, and every copy runs
packages/shared-types/fixtures/chaos-gate-vectors.json. It must stay
self-contained: the standard library only, no module state beyond the
constants below, and no backtick or dollar-brace, which the TypeScript copy
cannot hold.
"""

import base64
import binascii
import datetime
import json
import os
import re
import sys
import time

_CHAOS_FAULT_IDS = (
    "llm.rate_limit", "llm.upstream_5xx", "llm.context_trim", "llm.model_degrade", "tool.error", "tool.stale_data",
    "mcp.toolset_change", "permission.deny_or_delay", "inject.tool_result", "egress.dns_fail", "egress.credential_401",
)
_CHAOS_B64URL = re.compile(r"^[A-Za-z0-9_-]+={0,2}$")
_CHAOS_RUN_ID = re.compile(r"^[A-Za-z0-9_-]{6,64}$")
_CHAOS_CANARY = re.compile(r"^E-INTUTIC-[0-9A-F]{4,16}$")


def _chaos_int(v, low, high):
    # JSON numbers as JavaScript reads them: 2.0 is the integer 2. A bool is not a number.
    if isinstance(v, bool) or not isinstance(v, (int, float)):
        return None
    if isinstance(v, float):
        if not v.is_integer():
            return None
        v = int(v)
    return v if low <= v <= high else None


def chaos_decode(raw):
    """(plan, None), or (None, why it is not one)."""
    def invalid(why):
        return None, "INTUTIC_CHAOS_PLAN is not a valid plan: " + why
    try:
        if not isinstance(raw, str) or not _CHAOS_B64URL.match(raw):
            raise ValueError("alphabet")
        b64 = raw.rstrip("=")
        data = json.loads(base64.urlsafe_b64decode(b64 + "=" * ((4 - len(b64) % 4) % 4)).decode("utf-8"))
    except (ValueError, binascii.Error, UnicodeDecodeError):
        return None, "INTUTIC_CHAOS_PLAN is not base64url-encoded JSON"
    if not isinstance(data, dict):
        return invalid("not a JSON object")
    v = data.get("v")
    if isinstance(v, bool) or v != 1:
        return invalid("version " + json.dumps(v) + ", and a gate reads only version 1")
    run_id = data.get("runId")
    if not isinstance(run_id, str) or not _CHAOS_RUN_ID.match(run_id):
        return invalid("runId")
    canary = data.get("canary")
    if not isinstance(canary, str) or not _CHAOS_CANARY.match(canary):
        return invalid("canary")
    raw_faults = data.get("faults")
    if not isinstance(raw_faults, list) or len(raw_faults) > 50:
        return invalid("faults")
    faults = []
    for i, f in enumerate(raw_faults):
        at = "faults[" + str(i) + "]"
        if not isinstance(f, dict) or not isinstance(f.get("id"), str) or f["id"] not in _CHAOS_FAULT_IDS:
            return invalid(at + ".id")
        if f["id"] not in ("tool.error", "permission.deny_or_delay"):
            continue
        match = None
        if "match" in f:
            if not isinstance(f["match"], dict):
                return invalid(at + ".match")
            for k, mv in f["match"].items():
                if k not in ("tool", "host", "model") or not isinstance(mv, str) or not mv:
                    return invalid(at + ".match." + k)
            match = f["match"]
        after_calls = 0
        if "after_calls" in f:
            after_calls = _chaos_int(f["after_calls"], 0, 10000)
            if after_calls is None:
                return invalid(at + ".after_calls")
        times = None
        if "times" in f:
            times = _chaos_int(f["times"], 1, 10000)
            if times is None:
                return invalid(at + ".times")
        fault = {
            "index": i, "id": f["id"], "match": match, "after_calls": after_calls, "times": times,
            "message": "tool failed", "mode": "deny", "delay_s": 0,
        }
        if f["id"] == "tool.error" and "message" in f:
            # Lengths in UTF-16 code units, as JavaScript counts them.
            m = f["message"]
            if not isinstance(m, str) or not 1 <= len(m.encode("utf-16-le", "surrogatepass")) // 2 <= 2000:
                return invalid(at + ".message")
            fault["message"] = m
        if f["id"] == "permission.deny_or_delay":
            if "mode" in f:
                if f["mode"] not in ("deny", "delay", "hold_then_deny"):
                    return invalid(at + ".mode")
                fault["mode"] = f["mode"]
            if "delay_s" in f:
                delay_s = _chaos_int(f["delay_s"], 0, 600)
                if delay_s is None:
                    return invalid(at + ".delay_s")
                fault["delay_s"] = delay_s
        faults.append(fault)
    return {"runId": run_id, "canary": canary, "faults": faults}, None


def chaos_matches(match, tool):
    """Whether a fault's match covers a gate call, which has a tool and nothing else."""
    if not match:
        return True
    if "host" in match or "model" in match:
        return False
    p = match.get("tool")
    if p is None:
        return True
    return tool.endswith(p[1:]) if p.startswith("*") else tool == p


def chaos_event(plan, type_, fields, now):
    """One events-file line: ts, runId, component, type, then the fields that are set."""
    event = {"ts": now, "runId": plan["runId"], "component": "gate", "type": type_}
    for k, v in fields:
        if v is not None:
            event[k] = v
    return json.dumps(event, separators=(",", ":"), ensure_ascii=False) + "\\n"


def chaos_append(events_path, lines):
    """Appends whole lines in one write. An I/O error is reported, never raised."""
    try:
        fd = os.open(events_path, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o644)
        try:
            os.write(fd, lines.encode("utf-8"))
        finally:
            os.close(fd)
    except OSError as e:
        sys.stderr.write("[Intutic Governance] chaos: could not append to " + events_path + ": " + str(e) + "\\n")


def chaos_claim(directory, prefix, limit):
    """Claims the next numbered file DIRECTORY/PREFIXn with an exclusive create.

    Returns n, 0 when every number up to limit is taken, or -1 on an I/O
    error, after saying so.
    """
    try:
        # Beside the events file, never creating its directory: the runner did.
        try:
            os.mkdir(directory)
        except FileExistsError:
            pass
        n = sum(1 for name in os.listdir(directory) if name.startswith(prefix)) + 1
        while limit is None or n <= limit:
            try:
                os.close(os.open(os.path.join(directory, prefix + str(n)), os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o644))
                return n
            except FileExistsError:
                n += 1
        return 0
    except OSError as e:
        sys.stderr.write("[Intutic Governance] chaos: could not count calls in " + directory + ": " + str(e) + "\\n")
        return -1


def chaos_open_hold(directory, fault, key):
    """The open hold of one fault on one call: (g, created), the number of
    the newest FAULT.held.KEY.G file with no released twin and its
    modification time in milliseconds; None when there is none or it cannot
    be read."""
    try:
        held = str(fault) + ".held." + key + "."
        names = os.listdir(directory)
        g = 0
        for name in names:
            if name.startswith(held) and name[len(held):].isdigit():
                g = max(g, int(name[len(held):]))
        if g == 0 or (str(fault) + ".released." + key + "." + str(g)) in names:
            return None
        # In whole milliseconds, as now is: a hold is never younger than the call that reads it.
        return g, os.stat(os.path.join(directory, held + str(g))).st_mtime_ns // 1000000
    except OSError:
        # No counters yet, or none readable: no hold to continue.
        return None


def chaos_release(directory, fault, key, g):
    """Ends hold g with an exclusive create: True for the one caller that does."""
    try:
        os.close(os.open(os.path.join(directory, str(fault) + ".released." + key + "." + str(g)),
                         os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o644))
        return True
    except OSError:
        # Another gate released it first, or it cannot be written.
        return False


def _chaos_ms(now):
    # The ISO-8601 time a call is decided at, in milliseconds; the clock if unreadable.
    try:
        return round(datetime.datetime.fromisoformat(now.replace("Z", "+00:00")).timestamp() * 1000)
    except (AttributeError, TypeError, ValueError):
        return int(time.time() * 1000)


def chaos_now():
    """The time as the JavaScript gates write it: <TIMESTAMP>."""
    return datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="milliseconds").replace("+00:00", "Z")


def chaos_call(plan, events_path, call, now):
    """Reports one call and returns the fault the gate must apply, or None.

    call: tool, decision (allow, deny, ask or hold, before any fault), ruleId,
    destructive, policyHit, and key: the call's digest in hex (its tool and
    input, as the gate keys an approval hold), which a held call's retry
    shares. The fault: faultId, kind (deny or hold) and reason, as
    chaosGateCall returns it. now is the ISO-8601 time, and the clock a hold
    is timed by.
    """
    lines = ""
    first = True
    try:
        os.close(os.open(events_path + ".gate-plan-loaded", os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o644))
    except FileExistsError:
        first = False
    except OSError:
        pass
    if first:
        lines += chaos_event(plan, "plan_loaded", [("faults", len(plan["faults"]))], now)
    lines += chaos_event(plan, "gate_decision", [
        ("tool", call["tool"]),
        ("decision", call["decision"]),
        ("ruleId", call.get("ruleId") or None),
        ("destructive", bool(call.get("destructive"))),
        ("policyHit", bool(call.get("policyHit"))),
    ], now)
    fault = None
    if call["decision"] == "allow":
        directory = events_path + ".gate-counters"
        key = re.sub(r"[^0-9A-Za-z]", "", str(call.get("key") or ""))[:128] or "call"
        now_ms = _chaos_ms(now)
        tag = " [" + plan["canary"] + "]"
        held = "Permission held for approval; retrying this exact call passes once it is approved" + tag
        # The retry of a held call: still held until the delay has passed,
        # then let through or denied by the one retry that releases it.
        retry = False
        for f in plan["faults"]:
            if f["id"] != "permission.deny_or_delay" or f["mode"] == "deny" or not chaos_matches(f["match"], call["tool"]):
                continue
            open_hold = chaos_open_hold(directory, f["index"], key)
            if open_hold is None:
                continue
            retry = True
            if f["delay_s"] > 0 and now_ms - open_hold[1] < f["delay_s"] * 1000:
                fault = {"faultId": f["id"], "kind": "hold", "reason": held}
            elif chaos_release(directory, f["index"], key, open_hold[0]):
                if f["mode"] == "hold_then_deny":
                    fault = {"faultId": f["id"], "kind": "deny",
                             "reason": "Permission held for approval, then denied by approver" + tag}
            else:
                # Another gate released it first: this call is a new one.
                retry = False
                continue
            break
        for f in plan["faults"] if not retry else ():
            if not chaos_matches(f["match"], call["tool"]):
                continue
            # An MCP tool's error is the MCP proxy's to inject; a gate injects the built-in side.
            if f["id"] == "tool.error" and call["tool"].startswith("mcp__"):
                continue
            seen = chaos_claim(directory, str(f["index"]) + ".seen.", None)
            if fault is not None or seen < 1 or seen <= f["after_calls"]:
                continue
            if f["times"] is not None and chaos_claim(directory, str(f["index"]) + ".hit.", f["times"]) < 1:
                continue
            if f["id"] == "tool.error":
                fault = {"faultId": f["id"], "kind": "deny", "reason": f["message"] + tag}
            elif f["mode"] == "deny":
                fault = {"faultId": f["id"], "kind": "deny", "reason": "Permission denied by approver" + tag}
            else:
                # Held from now: the hold's file is what its retries find.
                if chaos_claim(directory, str(f["index"]) + ".held." + key + ".", None) < 1:
                    continue
                fault = {"faultId": f["id"], "kind": "hold", "reason": held}
            lines += chaos_event(plan, "fault_injected", [("faultId", f["id"]), ("call", seen), ("target", call["tool"])], now)
        if fault is None or fault["kind"] == "hold":
            lines += chaos_event(plan, "tool_call", [("tool", call["tool"]), ("ok", fault is None)], now)
    chaos_append(events_path, lines)
    return fault



def intutic_chaos_begin():
    # Why the chaos run's plan cannot be used, or "" when it can.
    plan, error = chaos_decode(os.environ.get("INTUTIC_CHAOS_PLAN", ""))
    if error:
        return error
    if not os.environ.get("INTUTIC_CHAOS_EVENTS"):
        return "INTUTIC_CHAOS_PLAN is set but INTUTIC_CHAOS_EVENTS is not, so nothing the run does could be reported"
    return ""


def intutic_chaos_call(tool, decision, rule_id, destructive, policy_hit, key=""):
    # Records one call as the gate decided it, before any fault; returns the
    # fault to apply to an allowed call as "kind<TAB>reason" (kind deny or
    # hold), or "". key is the call's digest, which a held call's retry shares.
    plan, error = chaos_decode(os.environ.get("INTUTIC_CHAOS_PLAN", ""))
    events = os.environ.get("INTUTIC_CHAOS_EVENTS", "")
    if error or not events:
        return ""
    call = {"tool": tool, "decision": decision, "ruleId": rule_id or None,
            "destructive": destructive == "1", "policyHit": policy_hit == "1", "key": key}
    fault = chaos_call(plan, events, call, chaos_now())
    if fault is None:
        return ""
    return fault["kind"] + "\\t" + fault["reason"]


_INTUTIC_DECIDE_CODES = {
    "allow": (None,),
    "refuse": ("DECIDE_REFUSED", "DECIDE_ESCALATED", "GOVERNANCE_UNAVAILABLE"),
    "escalate": ("DECIDE_ESCALATED",),
}


def intutic_decide_check(harness, tool, budget_ms, session_id, enforce, tool_input_json):
    # The decide tier of a bash gate: \`intutic decide check --stdin\` on a call
    # an @decide record names. Returns outcome, code, rule id and reason,
    # joined by the unit separator (an empty field where there is none). A
    # missing CLI, a non-zero exit, a timeout or an answer that does not read
    # is unavailable: refused with GOVERNANCE_UNAVAILABLE when a matched
    # record is stamped enforce (enforce "1"), allowed, with the reason, when
    # every one is shadow. The CLI spends the budget, its own start included.
    import json, shutil, subprocess
    sep = chr(31)

    def clean(text):
        return " ".join(str(text).split())

    def unavailable(why):
        if enforce != "1":
            return sep.join(["allow", "", "", clean(why)])
        return sep.join(["refuse", "GOVERNANCE_UNAVAILABLE", "", clean("GOVERNANCE_UNAVAILABLE — " + why)])

    try:
        tool_input = json.loads(tool_input_json or "{}")
    except ValueError:
        tool_input = {}
    exe = shutil.which("intutic")
    if not exe:
        return unavailable("the decide rules on " + tool + " need the intutic CLI, which is not on PATH")
    payload = {"v": 1, "harness": harness, "tool": tool, "toolInput": tool_input, "cwd": os.getcwd(),
               "sessionId": session_id, "budgetMs": int(budget_ms), "lastUserTurn": None}
    try:
        done = subprocess.run([exe, "decide", "check", "--stdin"], input=json.dumps(payload), capture_output=True,
                              text=True, timeout=int(budget_ms) / 1000.0)
    except subprocess.TimeoutExpired:
        return unavailable("intutic decide check did not answer within " + str(budget_ms) + " ms")
    except OSError as err:
        return unavailable("intutic decide check could not run (" + type(err).__name__ + ")")
    if done.returncode != 0:
        return unavailable("intutic decide check exited " + str(done.returncode))
    try:
        out = json.loads(done.stdout)
    except ValueError:
        out = None
    rule_id = out.get("ruleId") if isinstance(out, dict) else None
    if (not isinstance(out, dict) or out.get("v") != 1 or out.get("outcome") not in _INTUTIC_DECIDE_CODES
            or out.get("code") not in _INTUTIC_DECIDE_CODES[out.get("outcome")]
            or not (rule_id is None or (isinstance(rule_id, str) and rule_id.startswith("decide.")))
            or not isinstance(out.get("reason", ""), str)):
        return unavailable("intutic decide check gave an answer this gate does not read")
    return sep.join([out["outcome"], out.get("code") or "", clean(rule_id or ""), clean(out.get("reason") or "")])

INTUTIC_PY_LIB_END
export INTUTIC_PY_LIB

INTUTIC_FIELDS="$(printf '%s' "$INPUT" | python3 -c '
import os, sys, json
def clean(v):
    return " ".join(str(v).split()) if isinstance(v, str) else ""
state = "ok"
try:
    d = json.load(sys.stdin)
except Exception:
    d = {}
    state = "malformed"
if not isinstance(d, dict):
    d = {}
    state = "malformed"
# The envelope check githubCopilotHooks established, applied to the bash
# family: a payload carrying none of the tool fields in any known spelling is
# one the gate cannot evaluate, and extracting empty fields from it would
# match no rule — an allow. Reported as a STATE and decided in the gate body,
# because log_event is not defined yet at extraction time.
if state == "ok" and not any(
    k in d for k in ("tool_name", "toolName", "tool_input", "toolInput")
):
    state = "malformed"
i = d.get("tool_input") or {}
if not isinstance(i, dict):
    i = {}
def first(*keys):
    for k in keys:
        v = i.get(k)
        if isinstance(v, str) and v:
            return clean(v)
    return ""
def raw_first(*keys):
    for k in keys:
        v = i.get(k)
        if isinstance(v, str) and v:
            return v
    return ""
raw_command = raw_first("command", "cmd", "script", "shell_command")
tool_input_json = json.dumps(i, separators=(",", ":"), ensure_ascii=False)
# Too large to evaluate inside the hook timeout (gateLimits.ts): the gate body
# refuses on this line, and the command and arguments are not passed on.
command_bytes = len(raw_command.encode("utf-8", "surrogatepass"))
argument_bytes = len(tool_input_json.encode("utf-8", "surrogatepass"))
too_large = ""
if command_bytes > 262144:
    too_large = "the command is %d bytes, over the 262144-byte limit a gate evaluates; split it into smaller commands" % command_bytes
elif argument_bytes > 1048576:
    too_large = "the tool arguments are %d bytes, over the 1048576-byte limit a gate evaluates; write the content in smaller parts" % argument_bytes
if too_large:
    raw_command = ""
    tool_input_json = "{}"
# The hold classifier reads the raw command: a line continuation or a comment
# is still in it. The library is the shared phrase matcher, not a regex.
lib = {}
try:
    exec(os.environ.get("INTUTIC_PY_LIB", ""), lib)
    actions = lib["intutic_actions"](d.get("tool_name", ""), raw_command) if not too_large else " "
except Exception:
    actions = " "
# The state line comes FIRST: the lines after it may legitimately be empty,
# and command substitution strips trailing newlines, so the last line is the
# only position an empty value cannot survive in.
print(state)
print(too_large)
print(clean(d.get("tool_name", "")))
print(first("path", "file_path", "notebook_path", "filePath"))
print("" if too_large else first("command", "cmd", "script", "shell_command"))
print(clean(d.get("session_id", d.get("sessionId", ""))))
print(actions)
# The raw command as one JSON line, for phrase-subject rules.
print(json.dumps(raw_command, ensure_ascii=False))
# The FULL tool_input, serialized to the exact shape argPattern rules are
# matched against everywhere: JSON.stringify(tool_input) — compact separators,
# insertion order, non-ASCII intact. The selected fields above are whitespace-
# collapsed for token matching; this one must NOT be, or a WHERE clause that
# spans a key/value boundary matches here and not in the JS gates. json.dumps
# escapes every newline, so it is still exactly one line to read back.
print(tool_input_json)
' 2>/dev/null || printf '\\n\\n\\n\\n\\n\\n\\n\\n\\n')"

# Each read is \`|| true\` because command substitution strips trailing newlines:
# a tool call with no command argument yields fewer lines than reads, so a late
# read hits EOF and returns non-zero. Under \`set -e\` that killed the gate with
# **exit 1** — which every harness reads as a hook error and lets the call
# through. A guard that fails open on the most ordinary input there is (a Write
# with no shell command) is worse than no guard, because it looks present.
{ IFS= read -r INTUTIC_EXTRACT_STATE || true; IFS= read -r INTUTIC_TOO_LARGE || true; IFS= read -r TOOL || true; IFS= read -r TARGET || true; IFS= read -r COMMAND || true; IFS= read -r SESSION_ID || true; IFS= read -r INTUTIC_ACTIONS || true; IFS= read -r INTUTIC_RAW_COMMAND_JSON || true; IFS= read -r TOOL_INPUT_JSON || true; } <<EOF_INTUTIC_FIELDS
$INTUTIC_FIELDS
EOF_INTUTIC_FIELDS
TOOL="\${TOOL:-}"; TARGET="\${TARGET:-}"; COMMAND="\${COMMAND:-}"; SESSION_ID="\${SESSION_ID:-}"
# Space-padded action tokens the extractor's classifier found, or " ".
INTUTIC_ACTIONS="\${INTUTIC_ACTIONS:- }"
# Why the call is too large to evaluate, or empty (gateLimits.ts).
INTUTIC_TOO_LARGE="\${INTUTIC_TOO_LARGE:-}"
INTUTIC_RAW_COMMAND_JSON="\${INTUTIC_RAW_COMMAND_JSON:-""}"
# Empty means the extractor itself died (the fallback printf above): treat it
# exactly like a payload the parser rejected. The gate body refuses on any
# value other than "ok" — see the envelope refusal in emitShellGate.
INTUTIC_EXTRACT_STATE="\${INTUTIC_EXTRACT_STATE:-}"
[ -n "$INTUTIC_EXTRACT_STATE" ] || INTUTIC_EXTRACT_STATE="malformed"
# Empty only when the extractor failed wholesale (malformed stdin). Defaulting
# to the empty OBJECT rather than the empty string keeps the argPattern match
# well-defined either way.
TOOL_INPUT_JSON="\${TOOL_INPUT_JSON:-}"
[ -n "$TOOL_INPUT_JSON" ] || TOOL_INPUT_JSON="{}"
# Aliases for the names the older writers used. Kept so this extractor is a
# drop-in for every bash gate; the canonical names are the unsuffixed ones.
TOOL_NAME="$TOOL"; TARGET_PATH="$TARGET"


HOOK_EVENTS_LOG="<ROOT>/.intutic/events/hook-events.jsonl"

# ── Runtime credentials (sourced from ~/.intutic/env/runtime.env) ────────────────────────
# These are defaults, and they are also the only thing standing between
# \`set -u\` and a fatal unbound-variable error: log_event reads all three, so on
# a machine with no runtime.env to source, an unset name kills the gate before
# it can exit 2. Spelling matters — INTUTIC_, never INTUITIC_.
RUNTIME_ENV="$HOME/.intutic/env/runtime.env"
INTUTIC_HOST=""
INTUTIC_API_KEY=""
INTUTIC_WORKSPACE_ID="ws_test"
[ -f "$RUNTIME_ENV" ] && source "$RUNTIME_ENV" 2>/dev/null || true

log_event() {
  local verdict="$1" tool="$2" reason="$3"
  # \`tool\` and \`reason\` carry agent-controlled text — the tool name, and the
  # target path quoted into the block reason — and both are spliced into the
  # JSON string below. Escape first: one unescaped quote yields a line
  # JSON.parse rejects, and drainHookEvents drops malformed lines then wipes the
  # log on a successful drain, so the record of a block is destroyed rather than
  # delayed. A crafted path could otherwise close the string and forge fields.
  tool="\${tool//\\\\/\\\\\\\\}";     tool="\${tool//\\"/\\\\\\"}"
  reason="\${reason//\\\\/\\\\\\\\}"; reason="\${reason//\\"/\\\\\\"}"
  # Every C0 control character, not just newline and carriage return. JSON
  # forbids all of U+0000-U+001F unescaped, so a plain TAB in a filename — no
  # adversary required — was still enough to produce a line JSON.parse rejects.
  # (NUL cannot appear in a bash variable, so the range starts at \\x01.)
  tool="\${tool//[$'\\x01'-$'\\x1f']/ }"; reason="\${reason//[$'\\x01'-$'\\x1f']/ }"
  # The workspace id is spliced into the same JSON string. It comes from
  # runtime.env on disk rather than from the agent, so it is lower risk — but a
  # value with a quote in it breaks every audit line the same way, and "lower
  # risk" is not "cannot happen" for a file the operator edits by hand.
  local ws="\${INTUTIC_WORKSPACE_ID}"
  ws="\${ws//\\\\/\\\\\\\\}"; ws="\${ws//\\"/\\\\\\"}"; ws="\${ws//[$'\\x01'-$'\\x1f']/ }"
  local ts; ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  local incident_id; incident_id="$(printf '%s' "\${ts}\${tool}\${INTUTIC_WORKSPACE_ID}" | sha1sum 2>/dev/null | cut -c1-16 || echo "$(date +%s)")"
  # The event's id: random, made once here, and resent with the line it is
  # written into, so the control plane processes the event once.
  local event_id; event_id="$(od -An -N16 -tx1 /dev/urandom 2>/dev/null | tr -d ' \\n' || true)"
  [ -n "$event_id" ] || event_id="$(date +%s)$$\${RANDOM}\${RANDOM}\${RANDOM}"
  local entry="{\\"event\\":\\"\${verdict}\\",\\"toolName\\":\\"\${tool}\\",\\"reason\\":\\"\${reason}\\",\\"workspaceId\\":\\"\${ws}\\",\\"harnessType\\":\\"gemini-cli\\",\\"timestamp\\":\\"\${ts}\\",\\"incidentId\\":\\"\${incident_id}\\",\\"eventId\\":\\"\${event_id}\\"}"
  printf '%s\\n' "$entry" >> "$HOOK_EVENTS_LOG" 2>/dev/null || true
  if [ -n "$INTUTIC_API_KEY" ]; then
    curl -s -o /dev/null --max-time 3 -X POST \\
      -H "Content-Type: application/json" \\
      -H "Authorization: Bearer $INTUTIC_API_KEY" \\
      -d "{\\"events\\":[$entry]}" \\
      "\${INTUTIC_HOST}/api/v1/hook-events" & disown 2>/dev/null || true
  fi
}


# ── Intutic gate body v23 — harness: gemini-cli ────────────
# Generated by harness/gateBody.ts. Do not edit here; every harness regenerates.
#
# The harness name and version are stamped so this file identifies itself. Both
# were previously passed in and dropped on the floor: opts.harness was declared
# on the option type, supplied by all thirteen writers, and read nowhere.

# ── Post-tool outcome (gate body v23) ────────────────────────────────────────
# A post-tool invocation (--event post) records a test run's outcome for this
# session, or marks an earlier passing run stale after a file change, and
# always allows: the call has already run. Only where gemini-cli's post-tool
# payload was captured and carries an exit code (POST_TOOL_OBSERVABLE: 1).
if [ "\${INTUTIC_POST_MODE:-0}" = "1" ]; then
  if [ "1" = "1" ]; then
    python3 -c 'import os, sys
lib = {}
exec(os.environ.get("INTUTIC_PY_LIB", ""), lib)
sys.stdout.write(lib["intutic_post_record"](sys.argv[1], sys.stdin.read()))' 'gemini-cli' <<< "\${INPUT:-}" >/dev/null 2>&1 || true
  fi
  exit 0
fi

# ── Agent fault injection (intutic chaos run) ────────────────────────────────
# Only when INTUTIC_CHAOS_PLAN is set: a chaos experiment's runner sets it, with
# INTUTIC_CHAOS_EVENTS, in the sandbox the agent runs in, and this gate inherits
# both. The work is chaos.py in INTUTIC_PY_LIB, the transliteration of
# chaosGate.ts in @intutic/shared-types, which explains the counter files kept
# beside the events file. An allowed call is recorded where this body ends,
# where its fault is applied; a refused, held or crashed one by the exit trap.
# A fault applies only to an allowed call. Scoped to the bare invocation, like
# the envelope refusal below.
INTUTIC_CHAOS_ACTIVE=0
_intutic_chaos_done=0
_intutic_chaos_decision=deny
_intutic_chaos_rule=""
_intutic_chaos_hit=0
_intutic_chaos_destructive=0
# Records this call as decided ($1: allow, deny or hold) and prints the fault
# to apply to an allowed one, as kind and reason, tab-separated. $2 is the
# call's digest, which a held call's retry shares.
intutic_chaos_decide() {
  [ "$INTUTIC_CHAOS_ACTIVE" = "1" ] && [ "$_intutic_chaos_done" = "0" ] || return 0
  python3 -c 'import os, sys
lib = {}
exec(os.environ.get("INTUTIC_PY_LIB", ""), lib)
sys.stdout.write(lib["intutic_chaos_call"](*sys.argv[1:]))' "\${TOOL:-unknown}" "$1" "$_intutic_chaos_rule" "$_intutic_chaos_destructive" "$_intutic_chaos_hit" "\${2:-}" || true
}
# A rule fired without deciding the call (shadow, warn): its id, if none yet.
intutic_chaos_note() {
  [ -n "$_intutic_chaos_rule" ] || _intutic_chaos_rule="$1"
}
if [ -z "\${1:-}" ] && [ -n "\${INTUTIC_CHAOS_PLAN:-}" ]; then
  # A plan that is set but unreadable refuses, as an unreadable payload does:
  # an experiment run without the faults it asked for reports a resilience it
  # never measured.
  _intutic_chaos_err="$(python3 -c 'import os, sys
lib = {}
exec(os.environ.get("INTUTIC_PY_LIB", ""), lib)
sys.stdout.write(lib["intutic_chaos_begin"]())' 2>/dev/null || echo "INTUTIC_CHAOS_PLAN could not be read")"
  if [ -n "$_intutic_chaos_err" ]; then
    _intutic_chaos_err="\${_intutic_chaos_err} — refusing the call rather than running the experiment without the faults it asked for"
    echo "[Intutic Governance] BLOCKED: \${_intutic_chaos_err}" >&2
    log_event "tool_blocked" "\${TOOL:-unknown}" "\${_intutic_chaos_err}" || true
    exit 2
  fi
  INTUTIC_CHAOS_ACTIVE=1
fi

# Refuse an unreadable envelope before any rule is consulted.
#
# Unparseable stdin used to degrade to empty extracted fields, which match no
# rule — an ALLOW. Per each harness's contract this hook receives only
# PreToolUse events, so a payload from which neither a tool name nor a
# tool_input could be extracted is anomalous by definition: there is no such
# thing as a legitimate PreToolUse event with no tool call in it. Refusing is
# the posture githubCopilotHooks established for its Preview envelope, applied
# uniformly. INTUTIC_EXTRACT_STATE is set by SHELL_EXTRACT; the refusal lives
# here because log_event is not defined until after extraction runs.
#
# Scoped to the bare invocation: goose and openhands register post/stop
# invocations of this same script WITH arguments, and those events carry no
# tool call legitimately — refusing them would fail a hook that has nothing to
# gate. Every PreToolUse registration invokes the script with no arguments.
if [ -z "\${1:-}" ] && [ "\${INTUTIC_EXTRACT_STATE:-malformed}" != "ok" ]; then
  _intutic_env_reason="unrecognised PreToolUse payload — neither a tool name nor a tool_input could be extracted from stdin; refusing rather than allowing a call the gate cannot read"
  echo "[Intutic Governance] BLOCKED: \${_intutic_env_reason}" >&2
  log_event "tool_blocked" "unknown" "\${_intutic_env_reason}" || true
  exit 2
fi

# Refuse a call too large to evaluate inside the hook timeout, before any rule
# reads it (the extractor measured it; see gateLimits.ts). Scoped like the
# envelope refusal above: the post/stop invocations carry no call to gate.
if [ -z "\${1:-}" ] && [ -n "\${INTUTIC_TOO_LARGE:-}" ]; then
  echo "[Intutic Governance] BLOCKED: COMMAND_TOO_LARGE — \${INTUTIC_TOO_LARGE}" >&2
  log_event "tool_blocked" "\${TOOL:-unknown}" "COMMAND_TOO_LARGE — \${INTUTIC_TOO_LARGE}" || true
  exit 2
fi

# The static floor: compiled in, always enforced, never sourced from disk.
# These are the families with years of evidence behind them, so they block from
# the first run — before any sync has happened.
INTUTIC_FLOOR=(
  'bypass.chflags_nouchg	block	s	any	Governance bypass pattern: clearing the macOS immutable flag on a governance file	 chflags .*nouchg'
  'bypass.chattr_immutable	block	s	any	Governance bypass pattern: clearing the Linux immutable attribute on a governance file	 chattr .*-[a-zA-Z]*i'
  'bypass.chmod_governance	block	s	any	Governance bypass pattern: changing permissions on a governance file	 chmod .*(hooks|\\.intutic|\\.claude|\\.cursor)'
  'bypass.env_kill_switch	block	-	any	Governance bypass pattern: setting a harness environment variable that disables its hooks	 [A-Z][A-Z0-9_]*_HOOKS?='
  'hook_settings.vscode_key_written	block	-	content	Governance bypass pattern: setting chat.useHooks or chat.hookFilesLocations, which can switch off the GitHub Copilot governance hook. Change VS Code hook settings yourself, not through an agent.	chat\\.(useHooks|hookFilesLocations)(\\\\)?" *:'
  'hook_settings.vscode_key_command	block	-	command	Governance bypass pattern: a shell command naming chat.useHooks or chat.hookFilesLocations, which can switch off the GitHub Copilot governance hook. Change VS Code hook settings yourself, not through an agent.	chat\\.(useHooks|hookFilesLocations)'
  'secrets.aws_access_key	block	-	content	AWS access key ID detected in the content this call would write. Writing a live credential into a file is one commit away from shipping it; reference it from the environment instead.	(A3T[A-Z0-9]|AKIA|ASIA|ABIA|ACCA)[A-Z2-7][A-Z2-7][A-Z2-7][A-Z2-7][A-Z2-7][A-Z2-7][A-Z2-7][A-Z2-7][A-Z2-7][A-Z2-7][A-Z2-7][A-Z2-7][A-Z2-7][A-Z2-7][A-Z2-7][A-Z2-7]'
  'secrets.anthropic_api_key	block	-	content	Anthropic API key detected in the content this call would write. Writing a live credential into a file is one commit away from shipping it; reference it from the environment instead.	sk-ant-[A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-]*'
  'secrets.github_token	block	-	content	GitHub token detected in the content this call would write. Writing a live credential into a file is one commit away from shipping it; reference it from the environment instead.	gh[pousr]_[A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9]'
  'secrets.private_key_pem	block	-	content	PEM private key material detected in the content this call would write. Writing a live credential into a file is one commit away from shipping it; reference it from the environment instead.	-----BEGIN [A-Z ]*PRIVATE KEY-----'
  'secrets.openrouter_api_key	block	-	content	OpenRouter API key detected in the content this call would write. Writing a live credential into a file is one commit away from shipping it; reference it from the environment instead.	sk-or-v1-[A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9]*'
  'secrets.intutic_virtual_key	block	-	content	Intutic virtual key detected in the content this call would write. Writing a live credential into a file is one commit away from shipping it; reference it from the environment instead.	vk_[a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9]'
  'secrets.intutic_gateway_token	block	-	content	Intutic gateway token detected in the content this call would write. Writing a live credential into a file is one commit away from shipping it; reference it from the environment instead.	gwk_[a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9]'
  'secrets.stripe_secret_key	block	-	content	Stripe live secret key detected in the content this call would write. Writing a live credential into a file is one commit away from shipping it; reference it from the environment instead.	sk_live_[A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9]'
  'skill_surface.agents_skills_write	warn	-	target	Write or edit targets a .agents/skills/** skill file — advisory only, pending a false-positive measurement of scanSkillContent against real skill markdown	\\.agents/skills/'
  'skill_surface.claude_skills_write	warn	-	target	Write or edit targets a .claude/skills/** skill file — advisory only, pending a false-positive measurement of scanSkillContent against real skill markdown	\\.claude/skills/'
  'path.intutic_hooks	block	-	any	Shell command references the governance-protected path .intutic/hooks	\\.intutic/hooks'
  'path.intutic_integrity_json	block	-	any	Shell command references the governance-protected path .intutic/integrity.json	\\.intutic/integrity\\.json'
  'path.intutic_events	block	-	any	Shell command references the governance-protected path .intutic/events	\\.intutic/events'
  'path.intutic_env	block	-	any	Shell command references the governance-protected path .intutic/env	\\.intutic/env'
  'path.claude_settings_json	block	-	any	Shell command references the governance-protected path .claude/settings.json	\\.claude/settings\\.json'
  'path.claude_settings_local_json	block	-	any	Shell command references the governance-protected path .claude/settings.local.json	\\.claude/settings\\.local\\.json'
  'path.cursor_hooks_json	block	-	any	Shell command references the governance-protected path .cursor/hooks.json	\\.cursor/hooks\\.json'
  'path.etc_cursor_hooks_json	block	-	any	Shell command references the governance-protected path /etc/cursor/hooks.json	/etc/cursor/hooks\\.json'
  'path.Application_Support_Cursor_hooks_json	block	-	any	Shell command references the governance-protected path Application Support/Cursor/hooks.json	Application Support/Cursor/hooks\\.json'
  'path.ProgramData_backslash_Cursor_backslash_hooks_json	block	-	any	Shell command references the governance-protected path ProgramData\\Cursor\\hooks.json	ProgramData\\\\Cursor\\\\hooks\\.json'
  'path.ProgramData_Cursor_hooks_json	block	-	any	Shell command references the governance-protected path ProgramData/Cursor/hooks.json	ProgramData/Cursor/hooks\\.json'
  'path.clinerules_hooks	block	-	any	Shell command references the governance-protected path .clinerules/hooks	\\.clinerules/hooks'
  'path.codeium_windsurf_hooks_json	block	-	any	Shell command references the governance-protected path .codeium/windsurf/hooks.json	\\.codeium/windsurf/hooks\\.json'
  'path.codeium_hooks_json	block	-	any	Shell command references the governance-protected path .codeium/hooks.json	\\.codeium/hooks\\.json'
  'path.windsurf_hooks_json	block	-	any	Shell command references the governance-protected path .windsurf/hooks.json	\\.windsurf/hooks\\.json'
  'path.openhands_hooks_json	block	-	any	Shell command references the governance-protected path .openhands/hooks.json	\\.openhands/hooks\\.json'
  'path.gemini_settings_json	block	-	any	Shell command references the governance-protected path .gemini/settings.json	\\.gemini/settings\\.json'
  'path.gemini_config_hooks_json	block	-	any	Shell command references the governance-protected path .gemini/config/hooks.json	\\.gemini/config/hooks\\.json'
  'path.agents_hooks_json	block	-	any	Shell command references the governance-protected path .agents/hooks.json	\\.agents/hooks\\.json'
  'path.agents_plugins_intutic_governance	block	-	any	Shell command references the governance-protected path .agents/plugins/intutic-governance	\\.agents/plugins/intutic-governance'
  'path.muse_hooks_json	block	-	any	Shell command references the governance-protected path .muse/hooks.json	\\.muse/hooks\\.json'
  'path.config_muse_settings_json	block	-	any	Shell command references the governance-protected path .config/muse/settings.json	\\.config/muse/settings\\.json'
  'path.config_muse_intutic_managed_hooks_json	block	-	any	Shell command references the governance-protected path .config/muse/intutic-managed-hooks.json	\\.config/muse/intutic-managed-hooks\\.json'
  'path.grok_hooks	block	-	any	Shell command references the governance-protected path .grok/hooks	\\.grok/hooks'
  'path.grok_config_toml	block	-	any	Shell command references the governance-protected path .grok/config.toml	\\.grok/config\\.toml'
  'path.grok_trusted_folders_toml	block	-	any	Shell command references the governance-protected path .grok/trusted_folders.toml	\\.grok/trusted_folders\\.toml'
  'path.dsh_profiles	block	-	any	Shell command references the governance-protected path .dsh/profiles	\\.dsh/profiles'
  'path.dsh_cordis_patch_yml	block	-	any	Shell command references the governance-protected path .dsh/cordis.patch.yml	\\.dsh/cordis\\.patch\\.yml'
  'path.dsh_settings_yaml	block	-	any	Shell command references the governance-protected path .dsh/settings.yaml	\\.dsh/settings\\.yaml'
  'path.opencode_plugins	block	-	any	Shell command references the governance-protected path .opencode/plugins	\\.opencode/plugins'
  'path.opencode_plugin	block	-	any	Shell command references the governance-protected path .opencode/plugin	\\.opencode/plugin'
  'path.config_opencode_plugins	block	-	any	Shell command references the governance-protected path .config/opencode/plugins	\\.config/opencode/plugins'
  'path.pi_agent_extensions	block	-	any	Shell command references the governance-protected path .pi/agent/extensions	\\.pi/agent/extensions'
  'path.openclaw_openclaw_json	block	-	any	Shell command references the governance-protected path .openclaw/openclaw.json	\\.openclaw/openclaw\\.json'
  'path.pi_extensions	block	-	any	Shell command references the governance-protected path .pi/extensions	\\.pi/extensions'
  'path.codex_hooks_json	block	-	any	Shell command references the governance-protected path .codex/hooks.json	\\.codex/hooks\\.json'
  'path.codex_config_toml	block	-	any	Shell command references the governance-protected path .codex/config.toml	\\.codex/config\\.toml'
  'path.github_hooks_intutic_governance_json	block	-	any	Shell command references the governance-protected path .github/hooks/intutic-governance.json	\\.github/hooks/intutic-governance\\.json'
  'path.copilot_hooks_intutic_governance_json	block	-	any	Shell command references the governance-protected path .copilot/hooks/intutic-governance.json	\\.copilot/hooks/intutic-governance\\.json'
  'path.hermes_config_yaml	block	-	any	Shell command references the governance-protected path .hermes/config.yaml	\\.hermes/config\\.yaml'
  'path.config_goose_config_yaml	block	-	any	Shell command references the governance-protected path .config/goose/config.yaml	\\.config/goose/config\\.yaml'
  'path.open_webui_intutic_governance_filter_py	block	-	any	Shell command references the governance-protected path .open-webui/intutic-governance-filter.py	\\.open-webui/intutic-governance-filter\\.py'
)

# The dynamic tier, read from the policy snapshot. Additive only: it can turn an
# allow into a block, never a block into an allow. See policySnapshot.ts.
INTUTIC_SNAPSHOT_RULES="\${INTUTIC_SNAPSHOT_RULES:-$HOME/.intutic/hooks/policy-snapshot.rules}"
INTUTIC_SNAPSHOT_DIGEST="none"
INTUTIC_SNAPSHOT_STATE="absent"
INTUTIC_DYNAMIC=()

# A supported escape hatch, and the reason it exists is not politeness.
#
# The fastest workaround available to a developer wrongly blocked is
# \`chflags nouchg\` on the hook — the exact bypass the floor exists to stop. If
# the only way out is one we treat as an attack, we have manufactured our own
# adversary. So: an escape we can see, that disables the **dynamic tier only**.
# The floor is never disabled by it. Every invocation while it is set emits an
# event, so a machine running ungoverned is visible rather than quiet.
INTUTIC_GUARDS_DISABLED=0
if [ "\${INTUTIC_GUARD_DISABLE:-}" = "1" ]; then
  INTUTIC_GUARDS_DISABLED=1
  log_event "guards_disabled" "\${TOOL:-}" "INTUTIC_GUARD_DISABLE=1 — policy-snapshot rules skipped; built-in protections still active" || true
fi

INTUTIC_SNAPSHOT_WORKSPACE=""
INTUTIC_SNAPSHOT_GENERATED=""
# The per-server MCP allowlist (the @mcp_allowlist record, inside the digest).
# No record means the workspace set no list, and every server is allowed.
INTUTIC_MCP_ALLOWLIST=0
INTUTIC_MCP_SEVERITY=""
INTUTIC_MCP_SERVERS=""
# The MCP server registry record (base64 JSON, inside the digest).
INTUTIC_MCP_REGISTRY=""
# An OPAQUE workspace (the @intervention_mode record): a refusal on workspace
# policy tells the agent this sentence instead of the rule, and the audit line
# keeps the rule. Kept on a snapshot that fails its digest: it only ever hides
# text, never allows a call.
INTUTIC_OPAQUE=0
INTUTIC_OPAQUE_MESSAGE='Blocked by workspace policy. Ask a workspace admin if you need this action.'
# The snapshot format (the @format record; 1 without one), and the decide
# rules' @decide records, kept whole for the decide tier: this gate decodes
# none of them, the CLI does.
INTUTIC_SNAPSHOT_FORMAT=1
INTUTIC_DECIDE_RECORDS=()
# The @rule records (gate body v23), kept whole: the extractor's Python decodes
# them for the rule-record tiers below.
INTUTIC_RULE_RECORDS=()
if [ -f "$INTUTIC_SNAPSHOT_RULES" ]; then
  INTUTIC_SNAPSHOT_STATE="ok"
  while IFS= read -r _line || [ -n "$_line" ]; do
    case "$_line" in
      '#digest '*)      INTUTIC_SNAPSHOT_DIGEST="\${_line#\\#digest }" ;;
      '#workspace '*)   INTUTIC_SNAPSHOT_WORKSPACE="\${_line#\\#workspace }" ;;
      '#generated '*)   INTUTIC_SNAPSHOT_GENERATED="\${_line#\\#generated }" ;;
      '@mcp_allowlist'$'\\t'*)
        # Tag, severity and comma-joined servers, tab-separated — parameter
        # expansion only, no subshell. The writer drops a server name holding
        # whitespace or a comma, so neither separator can appear in one.
        INTUTIC_MCP_ALLOWLIST=1
        _intutic_mcp_rest="\${_line#*$'\\t'}"
        INTUTIC_MCP_SEVERITY="\${_intutic_mcp_rest%%$'\\t'*}"
        INTUTIC_MCP_SERVERS="\${_intutic_mcp_rest#*$'\\t'}"
        ;;
      '@mcp_registry'$'\\t'*) INTUTIC_MCP_REGISTRY="\${_line#*$'\\t'}" ;;
      '@intervention_mode'$'\\t''OPAQUE') INTUTIC_OPAQUE=1 ;;
      '@format'$'\\t'*)
        case "\${_line#*$'\\t'}" in ''|*[!0-9]*) : ;; *) INTUTIC_SNAPSHOT_FORMAT="\${_line#*$'\\t'}" ;; esac
        ;;
      '@decide'$'\\t'*) INTUTIC_DECIDE_RECORDS+=("$_line") ;;
      '@rule'$'\\t'*) INTUTIC_RULE_RECORDS+=("$_line") ;;
      '#'*|'') : ;;
      *) INTUTIC_DYNAMIC+=("$_line") ;;
    esac
  done < "$INTUTIC_SNAPSHOT_RULES"

  # A fallback line stands in for a decide rule a gate cannot evaluate. This
  # gate hands a decide rule to the CLI, which decodes its record and refuses
  # the call when it does not decode, so it skips the fallback line that an
  # @decide record of five columns names in its second. Any other line with
  # the prefix is enforced.
  if [ \${#INTUTIC_DECIDE_RECORDS[@]} -gt 0 ]; then
    _intutic_skip=$'\\n'
    for _rec in "\${INTUTIC_DECIDE_RECORDS[@]}"; do
      _intutic_tabs="\${_rec//[^$'\\t']/}"
      _intutic_fb="\${_rec#*$'\\t'}"
      _intutic_fb="\${_intutic_fb%%$'\\t'*}"
      if [ \${#_intutic_tabs} -eq 4 ] && [ -n "\${_rec##*$'\\t'}" ]; then
        case "$_intutic_fb" in 'decide-fallback:'*) _intutic_skip+="$_intutic_fb"$'\\n' ;; esac
      fi
    done
    _intutic_kept=()
    if [ \${#INTUTIC_DYNAMIC[@]} -gt 0 ]; then
      for _rec in "\${INTUTIC_DYNAMIC[@]}"; do
        case "$_intutic_skip" in *$'\\n'"\${_rec%%$'\\t'*}"$'\\n'*) continue ;; esac
        _intutic_kept+=("$_rec")
      done
    fi
    INTUTIC_DYNAMIC=()
    if [ \${#_intutic_kept[@]} -gt 0 ]; then INTUTIC_DYNAMIC=("\${_intutic_kept[@]}"); fi
  fi

  # A <kind>-fallback: line stands in for a rule record a gate cannot
  # evaluate. This gate evaluates requires_outcome,scope_paths,plan_approval, so it drops the fallback line a
  # decoded record of those kinds names. A python3 that cannot say keeps them all.
  if [ \${#INTUTIC_RULE_RECORDS[@]} -gt 0 ] && [ -n 'requires_outcome,scope_paths,plan_approval' ]; then
    _intutic_rskip="$(python3 -c 'import os, sys
lib = {}
exec(os.environ.get("INTUTIC_PY_LIB", ""), lib)
sys.stdout.write(lib["intutic_rule_skip"](sys.stdin.read(), sys.argv[1]))' 'requires_outcome,scope_paths,plan_approval' <<< "$(printf '%s\\n' "\${INTUTIC_RULE_RECORDS[@]}")" 2>/dev/null || true)"
    if [ -n "$_intutic_rskip" ] && [ \${#INTUTIC_DYNAMIC[@]} -gt 0 ]; then
      _intutic_rskip=$'\\n'"$_intutic_rskip"$'\\n'
      _intutic_kept=()
      for _rec in "\${INTUTIC_DYNAMIC[@]}"; do
        case "$_intutic_rskip" in *$'\\n'"\${_rec%%$'\\t'*}"$'\\n'*) continue ;; esac
        _intutic_kept+=("$_rec")
      done
      INTUTIC_DYNAMIC=()
      if [ \${#_intutic_kept[@]} -gt 0 ]; then INTUTIC_DYNAMIC=("\${_intutic_kept[@]}"); fi
    fi
  fi

  # A phrase rule that shares its id with an action rule is the partial form a
  # gate older than v23 holds by; this one holds by the action rule.
  if [ \${#INTUTIC_DYNAMIC[@]} -gt 0 ]; then
    _intutic_aids=$'\\n'
    for _rec in "\${INTUTIC_DYNAMIC[@]}"; do
      _r="\${_rec#*$'\\t'}"; _r="\${_r#*$'\\t'}"; _r="\${_r#*$'\\t'}"
      if [ "\${_r%%$'\\t'*}" = "action" ]; then _intutic_aids+="\${_rec%%$'\\t'*}"$'\\n'; fi
    done
    if [ "$_intutic_aids" != $'\\n' ]; then
      _intutic_kept=()
      for _rec in "\${INTUTIC_DYNAMIC[@]}"; do
        _r="\${_rec#*$'\\t'}"; _r="\${_r#*$'\\t'}"; _r="\${_r#*$'\\t'}"
        if [ "\${_r%%$'\\t'*}" = "phrase" ]; then
          case "$_intutic_aids" in *$'\\n'"\${_rec%%$'\\t'*}"$'\\n'*) continue ;; esac
        fi
        _intutic_kept+=("$_rec")
      done
      INTUTIC_DYNAMIC=()
      if [ \${#_intutic_kept[@]} -gt 0 ]; then INTUTIC_DYNAMIC=("\${_intutic_kept[@]}"); fi
    fi
  fi

  # Integrity, in the order that fails cheapest first.
  #
  # All three of these were parsed and then ignored. A digest nobody recomputes
  # is not integrity, it is a comment; and a workspace id nobody compares means a
  # snapshot from workspace A dropped onto workspace B's machine is enforced
  # verbatim, with B's audit events attributing A's rules to B.
  _intutic_body="$(grep -v '^#' "$INTUTIC_SNAPSHOT_RULES" | grep -v '^$' || true)"
  _intutic_actual=""
  if command -v shasum >/dev/null 2>&1; then
    _intutic_actual="$(printf '%s' "$_intutic_body" | shasum -a 256 | cut -c1-32)"
  elif command -v sha256sum >/dev/null 2>&1; then
    _intutic_actual="$(printf '%s' "$_intutic_body" | sha256sum | cut -c1-32)"
  fi

  if [ -n "$_intutic_actual" ] && [ "$_intutic_actual" != "$INTUTIC_SNAPSHOT_DIGEST" ]; then
    INTUTIC_SNAPSHOT_STATE="invalid"
  elif [ -n "$INTUTIC_SNAPSHOT_WORKSPACE" ] && [ -n "\${INTUTIC_WORKSPACE_ID:-}" ]        && [ "$INTUTIC_SNAPSHOT_WORKSPACE" != "$INTUTIC_WORKSPACE_ID" ]; then
    INTUTIC_SNAPSHOT_STATE="invalid"
  elif [ \${#INTUTIC_DYNAMIC[@]} -eq 0 ]; then
    # Distinct from "absent". The writer always ships the destructive tier, so a
    # rule-less snapshot means the compile produced nothing — a real fault that
    # otherwise looks exactly like a healthy quiet workspace.
    INTUTIC_SNAPSHOT_STATE="empty"
  fi

  # Degrade to the compiled floor. The dynamic tier is additive, so dropping it
  # returns to yesterday's behaviour rather than opening a hole.
  # The SSO-group refusals survive it: they only ever refuse, and dropping
  # them would make editing the member's group list in this file a way to
  # clear a tool the workspace's group policy refuses.
  if [ "$INTUTIC_SNAPSHOT_STATE" = "invalid" ]; then
    _intutic_kept=()
    if [ \${#INTUTIC_DYNAMIC[@]} -gt 0 ]; then
      for _rec in "\${INTUTIC_DYNAMIC[@]}"; do
        case "$_rec" in
          sso_group.*$'\\t'block$'\\t'*) _intutic_kept+=("$_rec") ;;
        esac
      done
    fi
    INTUTIC_DYNAMIC=()
    if [ \${#_intutic_kept[@]} -gt 0 ]; then INTUTIC_DYNAMIC=("\${_intutic_kept[@]}"); fi
    # Neither MCP record can be vouched for, and a deleted one looks like one
    # never set: the snapshot admits no MCP server (the refusal below).
    INTUTIC_MCP_REGISTRY=""
    INTUTIC_MCP_ALLOWLIST=0
    # The decide and rule records go with the rest of the dynamic tier.
    INTUTIC_DECIDE_RECORDS=()
    INTUTIC_RULE_RECORDS=()
  fi
fi

# Staleness governs alerting, not enforcement: rules stay in force. If they
# expired into permissiveness, "kill the daemon and wait" would be a supported
# way to disarm governance.
if [ "$INTUTIC_SNAPSHOT_STATE" = "ok" ] && [ -n "$INTUTIC_SNAPSHOT_GENERATED" ]; then
  _intutic_age_days="$(python3 -c 'import sys,datetime
try:
    t=datetime.datetime.fromisoformat(sys.argv[1].replace("Z","+00:00"))
    print(int((datetime.datetime.now(datetime.timezone.utc)-t).total_seconds()//86400))
except Exception:
    print(0)' "$INTUTIC_SNAPSHOT_GENERATED" 2>/dev/null || echo 0)"
  if [ "$_intutic_age_days" -gt 7 ] 2>/dev/null; then
    INTUTIC_SNAPSHOT_STATE="stale"
  fi
fi

case "$INTUTIC_SNAPSHOT_STATE" in
  absent)  log_event "snapshot_absent" "\${TOOL:-}" "No policy snapshot at $INTUTIC_SNAPSHOT_RULES — built-in protections only" || true ;;
  invalid) log_event "snapshot_invalid" "\${TOOL:-}" "Policy snapshot failed its digest or workspace check — dynamic rules dropped except SSO-group refusals, and every MCP call refused" || true ;;
  empty)   log_event "snapshot_empty" "\${TOOL:-}" "Policy snapshot contains no rules — the compile produced nothing" || true ;;
  stale)   log_event "snapshot_stale" "\${TOOL:-}" "Policy snapshot is \${_intutic_age_days} days old and still enforced" || true ;;
esac
if [ "$INTUTIC_SNAPSHOT_FORMAT" -gt 3 ]; then
  log_event "snapshot_format_newer" "\${TOOL:-}" "Policy snapshot format $INTUTIC_SNAPSHOT_FORMAT is newer than this gate reads (3) — records it does not know are skipped and their fallback lines enforced" || true
fi

# Normalise once; every pattern is written against this shape. The extractor
# hands each field over with its whitespace already collapsed to single spaces
# by Python, Unicode whitespace included, which bash cannot match; padding is
# all that is left to do. Bash substitutions over a 256 KiB command to find no
# whitespace left took most of a second on a loaded machine.
INTUTIC_NCOMMAND=" \${COMMAND:-} "
INTUTIC_NTARGET=" \${TARGET:-} "
INTUTIC_NTOOL=" \${TOOL:-} "

# ── Hold tier (gate body v8) ─────────────────────────────────────────────────
# A \`hold\` rule refuses the call and records it for a human; an exact,
# unexpired approved bypass the daemon cached lets the same call through once.
# All local — a file read, a file write and an exit code; no network on the
# tool path.
INTUTIC_REVIEW_REQUEST_FILE="\${INTUTIC_REVIEW_REQUESTS:-}"
if [ -z "$INTUTIC_REVIEW_REQUEST_FILE" ]; then
  INTUTIC_REVIEW_REQUEST_FILE="$(cd "$(dirname "$0")/.." 2>/dev/null && pwd)/events/review-requests.jsonl"
fi
INTUTIC_APPROVED_BYPASSES="\${INTUTIC_APPROVED_BYPASSES:-$HOME/.intutic/hooks/approved-bypasses.jsonl}"
intutic_sha256() {
  if command -v shasum >/dev/null 2>&1; then shasum -a 256 | cut -c1-64
  elif command -v sha256sum >/dev/null 2>&1; then sha256sum | cut -c1-64
  else printf ''; fi
}
intutic_json_escape() {
  printf '%s' "$1" | sed -e 's/\\\\/\\\\\\\\/g' -e 's/"/\\\\"/g' | tr -d '\\n\\r\\t'
}
# What the agent reads of a refusal on workspace policy, in _intutic_shown: the
# reason ($1), or in an OPAQUE workspace the generic sentence. The audit line
# is always written with the full reason.
intutic_shown() {
  if [ "$INTUTIC_OPAQUE" = "1" ]; then _intutic_shown="$INTUTIC_OPAQUE_MESSAGE"; else _intutic_shown="$1"; fi
}
# Looks for a valid, unexpired, EXACT-match approved bypass. Prints nothing
# and returns 1 on ANY reason not to bypass: missing file, failed digest or
# workspace check, no matching line, or an entry whose expiresAt has passed —
# every one of which falls through to the hold. Key material is computed the
# same way the JS gate and the control plane compute it: the normalised tool
# name, and sha256(normalised command, NUL, normalised target).
intutic_bypass() {
  local rid="$1" tn="$2" th="$3" hdr_digest hdr_ws body actual now line exp
  [ -n "$th" ] || return 1
  [ -r "$INTUTIC_APPROVED_BYPASSES" ] || return 1
  hdr_digest="$(grep -m1 '^#digest ' "$INTUTIC_APPROVED_BYPASSES" | cut -d' ' -f2 || true)"
  hdr_ws="$(grep -m1 '^#workspace ' "$INTUTIC_APPROVED_BYPASSES" | cut -d' ' -f2 || true)"
  body="$(grep -v '^#' "$INTUTIC_APPROVED_BYPASSES" | grep -v '^$' || true)"
  [ -n "$body" ] || return 1
  actual="$(printf '%s' "$body" | intutic_sha256 | cut -c1-32)"
  [ -n "$actual" ] && [ "$actual" = "$hdr_digest" ] || return 1
  if [ -n "$hdr_ws" ] && [ "$hdr_ws" != "\${INTUTIC_WORKSPACE_ID:-}" ]; then return 1; fi
  now="$(date -u +%Y-%m-%dT%H:%M:%S)"
  while IFS= read -r line; do
    case "$line" in *'"workspaceId":"'"\${INTUTIC_WORKSPACE_ID:-}"'"'*) ;; *) continue ;; esac
    case "$line" in *'"sopRuleId":"'"$rid"'"'*) ;; *) continue ;; esac
    case "$line" in *'"toolNameNormalized":"'"$tn"'"'*) ;; *) continue ;; esac
    case "$line" in *'"targetHash":"'"$th"'"'*) ;; *) continue ;; esac
    exp="$(printf '%s' "$line" | sed -n 's/.*"expiresAt":"\\([^"]*\\)".*/\\1/p')"
    [ -n "$exp" ] || continue
    # ISO-8601 UTC timestamps compare lexically; a past expiry fails closed
    # toward the hold, however fresh the file is.
    if [[ "$exp" > "$now" ]]; then
      printf '%s' "$line"; return 0
    fi
  done <<< "$body"
  return 1
}
# Returns 0 when an approved bypass lets the call through (the caller
# continues), 2 when the call is held (the caller refuses).
intutic_hold() {
  local rid="$1" rreason="$2" tn th entry decided_by hold_id at file targeth hint
  tn="$INTUTIC_NTOOL"
  th="$( { printf '%s' "$INTUTIC_NCOMMAND"; printf '\\0'; printf '%s' "$INTUTIC_NTARGET"; } | intutic_sha256 )"
  if entry="$(intutic_bypass "$rid" "$tn" "$th")"; then
    decided_by="$(printf '%s' "$entry" | sed -n 's/.*"decidedBy":"\\([^"]*\\)".*/\\1/p')"
    hold_id="$(printf '%s' "$entry" | sed -n 's/.*"holdId":"\\([^"]*\\)".*/\\1/p')"
    echo "[Intutic Guardrail] BYPASSED: Approved bypass for \${rid} — approved by \${decided_by} on hold \${hold_id}" >&2
    log_event "hold_approved_bypass_used" "\${TOOL:-}" "Approved bypass for \${rid} — approved by \${decided_by} on hold \${hold_id}" || true
    return 0
  fi
  hold_id="hold_$(printf '%x' "$(date +%s)")_$(printf '%04x%04x' "$RANDOM" "$RANDOM")"
  at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  targeth=""
  [ -n "$th" ] && targeth="$(printf ',"targetHash":"%s"' "$th")"
  file="$INTUTIC_REVIEW_REQUEST_FILE"
  # The hold still blocks even if the record cannot be written — the exit code
  # is what stops the tool. But say so: a hold nobody can review is the worst
  # of both outcomes.
  if ! { mkdir -p "$(dirname "$file")" 2>/dev/null && printf '{"v":1,"holdId":"%s","reason":"%s","tool":"%s","sessionId":"%s","workspaceId":"%s","at":"%s","toolNameNormalized":"%s"%s}\\n' \\
      "$hold_id" "$(intutic_json_escape "$rid")" "$(intutic_json_escape "\${TOOL:-}")" "$(intutic_json_escape "\${SESSION_ID:-}")" \\
      "$(intutic_json_escape "\${INTUTIC_WORKSPACE_ID:-}")" "$at" "$(intutic_json_escape "$tn")" "$targeth" >> "$file" 2>/dev/null; }; then
    echo "[Intutic Guardrail] could not record the hold at \${file}" >&2
  fi
  # Who may approve, and when the retry passes (holdMessages.ts in shared-types).
  hint='An Owner, Admin or EM can approve it with: intutic decision approve {holdId} (or reject it: intutic decision reject {holdId}). Retrying this exact call passes after approval only if the workspace has turned on the review-hold bypass; otherwise it is held again.'
  hint="\${hint//\\{holdId\\}/$hold_id}"
  intutic_shown "\${rreason} [\${rid}]"
  echo "[Intutic Guardrail] HELD: \${_intutic_shown} \${hint}" >&2
  log_event "tool_held" "\${TOOL:-}" "\${rreason} [\${rid}]" || true
  return 2
}

# A rule declares which part of the call it matches. \`any\` means command and
# target — never the tool name, because a pattern like \`\\.claude/settings\\.json\`
# would otherwise be tested against "Write" and quietly match nothing.
#
# Whether a rule fires on this call sets _intutic_fires to 1 or 0; the function
# always returns 0, so it runs under set -e like the rest of the gate. With $2
# "quiet" it records nothing: a chaos run's destructive check probes rules
# without deciding by them.
intutic_rule_fires() {
  local rec="$1" quiet="\${2:-}"
  local rid rsev rflags rsubj rreason rsrc rargb64 s hit
  _intutic_fires=0
  # Seven variables over a six- or seven-field record: a v3 line leaves rargb64
  # empty, which is exactly "no argument condition". The base64 column cannot
  # contain a tab, so the last variable never absorbs a separator.
  IFS=$'\\t' read -r rid rsev rflags rsubj rreason rsrc rargb64 <<< "$rec"
  [ -z "$rsrc" ] && return 0
  local _subs=() _ci=
  case "$rflags" in *i*) _ci=i ;; esac
  # A subject the screen below cleared for this case is left out: no pattern
  # matched it, this rule's included.
  case "$rsubj" in
    tool)    intutic_unscreened tool "$_ci" && _subs=("$INTUTIC_NTOOL") ;;
    command) intutic_unscreened command "$_ci" && _subs=("$INTUTIC_NCOMMAND") ;;
    target)  intutic_unscreened target "$_ci" && _subs=("$INTUTIC_NTARGET") ;;
    # Serialized tool input, un-normalised — same subject the WHERE argPattern
    # machinery matches. The secrets.* floor rules ride this. Guaranteed
    # non-empty by the extractor (it defaults to "{}").
    content) intutic_unscreened content "$_ci" && _subs=("$TOOL_INPUT_JSON") ;;
    # The space-padded action tokens the extractor's classifier derived from
    # the raw command (" action:deploy "), so a hold on \`action:deploy\`
    # matches whole tokens.
    action)  intutic_unscreened action "$_ci" && _subs=("$INTUTIC_ACTIONS") ;;
    # The source is |-separated phrases matched as words against the raw
    # command by the phrase matcher in Python, not a regex: grep is linear,
    # but the gap between the words was not expressible without one that
    # backtracks in the other gates. One python3 run, only for these rules.
    # The command goes in on stdin: as an argument, a long one would exceed
    # the kernel's per-argument limit and the rule would silently not run.
    phrase)
      if python3 -c 'import os, sys, json
lib = {}
exec(os.environ.get("INTUTIC_PY_LIB", ""), lib)
sys.exit(0 if lib["intutic_phrase_rule"](sys.argv[1], json.load(sys.stdin)) else 1)' "$rsrc" <<< "$INTUTIC_RAW_COMMAND_JSON" 2>/dev/null; then
        _subs=("$INTUTIC_NCOMMAND")
      else
        return 0
      fi
      ;;
    # Each field is tested separately rather than concatenated. Joining them
    # lets a pattern match across the seam — a command ending in "chflags" and
    # an unrelated target starting with "nouchg" would trip the bypass rule
    # together while neither does alone.
    *)
      intutic_unscreened command "$_ci" && _subs+=("$INTUTIC_NCOMMAND")
      intutic_unscreened target "$_ci" && _subs+=("$INTUTIC_NTARGET")
      ;;
  esac
  [ \${#_subs[@]} -gt 0 ] || return 0
  hit=0
  [ "$rsubj" = "phrase" ] && hit=1
  for s in "\${_subs[@]}"; do
    [ "$rsubj" = "phrase" ] && break
    # Flags: i = case-insensitive; s (a sequence rule) changes nothing here —
    # grep matches with an automaton, linear in the text, so the regex runs
    # as written.
    case "$rflags" in
      *i*) printf '%s' "$s" | grep -qiE -- "$rsrc" && hit=1 ;;
      *)   printf '%s' "$s" | grep -qE -- "$rsrc" && hit=1 ;;
    esac
  done
  [ "$hit" = "1" ] || return 0
  # The argument condition of a WHERE rule. The tool-name half has matched; the
  # rule fires only if the argPattern also matches the serialized tool input —
  # the same json.dumps(tool_input, separators=(",",":"), ensure_ascii=False)
  # shape matchSopRule and the intutic-clawde gate port pin, produced once by
  # the extractor above. Evaluated by python3 re, not grep: these patterns are
  # authored as JS regexes and routinely use lookahead, which no grep has.
  # Fail-safe direction: a pattern python cannot compile (exit 2) downgrades
  # THIS rule to name-only — today's behaviour, plus a rule_downgraded event —
  # rather than silently dropping the rule, which would fail open.
  if [ -n "$rargb64" ]; then
    _intutic_arg_rc=0
    python3 -c '
import sys, base64, re
try:
    pat = base64.b64decode(sys.argv[1], validate=True).decode("utf-8")
except Exception:
    sys.exit(2)
try:
    rx = re.compile(pat)
except re.error:
    sys.exit(2)
sys.exit(0 if rx.search(sys.argv[2]) else 1)
' "$rargb64" "\${TOOL_INPUT_JSON:-}" 2>/dev/null || _intutic_arg_rc=$?
    if [ "$_intutic_arg_rc" = "1" ]; then
      return 0
    elif [ "$_intutic_arg_rc" != "0" ] && [ -z "$quiet" ]; then
      log_event "rule_downgraded" "\${TOOL:-}" "argPattern for \${rid} did not compile in python re — rule enforced name-only" || true
    fi
  fi
  _intutic_fires=1
}

intutic_apply() {
  local rec="$1"
  local rid rsev rflags rsubj rreason rsrc rargb64
  IFS=$'\\t' read -r rid rsev rflags rsubj rreason rsrc rargb64 <<< "$rec"
  [ -z "$rsrc" ] && return 0
  # The escape hatch skips the DESTRUCTIVE family only. It is not a way to turn
  # off a workspace's own BLOCK: SOP rules — those are what the customer asked
  # for, and one environment variable disarming them would make the switch the
  # first thing an agent sets. Keyed on the rule-id family, which the snapshot
  # writer assigns: destructive.* versus sop.*
  if [ "$INTUTIC_GUARDS_DISABLED" = "1" ]; then
    case "$rid" in
      destructive.*) return 0 ;;
    esac
  fi
  # The tier order (gate body v23): every refusal first, the holds after the
  # rule records and the MCP checks. A hold is only ever decided on a call
  # nothing deterministic refused.
  case "\${_intutic_pass:-all}" in
    det) [ "$rsev" = "hold" ] && return 0 ;;
    hold) [ "$rsev" = "hold" ] || return 0 ;;
  esac
  intutic_rule_fires "$rec"
  [ "$_intutic_fires" = "1" ] || return 0
  if [ "$rsev" = "shadow" ]; then
    intutic_chaos_note "$rid"
    log_event "tool_would_block" "\${TOOL:-}" "\${rreason} [\${rid}]" || true
    return 0
  fi
  if [ "$rsev" = "hold" ]; then
    # Not a permanent denial: the action is legitimate, someone asked to see
    # it first. A bypass they approved lets this exact call through once.
    _intutic_chaos_rule="$rid"; _intutic_chaos_hit=1
    if intutic_hold "$rid" "$rreason"; then return 0; fi
    _intutic_chaos_decision=hold
    exit 2
  fi
  if [ "$rsev" = "warn" ]; then
    # Advisory tier: allowed, and recorded with enough shape to triage.
    #
    # The rule id alone was not enough. The warn tier exists to earn promotion to
    # block from a measured false-positive rate, and you cannot call a flag true
    # or false without seeing something of what was run. So: the first token of
    # the command, and nothing else. That is the verb — curl, git, rm — which is
    # what distinguishes "a real destructive command" from "a false positive on a
    # build script", and it carries no paths, no arguments, no secrets. The full
    # command stays out deliberately; that is what DLP exists to keep out of
    # telemetry.
    _intutic_verb="\${INTUTIC_NCOMMAND# }"
    _intutic_verb="\${_intutic_verb%% *}"
    intutic_chaos_note "$rid"
    log_event "tool_flagged" "\${TOOL:-}" "\${rreason} [\${rid}] verb=\${_intutic_verb}" || true
    return 0
  fi
  # The rule's own reason, not a generic one: hookEvents.resolveSeverity reads
  # this text for "governance-protected" to file the incident CRITICAL.
  local reason="\${rreason} [\${rid}]"
  _intutic_chaos_rule="$rid"; _intutic_chaos_hit=1
  intutic_shown "$reason"
  echo "[Intutic Governance] BLOCKED: \${_intutic_shown}" >&2
  log_event "tool_blocked" "\${TOOL:-}" "\${reason}"
  exit 2
}

# ── Screening ────────────────────────────────────────────────────────────────
# Rule by rule, the gate forks a grep per rule and subject: about a hundred on
# every call, which on a loaded machine took seconds before any rule could
# match. So each subject is first screened by one grep holding every pattern
# that tests it, the case-insensitive ones apart. A subject none of them
# matches is left out of every rule that tests it, since no one of them could
# match it either. A screen that matches, or one grep cannot run (exit 2),
# clears nothing, and the rules decide as before: the screen saves work and
# never changes a verdict. grep is still the engine, so the screen is linear too.
_intutic_screen_tool=(); _intutic_screen_tooli=(); _intutic_clear_tool=; _intutic_clear_tooli=
_intutic_screen_command=(); _intutic_screen_commandi=(); _intutic_clear_command=; _intutic_clear_commandi=
_intutic_screen_target=(); _intutic_screen_targeti=(); _intutic_clear_target=; _intutic_clear_targeti=
_intutic_screen_content=(); _intutic_screen_contenti=(); _intutic_clear_content=; _intutic_clear_contenti=
_intutic_screen_action=(); _intutic_screen_actioni=(); _intutic_clear_action=; _intutic_clear_actioni=
intutic_screen_add() {
  case "$1$2" in
    tool) _intutic_screen_tool+=(-e "$3") ;;
    tooli) _intutic_screen_tooli+=(-e "$3") ;;
    command) _intutic_screen_command+=(-e "$3") ;;
    commandi) _intutic_screen_commandi+=(-e "$3") ;;
    target) _intutic_screen_target+=(-e "$3") ;;
    targeti) _intutic_screen_targeti+=(-e "$3") ;;
    content) _intutic_screen_content+=(-e "$3") ;;
    contenti) _intutic_screen_contenti+=(-e "$3") ;;
    action) _intutic_screen_action+=(-e "$3") ;;
    actioni) _intutic_screen_actioni+=(-e "$3") ;;
  esac
}
for _rec in "\${INTUTIC_FLOOR[@]}" \${INTUTIC_DYNAMIC[@]+"\${INTUTIC_DYNAMIC[@]}"}; do
  IFS=$'	' read -r _r_id _r_sev _r_flags _r_subj _r_reason _r_src _r_arg <<< "$_rec"
  [ -n "$_r_src" ] || continue
  _r_ci=
  case "$_r_flags" in *i*) _r_ci=i ;; esac
  case "$_r_subj" in
    tool|command|target|content|action) intutic_screen_add "$_r_subj" "$_r_ci" "$_r_src" ;;
    phrase) : ;;
    *) intutic_screen_add command "$_r_ci" "$_r_src"; intutic_screen_add target "$_r_ci" "$_r_src" ;;
  esac
done
# $1 subject, $2 "i" or empty, $3 its text, then the patterns as -e pairs.
intutic_screen() {
  local key="$1" ci="$2" text="$3" rc=0
  shift 3
  if [ "$ci" = "i" ]; then printf '%s' "$text" | grep -qiE "$@" || rc=$?
  else printf '%s' "$text" | grep -qE "$@" || rc=$?
  fi
  [ "$rc" != "1" ] || printf -v "_intutic_clear_$key$ci" '%s' 1
}
[ \${#_intutic_screen_tool[@]} -eq 0 ] || intutic_screen tool '' "$INTUTIC_NTOOL" "\${_intutic_screen_tool[@]}"
[ \${#_intutic_screen_tooli[@]} -eq 0 ] || intutic_screen tool i "$INTUTIC_NTOOL" "\${_intutic_screen_tooli[@]}"
[ \${#_intutic_screen_command[@]} -eq 0 ] || intutic_screen command '' "$INTUTIC_NCOMMAND" "\${_intutic_screen_command[@]}"
[ \${#_intutic_screen_commandi[@]} -eq 0 ] || intutic_screen command i "$INTUTIC_NCOMMAND" "\${_intutic_screen_commandi[@]}"
[ \${#_intutic_screen_target[@]} -eq 0 ] || intutic_screen target '' "$INTUTIC_NTARGET" "\${_intutic_screen_target[@]}"
[ \${#_intutic_screen_targeti[@]} -eq 0 ] || intutic_screen target i "$INTUTIC_NTARGET" "\${_intutic_screen_targeti[@]}"
[ \${#_intutic_screen_content[@]} -eq 0 ] || intutic_screen content '' "$TOOL_INPUT_JSON" "\${_intutic_screen_content[@]}"
[ \${#_intutic_screen_contenti[@]} -eq 0 ] || intutic_screen content i "$TOOL_INPUT_JSON" "\${_intutic_screen_contenti[@]}"
[ \${#_intutic_screen_action[@]} -eq 0 ] || intutic_screen action '' "$INTUTIC_ACTIONS" "\${_intutic_screen_action[@]}"
[ \${#_intutic_screen_actioni[@]} -eq 0 ] || intutic_screen action i "$INTUTIC_ACTIONS" "\${_intutic_screen_actioni[@]}"
# Whether rules testing subject $1, case $2, still need to: not when screened clear.
intutic_unscreened() {
  local v="_intutic_clear_$1$2"
  [ "\${!v:-}" != "1" ]
}

# A chaos run's no_destructive_attempt probe: whether a destructive.* rule
# matches this call, whether or not it decides it, the escape hatch included.
if [ "$INTUTIC_CHAOS_ACTIVE" = "1" ] && [ \${#INTUTIC_DYNAMIC[@]} -gt 0 ]; then
  for _rec in "\${INTUTIC_DYNAMIC[@]}"; do
    case "$_rec" in
      destructive.*)
        intutic_rule_fires "$_rec" quiet
        if [ "$_intutic_fires" = "1" ]; then _intutic_chaos_destructive=1; break; fi
        ;;
    esac
  done
fi

for _rec in "\${INTUTIC_FLOOR[@]}"; do
  intutic_apply "$_rec"
done

_intutic_pass=det
if [ \${#INTUTIC_DYNAMIC[@]} -gt 0 ]; then
  for _rec in "\${INTUTIC_DYNAMIC[@]}"; do
    intutic_apply "$_rec"
  done
fi

# ── Rule records (gate body v23) ─────────────────────────────────────────────
# A rule record's verdict, as the Python check returns it: verdict, code, rule
# id and reason, tab-separated; empty to continue. shadow records the finding;
# block refuses.
intutic_rule_verdict() {
  [ -n "$1" ] || return 0
  local verdict code rid reason retry
  IFS=$'	' read -r verdict code rid reason retry <<< "$1"
  if [ "$verdict" = "shadow" ]; then
    intutic_chaos_note "$rid"
    log_event "tool_would_block" "\${TOOL:-}" "\${reason} [\${rid}]" || true
    return 0
  fi
  _intutic_chaos_rule="$rid"; _intutic_chaos_hit=1
  intutic_shown "\${reason} [\${rid}]"
  echo "[Intutic Governance] BLOCKED: \${_intutic_shown} (refusal code \${code})" >&2
  # Where to retry: the paths or tools the refusal names. An
  # OPAQUE workspace drops it, as it drops the rule.
  if [ -n "$retry" ] && [ "$INTUTIC_OPAQUE" != "1" ]; then echo "$retry" >&2; fi
  log_event "tool_blocked" "\${TOOL:-}" "\${reason} [\${rid}]"
  exit 2
}
_intutic_rr_text=""
if [ \${#INTUTIC_RULE_RECORDS[@]} -gt 0 ]; then
  _intutic_rr_text="$(printf '%s
' "\${INTUTIC_RULE_RECORDS[@]}")"
fi
# requires_outcome: a call whose action token (or tool) a qualified
# requires_before gates is refused unless this session's last test run passed,
# and no file changed since (PREREQUISITE_UNMET). The check also keeps the
# session's state: a file change marks a passing run stale. A check that
# cannot run refuses.
case "$_intutic_rr_text" in
  *$'	'requires_outcome$'	'*)
    _intutic_rr="$(python3 -c 'import os, sys
lib = {}
exec(os.environ.get("INTUTIC_PY_LIB", ""), lib)
sys.stdout.write(lib["intutic_outcome_check"](*(sys.argv[1:7] + [sys.stdin.read()])))' 'gemini-cli' 1 "\${TOOL:-}" "\${INTUTIC_ACTIONS:- }" "\${SESSION_ID:-}" "$_intutic_rr_text" <<< "\${TOOL_INPUT_JSON:-}" 2>/dev/null || printf 'block	PREREQUISITE_UNMET	requires_before	the requires_before check could not run')"
    intutic_rule_verdict "$_intutic_rr"
    ;;
esac

# ── Unverified snapshot (gate body v17) ──────────────────────────────────────
# A snapshot that failed its digest or workspace check admits no MCP server:
# neither record in it can be vouched for, and a deleted one looks like one
# never set. Refused at block, in an observe-only workspace too, with the code,
# rule id and reason of mcpSnapshotUnverifiedRefusal (intutic_mcp_unverified
# in GATE_PY_LIB).
if [ "$INTUTIC_SNAPSHOT_STATE" = "invalid" ]; then
  case "\${TOOL:-}" in
    mcp__*__*)
      _intutic_unv="$(python3 -c 'import os, sys
lib = {}
exec(os.environ.get("INTUTIC_PY_LIB", ""), lib)
sys.stdout.write(lib["intutic_mcp_unverified"](sys.argv[1]))' "\${TOOL:-}" 2>/dev/null || true)"
      if [ -n "$_intutic_unv" ]; then
        IFS=$'\\t' read -r _ _intutic_unv_rid _intutic_unv_reason <<< "$_intutic_unv"
      else
        # python3 could not say why (it is required, and checked, before any
        # rule runs): still a refusal, never an allow.
        _intutic_unv_rid="policy_snapshot"
        _intutic_unv_reason="POLICY_SNAPSHOT_UNVERIFIED — the policy snapshot failed its integrity check and admits no MCP server"
      fi
      _intutic_chaos_rule="$_intutic_unv_rid"; _intutic_chaos_hit=1
      echo "[Intutic Governance] BLOCKED: \${_intutic_unv_reason} [\${_intutic_unv_rid}]" >&2
      log_event "tool_blocked" "\${TOOL:-}" "\${_intutic_unv_reason} [\${_intutic_unv_rid}]"
      exit 2
      ;;
  esac
fi

# ── MCP server registry backstop (gate body v14) ─────────────────────────────
# The workspace's registry decisions from the snapshot's @mcp_registry record,
# applied to every mcp__<server>__<tool> call: a blocked or held server, a
# server not approved under mcpDefaultPolicy deny, a disabled tool. The same
# decision, rule ids and reasons as the MCP proxy, so a server no proxy fronts
# is refused as one it fronts would be. Evaluated in Python (intutic_mcp_registry
# in GATE_PY_LIB), which reads the record's JSON; only for MCP-shaped calls.
if [ -n "$INTUTIC_MCP_REGISTRY" ]; then
  case "\${TOOL:-}" in
    mcp__*__*)
      _intutic_reg="$(python3 -c 'import os, sys
lib = {}
exec(os.environ.get("INTUTIC_PY_LIB", ""), lib)
sys.stdout.write(lib["intutic_mcp_registry"](sys.argv[1], sys.argv[2]))' "$INTUTIC_MCP_REGISTRY" "\${TOOL:-}" 2>/dev/null || true)"
      if [ -n "$_intutic_reg" ]; then
        IFS=$'\\t' read -r _ _intutic_reg_rid _intutic_reg_reason <<< "$_intutic_reg"
        _intutic_chaos_rule="$_intutic_reg_rid"; _intutic_chaos_hit=1
        intutic_shown "\${_intutic_reg_reason} [\${_intutic_reg_rid}]"
        echo "[Intutic Governance] BLOCKED: \${_intutic_shown}" >&2
        log_event "tool_blocked" "\${TOOL:-}" "\${_intutic_reg_reason} [\${_intutic_reg_rid}]"
        exit 2
      fi
      ;;
  esac
fi

# ── MCP per-server allowlist backstop ────────────────────────────────────────
# A dedicated record, not a synthetic GuardPattern rule: "allow only these
# servers" as one regex needs negative lookahead, which POSIX ERE (grep -E)
# does not have. So this is a plain membership test over the @mcp_allowlist
# record, with evaluateMcpAllowlist's code, rule id and reason (the shared
# vectors hold this copy to it). Only for an mcp__<server>__<tool> call, and
# only when the snapshot carries the record.
case "\${TOOL:-}" in
  mcp__*__*)
    if [ "$INTUTIC_MCP_ALLOWLIST" = "1" ]; then
      _intutic_mcp_server="\${TOOL#mcp__}"
      _intutic_mcp_server="\${_intutic_mcp_server%%__*}"
      case ",$INTUTIC_MCP_SERVERS," in
        *",$_intutic_mcp_server,"*)
          : # allowed — the server is in the workspace's list
          ;;
        *)
          _intutic_mcp_reason="MCP server \\"$_intutic_mcp_server\\" is not on the MCP server allowlist for this workspace [mcp_allowlist]"
          if [ "$INTUTIC_MCP_SEVERITY" = "shadow" ]; then
            intutic_chaos_note mcp_allowlist
            log_event "tool_would_block" "\${TOOL:-}" "$_intutic_mcp_reason" || true
          else
            _intutic_chaos_rule=mcp_allowlist; _intutic_chaos_hit=1
            intutic_shown "$_intutic_mcp_reason"
            echo "[Intutic Governance] BLOCKED: \${_intutic_shown}" >&2
            log_event "tool_blocked" "\${TOOL:-}" "$_intutic_mcp_reason"
            exit 2
          fi
          ;;
      esac
    fi
    ;;
esac

# ── Holds (gate body v8; after every refusal since v23) ──────────────────────
_intutic_pass=hold
if [ \${#INTUTIC_DYNAMIC[@]} -gt 0 ]; then
  for _rec in "\${INTUTIC_DYNAMIC[@]}"; do
    intutic_apply "$_rec"
  done
fi

# ── Trajectory: scope_paths and plan_approval (gate body v23) ────────────────
# A file change outside the union of scope_paths (OUT_OF_SCOPE), and a call
# before the session's plan is approved (PLAN_NOT_APPROVED) or, under strict,
# off its steps (OFF_PLAN). After the holds, before the decide tier. A check
# that cannot run refuses.
case "$_intutic_rr_text" in
  *$'	'scope_paths$'	'*|*$'	'plan_approval$'	'*)
    _intutic_tr="$(python3 -c 'import os, sys
lib = {}
exec(os.environ.get("INTUTIC_PY_LIB", ""), lib)
sys.stdout.write(lib["intutic_trajectory_check"](*(sys.argv[1:4] + [sys.argv[4], sys.stdin.read(), sys.argv[5], sys.argv[6]])))' 'gemini-cli' "\${TOOL:-}" "\${SESSION_ID:-}" "$_intutic_rr_text" "$PWD" "\${INTUTIC_WORKSPACE_ID:-}" <<< "\${TOOL_INPUT_JSON:-}" 2>/dev/null || printf 'block	OUT_OF_SCOPE	scope_paths	the scope and plan check could not run')"
    intutic_rule_verdict "$_intutic_tr"
    ;;
esac

# ── Decide tier (gate body v22) ──────────────────────────────────────────────
# Only after every tier above allowed the call, and only for a tool an @decide
# record names in its fourth column: intutic decide check --stdin asks the
# self-hosted engine, within 3900 ms less what the deadline has left.
# A CLI that is missing, fails, times out or answers what this gate cannot
# read is unavailable, which refuses unless every record on the tool is
# stamped shadow.
_intutic_decide_match=0
_intutic_decide_enforce=0
if [ -z "\${1:-}" ] && [ \${#INTUTIC_DECIDE_RECORDS[@]} -gt 0 ]; then
  for _rec in "\${INTUTIC_DECIDE_RECORDS[@]}"; do
    IFS=$'\\t' read -r _ _d_fb _d_roll _d_tools _d_rest <<< "$_rec"
    case ",\${_d_tools}," in
      *",\${TOOL:-},"*)
        _intutic_decide_match=1
        [ "$_d_roll" = "enforce" ] && _intutic_decide_enforce=1
        ;;
    esac
  done
fi
if [ "$_intutic_decide_match" = "1" ]; then
  _intutic_decide_budget=$(( 9000 - (SECONDS + 1) * 1000 - 500 ))
  [ "$_intutic_decide_budget" -gt 3900 ] && _intutic_decide_budget=3900
  if [ "$_intutic_decide_budget" -lt 50 ]; then
    if [ "$_intutic_decide_enforce" = "1" ]; then
      _intutic_dec="refuse"$'\\x1f'"GOVERNANCE_UNAVAILABLE"$'\\x1f'$'\\x1f'"GOVERNANCE_UNAVAILABLE — no time was left for the decide rules on \${TOOL:-} within the gate deadline"
    else
      _intutic_dec="allow"$'\\x1f'$'\\x1f'$'\\x1f'"no time was left for the decide rules on \${TOOL:-} within the gate deadline"
    fi
  else
    _intutic_dec="$(python3 -c 'import os, sys
lib = {}
exec(os.environ.get("INTUTIC_PY_LIB", ""), lib)
sys.stdout.write(lib["intutic_decide_check"](*sys.argv[1:6], sys.stdin.read()))' 'gemini-cli' "\${TOOL:-}" "$_intutic_decide_budget" "\${SESSION_ID:-}" "$_intutic_decide_enforce" <<< "\${TOOL_INPUT_JSON:-}" 2>/dev/null || true)"
    if [ -z "$_intutic_dec" ]; then
      # python3 could not say (it is required, and checked, before any rule
      # runs): unavailable, as a CLI that did not answer is.
      if [ "$_intutic_decide_enforce" = "1" ]; then
        _intutic_dec="refuse"$'\\x1f'"GOVERNANCE_UNAVAILABLE"$'\\x1f'$'\\x1f'"GOVERNANCE_UNAVAILABLE — the decide check could not run"
      else
        _intutic_dec="allow"$'\\x1f'$'\\x1f'$'\\x1f'"the decide check could not run"
      fi
    fi
  fi
  IFS=$'\\x1f' read -r _intutic_dec_out _intutic_dec_code _intutic_dec_rid _intutic_dec_reason <<< "$_intutic_dec"
  if [ "$_intutic_dec_out" = "allow" ]; then
    # A shadow rule's engine that could not answer: recorded, and the call goes on.
    if [ -n "$_intutic_dec_reason" ]; then
      log_event "tool_would_block" "\${TOOL:-}" "GOVERNANCE_UNAVAILABLE — $_intutic_dec_reason" || true
    fi
  else
    _intutic_dec_full="$_intutic_dec_reason"
    [ -n "$_intutic_dec_rid" ] && _intutic_dec_full="$_intutic_dec_full [$_intutic_dec_rid]"
    # gemini-cli cannot ask a person, so an escalation refuses (DECIDE_ESCALATED).
    _intutic_chaos_rule="$_intutic_dec_rid"; _intutic_chaos_hit=1
    intutic_shown "$_intutic_dec_full"
    echo "[Intutic Governance] BLOCKED: \${_intutic_shown} (refusal code \${_intutic_dec_code:-DECIDE_ESCALATED})" >&2
    log_event "tool_blocked" "\${TOOL:-}" "$_intutic_dec_full"
    exit 2
  fi
fi

# ── Agent fault injection: the call is allowed ───────────────────────────────
# Recorded as allowed, then the fault that is due, if any. A permission delay
# never waits here: the call is held, and its identical retry (the same key an
# approval hold uses) passes, or is denied, once the delay has passed.
if [ "$INTUTIC_CHAOS_ACTIVE" = "1" ]; then
  _intutic_chaos_key="$( { printf '%s' "$INTUTIC_NTOOL"; printf '\\0'; printf '%s' "$INTUTIC_NCOMMAND"; printf '\\0'; printf '%s' "$INTUTIC_NTARGET"; } | intutic_sha256 )"
  _intutic_fault="$(intutic_chaos_decide allow "$_intutic_chaos_key")"
  _intutic_chaos_done=1
  if [ -n "$_intutic_fault" ]; then
    _intutic_fault_kind="\${_intutic_fault%%$'\\t'*}"
    _intutic_fault_reason="\${_intutic_fault#*$'\\t'}"
    # The fault's own text, carrying the plan's canary: what the agent reads.
    if [ "$_intutic_fault_kind" = "hold" ]; then
      echo "[Intutic Governance] HELD: \${_intutic_fault_reason}" >&2
    else
      echo "$_intutic_fault_reason" >&2
    fi
    exit 2
  fi
fi
# ── end Intutic gate body ────────────────────────────────────────────────────

log_event "tool_allowed" "$TOOL_NAME" ""
exit 0
",
}
`;

exports[`generated hook scripts > goose > matches the recorded output byte for byte 1`] = `
{
  ".agents/plugins/intutic-governance/scripts/intutic-check.sh": "#!/usr/bin/env bash
# Intutic Goose PreToolUse governance gate.
# Auto-generated by intutic sync-daemon. DO NOT EDIT.
# Proxy: http://127.0.0.1:4000
# Generated: <TIMESTAMP>
set -euo pipefail

# ── Intutic fail-closed prelude v23 ─────────────────────────────
# Any exit status other than the two deliberate verdicts (0 = allow, 2 = block)
# means this gate crashed rather than decided. The harness would read exit 1 as
# "hook errored" and run the tool anyway, so a crash is converted into a block.
# EXIT rather than ERR: ERR is unreliable across shells for set -u deaths, and
# it fires on benign non-zero intermediates; the final status cannot lie.
# A post-tool invocation (--event post, gate body v23) records a tool's result
# and never refuses: the tool has already run, and some harnesses read a
# post-tool exit 2 as text to feed back to the model. So in post mode every
# exit, a crash and the deadline included, is 0.
INTUTIC_POST_MODE=0
if [ "\${1:-}" = "--event" ] && [ "\${2:-}" = "post" ]; then INTUTIC_POST_MODE=1; fi
intutic_fail_closed() {
  _intutic_exit_rc=$?
  # The trap must not itself die on an unset variable or a failed command —
  # that would replace the exit status it exists to correct.
  set +eu
  trap - EXIT
  [ -n "\${INTUTIC_WATCHDOG_PID:-}" ] && kill "$INTUTIC_WATCHDOG_PID" 2>/dev/null
  if [ "\${INTUTIC_POST_MODE:-0}" = "1" ]; then exit 0; fi
  # A chaos run's record of a call the gate refused, held or crashed on (the
  # gate body records an allowed one where it ends). It cannot change the
  # exit status: everything it prints is discarded.
  if [ "$_intutic_exit_rc" != "0" ] && [ "\${INTUTIC_CHAOS_ACTIVE:-0}" = "1" ] && command -v intutic_chaos_decide >/dev/null 2>&1; then
    intutic_chaos_decide "\${_intutic_chaos_decision:-deny}" >/dev/null 2>&1
  fi
  if [ "$_intutic_exit_rc" = "0" ] || [ "$_intutic_exit_rc" = "2" ]; then
    exit "$_intutic_exit_rc"
  fi
  echo "[Intutic Governance] BLOCKED: gate crashed (exit \${_intutic_exit_rc}) — failing closed rather than allowing an unevaluated call." >&2
  if command -v log_event >/dev/null 2>&1; then
    log_event "tool_blocked" "\${TOOL:-unknown}" "gate crashed (exit \${_intutic_exit_rc}) — failing closed" || true
  fi
  exit 2
}
trap intutic_fail_closed EXIT

# ── Internal deadline ────────────────────────────────────────────────────────
# Most harnesses run a call whose hook outlives their timeout as if the hook had
# allowed it. So this gate refuses at 9 s from its own start, inside the
# hook timeout goose applies (gateLimits.ts): a watchdog, detached so it holds none of
# the harness's pipes, stops the gate's children (a grep or python3 still
# matching) and signals it; the trap below refuses. Every built-in rule is
# linear; a workspace's own WHERE pattern need not be.
intutic_deadline() {
  trap - USR1
  if [ "\${INTUTIC_POST_MODE:-0}" = "1" ]; then exit 0; fi
  echo "[Intutic Governance] BLOCKED: GATE_DEADLINE — the gate did not finish evaluating this call within 9 s, and refuses it rather than let the hook timeout allow it." >&2
  if command -v log_event >/dev/null 2>&1; then
    log_event "tool_blocked" "\${TOOL:-unknown}" "GATE_DEADLINE — the gate did not finish within 9 s" || true
  fi
  exit 2
}
trap intutic_deadline USR1
INTUTIC_GATE_PID=$$
INTUTIC_WATCHDOG_PID="$( { ( sleep 9; pkill -P "$INTUTIC_GATE_PID" 2>/dev/null; kill -USR1 "$INTUTIC_GATE_PID" 2>/dev/null ) </dev/null >/dev/null 2>&1 & } ; echo $! )"

# The hook event: PreToolUse invokes this script bare, PostToolUse with
# "--event post". It used to read EVENT="\${1:-pre}", which is "--event" on the
# post call, and the post call then ran the pre-tool gate again. The fail-closed
# prelude above sets INTUTIC_POST_MODE from the same arguments; the gate body
# returns at once in post mode, and records nothing for goose, whose post-tool
# payload has not been captured (POST_TOOL_OBSERVABLE).
EVENT=pre
if [ "\${1:-}" = "--event" ]; then EVENT="\${2:-pre}"; fi
INPUT="$(cat)"

if ! command -v python3 >/dev/null 2>&1; then
  # A post-tool invocation records nothing without python3, and never refuses.
  if [ "\${INTUTIC_POST_MODE:-0}" = "1" ]; then exit 0; fi
  echo "[Intutic Governance] BLOCKED: python3 is required to evaluate tool calls and was not found on PATH." >&2
  echo "[Intutic Governance] Install python3, or unset the Intutic hooks to run ungoverned." >&2
  exit 2
fi

# The phrase matcher and the hold classifier (GATE_PY_LIB in gateBody.ts),
# for the extractor below and for phrase-subject rules. A quoted heredoc, so
# the shell expands nothing in it; read stops at end of input and returns 1.
IFS= read -r -d '' INTUTIC_PY_LIB <<'INTUTIC_PY_LIB_END' || true
"""Phrase matching for shell commands and SQL in linear time.

A transliteration of packages/shared-types/src/phrases.ts; read that module's
docstring for what counts as a separator and why no regex searches the input.
The rules are the same; the walk is organised for CPython, which is slow per
step: runs of ordinary characters, spaces and backslashes are consumed by
anchored character-class matches (one pass each, nothing to backtrack into),
and a phrase is checked only at the words that can start it.

Every classifier runs the shared vectors in
packages/proxy/src/plugins/anomaly/action_vectors.json, and the hook gates
emit this file verbatim (services/sync-daemon/src/lib/phrasesPy.ts holds a
byte-identical copy, which a test compares). It must stay self-contained: the
standard library only, no module state beyond the constants below, and no
backtick or dollar-brace, which the TypeScript copy cannot hold.
"""

import re
from bisect import bisect_left

_SPACE_CHARS = (
    " \\t\\n\\r\\v\\f\\u00a0\\u1680\\u2000\\u2001\\u2002\\u2003\\u2004\\u2005\\u2006\\u2007"
    "\\u2008\\u2009\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff"
)
_SPACES = frozenset(_SPACE_CHARS)
_WORD = frozenset("abcdefghijklmnopqrstuvwxyz0123456789_")
# One anchored match per piece of the text. Every alternative starts with a
# character no other alternative can start with, so exactly one can match at
# a position and it matches one run of its class: nothing to backtrack into.
_PIECE = re.compile(
    "(?P<plain>[^" + _SPACE_CHARS + "\\\\\\\\/;&|-]+)"
    "|(?P<space>[" + _SPACE_CHARS + "]+)"
    "|(?P<dash>-+)"
    "|(?P<backslash>\\\\\\\\+)"
    "|(?P<other>[/;&|])"
)
# A run of words that need no decision, each followed by one plain space:
# ordinary characters, after at most a leading run of dashes. Consumed in one
# match and split in C — most of a long command is this.
_BULK = re.compile("(?:(?:[^" + _SPACE_CHARS + "\\\\\\\\/;&|-]+|-+[^" + _SPACE_CHARS + "\\\\\\\\/;&|-]*) )+")
_BULK_NO_COMMENT = re.compile("(?:(?:[^" + _SPACE_CHARS + "\\\\\\\\;&|-]+|-+[^" + _SPACE_CHARS + "\\\\\\\\;&|-]*) )+")
# A run of line continuations or escaped spaces between words: one break.
_CONTINUATIONS = re.compile("(?:\\\\\\\\[" + _SPACE_CHARS + "])+")
# The same once no "*/" is left in the text: no "/*" can open a comment, so a
# slash is an ordinary character.
_PIECE_NO_COMMENT = re.compile(
    "(?P<plain>[^" + _SPACE_CHARS + "\\\\\\\\;&|-]+)"
    "|(?P<space>[" + _SPACE_CHARS + "]+)"
    "|(?P<dash>-+)"
    "|(?P<backslash>\\\\\\\\+)"
    "|(?P<other>[;&|])"
)


class PhraseText:
    """A text cut into words, ready for any number of has_phrase calls."""

    __slots__ = ("raw", "joined", "toks", "sep", "nl", "eol", "dash", "bar", "tail", "memo")

    def __init__(self):
        self.raw = ""
        self.joined = ""
        self.toks = []
        self.sep = []
        self.nl = []
        self.eol = []
        self.dash = []
        self.bar = []
        self.tail = False
        self.memo = {}


def phrase_text(value):
    """Cut value into words in one pass (see phraseText in phrases.ts)."""
    s = ("" if value is None else str(value)).lower()
    n = len(s)
    t = PhraseText()
    t.raw = s
    toks, sep, nl, eol, dash, bar = t.toks, t.sep, t.nl, t.eol, t.dash, t.bar
    start = -1
    tok_bar = False
    pend_sep = pend_nl = pend_eol = False
    close = -2 if "*/" in s else -1  # the next "*/" at or after the last search; -1 once none is left
    piece = _PIECE if close != -1 else _PIECE_NO_COMMENT
    bulk = _BULK if close != -1 else _BULK_NO_COMMENT
    i = 0
    while i < n:
        if start < 0:
            m = bulk.match(s, i)
            if m is not None:
                words = m.group().split(" ")
                words.pop()
                rest = len(words) - 1
                toks.extend(words)
                sep.append(pend_sep)
                sep.extend([True] * rest)
                nl.append(pend_nl)
                nl.extend([False] * rest)
                eol.append(pend_eol)
                eol.extend([False] * rest)
                dash.extend([w.startswith("--") for w in words])
                bar.extend([False] * (rest + 1))
                pend_sep = True
                pend_nl = pend_eol = False
                i = m.end()
                continue
            m = _CONTINUATIONS.match(s, i)
            if m is not None:
                pend_sep = True
                i = m.end()
                continue
        m = piece.match(s, i)
        kind = m.lastgroup
        j = m.end()
        if kind == "plain":
            if start < 0:
                start = i
            i = j
            continue
        word_break = False
        newline = eol_here = False
        nxt = j
        if kind == "space":
            newline = eol_here = "\\n" in m.group()
            word_break = True
        elif kind == "dash":
            # A "--" inside a word starts a new one, glued to it: it can open a
            # comment or an option run but cannot stand for a plain gap.
            if j - i > 1 and start >= 0:
                toks.append(s[start:i])
                sep.append(pend_sep)
                nl.append(pend_nl)
                eol.append(pend_eol)
                dash.append(s.startswith("--", start))
                bar.append(tok_bar)
                start = -1
                tok_bar = False
                pend_sep = pend_nl = pend_eol = False
            if start < 0:
                start = i
            i = j
            continue
        elif kind == "backslash":
            # Every backslash but the last is followed by a backslash: a
            # literal character. The last one decides.
            last = j - 1
            d = s[j] if j < n else ""
            if d in ("n", "t", "r") or (d != "" and d in _SPACES):
                if last > i and start < 0:
                    start = i
                word_break = True
                eol_here = d == "n"
                nxt = j + 1
                if last > i:
                    # the literal backslashes end the word before the escape
                    toks.append(s[start:last])
                    sep.append(pend_sep)
                    nl.append(pend_nl)
                    eol.append(pend_eol)
                    dash.append(s.startswith("--", start))
                    bar.append(tok_bar)
                    start = -1
                    tok_bar = False
                    pend_sep = pend_nl = pend_eol = False
            else:
                if start < 0:
                    start = i
                i = j
                continue
        else:
            c = s[i]
            if c == "/" and j < n and s[j] == "*" and close != -1:
                if close < i + 2:
                    close = s.find("*/", i + 2)
                    if close == -1:
                        piece = _PIECE_NO_COMMENT
                        bulk = _BULK_NO_COMMENT
                if close != -1:
                    word_break = True
                    nxt = close + 2
            if not word_break:
                if start < 0:
                    start = i
                if c != "/":
                    tok_bar = True
                i = j
                continue
        if start >= 0:
            toks.append(s[start:i])
            sep.append(pend_sep)
            nl.append(pend_nl)
            eol.append(pend_eol)
            dash.append(s.startswith("--", start))
            bar.append(tok_bar)
            start = -1
            tok_bar = False
            pend_sep = pend_nl = pend_eol = False
        pend_sep = True
        if newline:
            pend_nl = True
        if eol_here:
            pend_eol = True
        i = nxt
    if start >= 0:
        toks.append(s[start:n])
        sep.append(pend_sep)
        nl.append(pend_nl)
        eol.append(pend_eol)
        dash.append(s.startswith("--", start))
        bar.append(tok_bar)
        pend_sep = False
    t.tail = pend_sep
    t.joined = " ".join(toks)
    return t


def _next_index(t):
    """Per word x: the first word at or after x containing ;&|, with a real
    newline before it, and with any newline before it. Built once per text."""
    ix = t.memo.get("#next")
    if ix is None:
        T = len(t.toks)
        nb = [T] * (T + 1)
        nn = [T] * (T + 1)
        ne = [T] * (T + 1)
        b = n_ = e = T
        bar, nl, eol = t.bar, t.nl, t.eol
        for x in range(T - 1, -1, -1):
            if bar[x]:
                b = x
            if nl[x]:
                n_ = x
            if eol[x]:
                e = x
            nb[x] = b
            nn[x] = n_
            ne[x] = e
        ix = (nb, nn, ne)
        t.memo["#next"] = ix
    return ix


def has_phrase(t, needle, bounded=False):
    """Whether t contains needle (see hasPhrase in phrases.ts)."""
    words = needle.lower().split(" ")
    if len(words) == 1:
        return words[0] in t.raw
    trailing_gap = words[-1] == ""
    if trailing_gap:
        words.pop()
    for w in words:
        if w == "" or w not in t.joined:
            return False
    toks, sep, dash, tail = t.toks, t.sep, t.dash, t.tail
    T = len(toks)
    k = len(words)

    def positions(i):
        """The words that word i of the phrase can be, by its position."""
        w = words[i]
        first = i == 0
        last = i == k - 1 and not trailing_gap
        key = ("f" if first else "") + ("l" if last else "") + ("b" if bounded else "") + ":" + w
        hit = t.memo.get(key)
        if hit is not None:
            return hit
        lw = len(w)
        if first:
            out = [q for q, tok in enumerate(toks) if tok.endswith(w)]
        elif last:
            out = [q for q, tok in enumerate(toks) if tok.startswith(w)]
        else:
            out = [q for q, tok in enumerate(toks) if tok == w]
        if bounded:
            kept = []
            for q in out:
                tok = toks[q]
                if first and len(tok) > lw and tok[len(tok) - lw - 1] in _WORD:
                    continue
                if last and len(tok) > lw and (tok[lw] in _WORD or tok[lw] == "."):
                    continue
                kept.append(q)
            out = kept
        t.memo[key] = out
        return out

    # The words at which the rest of the phrase matches, ascending.
    ok = positions(k - 1)
    if trailing_gap:
        kept = []
        for q in ok:
            r = q + 1
            if r < T:
                if sep[r] or (dash[r] and not t.bar[r] and (r + 1 < T or tail)):
                    kept.append(q)
            elif tail:
                kept.append(q)
        ok = kept
    if k == 1:
        return bool(ok)
    nb, nn, ne = _next_index(t)
    for i in range(k - 2, -1, -1):
        ok_sep = [q for q in ok if sep[q]]
        ok_set = set(ok_sep)
        memo = {}

        def option(r):
            # An option run reaches any word before a ;&| word or a real newline.
            j = bisect_left(ok_sep, r + 1)
            return j < len(ok_sep) and ok_sep[j] <= min(nb[r], nn[r + 1], T - 1)

        def reach(r):
            # The gap that starts at word r leads into the rest of the phrase:
            # directly, after an option run, or after -- comments, each of
            # which runs to the next newline.
            path = []
            cur = r
            while True:
                if cur >= T:
                    val = False
                    break
                if cur in memo:
                    val = memo[cur]
                    break
                if cur in ok_set or (dash[cur] and option(cur)):
                    val = memo[cur] = True
                    break
                if not dash[cur]:
                    val = memo[cur] = False
                    break
                path.append(cur)
                cur = ne[cur + 1]
            for x in path:
                memo[x] = val
            return val

        ok = [p for p in positions(i) if reach(p + 1)]
        if not ok:
            return False
    return bool(ok)


"""The MCP server registry and allowlist decisions, read from the policy snapshot.

A transliteration of packages/shared-types/src/mcpRegistryRecord.ts: the
registry decision (evaluateMcpRegistry), the allowlist decision
(evaluateMcpAllowlist), and the snapshot's @mcp_registry and @mcp_allowlist
records. The control plane's hook gate, the MCP proxy and the JavaScript hook
gates run the TypeScript; the bash hook gates and this package run this file,
and every one of them runs packages/shared-types/fixtures/mcp-registry-vectors.json,
so all of them refuse a call with the same code, rule id and reason.

The bash gates emit this file verbatim (services/sync-daemon/src/lib/mcpRegistryPy.ts
holds a byte-identical copy, which a test compares). It must stay
self-contained: the standard library only, no module state beyond the
constants below, and no backtick or dollar-brace, which the TypeScript copy
cannot hold.

Both records sit inside the snapshot's digest. A gate that finds the snapshot
unverified (its digest broken or missing, or another workspace's) trusts
neither: it refuses every MCP call with unverified_refusal, at block, in an
observe-only workspace too.
"""

import base64
import json

MCP_REGISTRY_RECORD_TAG = "@mcp_registry"
MCP_ALLOWLIST_RECORD_TAG = "@mcp_allowlist"


def split_mcp_tool_name(tool):
    """(server, tool) for a harness name mcp__<server>__<tool>, else None.

    The server is the part before the first double underscore; the tool, the
    rest, may hold more of them.
    """
    if not isinstance(tool, str) or not tool.startswith("mcp__"):
        return None
    rest = tool[len("mcp__"):]
    sep = rest.find("__")
    if sep <= 0:
        return None
    return rest[:sep], rest[sep + 2:]


def _strings(value):
    return [v for v in value if isinstance(v, str)] if isinstance(value, list) else []


def parse_registry(value):
    """The registry as the control plane sends it, or None for a non-object.

    Wrong-typed lists read as empty, and any default but deny as allow.
    """
    if not isinstance(value, dict):
        return None
    disabled = {}
    if isinstance(value.get("disabledTools"), dict):
        for server, tools in value["disabledTools"].items():
            names = _strings(tools)
            if names:
                disabled[server] = names
    return {
        "defaultPolicy": "deny" if value.get("defaultPolicy") == "deny" else "allow",
        "approvedServers": _strings(value.get("approvedServers")),
        "blockedServers": _strings(value.get("blockedServers")),
        "heldServers": _strings(value.get("heldServers")),
        "disabledTools": disabled,
    }


def decode_registry_record(line):
    """The @mcp_registry line's registry; None for another line or a damaged one."""
    parts = line.split("\\t")
    if len(parts) != 2 or parts[0] != MCP_REGISTRY_RECORD_TAG or not parts[1]:
        return None
    try:
        return parse_registry(json.loads(base64.b64decode(parts[1], validate=True).decode("utf-8")))
    except Exception:
        return None


def evaluate_registry(registry, server, tool):
    """(code, rule_id, reason) refusing one MCP call, or None to let it continue.

    A blocked server, then a held one, then (under deny) one not approved,
    then a disabled tool.
    """
    if server in registry["blockedServers"]:
        return (
            "SERVER_BLOCKED",
            "mcp_registry." + server,
            "MCP server \\"" + server + "\\" is blocked in this workspace's MCP server registry. "
            "An owner or admin can change that on the MCP Servers page.",
        )
    if server in registry["heldServers"]:
        return (
            "SERVER_HELD",
            "mcp_registry." + server,
            "MCP server \\"" + server + "\\" changed its tools in a way scored high risk, and this workspace "
            "holds such a server until it is approved again. It is waiting in the approval queue on the MCP "
            "Servers page for an owner or admin.",
        )
    if registry["defaultPolicy"] == "deny" and server not in registry["approvedServers"]:
        return (
            "SERVER_NOT_APPROVED",
            "mcpDefaultPolicy",
            "MCP server \\"" + server + "\\" is not approved in this workspace's MCP server registry, "
            "and the workspace refuses unapproved servers (mcpDefaultPolicy: deny). It is waiting in "
            "the approval queue on the MCP Servers page for an owner or admin.",
        )
    if tool in registry["disabledTools"].get(server, []):
        return (
            "TOOL_DISABLED",
            "mcp_registry." + server + "." + tool,
            "Tool \\"" + tool + "\\" is disabled on MCP server \\"" + server + "\\" in this workspace's "
            "MCP server registry. An owner or admin can re-enable it on the MCP Servers page.",
        )
    return None


def decode_allowlist_record(line):
    """The @mcp_allowlist line as {"severity", "servers"}; None for another line.

    A severity other than shadow reads as block, so a damaged one refuses.
    """
    parts = line.split("\\t")
    if len(parts) != 3 or parts[0] != MCP_ALLOWLIST_RECORD_TAG:
        return None
    return {
        "severity": "shadow" if parts[1] == "shadow" else "block",
        "servers": [s for s in parts[2].split(",") if s],
    }


def evaluate_allowlist(allowlist, server):
    """(code, rule_id, reason) for a server the allowlist does not name, else None.

    Under shadow the caller records the refusal instead of enforcing it.
    """
    if server in allowlist["servers"]:
        return None
    return (
        "SERVER_NOT_ALLOWED",
        "mcp_allowlist",
        "MCP server \\"" + server + "\\" is not on the MCP server allowlist for this workspace",
    )


def unverified_refusal(server):
    """(code, rule_id, reason) refusing an MCP call on an unverified snapshot.

    Neither the registry's approvals nor the allowlist's servers can be
    vouched for, and a deleted record looks like one never set, so the
    snapshot admits no MCP server at all.
    """
    return (
        "POLICY_SNAPSHOT_UNVERIFIED",
        "policy_snapshot",
        "MCP server \\"" + server + "\\" is refused because the policy snapshot on this machine failed its "
        "integrity check, so its MCP server registry and allowlist admit no server until the sync daemon "
        "restores a verified snapshot",
    )


"""Did the tests pass? The deciding function behind the qualified ordering rule
requires_before: action:run_tests[ok] -> action:deploy, and the
per-session state a gate keeps of it.

A transliteration of packages/shared-types/src/testOutcome.ts; read that
module's docstring for the steps. In short, decide_test_outcome says failed
for a non-zero exit code, an error flag, a false success flag, a runner
summary with failures, or a summary saying no tests ran; ok for exit code 0,
or, with no exit code, a summary that counts a pass; and unknown otherwise,
which leaves a qualified rule unmet as a failure does.

Every port runs packages/shared-types/fixtures/test-outcome-vectors.json. The
bash hook gates emit this file verbatim, so it must stay self-contained: the
standard library only, no module state beyond the constants below, and no
backtick or dollar-brace, which a TypeScript copy cannot hold.

Inputs and states are plain dicts with the TypeScript field names
(exitCode, isError, success, output; {"v": 1, "outcomes":
{...}}), so a gate can read and write the same state file.
"""

import json
import re

OUTCOME_TOKENS = ("action:run_tests",)
OUTCOME_QUALIFIERS = ("ok",)
TEST_OUTPUT_TAIL_BYTES = 65536
TEST_OUTPUT_LINE_BYTES = 1024
TEST_OUTPUT_JSON_MAX_CHARS = 1048576
OUTCOME_STATE_TTL_MS = 86400000
_MAX_SAFE_INTEGER = 9007199254740991

_ANSI = re.compile(r"\\x1b\\[[0-9;?]*[A-Za-z]")
_EXIT_CODE = re.compile(r"exit code:? (-?[0-9]{1,9})\\Z", re.IGNORECASE | re.ASCII)
_EXIT_STATUS = re.compile(r"exit status ([0-9]{1,9})\\Z")
_EXITED = re.compile(r"(?:Process|Command) exited with code (-?[0-9]{1,9})")
_COUNT = re.compile(r"([0-9]{1,9}) ([a-z]+)")
_PYTEST_NONE = re.compile(r"=+ no tests ran")
_PYTEST = re.compile(r"=+ (.+) in [0-9.]+s.* =+\\Z")
_JEST = re.compile(r"Tests:[ \\t]+(.+)\\Z")
_VITEST = re.compile(r"[ \\t]*Tests[ \\t]+(.+)\\Z")
_GO_OK = re.compile(r"ok[ \\t]+[^ \\t]+")
_GO_FAIL = re.compile(r"FAIL(?:[ \\t]|\\Z)")
_GO_FAIL_TEST = re.compile(r"--- FAIL:")
_CARGO = re.compile(r"test result: (ok|FAILED)\\. ([0-9]{1,9}) passed; ([0-9]{1,9}) failed;")
_MOCHA_PASS = re.compile(r"[ \\t]*([0-9]{1,9}) passing")
_MOCHA_FAIL = re.compile(r"[ \\t]*([0-9]{1,9}) failing")
_RSPEC = re.compile(r"([0-9]{1,9}) examples?, ([0-9]{1,9}) failures?")


def _utf8_len(ch):
    cp = ord(ch)
    if cp < 0x80:
        return 1
    if cp < 0x800:
        return 2
    if cp < 0x10000:
        return 3
    return 4


def _utf8_tail(s, max_bytes):
    """The last max_bytes bytes of s as UTF-8, starting on a character."""
    total = 0
    i = len(s)
    while i > 0:
        n = _utf8_len(s[i - 1])
        if total + n > max_bytes:
            break
        total += n
        i -= 1
    return s[i:]


def _utf8_head(s, max_bytes):
    """The first max_bytes bytes of s as UTF-8, ending on a character."""
    total = 0
    i = 0
    while i < len(s):
        n = _utf8_len(s[i])
        if total + n > max_bytes:
            break
        total += n
        i += 1
    return s[:i]


def _lines(text):
    """The lines of text, each cut to 1 KiB, without carriage returns or ANSI sequences."""
    return [_ANSI.sub("", _utf8_head(raw, TEST_OUTPUT_LINE_BYTES).replace("\\r", "")) for raw in text.split("\\n")]


def _integer_or_none(v):
    """A JSON integer exit code, or None."""
    if isinstance(v, bool):
        return None
    if isinstance(v, int) and abs(v) <= _MAX_SAFE_INTEGER:
        return v
    if isinstance(v, float) and v.is_integer() and abs(v) <= _MAX_SAFE_INTEGER:
        return int(v)
    return None


def extract_exit_code(output):
    """The exit code a run's text reports, or None. See testOutcome.ts extractExitCode."""
    if not isinstance(output, str) or output == "":
        return None
    trimmed = output.strip()
    if len(trimmed) <= TEST_OUTPUT_JSON_MAX_CHARS and trimmed[:1] == "{" and trimmed[-1:] == "}":
        try:
            parsed = json.loads(trimmed)
        except ValueError:
            parsed = None
        if isinstance(parsed, dict):
            meta = parsed.get("metadata")
            if isinstance(meta, dict):
                m = _integer_or_none(meta.get("exit_code"))
                if m is not None:
                    return m
            for key in ("exit_code", "exitCode"):
                v = _integer_or_none(parsed.get(key))
                if v is not None:
                    return v
    head = _utf8_head(output, TEST_OUTPUT_TAIL_BYTES)
    parts = [head] if len(head) == len(output) else [head, _utf8_tail(output[len(head):], TEST_OUTPUT_TAIL_BYTES)]
    for part in parts:
        for raw in _lines(part):
            line = raw.lstrip(" \\t").rstrip(" \\t")
            m = _EXIT_CODE.match(line) or _EXIT_STATUS.match(line) or _EXITED.match(line)
            if m:
                return int(m.group(1))
    return None


def _counts(text):
    """'N word' pieces of a summary, split on ',' and '|': the count of each word."""
    counts = {}
    for piece in re.split(r"[,|]", text):
        m = _COUNT.match(piece.lstrip(" \\t"))
        if m:
            counts[m.group(2)] = counts.get(m.group(2), 0) + int(m.group(1))
    return counts


def parse_test_summaries(output):
    """The runner summaries in the last 64 KiB of output, in order (go and mocha folded into one each)."""
    if not isinstance(output, str) or output == "":
        return []
    out = []
    go = None
    mocha = None
    for line in _lines(_utf8_tail(output, TEST_OUTPUT_TAIL_BYTES)):
        if _PYTEST_NONE.match(line):
            out.append({"runner": "pytest", "passed": 0, "failed": 0, "noTests": True})
            continue
        m = _PYTEST.match(line)
        if m:
            c = _counts(m.group(1))
            if not any(k in c for k in ("passed", "failed", "error", "errors")):
                continue
            out.append({"runner": "pytest", "passed": c.get("passed", 0),
                        "failed": c.get("failed", 0) + c.get("error", 0) + c.get("errors", 0),
                        "noTests": c.get("passed") == 0})
            continue
        m = _JEST.match(line)
        if m:
            c = _counts(m.group(1))
            out.append({"runner": "jest", "passed": c.get("passed", 0), "failed": c.get("failed", 0),
                        "noTests": c.get("passed") == 0 or c.get("total") == 0})
            continue
        m = _VITEST.match(line)
        if m:
            c = _counts(m.group(1))
            if "passed" not in c and "failed" not in c:
                continue
            out.append({"runner": "vitest", "passed": c.get("passed", 0), "failed": c.get("failed", 0),
                        "noTests": c.get("passed") == 0})
            continue
        if _GO_OK.match(line):
            if go is None:
                go = {"runner": "go", "passed": 0, "failed": 0, "noTests": False}
                out.append(go)
            go["passed"] += 1
            continue
        if _GO_FAIL.match(line) or _GO_FAIL_TEST.match(line):
            if go is None:
                go = {"runner": "go", "passed": 0, "failed": 0, "noTests": False}
                out.append(go)
            go["failed"] += 1
            continue
        m = _CARGO.match(line)
        if m:
            passed, failed = int(m.group(2)), int(m.group(3))
            out.append({"runner": "cargo", "passed": passed,
                        "failed": 1 if m.group(1) == "FAILED" and failed == 0 else failed,
                        "noTests": passed == 0})
            continue
        m = _MOCHA_PASS.match(line)
        if m:
            if mocha is None:
                mocha = {"runner": "mocha", "passed": 0, "failed": 0, "noTests": False}
                out.append(mocha)
            mocha["passed"] += int(m.group(1))
            if int(m.group(1)) == 0:
                mocha["noTests"] = True
            continue
        m = _MOCHA_FAIL.match(line)
        if m:
            if mocha is None:
                mocha = {"runner": "mocha", "passed": 0, "failed": 0, "noTests": False}
                out.append(mocha)
            mocha["failed"] += int(m.group(1))
            continue
        m = _RSPEC.match(line)
        if m:
            examples, failures = int(m.group(1)), int(m.group(2))
            out.append({"runner": "rspec", "passed": max(0, examples - failures), "failed": failures,
                        "noTests": examples == 0})
    return out


def decide_test_outcome(inp):
    """The outcome of one test run, as {"outcome": ok|failed|unknown, "why": ...}.

    'inp' carries any of exitCode, isError, success and output.
    """
    exit_code = inp.get("exitCode")
    if isinstance(exit_code, bool) or not isinstance(exit_code, (int, float)) or _integer_or_none(exit_code) is None:
        exit_code = None
    else:
        exit_code = int(exit_code)
    if exit_code is not None and exit_code != 0:
        return {"outcome": "failed", "why": "exit_code"}
    if inp.get("isError") is True:
        return {"outcome": "failed", "why": "is_error"}
    if inp.get("success") is False:
        return {"outcome": "failed", "why": "success_false"}
    passed = 0
    no_tests = False
    for s in parse_test_summaries(inp.get("output")):
        if s["failed"] > 0:
            return {"outcome": "failed", "why": "summary_failed"}
        passed += s["passed"]
        if s["noTests"]:
            no_tests = True
    if passed == 0 and no_tests:
        return {"outcome": "failed", "why": "no_tests"}
    if exit_code == 0:
        return {"outcome": "ok", "why": "exit_zero"}
    if passed >= 1:
        return {"outcome": "ok", "why": "summary_passed"}
    return {"outcome": "unknown", "why": "no_signal"}


def ordering_qualifier_error(side, left):
    """Why one side of an ordering rule cannot carry its qualifier, or None."""
    if "[" not in side and "]" not in side:
        return None
    if left and side == "action:run_tests[ok]":
        return None
    return json.dumps(side, ensure_ascii=False) + ": [ok] qualifies only action:run_tests, on the left of ->"


def split_qualifier(token):
    """action:run_tests[ok] as ("action:run_tests", "ok"); any other token unqualified."""
    return ("action:run_tests", "ok") if token == "action:run_tests[ok]" else (token, None)


def empty_outcome_state():
    return {"v": 1, "outcomes": {}}


def outcome_state_file_name(harness, session_id, sha256_hex):
    """The first 32 hex of sha256(harness NUL session_id), and .json."""
    return sha256_hex(harness + "\\0" + session_id)[:32] + ".json"


def parse_outcome_state(text):
    """A state file's text as a state, or None when it is not one."""
    try:
        v = json.loads(text)
    except ValueError:
        return None
    if not isinstance(v, dict) or v.get("v") != 1 or isinstance(v.get("v"), bool) or not isinstance(v.get("outcomes"), dict):
        return None
    outcomes = {}
    for key, e in v["outcomes"].items():
        if not isinstance(e, dict):
            return None
        at = e.get("at")
        if e.get("o") not in ("ok", "failed", "unknown") or isinstance(at, bool) or not isinstance(at, (int, float)):
            return None
        if at != at or at in (float("inf"), float("-inf")):
            return None
        if "why" in e and not isinstance(e["why"], str):
            return None
        if "changed" in e and e["changed"] is not True:
            return None
        if "later" in e and e["later"] is not True:
            return None
        outcomes[key] = e
    return {"v": 1, "outcomes": outcomes}


def record_test_outcome(state, token, decision, at_ms):
    """state with token's outcome replaced by this run's."""
    outcomes = dict(state["outcomes"])
    outcomes[token] = {"o": decision["outcome"], "at": at_ms, "why": decision["why"]}
    return {"v": 1, "outcomes": outcomes}


def note_completed_call(state, changed_files):
    """state after another call completed: none adjacent any more, and stale after a file change."""
    outcomes = {}
    for key, e in state["outcomes"].items():
        nxt = {"o": e["o"], "at": e["at"]}
        if "why" in e:
            nxt["why"] = e["why"]
        if e.get("changed") or changed_files:
            nxt["changed"] = True
        nxt["later"] = True
        outcomes[key] = nxt
    return {"v": 1, "outcomes": outcomes}


def prerequisite_case(state, token, adjacent, now_ms):
    """(case, why): met only for an ok younger than a day that no file change followed
    (and, adjacent, no other call)."""
    e = None if state is None else state["outcomes"].get(token)
    if e is None or not (now_ms - e["at"] < OUTCOME_STATE_TTL_MS) or e["at"] > now_ms:
        return ("none", None)
    if e["o"] == "failed":
        return ("failed", e.get("why"))
    if e["o"] == "unknown":
        return ("unknown", e.get("why"))
    if e.get("changed"):
        return ("changed", None)
    if adjacent and e.get("later"):
        return ("not_adjacent", None)
    return ("met", None)


def prerequisite_unmet_reason(first, then, case, why, harness):
    """The PREREQUISITE_UNMET reason for every case but met, byte for byte as every port words it."""
    head = then + " needs a passing " + first + " first; "
    if case == "none":
        return head + "none ran in this session"
    if case == "failed":
        return head + "the last " + first + " failed (" + (why if why is not None else "failed") + ")"
    if case == "unknown":
        return head + "the result of the last " + first + " could not be read; rerun the tests so their summary is visible"
    if case == "changed":
        return head + "files changed after the last passing " + first + "; rerun the tests"
    if case == "not_adjacent":
        return head + then + " must come directly after it, and another call came between"
    if case == "not_observable":
        return head + harness + " reports no tool results Intutic can read, so a passing run cannot be observed here"
    if case == "no_session":
        return head + harness + " sent no session id, so test results cannot be tied to this session"
    return ""


"""Scope and plan semantics, ported from the proxy so every surface answers
"is this change inside the scope?" and "is this run on its plan?" the same way
.

A transliteration of packages/shared-types/src/scopeMatch.ts; read that
module's docstring for each function's port of origin (detectors.rs,
sops.rs, manifest.rs). Every port runs
packages/shared-types/fixtures/scope-plan-vectors.json.

The bash hook gates emit this file after the phrase matcher's (phrases.py),
which is_file_write_call calls: imported here as a module, and found in the
emitting script's scope when it is not one. Otherwise the standard library
only, and no backtick or dollar-brace, which a TypeScript copy cannot hold.
"""

try:
    from .phrases import has_phrase, phrase_text
except (ImportError, KeyError):  # embedded in a bash gate (exec without __name__), beside the phrase matcher's source
    pass

PLAN_DEVIATION_TOLERANCE = 0.4
NARROWED_TO_NOTHING = "<none: workspace list disjoint from org ceiling>"

SCOPE_WRITE_TOOLS = ("write", "write_file", "writefile", "create_file", "createfile")
SCOPE_EDIT_TOOLS = ("edit", "edit_file", "editfile", "multiedit", "apply_patch", "str_replace", "notebookedit")
SCOPE_DELETE_TOOLS = ("delete_file", "deletefile", "remove_file", "rm_file")
SCOPE_MOVE_TOOLS = ("move_file", "movefile", "rename_file", "rename")
SCOPE_EDITOR_TOOLS = ("str_replace_editor", "text_editor", "texteditor", "str_replace_based_edit_tool")
SCOPE_PATH_KEYS = ("file_path", "filepath", "path", "filename", "target_file", "notebook_path")
SCOPE_COMMAND_KEYS = ("command", "cmd", "script")
SCOPE_SHELL_TOOLS = ("bash", "shell", "run_command", "runcommand", "execute_command", "run_shell_command",
                     "terminal", "execute", "exec")
SCOPE_READ_TOOLS = ("read", "readfile", "view", "cat", "open_file")
SCOPE_MOVE_FROM_KEYS = ("source", "source_path", "from", "old_path")
SCOPE_MOVE_TO_KEYS = ("destination", "destination_path", "to", "new_path")
SCOPE_TARGET_MAX_BYTES = 512
PLAN_EXEMPT_TOOLS = ("read", "readfile", "view", "cat", "open_file", "glob", "grep", "ls", "list_dir", "search",
                     "todowrite")
FILE_WRITE_SHELL_PHRASES = ("sed -i", "perl -i", "perl -pi", "git apply", "git am", "git checkout", "git switch",
                            "git restore", "git reset", "git merge", "git pull", "git rebase", "git cherry-pick",
                            "git revert", "git stash pop", "git stash apply", "patch -p")


def _ascii_lower(s):
    return "".join(chr(ord(c) + 32) if "A" <= c <= "Z" else c for c in s)


def _tool_is(name, group):
    lower = name.lower()
    return any(lower == t or lower.endswith(t) for t in group)


def _keyed(inp, keys):
    if not isinstance(inp, dict):
        return None
    for k in keys:
        v = inp.get(k)
        if isinstance(v, str) and v != "":
            return v
    return None


def _utf8_len(ch):
    cp = ord(ch)
    return 1 if cp < 0x80 else 2 if cp < 0x800 else 3 if cp < 0x10000 else 4


def _clip(s):
    total = 0
    for i, ch in enumerate(s):
        n = _utf8_len(ch)
        if total + n > SCOPE_TARGET_MAX_BYTES:
            return s[:i] + "…"
        total += n
    return s


def _norm_scope(s):
    t = s
    while t[:2] == "./":
        t = t[2:]
    t = t.lstrip("/").rstrip("/")
    return _ascii_lower(t)


def is_within_scope(target, scopes):
    """Segment-prefix match of target against scopes, ignoring ASCII case and leading ./ or /."""
    t = _norm_scope(target)
    for raw in scopes:
        s = _norm_scope(raw)
        if s == "" or t == s or t[:len(s) + 1] == s + "/":
            return True
    return False


def sop_applies_to_role(roles, role):
    if not roles:
        return True
    if role == "":
        return False
    return _ascii_lower(role) in roles


def collect_scope_paths(sops, role):
    """The path scope in force for role (sops.rs collect_scope_paths), org ceiling included."""
    workspace, org = [], []
    for s in sops:
        if not sop_applies_to_role(s["roles"], role):
            continue
        (org if s["scope"] == "org" else workspace).extend(s["scopePaths"])
    if not org:
        out = workspace
    elif not workspace:
        out = org
    else:
        out = [w for w in workspace if is_within_scope(w, org)] or [NARROWED_TO_NOTHING]
    return sorted(set(out))


def collect_plan_steps(sops, role):
    """The plan in force for role (sops.rs collect_plan_steps), org ceiling included."""
    workspace, org = [], []
    for s in sops:
        if not sop_applies_to_role(s["roles"], role):
            continue
        (org if s["scope"] == "org" else workspace).extend(s["planSteps"])
    if not org:
        return workspace
    if not workspace:
        return org
    allowed = {_ascii_lower(o) for o in org}
    return [w for w in workspace if _ascii_lower(w) in allowed] or [NARROWED_TO_NOTHING]


def plan_off_steps(sequence, plan_steps, tolerance):
    """{"offPlan", "ratio"}: the off-plan names, sorted and deduplicated, when their share is over tolerance."""
    if not plan_steps or not sequence:
        return {"offPlan": [], "ratio": 0}
    plan = {_ascii_lower(p) for p in plan_steps}
    off = [t for t in sequence if _ascii_lower(t) not in plan]
    if not off:
        return {"offPlan": [], "ratio": 0}
    ratio = len(off) / len(sequence)
    if ratio <= tolerance:
        return {"offPlan": [], "ratio": ratio}
    return {"offPlan": sorted(set(off)), "ratio": min(1, ratio)}


def change_targets(tool, inp):
    """The mutations one tool call makes, as the proxy's change manifest records them."""
    if _tool_is(tool, SCOPE_MOVE_TOOLS):
        src = _keyed(inp, SCOPE_MOVE_FROM_KEYS)
        dst = _keyed(inp, SCOPE_MOVE_TO_KEYS)
        if src is not None or dst is not None:
            return [{"op": "move", "target": _clip(t)} for t in (src, dst) if t is not None]
    op = None
    if _tool_is(tool, SCOPE_EDITOR_TOOLS):
        command = inp.get("command") if isinstance(inp, dict) else None
        command = _ascii_lower(command) if isinstance(command, str) else ""
        if command == "view":
            return []
        op = "write" if command == "create" else "edit"
    elif _tool_is(tool, SCOPE_WRITE_TOOLS):
        op = "write"
    elif _tool_is(tool, SCOPE_EDIT_TOOLS):
        op = "edit"
    elif _tool_is(tool, SCOPE_DELETE_TOOLS):
        op = "delete"
    if op is None:
        return []
    target = _keyed(inp, SCOPE_PATH_KEYS)
    return [] if target is None else [{"op": op, "target": _clip(target)}]


def _diff_path(raw, prefix):
    p = raw
    tab = p.find("\\t")
    if tab != -1:
        p = p[:tab]
    p = p.strip(" ")
    if len(p) >= 2 and p[0] == '"' and p[-1] == '"':
        p = p[1:-1]
    if p in ("/dev/null", ""):
        return None
    if prefix and p[:len(prefix)] == prefix:
        p = p[len(prefix):]
    return p or None


def diff_changed_paths(diff):
    """The paths a diff changes, in the order first seen, each once."""
    out = []

    def add(p):
        if p is not None and p not in out:
            out.append(p)

    for raw in diff.split("\\n"):
        line = raw[:-1] if raw.endswith("\\r") else raw
        if line[:11] == "diff --git ":
            rest = line[11:]
            if rest[:2] != "a/":
                continue
            first = rest.find(" b/")
            if first == -1:
                continue
            if rest.find(" b/", first + 1) == -1:
                add(_diff_path(rest[:first], "a/"))
                add(_diff_path(rest[first + 1:], "b/"))
            elif (len(rest) - 5) % 2 == 0:
                n = (len(rest) - 5) // 2
                a = rest[2:2 + n]
                if rest[2 + n:5 + n] == " b/" and rest[5 + n:] == a:
                    add(_diff_path(a, ""))
        elif line[:4] == "--- ":
            add(_diff_path(line[4:], "a/"))
        elif line[:4] == "+++ ":
            add(_diff_path(line[4:], "b/"))
        elif line[:12] == "rename from ":
            add(_diff_path(line[12:], ""))
        elif line[:10] == "rename to ":
            add(_diff_path(line[10:], ""))
    return out


def _normalise_path(p):
    parts = []
    for seg in p.split("/"):
        if seg in ("", "."):
            continue
        if seg == "..":
            if parts:
                parts.pop()
        else:
            parts.append(seg)
    return "/" + "/".join(parts)


def scope_relative_path(target, cwd, root):
    """target relative to the workspace root, or None when outside it, under ~, or unresolvable."""
    if target == "" or target[:1] == "~" or cwd[:1] != "/" or root[:1] != "/":
        return None
    absolute = _normalise_path(target if target[:1] == "/" else cwd + "/" + target)
    base = _normalise_path(root)
    if absolute == base:
        return ""
    head = "/" if base == "/" else base + "/"
    return absolute[len(head):] if absolute[:len(head)] == head else None


def is_plan_exempt_tool(tool):
    """Whether plan_approval: lets tool run before approval: a PLAN_EXEMPT_TOOLS name, bare or mcp__<server>__<name>."""
    lower = tool.lower()
    return any(lower == t or lower[-(len(t) + 2):] == "__" + t for t in PLAN_EXEMPT_TOOLS)


def is_file_write_call(tool, inp):
    """Whether the call changed files: a mutation, or a shell command with a FILE_WRITE_SHELL_PHRASES phrase."""
    if change_targets(tool, inp):
        return True
    if not _tool_is(tool, SCOPE_SHELL_TOOLS):
        return False
    command = _keyed(inp, SCOPE_COMMAND_KEYS)
    if command is None:
        return False
    words = phrase_text(command)
    return any(has_phrase(words, p) for p in FILE_WRITE_SHELL_PHRASES)


# The lane phrases rule_record.py names (lanes.ts LANE_PHRASES).
LANE_PHRASES = {"action:deploy":["git push","kubectl apply","kubectl rollout","helm upgrade","helm install","terraform apply","docker push","serverless deploy","fly deploy","vercel deploy","gcloud run deploy","aws deploy","aws s3 sync","eb deploy"],"action:publish":["npm publish","pnpm publish","yarn publish","cargo publish","twine upload","poetry publish","gem push","docker manifest push"],"action:release":["gh release create","git tag","npm version","cargo release","goreleaser release","semantic-release"],"action:db_write":["insert into","update ","delete from","drop table","drop database","drop schema","truncate ","alter table"],"action:http_post":["curl -x post","curl --request post","curl -d ","curl --data","wget --post","http post"],"action:run_tests":["npm test","npm run test","pnpm test","pnpm run test","yarn test","cargo test","go test","pytest","python -m pytest","vitest","jest","mocha","rspec","phpunit","make test","gradle test","mvn test","dotnet test","bazel test","tox"],"action:migrate":["prisma migrate deploy","prisma db push","alembic upgrade","alembic downgrade","rails db:migrate","rake db:migrate","manage.py migrate","flyway migrate","liquibase update","knex migrate:latest","sequelize db:migrate"],"action:prod_write":["--prod","rails_env=production","node_env=production","--context prod","--namespace production","-n production","--environment production","--stage prod"],"action:destroy":["terraform destroy","kubectl delete","helm uninstall","helm delete","drop table","drop database","drop schema","truncate ","aws s3 rb","aws s3 rm"],"action:force_push":["git push --force","git push -f"],"action:payment":["api.stripe.com/v1/charges","api.stripe.com/v1/payment_intents","api.stripe.com/v1/transfers","api.stripe.com/v1/payouts","api.stripe.com/v1/refunds","stripe charges create","stripe payment_intents create","stripe transfers create","stripe payouts create","api-m.paypal.com/v2/payments","api.paypal.com/v1/payments"]}

"""Rule records in the policy snapshot: the @rule record, its
fallback line, and how a gate that reads it decides a call (Tier R).

A transliteration of packages/shared-types/src/gateRuleRecord.ts (the
reader's half: the writers are the daemon, the CLI and the control plane).
A record is five tab-separated columns: @rule, the fallback line's id or
-, the kind, the rollout, and base64 of the canonical JSON of its
payload, {v, ref, sopTitle, ...kind fields}. A record that does not
decode leaves its fallback line in force, which refuses. Kinds:
requires_outcome (a qualified requires_before), scope_paths (under
scope_paths_mode: enforce) and plan_approval.

Every port runs packages/shared-types/fixtures/rule-record-vectors.json. The
bash hook gates emit this file after test_outcome.py, scope_match.py and the
lane phrases, whose names it uses: imported here as modules, and found in the
emitting script's scope when it is not one. Otherwise the standard library
only, and no backtick or dollar-brace, which a TypeScript copy cannot hold.
"""

import base64
import binascii
import json
import re

try:
    from .actions import LANE_PHRASES
    from .scope_match import (
        SCOPE_DELETE_TOOLS, SCOPE_EDIT_TOOLS, SCOPE_EDITOR_TOOLS, SCOPE_MOVE_TOOLS, SCOPE_SHELL_TOOLS,
        SCOPE_WRITE_TOOLS, change_targets, is_plan_exempt_tool, is_within_scope, scope_relative_path,
    )
    from .test_outcome import prerequisite_case, prerequisite_unmet_reason
except (ImportError, KeyError):  # embedded in a bash gate (exec without __name__), beside the sources it needs
    pass

RULE_RECORD_TAG = "@rule"
RULE_SNAPSHOT_FORMAT = 3
RULE_SOP_TITLE_MAX_CHARS = 80
RULE_SCOPE_PATHS_MAX = 64
RULE_SCOPE_PATH_MAX_CHARS = 512
GATE_RULE_KINDS = ("requires_outcome", "scope_paths", "plan_approval")
V22_ACTION_TOKENS = ("action:deploy", "action:publish", "action:release", "action:db_write")

# The payload fields of each kind, sorted; the kind, fallback id and rollout are columns.
_FIELDS = {
    "requires_outcome": ["adjacent", "first", "qualifier", "ref", "sopTitle", "then", "v"],
    "scope_paths": ["ref", "scopePaths", "sopTitle", "v"],
    "plan_approval": ["mode", "ref", "sopTitle", "v"],
}
_REF = re.compile(r"^[^\\n\\r\\u2028\\u2029]+#([a-z_]+):([1-9][0-9]{0,5})\\Z")
_TOKEN = re.compile(r"^[A-Za-z][A-Za-z0-9_.:-]{0,63}\\Z")
_LINE_BREAK = re.compile(r"[\\t\\r\\n]")


def _from_base64(b64):
    """Standard base64 back to UTF-8 text; raises on anything but the canonical encoding."""
    raw = base64.b64decode(b64, validate=True)
    text = raw.decode("utf-8")
    if base64.b64encode(raw).decode("ascii") != b64:
        raise ValueError("not canonical base64")
    return text


def _text(v, max_chars, min_chars):
    return isinstance(v, str) and not _LINE_BREAK.search(v) and min_chars <= len(v) <= max_chars


def decode_gate_rule_record(line):
    """An @rule line as a record dict (payload fields plus kind, fallbackId and rollout), or None."""
    f = line.split("\\t")
    if len(f) != 5 or f[0] != RULE_RECORD_TAG or not f[4]:
        return None
    kind = f[2]
    if kind not in _FIELDS:
        return None
    try:
        r = json.loads(_from_base64(f[4]))
    except (ValueError, binascii.Error, UnicodeDecodeError):
        return None
    if not isinstance(r, dict) or sorted(r.keys()) != _FIELDS[kind]:
        return None
    if f[3] not in ("shadow", "enforce"):
        return None
    r = dict(r, kind=kind, fallbackId=None if f[1] == "-" else f[1], rollout=f[3])
    if r["v"] != 1 or isinstance(r["v"], bool):
        return None
    if not _text(r["sopTitle"], RULE_SOP_TITLE_MAX_CHARS, 0) or not isinstance(r["ref"], str):
        return None
    m = _REF.match(r["ref"])
    if not m or m.group(1) != kind:
        return None
    if r["rollout"] == "enforce":
        fid = r["fallbackId"]
        if not isinstance(fid, str) or not re.match(r"^" + kind + "-fallback:" + m.group(2) + r"@[0-9a-f]{12}\\Z", fid):
            return None
    elif r["fallbackId"] is not None:
        return None
    if kind == "requires_outcome":
        if r["first"] != "action:run_tests" or r["qualifier"] != "ok" or not isinstance(r["adjacent"], bool):
            return None
        if not isinstance(r["then"], str) or not _TOKEN.match(r["then"]) or r["then"] == "action:run_tests":
            return None
    elif kind == "scope_paths":
        paths = r["scopePaths"]
        if not isinstance(paths, list) or not 1 <= len(paths) <= RULE_SCOPE_PATHS_MAX:
            return None
        if any(not _text(p, RULE_SCOPE_PATH_MAX_CHARS, 1) for p in paths):
            return None
    elif r["mode"] not in ("required", "strict"):
        return None
    return r


def gate_rule_fallback_reason(kind, sop_title):
    if kind == "requires_outcome":
        return ("Qualified requires_before (" + sop_title + "): this gate cannot read test results, so the call "
                "it gates is refused; upgrade the Intutic gate")
    if kind == "scope_paths":
        return ("scope_paths_mode: enforce (" + sop_title + "): this gate cannot check a change against the "
                "scope, so every file change is refused; upgrade the Intutic gate")
    return ("plan_approval (" + sop_title + "): this gate cannot check plan approval, so every call is refused; "
            "upgrade the Intutic gate")


def _escape(s):
    return re.sub(r"([.*+?^(){}$|\\[\\]\\\\])", r"\\\\\\1", s)


def gate_rule_fallback(record):
    """The fallback line an older gate refuses with in the record's place, or None for a shadow record."""
    if record["fallbackId"] is None:
        return None
    base = {"id": record["fallbackId"], "severity": "block", "reason": gate_rule_fallback_reason(record["kind"], record["sopTitle"])}
    if record["kind"] == "plan_approval":
        return dict(base, subject="tool", source=" [^ ]+ ", ignoreCase=False)
    if record["kind"] == "scope_paths":
        tools = SCOPE_WRITE_TOOLS + SCOPE_EDIT_TOOLS + SCOPE_DELETE_TOOLS + SCOPE_MOVE_TOOLS + SCOPE_EDITOR_TOOLS
        return dict(base, subject="tool", source=" [^ ]*(" + "|".join(_escape(t) for t in tools) + ") ", ignoreCase=True)
    then = record["then"]
    if then in V22_ACTION_TOKENS:
        return dict(base, subject="action", source=" (" + _escape(then) + ") ", ignoreCase=True)
    if then.startswith("action:"):
        phrases = LANE_PHRASES.get(then) or []
        if phrases:
            return dict(base, subject="phrase", source="|".join(phrases), ignoreCase=True)
        return dict(base, subject="tool", source=" [^ ]*(" + "|".join(_escape(t) for t in SCOPE_SHELL_TOOLS) + ") ",
                    ignoreCase=True)
    return dict(base, subject="tool", source=" (" + _escape(then) + ") ", ignoreCase=False)


def gate_rule_plan_from_response(status, body):
    """The session's plan from GET /api/v1/plans/session/:id ({"status": approved|none|unavailable})."""
    if status == 404:
        return {"status": "none"}
    if status != 200 or not isinstance(body, dict):
        return {"status": "unavailable"}
    if body.get("lifecycleState") not in ("APPROVED", "EXECUTING"):
        return {"status": "none"}
    tools = []
    steps = body.get("steps")
    for step in steps if isinstance(steps, list) else []:
        if not isinstance(step, dict):
            continue
        tool = step.get("tool") if isinstance(step.get("tool"), str) else step.get("toolName")
        if isinstance(tool, str) and tool.strip() and tool.strip() not in tools:
            tools.append(tool.strip())
    return {"status": "approved", "tools": tools}


def _plan_finding(records, call):
    if not records or is_plan_exempt_tool(call["tool"]):
        return None
    rec = next((r for r in records if r["mode"] == "strict"), records[0])
    rule_id = "plan_approval." + rec["sopTitle"]
    scope = {"tools": [call["tool"]]}
    head = "plan_approval: " + rec["mode"] + " (" + rec["sopTitle"] + "): "
    if call["sessionId"] == "":
        return {"code": "PLAN_NOT_APPROVED", "ruleId": rule_id, "scope": scope, "ref": rec["ref"],
                "reason": head + call["harness"] + " sent no session id, so no approved plan can be found for this session"}
    plan = call["plan"]
    if plan["status"] != "approved":
        why = "this session has no approved plan" if plan["status"] == "none" else "the approved plans could not be read"
        return {"code": "PLAN_NOT_APPROVED", "ruleId": rule_id, "scope": scope, "ref": rec["ref"],
                "reason": head + why + "; get the plan approved, then retry"}
    if rec["mode"] == "strict":
        tool = call["tool"].lower()
        if not any(t.lower() == tool for t in plan["tools"]):
            return {"code": "OFF_PLAN", "ruleId": rule_id, "scope": scope, "ref": rec["ref"],
                    "reason": call["tool"] + " is not a step of this session's approved plan (plan_approval: strict, "
                    + rec["sopTitle"] + ")"}
    return None


def _requires_finding(records, call):
    tool = call["tool"].lower()
    for rec in records:
        if rec["then"] not in call["actions"] and rec["then"].lower() != tool:
            continue
        why = None
        if not call["observable"]:
            case = "not_observable"
        elif call["sessionId"] == "":
            case = "no_session"
        else:
            case, why = prerequisite_case(call["outcomes"], rec["first"], rec["adjacent"], call["nowMs"])
        if case == "met":
            continue
        return {
            "code": "PREREQUISITE_UNMET",
            "ruleId": "requires_before." + rec["first"] + "[ok]" + ("~>" if rec["adjacent"] else "->") + rec["then"],
            "reason": prerequisite_unmet_reason(rec["first"], rec["then"], case, why, call["harness"]),
            "scope": {"tools": [rec["then"]], "step": rec["first"]},
            "ref": rec["ref"],
        }
    return None


def _scope_finding(records, call):
    if not records:
        return None
    targets = change_targets(call["tool"], call["input"])
    if not targets:
        return None
    scopes = []
    for r in records:
        for p in r["scopePaths"]:
            if p not in scopes:
                scopes.append(p)
    outside = []
    for t in targets:
        rel = scope_relative_path(t["target"], call["cwd"], call["root"])
        if (rel is None or not is_within_scope(rel, scopes)) and t["target"] not in outside:
            outside.append(t["target"])
    if not outside:
        return None
    rec = records[0]
    return {
        "code": "OUT_OF_SCOPE",
        "ruleId": "scope_paths." + rec["sopTitle"],
        "reason": "Changes outside the declared file scope: " + ", ".join(outside) + " (scope: " + ", ".join(scopes) + ")",
        "scope": {"paths": outside},
        "ref": rec["ref"],
    }


def _findings(records, call):
    out = []
    for finding in (
        _plan_finding([r for r in records if r["kind"] == "plan_approval"], call),
        _requires_finding([r for r in records if r["kind"] == "requires_outcome"], call),
        _scope_finding([r for r in records if r["kind"] == "scope_paths"], call),
    ):
        if finding is not None:
            out.append(finding)
    return out


def evaluate_gate_rule_records(records, call):
    """Tier R: {"refusal": the first enforcing finding or None, "shadow": the shadow records' findings}.

    'call' carries tool, input, actions, cwd, root, sessionId, harness,
    outcomes (a state dict or None), observable, plan and nowMs, as in
    gateRuleRecord.ts GateRuleCall.
    """
    enforce = _findings([r for r in records if r["rollout"] == "enforce"], call)
    return {"refusal": enforce[0] if enforce else None,
            "shadow": _findings([r for r in records if r["rollout"] == "shadow"], call)}


"""What a refusal says about where to retry: its scope (paths,
tools, step, detector, rule) and its evidence (what the refuser saw),
bounded the same way on every surface.

A transliteration of packages/shared-types/src/refusalDetail.ts: each list
holds at most 8 items and each string at most 256 code points, with C0
control characters (U+0000 to U+001F) removed first; a string empty after
that is dropped, an empty list left out, and a scope with nothing left is
None. In an OPAQUE workspace both are dropped, and so is the stderr retry
line. Every port runs packages/shared-types/fixtures/refusal-detail-vectors.json.

Self-contained (the standard library only), so the bash hook gates can emit
it verbatim; no backtick or dollar-brace, which a TypeScript copy cannot hold.
"""

import re

REFUSAL_DETAIL_MAX_ITEMS = 8
REFUSAL_DETAIL_MAX_CHARS = 256
RETRY_SCOPE_PREFIX = "[Intutic] Retry scope: "

_C0 = re.compile("[\\u0000-\\u001f]")


def _detail_text(s):
    """s without C0 control characters, cut to 256 code points; None when nothing is left or it is not a string."""
    if not isinstance(s, str):
        return None
    clean = _C0.sub("", s)
    return clean[:REFUSAL_DETAIL_MAX_CHARS] if clean else None


def _detail_list(v):
    if not isinstance(v, list):
        return None
    out = []
    for item in v:
        if len(out) >= REFUSAL_DETAIL_MAX_ITEMS:
            break
        t = _detail_text(item)
        if t is not None:
            out.append(t)
    return out or None


def bound_refusal_scope(scope):
    """A scope bounded as the module says, keys in a fixed order; None when nothing is left."""
    if not isinstance(scope, dict):
        return None
    out = {}
    for key in ("paths", "tools"):
        v = _detail_list(scope.get(key))
        if v:
            out[key] = v
    for key in ("step", "detector", "rule"):
        v = _detail_text(scope.get(key))
        if v is not None:
            out[key] = v
    return out or None


def bound_refusal_evidence(evidence):
    """Evidence bounded: at most 8 items, each with a kind and a detail that survive bounding."""
    out = []
    if not isinstance(evidence, list):
        return out
    for item in evidence:
        if len(out) >= REFUSAL_DETAIL_MAX_ITEMS:
            break
        if not isinstance(item, dict):
            continue
        kind, detail = _detail_text(item.get("kind")), _detail_text(item.get("detail"))
        if kind is not None and detail is not None:
            out.append({"kind": kind, "detail": detail})
    return out


def refusal_detail_for_mode(mode, scope, evidence):
    """The detail a refusal carries in an intervention mode: nothing in OPAQUE, else the bounded scope and evidence."""
    if mode == "OPAQUE":
        return {}
    out = {}
    s = bound_refusal_scope(scope)
    if s:
        out["scope"] = s
    e = bound_refusal_evidence(evidence)
    if e:
        out["evidence"] = e
    return out


def retry_scope_line(mode, scope):
    """'[Intutic] Retry scope: <paths, else tools>', or None when neither, and in OPAQUE."""
    if mode == "OPAQUE":
        return None
    s = bound_refusal_scope(scope) or {}
    items = s.get("paths") or s.get("tools")
    return RETRY_SCOPE_PREFIX + ", ".join(items) if items else None


_INTUTIC_ACTION_NEEDLES = [["action:deploy",["git push","kubectl apply","kubectl rollout","helm upgrade","helm install","terraform apply","docker push","serverless deploy","fly deploy","vercel deploy","gcloud run deploy","aws deploy","aws s3 sync","eb deploy"]],["action:publish",["npm publish","pnpm publish","yarn publish","cargo publish","twine upload","poetry publish","gem push","docker manifest push"]],["action:release",["gh release create","git tag","npm version","cargo release","goreleaser release","semantic-release"]],["action:db_write",["insert into","update ","delete from","drop table","drop database","drop schema","truncate ","alter table"]],["action:run_tests",["npm test","npm run test","pnpm test","pnpm run test","yarn test","cargo test","go test","pytest","python -m pytest","vitest","jest","mocha","rspec","phpunit","make test","gradle test","mvn test","dotnet test","bazel test","tox"]],["action:http_post",["curl -x post","curl --request post","curl -d ","curl --data","wget --post","http post"]],["action:migrate",["prisma migrate deploy","prisma db push","alembic upgrade","alembic downgrade","rails db:migrate","rake db:migrate","manage.py migrate","flyway migrate","liquibase update","knex migrate:latest","sequelize db:migrate"]],["action:prod_write",["--prod","rails_env=production","node_env=production","--context prod","--namespace production","-n production","--environment production","--stage prod"]],["action:destroy",["terraform destroy","kubectl delete","helm uninstall","helm delete","drop table","drop database","drop schema","truncate ","aws s3 rb","aws s3 rm"]],["action:payment",["api.stripe.com/v1/charges","api.stripe.com/v1/payment_intents","api.stripe.com/v1/transfers","api.stripe.com/v1/payouts","api.stripe.com/v1/refunds","stripe charges create","stripe payment_intents create","stripe transfers create","stripe payouts create","api-m.paypal.com/v2/payments","api.paypal.com/v1/payments"]]]
_INTUTIC_ACTION_TOOLS = ["bash","shell","run_command","runcommand","execute_command","run_shell_command","terminal","execute","exec"]
_INTUTIC_FORCE_FLAGS = [" --force "," -f "]

_INTUTIC_RM_SEGMENT = re.compile(r"[;&|()\\n]")
_INTUTIC_RM_GAP = re.compile(r"[ \\t\\r\\f\\v]+")


def _intutic_removes_outside_tree(args):
    # removes_outside_tree (intutic_clawde actions.py, gate-js actions.ts):
    # rm -rf / -fr / -r -f / --recursive --force with a target that is
    # absolute, under ~, or contains "..". rm -rf build/ is not one.
    for segment in _INTUTIC_RM_SEGMENT.split(args):
        words = [w for w in _INTUTIC_RM_GAP.split(segment) if w != ""]
        at = next((i for i, w in enumerate(words) if w == "rm" or w.endswith("/rm")), -1)
        if at == -1:
            continue
        recursive = force = False
        flags = True
        targets = []
        for w in words[at + 1:]:
            if flags and w == "--":
                flags = False
            elif flags and w.startswith("--"):
                if w == "--recursive":
                    recursive = True
                if w == "--force":
                    force = True
            elif flags and w.startswith("-") and len(w) > 1:
                lower = w.lower()
                if "r" in lower:
                    recursive = True
                if "f" in lower:
                    force = True
            else:
                targets.append(w.strip("\\"'"))
        if recursive and force and any(t.startswith("/") or t.startswith("~") or ".." in t for t in targets):
            return True
    return False


def intutic_actions(tool, command):
    if str(tool or "").lower() not in _INTUTIC_ACTION_TOOLS:
        return " "
    words = phrase_text(command)
    out = " "
    for action, needles in _INTUTIC_ACTION_NEEDLES:
        if any(has_phrase(words, n) for n in needles):
            out += action + " "
    # A recursive, forced remove outside the working tree is destroy too
    # (Q3); no phrase can say "outside the tree", so it is a predicate.
    if " action:destroy " not in out and _intutic_removes_outside_tree(str(command or "")):
        out += "action:destroy "
    # The force-push compound: the git push phrase and a whole-word flag.
    if has_phrase(words, "git push"):
        padded = " " + " ".join(str(command or "").lower().split()) + " "
        if any(f in padded for f in _INTUTIC_FORCE_FLAGS):
            out += "action:force_push "
    return out


def _intutic_records(records_text, kind):
    out = []
    for line in str(records_text or "").split("\\n"):
        r = decode_gate_rule_record(line) if line else None
        if r is not None and r["kind"] == kind:
            out.append(r)
    return out


def intutic_rule_skip(records_text, kinds_csv):
    # The fallback line ids a decoded, enforcing record names, one per line,
    # for the kinds this gate evaluates. Any other fallback line stays.
    kinds = [k for k in str(kinds_csv).split(",") if k]
    out = []
    for line in str(records_text or "").split("\\n"):
        r = decode_gate_rule_record(line) if line else None
        if r is not None and r["fallbackId"] and r["kind"] in kinds:
            out.append(r["fallbackId"])
    return "\\n".join(out)


def _intutic_now_ms():
    import time
    return int(time.time() * 1000)


def _intutic_state_path(harness, session):
    import hashlib, os
    base = os.environ.get("INTUTIC_OUTCOME_STATE_DIR") or os.path.join(
        os.path.expanduser("~"), ".intutic", "hooks", "state", "outcomes")
    return os.path.join(base, outcome_state_file_name(str(harness), str(session),
                                                      lambda t: hashlib.sha256(t.encode("utf-8")).hexdigest()))


def _intutic_state_read(path):
    # (exists, state): a missing file is an empty state; one that does not
    # read is None, which leaves every qualified rule unmet.
    import os
    if not os.path.exists(path):
        return False, empty_outcome_state()
    try:
        with open(path, "r", encoding="utf-8") as fh:
            return True, parse_outcome_state(fh.read())
    except Exception:
        return True, None


def _intutic_state_write(path, state):
    import json, os
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        tmp = path + ".tmp." + str(os.getpid())
        with open(tmp, "w", encoding="utf-8") as fh:
            json.dump(state, fh, separators=(",", ":"))
        os.replace(tmp, path)
    except Exception:
        pass


def _intutic_verdict(r, code, rid, reason, scope):
    return "\\t".join(["block" if r["rollout"] == "enforce" else "shadow", code, rid, " ".join(reason.split()),
                      retry_scope_line("TRANSPARENT", scope) or ""])


def intutic_outcome_check(harness, observable, tool, actions, session, records_text, tool_input_json):
    import json
    try:
        ti = json.loads(tool_input_json or "{}")
    except ValueError:
        ti = {}
    recs = _intutic_records(records_text, "requires_outcome")
    path = _intutic_state_path(harness, session) if session else None
    exists, state = _intutic_state_read(path) if path else (False, empty_outcome_state())
    shadow = ""
    for r in recs:
        then = r["then"]
        if (" " + then + " ") not in str(actions) and then.lower() != str(tool).lower():
            continue
        why = None
        if observable != "1":
            case = "not_observable"
        elif not session:
            case = "no_session"
        else:
            case, why = prerequisite_case(state, r["first"], r["adjacent"], _intutic_now_ms())
        if case == "met":
            continue
        rid = "requires_before." + r["first"] + "[ok]" + ("~>" if r["adjacent"] else "->") + then
        line = _intutic_verdict(r, "PREREQUISITE_UNMET", rid, prerequisite_unmet_reason(r["first"], then, case, why, harness),
                                {"tools": [then], "step": r["first"]})
        if r["rollout"] == "enforce":
            return line
        shadow = shadow or line
    # Bookkeeping, on a call this tier lets through: no outcome is adjacent
    # to what comes next any more, and a call that changes files (a mutation
    # tool, or a shell write such as sed -i or git checkout) makes a pass
    # before it stale (Q1).
    if path and exists and state is not None:
        _intutic_state_write(path, note_completed_call(state, is_file_write_call(tool, ti)))
    return shadow


def intutic_post_record(harness, payload_text):
    # A post-tool payload: a shell call that ran tests records its outcome;
    # a file change marks an earlier [ok] stale. Never refuses.
    import json
    try:
        d = json.loads(payload_text or "{}")
    except ValueError:
        return ""
    if not isinstance(d, dict):
        return ""
    session = str(d.get("session_id") or d.get("sessionId") or "")
    if not session:
        return ""
    tool = str(d.get("tool_name") or d.get("toolName") or "")
    ti = d.get("tool_input") if isinstance(d.get("tool_input"), dict) else {}
    command = ""
    for k in ("command", "cmd", "script", "shell_command"):
        if isinstance(ti.get(k), str) and ti.get(k):
            command = ti[k]
            break
    actions = intutic_actions(tool, command)
    path = _intutic_state_path(harness, session)
    exists, state = _intutic_state_read(path)
    if " action:run_tests " in actions:
        resp = d.get("tool_response")
        output = ""
        if isinstance(resp, dict):
            v = resp.get("llmContent")
            output = v if isinstance(v, str) else json.dumps(v)
            # Gemini CLI prefixes the command's output with "Output: ".
            if output.startswith("Output: "):
                output = output[len("Output: "):]
        elif isinstance(resp, str):
            output = resp
        decision = decide_test_outcome({"exitCode": extract_exit_code(output), "output": output})
        _intutic_state_write(path, record_test_outcome(state if state is not None else empty_outcome_state(),
                                                       "action:run_tests", decision, _intutic_now_ms()))
    elif exists and state is not None and is_file_write_call(tool, ti):
        _intutic_state_write(path, note_completed_call(state, True))
    return ""


def _intutic_real(path):
    import os
    return os.path.realpath(path)


def _intutic_repo_root(cwd):
    import os
    d = _intutic_real(cwd or os.getcwd())
    while True:
        if os.path.exists(os.path.join(d, ".git")):
            return d
        parent = os.path.dirname(d)
        if parent == d:
            return _intutic_real(cwd or os.getcwd())
        d = parent


def _intutic_approved_plan(session, workspace_id):
    import hashlib, json, os, datetime
    path = os.environ.get("INTUTIC_APPROVED_PLANS") or os.path.join(
        os.path.expanduser("~"), ".intutic", "hooks", "approved-plans.jsonl")
    try:
        with open(path, "r", encoding="utf-8") as fh:
            lines = fh.read().split("\\n")
    except Exception:
        return None
    digest = ws = expires = ""
    body = []
    for line in lines:
        if line.startswith("#digest "):
            digest = line[8:].strip()
        elif line.startswith("#workspace "):
            ws = line[11:].strip()
        elif line.startswith("#expires "):
            expires = line[9:].strip()
        elif line and not line.startswith("#"):
            body.append(line)
    if hashlib.sha256("\\n".join(body).encode("utf-8")).hexdigest()[:32] != digest:
        return None
    if ws and workspace_id and ws != workspace_id:
        return None
    try:
        exp = datetime.datetime.fromisoformat(expires.replace("Z", "+00:00"))
    except Exception:
        return None
    if datetime.datetime.now(datetime.timezone.utc) >= exp:
        return None
    tools = None
    for line in body:
        try:
            e = json.loads(line)
        except ValueError:
            continue
        if not isinstance(e, dict) or e.get("sessionId") != session or e.get("state") not in ("APPROVED", "EXECUTING"):
            continue
        tools = (tools or []) + [str(t).lower() for t in (e.get("tools") or []) if isinstance(t, str)]
    return None if tools is None else {"tools": tools}


def intutic_trajectory_check(harness, tool, session, records_text, tool_input_json, payload_cwd, workspace_id):
    import json, os
    try:
        ti = json.loads(tool_input_json or "{}")
    except ValueError:
        ti = {}
    shadow = ""
    scopes = _intutic_records(records_text, "scope_paths")
    targets = [t["target"] for t in change_targets(tool, ti)] if scopes else []
    if targets:
        cwd = payload_cwd or os.getcwd()
        root = _intutic_repo_root(cwd)
        rels = []
        for t in targets:
            absolute = _intutic_real(os.path.join(_intutic_real(cwd), t))
            rel = os.path.relpath(absolute, root)
            rels.append((t, None if rel == ".." or rel.startswith(".." + os.sep) or os.path.isabs(rel) else rel.replace(os.sep, "/")))
        for rollout in ("enforce", "shadow"):
            group = [r for r in scopes if r["rollout"] == rollout]
            if not group:
                continue
            union = [s for r in group for s in r["scopePaths"]]
            bad = [t for t, rel in rels if rel is None or not is_within_scope(rel, union)]
            if bad:
                r = group[0]
                line = _intutic_verdict(r, "OUT_OF_SCOPE", "scope_paths." + r["sopTitle"],
                                        ", ".join(bad) + " is outside scope_paths (" + ", ".join(union) + ")", {"paths": bad})
                if rollout == "enforce":
                    return line
                shadow = shadow or line
    plans = _intutic_records(records_text, "plan_approval")
    if plans and not is_plan_exempt_tool(str(tool)):
        for rollout in ("enforce", "shadow"):
            group = [r for r in plans if r["rollout"] == rollout]
            if not group:
                continue
            strict = [r for r in group if r["mode"] == "strict"]
            r = strict[0] if strict else group[0]
            level = r["mode"]
            rid = "plan_approval." + r["sopTitle"]
            line = ""
            if not session:
                line = _intutic_verdict(r, "PLAN_NOT_APPROVED", rid, "plan_approval: " + level + " - " + harness + " sent no session id, so no approved plan can be found for this call", {"tools": [str(tool)]})
            else:
                plan = _intutic_approved_plan(session, workspace_id)
                if plan is None:
                    line = _intutic_verdict(r, "PLAN_NOT_APPROVED", rid, "plan_approval: " + level + " - this session has no APPROVED or EXECUTING plan; get its plan approved, then retry", {"tools": [str(tool)]})
                elif level == "strict" and str(tool).lower() not in plan["tools"]:
                    line = _intutic_verdict(r, "OFF_PLAN", rid, "plan_approval: strict - " + str(tool) + " is not a step of the approved plan", {"tools": [str(tool)]})
            if line and rollout == "enforce":
                return line
            shadow = shadow or line
    return shadow


def intutic_phrase_rule(source, command):
    words = phrase_text(command)
    return any(has_phrase(words, p, True) for p in source.split("|"))


def intutic_mcp_registry(record_b64, tool):
    # The registry decision for one mcp__<server>__<tool> call, from the
    # snapshot's @mcp_registry record: "code<TAB>ruleId<TAB>reason", or "" to
    # let the call continue.
    call = split_mcp_tool_name(tool)
    registry = decode_registry_record(MCP_REGISTRY_RECORD_TAG + "\\t" + record_b64)
    if call is None or registry is None:
        return ""
    refusal = evaluate_registry(registry, call[0], call[1])
    return "\\t".join(refusal) if refusal else ""


def intutic_mcp_unverified(tool):
    # The refusal of an mcp__<server>__<tool> call on a snapshot that failed
    # its integrity check, as "code<TAB>ruleId<TAB>reason"; "" for a call that
    # is not an MCP call.
    call = split_mcp_tool_name(tool)
    return "\\t".join(unverified_refusal(call[0])) if call else ""


"""Fault injection in the hook gates, for chaos runs (intutic chaos run).

A transliteration of packages/shared-types/src/chaosGate.ts; read that
module's docstring for the counter files and why every count lives on disk.
In short: a gate is a new process per tool call, so the plan is decoded on
each call, plan_loaded is reported by whichever gate first creates
EVENTS.gate-plan-loaded, and each fault's seen and hit counts are numbered
empty files in EVENTS.gate-counters/, each number claimed with an exclusive
create (O_CREAT | O_EXCL), which exactly one process wins. A permission fault
never sleeps: it holds the call as an approval hold does, in a
FAULT.held.KEY.G file whose modification time is when, and the identical
retry is held again until delay_s has passed, then allowed (delay) or denied
(hold_then_deny) by the one retry that creates FAULT.released.KEY.G.

The bash gates emit this file verbatim (services/sync-daemon/src/lib/chaosPy.ts
holds a byte-identical copy, which a test compares), intutic_clawde.gate's
Gate.guard runs it in process, and every copy runs
packages/shared-types/fixtures/chaos-gate-vectors.json. It must stay
self-contained: the standard library only, no module state beyond the
constants below, and no backtick or dollar-brace, which the TypeScript copy
cannot hold.
"""

import base64
import binascii
import datetime
import json
import os
import re
import sys
import time

_CHAOS_FAULT_IDS = (
    "llm.rate_limit", "llm.upstream_5xx", "llm.context_trim", "llm.model_degrade", "tool.error", "tool.stale_data",
    "mcp.toolset_change", "permission.deny_or_delay", "inject.tool_result", "egress.dns_fail", "egress.credential_401",
)
_CHAOS_B64URL = re.compile(r"^[A-Za-z0-9_-]+={0,2}$")
_CHAOS_RUN_ID = re.compile(r"^[A-Za-z0-9_-]{6,64}$")
_CHAOS_CANARY = re.compile(r"^E-INTUTIC-[0-9A-F]{4,16}$")


def _chaos_int(v, low, high):
    # JSON numbers as JavaScript reads them: 2.0 is the integer 2. A bool is not a number.
    if isinstance(v, bool) or not isinstance(v, (int, float)):
        return None
    if isinstance(v, float):
        if not v.is_integer():
            return None
        v = int(v)
    return v if low <= v <= high else None


def chaos_decode(raw):
    """(plan, None), or (None, why it is not one)."""
    def invalid(why):
        return None, "INTUTIC_CHAOS_PLAN is not a valid plan: " + why
    try:
        if not isinstance(raw, str) or not _CHAOS_B64URL.match(raw):
            raise ValueError("alphabet")
        b64 = raw.rstrip("=")
        data = json.loads(base64.urlsafe_b64decode(b64 + "=" * ((4 - len(b64) % 4) % 4)).decode("utf-8"))
    except (ValueError, binascii.Error, UnicodeDecodeError):
        return None, "INTUTIC_CHAOS_PLAN is not base64url-encoded JSON"
    if not isinstance(data, dict):
        return invalid("not a JSON object")
    v = data.get("v")
    if isinstance(v, bool) or v != 1:
        return invalid("version " + json.dumps(v) + ", and a gate reads only version 1")
    run_id = data.get("runId")
    if not isinstance(run_id, str) or not _CHAOS_RUN_ID.match(run_id):
        return invalid("runId")
    canary = data.get("canary")
    if not isinstance(canary, str) or not _CHAOS_CANARY.match(canary):
        return invalid("canary")
    raw_faults = data.get("faults")
    if not isinstance(raw_faults, list) or len(raw_faults) > 50:
        return invalid("faults")
    faults = []
    for i, f in enumerate(raw_faults):
        at = "faults[" + str(i) + "]"
        if not isinstance(f, dict) or not isinstance(f.get("id"), str) or f["id"] not in _CHAOS_FAULT_IDS:
            return invalid(at + ".id")
        if f["id"] not in ("tool.error", "permission.deny_or_delay"):
            continue
        match = None
        if "match" in f:
            if not isinstance(f["match"], dict):
                return invalid(at + ".match")
            for k, mv in f["match"].items():
                if k not in ("tool", "host", "model") or not isinstance(mv, str) or not mv:
                    return invalid(at + ".match." + k)
            match = f["match"]
        after_calls = 0
        if "after_calls" in f:
            after_calls = _chaos_int(f["after_calls"], 0, 10000)
            if after_calls is None:
                return invalid(at + ".after_calls")
        times = None
        if "times" in f:
            times = _chaos_int(f["times"], 1, 10000)
            if times is None:
                return invalid(at + ".times")
        fault = {
            "index": i, "id": f["id"], "match": match, "after_calls": after_calls, "times": times,
            "message": "tool failed", "mode": "deny", "delay_s": 0,
        }
        if f["id"] == "tool.error" and "message" in f:
            # Lengths in UTF-16 code units, as JavaScript counts them.
            m = f["message"]
            if not isinstance(m, str) or not 1 <= len(m.encode("utf-16-le", "surrogatepass")) // 2 <= 2000:
                return invalid(at + ".message")
            fault["message"] = m
        if f["id"] == "permission.deny_or_delay":
            if "mode" in f:
                if f["mode"] not in ("deny", "delay", "hold_then_deny"):
                    return invalid(at + ".mode")
                fault["mode"] = f["mode"]
            if "delay_s" in f:
                delay_s = _chaos_int(f["delay_s"], 0, 600)
                if delay_s is None:
                    return invalid(at + ".delay_s")
                fault["delay_s"] = delay_s
        faults.append(fault)
    return {"runId": run_id, "canary": canary, "faults": faults}, None


def chaos_matches(match, tool):
    """Whether a fault's match covers a gate call, which has a tool and nothing else."""
    if not match:
        return True
    if "host" in match or "model" in match:
        return False
    p = match.get("tool")
    if p is None:
        return True
    return tool.endswith(p[1:]) if p.startswith("*") else tool == p


def chaos_event(plan, type_, fields, now):
    """One events-file line: ts, runId, component, type, then the fields that are set."""
    event = {"ts": now, "runId": plan["runId"], "component": "gate", "type": type_}
    for k, v in fields:
        if v is not None:
            event[k] = v
    return json.dumps(event, separators=(",", ":"), ensure_ascii=False) + "\\n"


def chaos_append(events_path, lines):
    """Appends whole lines in one write. An I/O error is reported, never raised."""
    try:
        fd = os.open(events_path, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o644)
        try:
            os.write(fd, lines.encode("utf-8"))
        finally:
            os.close(fd)
    except OSError as e:
        sys.stderr.write("[Intutic Governance] chaos: could not append to " + events_path + ": " + str(e) + "\\n")


def chaos_claim(directory, prefix, limit):
    """Claims the next numbered file DIRECTORY/PREFIXn with an exclusive create.

    Returns n, 0 when every number up to limit is taken, or -1 on an I/O
    error, after saying so.
    """
    try:
        # Beside the events file, never creating its directory: the runner did.
        try:
            os.mkdir(directory)
        except FileExistsError:
            pass
        n = sum(1 for name in os.listdir(directory) if name.startswith(prefix)) + 1
        while limit is None or n <= limit:
            try:
                os.close(os.open(os.path.join(directory, prefix + str(n)), os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o644))
                return n
            except FileExistsError:
                n += 1
        return 0
    except OSError as e:
        sys.stderr.write("[Intutic Governance] chaos: could not count calls in " + directory + ": " + str(e) + "\\n")
        return -1


def chaos_open_hold(directory, fault, key):
    """The open hold of one fault on one call: (g, created), the number of
    the newest FAULT.held.KEY.G file with no released twin and its
    modification time in milliseconds; None when there is none or it cannot
    be read."""
    try:
        held = str(fault) + ".held." + key + "."
        names = os.listdir(directory)
        g = 0
        for name in names:
            if name.startswith(held) and name[len(held):].isdigit():
                g = max(g, int(name[len(held):]))
        if g == 0 or (str(fault) + ".released." + key + "." + str(g)) in names:
            return None
        # In whole milliseconds, as now is: a hold is never younger than the call that reads it.
        return g, os.stat(os.path.join(directory, held + str(g))).st_mtime_ns // 1000000
    except OSError:
        # No counters yet, or none readable: no hold to continue.
        return None


def chaos_release(directory, fault, key, g):
    """Ends hold g with an exclusive create: True for the one caller that does."""
    try:
        os.close(os.open(os.path.join(directory, str(fault) + ".released." + key + "." + str(g)),
                         os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o644))
        return True
    except OSError:
        # Another gate released it first, or it cannot be written.
        return False


def _chaos_ms(now):
    # The ISO-8601 time a call is decided at, in milliseconds; the clock if unreadable.
    try:
        return round(datetime.datetime.fromisoformat(now.replace("Z", "+00:00")).timestamp() * 1000)
    except (AttributeError, TypeError, ValueError):
        return int(time.time() * 1000)


def chaos_now():
    """The time as the JavaScript gates write it: <TIMESTAMP>."""
    return datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="milliseconds").replace("+00:00", "Z")


def chaos_call(plan, events_path, call, now):
    """Reports one call and returns the fault the gate must apply, or None.

    call: tool, decision (allow, deny, ask or hold, before any fault), ruleId,
    destructive, policyHit, and key: the call's digest in hex (its tool and
    input, as the gate keys an approval hold), which a held call's retry
    shares. The fault: faultId, kind (deny or hold) and reason, as
    chaosGateCall returns it. now is the ISO-8601 time, and the clock a hold
    is timed by.
    """
    lines = ""
    first = True
    try:
        os.close(os.open(events_path + ".gate-plan-loaded", os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o644))
    except FileExistsError:
        first = False
    except OSError:
        pass
    if first:
        lines += chaos_event(plan, "plan_loaded", [("faults", len(plan["faults"]))], now)
    lines += chaos_event(plan, "gate_decision", [
        ("tool", call["tool"]),
        ("decision", call["decision"]),
        ("ruleId", call.get("ruleId") or None),
        ("destructive", bool(call.get("destructive"))),
        ("policyHit", bool(call.get("policyHit"))),
    ], now)
    fault = None
    if call["decision"] == "allow":
        directory = events_path + ".gate-counters"
        key = re.sub(r"[^0-9A-Za-z]", "", str(call.get("key") or ""))[:128] or "call"
        now_ms = _chaos_ms(now)
        tag = " [" + plan["canary"] + "]"
        held = "Permission held for approval; retrying this exact call passes once it is approved" + tag
        # The retry of a held call: still held until the delay has passed,
        # then let through or denied by the one retry that releases it.
        retry = False
        for f in plan["faults"]:
            if f["id"] != "permission.deny_or_delay" or f["mode"] == "deny" or not chaos_matches(f["match"], call["tool"]):
                continue
            open_hold = chaos_open_hold(directory, f["index"], key)
            if open_hold is None:
                continue
            retry = True
            if f["delay_s"] > 0 and now_ms - open_hold[1] < f["delay_s"] * 1000:
                fault = {"faultId": f["id"], "kind": "hold", "reason": held}
            elif chaos_release(directory, f["index"], key, open_hold[0]):
                if f["mode"] == "hold_then_deny":
                    fault = {"faultId": f["id"], "kind": "deny",
                             "reason": "Permission held for approval, then denied by approver" + tag}
            else:
                # Another gate released it first: this call is a new one.
                retry = False
                continue
            break
        for f in plan["faults"] if not retry else ():
            if not chaos_matches(f["match"], call["tool"]):
                continue
            # An MCP tool's error is the MCP proxy's to inject; a gate injects the built-in side.
            if f["id"] == "tool.error" and call["tool"].startswith("mcp__"):
                continue
            seen = chaos_claim(directory, str(f["index"]) + ".seen.", None)
            if fault is not None or seen < 1 or seen <= f["after_calls"]:
                continue
            if f["times"] is not None and chaos_claim(directory, str(f["index"]) + ".hit.", f["times"]) < 1:
                continue
            if f["id"] == "tool.error":
                fault = {"faultId": f["id"], "kind": "deny", "reason": f["message"] + tag}
            elif f["mode"] == "deny":
                fault = {"faultId": f["id"], "kind": "deny", "reason": "Permission denied by approver" + tag}
            else:
                # Held from now: the hold's file is what its retries find.
                if chaos_claim(directory, str(f["index"]) + ".held." + key + ".", None) < 1:
                    continue
                fault = {"faultId": f["id"], "kind": "hold", "reason": held}
            lines += chaos_event(plan, "fault_injected", [("faultId", f["id"]), ("call", seen), ("target", call["tool"])], now)
        if fault is None or fault["kind"] == "hold":
            lines += chaos_event(plan, "tool_call", [("tool", call["tool"]), ("ok", fault is None)], now)
    chaos_append(events_path, lines)
    return fault



def intutic_chaos_begin():
    # Why the chaos run's plan cannot be used, or "" when it can.
    plan, error = chaos_decode(os.environ.get("INTUTIC_CHAOS_PLAN", ""))
    if error:
        return error
    if not os.environ.get("INTUTIC_CHAOS_EVENTS"):
        return "INTUTIC_CHAOS_PLAN is set but INTUTIC_CHAOS_EVENTS is not, so nothing the run does could be reported"
    return ""


def intutic_chaos_call(tool, decision, rule_id, destructive, policy_hit, key=""):
    # Records one call as the gate decided it, before any fault; returns the
    # fault to apply to an allowed call as "kind<TAB>reason" (kind deny or
    # hold), or "". key is the call's digest, which a held call's retry shares.
    plan, error = chaos_decode(os.environ.get("INTUTIC_CHAOS_PLAN", ""))
    events = os.environ.get("INTUTIC_CHAOS_EVENTS", "")
    if error or not events:
        return ""
    call = {"tool": tool, "decision": decision, "ruleId": rule_id or None,
            "destructive": destructive == "1", "policyHit": policy_hit == "1", "key": key}
    fault = chaos_call(plan, events, call, chaos_now())
    if fault is None:
        return ""
    return fault["kind"] + "\\t" + fault["reason"]


_INTUTIC_DECIDE_CODES = {
    "allow": (None,),
    "refuse": ("DECIDE_REFUSED", "DECIDE_ESCALATED", "GOVERNANCE_UNAVAILABLE"),
    "escalate": ("DECIDE_ESCALATED",),
}


def intutic_decide_check(harness, tool, budget_ms, session_id, enforce, tool_input_json):
    # The decide tier of a bash gate: \`intutic decide check --stdin\` on a call
    # an @decide record names. Returns outcome, code, rule id and reason,
    # joined by the unit separator (an empty field where there is none). A
    # missing CLI, a non-zero exit, a timeout or an answer that does not read
    # is unavailable: refused with GOVERNANCE_UNAVAILABLE when a matched
    # record is stamped enforce (enforce "1"), allowed, with the reason, when
    # every one is shadow. The CLI spends the budget, its own start included.
    import json, shutil, subprocess
    sep = chr(31)

    def clean(text):
        return " ".join(str(text).split())

    def unavailable(why):
        if enforce != "1":
            return sep.join(["allow", "", "", clean(why)])
        return sep.join(["refuse", "GOVERNANCE_UNAVAILABLE", "", clean("GOVERNANCE_UNAVAILABLE — " + why)])

    try:
        tool_input = json.loads(tool_input_json or "{}")
    except ValueError:
        tool_input = {}
    exe = shutil.which("intutic")
    if not exe:
        return unavailable("the decide rules on " + tool + " need the intutic CLI, which is not on PATH")
    payload = {"v": 1, "harness": harness, "tool": tool, "toolInput": tool_input, "cwd": os.getcwd(),
               "sessionId": session_id, "budgetMs": int(budget_ms), "lastUserTurn": None}
    try:
        done = subprocess.run([exe, "decide", "check", "--stdin"], input=json.dumps(payload), capture_output=True,
                              text=True, timeout=int(budget_ms) / 1000.0)
    except subprocess.TimeoutExpired:
        return unavailable("intutic decide check did not answer within " + str(budget_ms) + " ms")
    except OSError as err:
        return unavailable("intutic decide check could not run (" + type(err).__name__ + ")")
    if done.returncode != 0:
        return unavailable("intutic decide check exited " + str(done.returncode))
    try:
        out = json.loads(done.stdout)
    except ValueError:
        out = None
    rule_id = out.get("ruleId") if isinstance(out, dict) else None
    if (not isinstance(out, dict) or out.get("v") != 1 or out.get("outcome") not in _INTUTIC_DECIDE_CODES
            or out.get("code") not in _INTUTIC_DECIDE_CODES[out.get("outcome")]
            or not (rule_id is None or (isinstance(rule_id, str) and rule_id.startswith("decide.")))
            or not isinstance(out.get("reason", ""), str)):
        return unavailable("intutic decide check gave an answer this gate does not read")
    return sep.join([out["outcome"], out.get("code") or "", clean(rule_id or ""), clean(out.get("reason") or "")])

INTUTIC_PY_LIB_END
export INTUTIC_PY_LIB

INTUTIC_FIELDS="$(printf '%s' "$INPUT" | python3 -c '
import os, sys, json
def clean(v):
    return " ".join(str(v).split()) if isinstance(v, str) else ""
state = "ok"
try:
    d = json.load(sys.stdin)
except Exception:
    d = {}
    state = "malformed"
if not isinstance(d, dict):
    d = {}
    state = "malformed"
# The envelope check githubCopilotHooks established, applied to the bash
# family: a payload carrying none of the tool fields in any known spelling is
# one the gate cannot evaluate, and extracting empty fields from it would
# match no rule — an allow. Reported as a STATE and decided in the gate body,
# because log_event is not defined yet at extraction time.
if state == "ok" and not any(
    k in d for k in ("tool_name", "toolName", "tool_input", "toolInput")
):
    state = "malformed"
i = d.get("tool_input") or {}
if not isinstance(i, dict):
    i = {}
def first(*keys):
    for k in keys:
        v = i.get(k)
        if isinstance(v, str) and v:
            return clean(v)
    return ""
def raw_first(*keys):
    for k in keys:
        v = i.get(k)
        if isinstance(v, str) and v:
            return v
    return ""
raw_command = raw_first("command", "cmd", "script", "shell_command")
tool_input_json = json.dumps(i, separators=(",", ":"), ensure_ascii=False)
# Too large to evaluate inside the hook timeout (gateLimits.ts): the gate body
# refuses on this line, and the command and arguments are not passed on.
command_bytes = len(raw_command.encode("utf-8", "surrogatepass"))
argument_bytes = len(tool_input_json.encode("utf-8", "surrogatepass"))
too_large = ""
if command_bytes > 262144:
    too_large = "the command is %d bytes, over the 262144-byte limit a gate evaluates; split it into smaller commands" % command_bytes
elif argument_bytes > 1048576:
    too_large = "the tool arguments are %d bytes, over the 1048576-byte limit a gate evaluates; write the content in smaller parts" % argument_bytes
if too_large:
    raw_command = ""
    tool_input_json = "{}"
# The hold classifier reads the raw command: a line continuation or a comment
# is still in it. The library is the shared phrase matcher, not a regex.
lib = {}
try:
    exec(os.environ.get("INTUTIC_PY_LIB", ""), lib)
    actions = lib["intutic_actions"](d.get("tool_name", ""), raw_command) if not too_large else " "
except Exception:
    actions = " "
# The state line comes FIRST: the lines after it may legitimately be empty,
# and command substitution strips trailing newlines, so the last line is the
# only position an empty value cannot survive in.
print(state)
print(too_large)
print(clean(d.get("tool_name", "")))
print(first("path", "file_path", "notebook_path", "filePath"))
print("" if too_large else first("command", "cmd", "script", "shell_command"))
print(clean(d.get("session_id", d.get("sessionId", ""))))
print(actions)
# The raw command as one JSON line, for phrase-subject rules.
print(json.dumps(raw_command, ensure_ascii=False))
# The FULL tool_input, serialized to the exact shape argPattern rules are
# matched against everywhere: JSON.stringify(tool_input) — compact separators,
# insertion order, non-ASCII intact. The selected fields above are whitespace-
# collapsed for token matching; this one must NOT be, or a WHERE clause that
# spans a key/value boundary matches here and not in the JS gates. json.dumps
# escapes every newline, so it is still exactly one line to read back.
print(tool_input_json)
' 2>/dev/null || printf '\\n\\n\\n\\n\\n\\n\\n\\n\\n')"

# Each read is \`|| true\` because command substitution strips trailing newlines:
# a tool call with no command argument yields fewer lines than reads, so a late
# read hits EOF and returns non-zero. Under \`set -e\` that killed the gate with
# **exit 1** — which every harness reads as a hook error and lets the call
# through. A guard that fails open on the most ordinary input there is (a Write
# with no shell command) is worse than no guard, because it looks present.
{ IFS= read -r INTUTIC_EXTRACT_STATE || true; IFS= read -r INTUTIC_TOO_LARGE || true; IFS= read -r TOOL || true; IFS= read -r TARGET || true; IFS= read -r COMMAND || true; IFS= read -r SESSION_ID || true; IFS= read -r INTUTIC_ACTIONS || true; IFS= read -r INTUTIC_RAW_COMMAND_JSON || true; IFS= read -r TOOL_INPUT_JSON || true; } <<EOF_INTUTIC_FIELDS
$INTUTIC_FIELDS
EOF_INTUTIC_FIELDS
TOOL="\${TOOL:-}"; TARGET="\${TARGET:-}"; COMMAND="\${COMMAND:-}"; SESSION_ID="\${SESSION_ID:-}"
# Space-padded action tokens the extractor's classifier found, or " ".
INTUTIC_ACTIONS="\${INTUTIC_ACTIONS:- }"
# Why the call is too large to evaluate, or empty (gateLimits.ts).
INTUTIC_TOO_LARGE="\${INTUTIC_TOO_LARGE:-}"
INTUTIC_RAW_COMMAND_JSON="\${INTUTIC_RAW_COMMAND_JSON:-""}"
# Empty means the extractor itself died (the fallback printf above): treat it
# exactly like a payload the parser rejected. The gate body refuses on any
# value other than "ok" — see the envelope refusal in emitShellGate.
INTUTIC_EXTRACT_STATE="\${INTUTIC_EXTRACT_STATE:-}"
[ -n "$INTUTIC_EXTRACT_STATE" ] || INTUTIC_EXTRACT_STATE="malformed"
# Empty only when the extractor failed wholesale (malformed stdin). Defaulting
# to the empty OBJECT rather than the empty string keeps the argPattern match
# well-defined either way.
TOOL_INPUT_JSON="\${TOOL_INPUT_JSON:-}"
[ -n "$TOOL_INPUT_JSON" ] || TOOL_INPUT_JSON="{}"
# Aliases for the names the older writers used. Kept so this extractor is a
# drop-in for every bash gate; the canonical names are the unsuffixed ones.
TOOL_NAME="$TOOL"; TARGET_PATH="$TARGET"


HOOK_EVENTS_LOG="<ROOT>/.intutic/events/hook-events.jsonl"

# ── Runtime credentials (sourced from ~/.intutic/env/runtime.env) ────────────────────────
# These are defaults, and they are also the only thing standing between
# \`set -u\` and a fatal unbound-variable error: log_event reads all three, so on
# a machine with no runtime.env to source, an unset name kills the gate before
# it can exit 2. Spelling matters — INTUTIC_, never INTUITIC_.
RUNTIME_ENV="$HOME/.intutic/env/runtime.env"
INTUTIC_HOST=""
INTUTIC_API_KEY=""
INTUTIC_WORKSPACE_ID="ws_test"
[ -f "$RUNTIME_ENV" ] && source "$RUNTIME_ENV" 2>/dev/null || true

log_event() {
  local verdict="$1" tool="$2" reason="$3"
  # \`tool\` and \`reason\` carry agent-controlled text — the tool name, and the
  # target path quoted into the block reason — and both are spliced into the
  # JSON string below. Escape first: one unescaped quote yields a line
  # JSON.parse rejects, and drainHookEvents drops malformed lines then wipes the
  # log on a successful drain, so the record of a block is destroyed rather than
  # delayed. A crafted path could otherwise close the string and forge fields.
  tool="\${tool//\\\\/\\\\\\\\}";     tool="\${tool//\\"/\\\\\\"}"
  reason="\${reason//\\\\/\\\\\\\\}"; reason="\${reason//\\"/\\\\\\"}"
  # Every C0 control character, not just newline and carriage return. JSON
  # forbids all of U+0000-U+001F unescaped, so a plain TAB in a filename — no
  # adversary required — was still enough to produce a line JSON.parse rejects.
  # (NUL cannot appear in a bash variable, so the range starts at \\x01.)
  tool="\${tool//[$'\\x01'-$'\\x1f']/ }"; reason="\${reason//[$'\\x01'-$'\\x1f']/ }"
  # The workspace id is spliced into the same JSON string. It comes from
  # runtime.env on disk rather than from the agent, so it is lower risk — but a
  # value with a quote in it breaks every audit line the same way, and "lower
  # risk" is not "cannot happen" for a file the operator edits by hand.
  local ws="\${INTUTIC_WORKSPACE_ID}"
  ws="\${ws//\\\\/\\\\\\\\}"; ws="\${ws//\\"/\\\\\\"}"; ws="\${ws//[$'\\x01'-$'\\x1f']/ }"
  local ts; ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  local incident_id; incident_id="$(printf '%s' "\${ts}\${tool}\${INTUTIC_WORKSPACE_ID}" | sha1sum 2>/dev/null | cut -c1-16 || echo "$(date +%s)")"
  # The event's id: random, made once here, and resent with the line it is
  # written into, so the control plane processes the event once.
  local event_id; event_id="$(od -An -N16 -tx1 /dev/urandom 2>/dev/null | tr -d ' \\n' || true)"
  [ -n "$event_id" ] || event_id="$(date +%s)$$\${RANDOM}\${RANDOM}\${RANDOM}"
  local entry="{\\"event\\":\\"\${verdict}\\",\\"toolName\\":\\"\${tool}\\",\\"reason\\":\\"\${reason}\\",\\"workspaceId\\":\\"\${ws}\\",\\"harnessType\\":\\"goose\\",\\"timestamp\\":\\"\${ts}\\",\\"incidentId\\":\\"\${incident_id}\\",\\"eventId\\":\\"\${event_id}\\"}"
  # Path B: reliable file append
  printf '%s\\n' "$entry" >> "$HOOK_EVENTS_LOG" 2>/dev/null || true
  # Path A: fire-and-forget HTTP (non-blocking, near-real-time)
  if [ -n "$INTUTIC_API_KEY" ]; then
    curl -s -o /dev/null --max-time 3 -X POST \\
      -H "Content-Type: application/json" \\
      -H "Authorization: Bearer $INTUTIC_API_KEY" \\
      -d "{\\"events\\":[$entry]}" \\
      "\${INTUTIC_HOST}/api/v1/hook-events" & disown 2>/dev/null || true
  fi
}


# ── Intutic gate body v23 — harness: goose ────────────
# Generated by harness/gateBody.ts. Do not edit here; every harness regenerates.
#
# The harness name and version are stamped so this file identifies itself. Both
# were previously passed in and dropped on the floor: opts.harness was declared
# on the option type, supplied by all thirteen writers, and read nowhere.

# ── Post-tool outcome (gate body v23) ────────────────────────────────────────
# A post-tool invocation (--event post) records a test run's outcome for this
# session, or marks an earlier passing run stale after a file change, and
# always allows: the call has already run. Only where goose's post-tool
# payload was captured and carries an exit code (POST_TOOL_OBSERVABLE: 0).
if [ "\${INTUTIC_POST_MODE:-0}" = "1" ]; then
  if [ "0" = "1" ]; then
    python3 -c 'import os, sys
lib = {}
exec(os.environ.get("INTUTIC_PY_LIB", ""), lib)
sys.stdout.write(lib["intutic_post_record"](sys.argv[1], sys.stdin.read()))' 'goose' <<< "\${INPUT:-}" >/dev/null 2>&1 || true
  fi
  exit 0
fi

# ── Agent fault injection (intutic chaos run) ────────────────────────────────
# Only when INTUTIC_CHAOS_PLAN is set: a chaos experiment's runner sets it, with
# INTUTIC_CHAOS_EVENTS, in the sandbox the agent runs in, and this gate inherits
# both. The work is chaos.py in INTUTIC_PY_LIB, the transliteration of
# chaosGate.ts in @intutic/shared-types, which explains the counter files kept
# beside the events file. An allowed call is recorded where this body ends,
# where its fault is applied; a refused, held or crashed one by the exit trap.
# A fault applies only to an allowed call. Scoped to the bare invocation, like
# the envelope refusal below.
INTUTIC_CHAOS_ACTIVE=0
_intutic_chaos_done=0
_intutic_chaos_decision=deny
_intutic_chaos_rule=""
_intutic_chaos_hit=0
_intutic_chaos_destructive=0
# Records this call as decided ($1: allow, deny or hold) and prints the fault
# to apply to an allowed one, as kind and reason, tab-separated. $2 is the
# call's digest, which a held call's retry shares.
intutic_chaos_decide() {
  [ "$INTUTIC_CHAOS_ACTIVE" = "1" ] && [ "$_intutic_chaos_done" = "0" ] || return 0
  python3 -c 'import os, sys
lib = {}
exec(os.environ.get("INTUTIC_PY_LIB", ""), lib)
sys.stdout.write(lib["intutic_chaos_call"](*sys.argv[1:]))' "\${TOOL:-unknown}" "$1" "$_intutic_chaos_rule" "$_intutic_chaos_destructive" "$_intutic_chaos_hit" "\${2:-}" || true
}
# A rule fired without deciding the call (shadow, warn): its id, if none yet.
intutic_chaos_note() {
  [ -n "$_intutic_chaos_rule" ] || _intutic_chaos_rule="$1"
}
if [ -z "\${1:-}" ] && [ -n "\${INTUTIC_CHAOS_PLAN:-}" ]; then
  # A plan that is set but unreadable refuses, as an unreadable payload does:
  # an experiment run without the faults it asked for reports a resilience it
  # never measured.
  _intutic_chaos_err="$(python3 -c 'import os, sys
lib = {}
exec(os.environ.get("INTUTIC_PY_LIB", ""), lib)
sys.stdout.write(lib["intutic_chaos_begin"]())' 2>/dev/null || echo "INTUTIC_CHAOS_PLAN could not be read")"
  if [ -n "$_intutic_chaos_err" ]; then
    _intutic_chaos_err="\${_intutic_chaos_err} — refusing the call rather than running the experiment without the faults it asked for"
    echo "[Intutic Governance] BLOCKED: \${_intutic_chaos_err}" >&2
    log_event "tool_blocked" "\${TOOL:-unknown}" "\${_intutic_chaos_err}" || true
    exit 2
  fi
  INTUTIC_CHAOS_ACTIVE=1
fi

# Refuse an unreadable envelope before any rule is consulted.
#
# Unparseable stdin used to degrade to empty extracted fields, which match no
# rule — an ALLOW. Per each harness's contract this hook receives only
# PreToolUse events, so a payload from which neither a tool name nor a
# tool_input could be extracted is anomalous by definition: there is no such
# thing as a legitimate PreToolUse event with no tool call in it. Refusing is
# the posture githubCopilotHooks established for its Preview envelope, applied
# uniformly. INTUTIC_EXTRACT_STATE is set by SHELL_EXTRACT; the refusal lives
# here because log_event is not defined until after extraction runs.
#
# Scoped to the bare invocation: goose and openhands register post/stop
# invocations of this same script WITH arguments, and those events carry no
# tool call legitimately — refusing them would fail a hook that has nothing to
# gate. Every PreToolUse registration invokes the script with no arguments.
if [ -z "\${1:-}" ] && [ "\${INTUTIC_EXTRACT_STATE:-malformed}" != "ok" ]; then
  _intutic_env_reason="unrecognised PreToolUse payload — neither a tool name nor a tool_input could be extracted from stdin; refusing rather than allowing a call the gate cannot read"
  echo "[Intutic Governance] BLOCKED: \${_intutic_env_reason}" >&2
  log_event "tool_blocked" "unknown" "\${_intutic_env_reason}" || true
  exit 2
fi

# Refuse a call too large to evaluate inside the hook timeout, before any rule
# reads it (the extractor measured it; see gateLimits.ts). Scoped like the
# envelope refusal above: the post/stop invocations carry no call to gate.
if [ -z "\${1:-}" ] && [ -n "\${INTUTIC_TOO_LARGE:-}" ]; then
  echo "[Intutic Governance] BLOCKED: COMMAND_TOO_LARGE — \${INTUTIC_TOO_LARGE}" >&2
  log_event "tool_blocked" "\${TOOL:-unknown}" "COMMAND_TOO_LARGE — \${INTUTIC_TOO_LARGE}" || true
  exit 2
fi

# The static floor: compiled in, always enforced, never sourced from disk.
# These are the families with years of evidence behind them, so they block from
# the first run — before any sync has happened.
INTUTIC_FLOOR=(
  'bypass.chflags_nouchg	block	s	any	Governance bypass pattern: clearing the macOS immutable flag on a governance file	 chflags .*nouchg'
  'bypass.chattr_immutable	block	s	any	Governance bypass pattern: clearing the Linux immutable attribute on a governance file	 chattr .*-[a-zA-Z]*i'
  'bypass.chmod_governance	block	s	any	Governance bypass pattern: changing permissions on a governance file	 chmod .*(hooks|\\.intutic|\\.claude|\\.cursor)'
  'bypass.env_kill_switch	block	-	any	Governance bypass pattern: setting a harness environment variable that disables its hooks	 [A-Z][A-Z0-9_]*_HOOKS?='
  'hook_settings.vscode_key_written	block	-	content	Governance bypass pattern: setting chat.useHooks or chat.hookFilesLocations, which can switch off the GitHub Copilot governance hook. Change VS Code hook settings yourself, not through an agent.	chat\\.(useHooks|hookFilesLocations)(\\\\)?" *:'
  'hook_settings.vscode_key_command	block	-	command	Governance bypass pattern: a shell command naming chat.useHooks or chat.hookFilesLocations, which can switch off the GitHub Copilot governance hook. Change VS Code hook settings yourself, not through an agent.	chat\\.(useHooks|hookFilesLocations)'
  'secrets.aws_access_key	block	-	content	AWS access key ID detected in the content this call would write. Writing a live credential into a file is one commit away from shipping it; reference it from the environment instead.	(A3T[A-Z0-9]|AKIA|ASIA|ABIA|ACCA)[A-Z2-7][A-Z2-7][A-Z2-7][A-Z2-7][A-Z2-7][A-Z2-7][A-Z2-7][A-Z2-7][A-Z2-7][A-Z2-7][A-Z2-7][A-Z2-7][A-Z2-7][A-Z2-7][A-Z2-7][A-Z2-7]'
  'secrets.anthropic_api_key	block	-	content	Anthropic API key detected in the content this call would write. Writing a live credential into a file is one commit away from shipping it; reference it from the environment instead.	sk-ant-[A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-]*'
  'secrets.github_token	block	-	content	GitHub token detected in the content this call would write. Writing a live credential into a file is one commit away from shipping it; reference it from the environment instead.	gh[pousr]_[A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9]'
  'secrets.private_key_pem	block	-	content	PEM private key material detected in the content this call would write. Writing a live credential into a file is one commit away from shipping it; reference it from the environment instead.	-----BEGIN [A-Z ]*PRIVATE KEY-----'
  'secrets.openrouter_api_key	block	-	content	OpenRouter API key detected in the content this call would write. Writing a live credential into a file is one commit away from shipping it; reference it from the environment instead.	sk-or-v1-[A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9]*'
  'secrets.intutic_virtual_key	block	-	content	Intutic virtual key detected in the content this call would write. Writing a live credential into a file is one commit away from shipping it; reference it from the environment instead.	vk_[a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9]'
  'secrets.intutic_gateway_token	block	-	content	Intutic gateway token detected in the content this call would write. Writing a live credential into a file is one commit away from shipping it; reference it from the environment instead.	gwk_[a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9]'
  'secrets.stripe_secret_key	block	-	content	Stripe live secret key detected in the content this call would write. Writing a live credential into a file is one commit away from shipping it; reference it from the environment instead.	sk_live_[A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9]'
  'skill_surface.agents_skills_write	warn	-	target	Write or edit targets a .agents/skills/** skill file — advisory only, pending a false-positive measurement of scanSkillContent against real skill markdown	\\.agents/skills/'
  'skill_surface.claude_skills_write	warn	-	target	Write or edit targets a .claude/skills/** skill file — advisory only, pending a false-positive measurement of scanSkillContent against real skill markdown	\\.claude/skills/'
  'path.intutic_hooks	block	-	any	Shell command references the governance-protected path .intutic/hooks	\\.intutic/hooks'
  'path.intutic_integrity_json	block	-	any	Shell command references the governance-protected path .intutic/integrity.json	\\.intutic/integrity\\.json'
  'path.intutic_events	block	-	any	Shell command references the governance-protected path .intutic/events	\\.intutic/events'
  'path.intutic_env	block	-	any	Shell command references the governance-protected path .intutic/env	\\.intutic/env'
  'path.claude_settings_json	block	-	any	Shell command references the governance-protected path .claude/settings.json	\\.claude/settings\\.json'
  'path.claude_settings_local_json	block	-	any	Shell command references the governance-protected path .claude/settings.local.json	\\.claude/settings\\.local\\.json'
  'path.cursor_hooks_json	block	-	any	Shell command references the governance-protected path .cursor/hooks.json	\\.cursor/hooks\\.json'
  'path.etc_cursor_hooks_json	block	-	any	Shell command references the governance-protected path /etc/cursor/hooks.json	/etc/cursor/hooks\\.json'
  'path.Application_Support_Cursor_hooks_json	block	-	any	Shell command references the governance-protected path Application Support/Cursor/hooks.json	Application Support/Cursor/hooks\\.json'
  'path.ProgramData_backslash_Cursor_backslash_hooks_json	block	-	any	Shell command references the governance-protected path ProgramData\\Cursor\\hooks.json	ProgramData\\\\Cursor\\\\hooks\\.json'
  'path.ProgramData_Cursor_hooks_json	block	-	any	Shell command references the governance-protected path ProgramData/Cursor/hooks.json	ProgramData/Cursor/hooks\\.json'
  'path.clinerules_hooks	block	-	any	Shell command references the governance-protected path .clinerules/hooks	\\.clinerules/hooks'
  'path.codeium_windsurf_hooks_json	block	-	any	Shell command references the governance-protected path .codeium/windsurf/hooks.json	\\.codeium/windsurf/hooks\\.json'
  'path.codeium_hooks_json	block	-	any	Shell command references the governance-protected path .codeium/hooks.json	\\.codeium/hooks\\.json'
  'path.windsurf_hooks_json	block	-	any	Shell command references the governance-protected path .windsurf/hooks.json	\\.windsurf/hooks\\.json'
  'path.openhands_hooks_json	block	-	any	Shell command references the governance-protected path .openhands/hooks.json	\\.openhands/hooks\\.json'
  'path.gemini_settings_json	block	-	any	Shell command references the governance-protected path .gemini/settings.json	\\.gemini/settings\\.json'
  'path.gemini_config_hooks_json	block	-	any	Shell command references the governance-protected path .gemini/config/hooks.json	\\.gemini/config/hooks\\.json'
  'path.agents_hooks_json	block	-	any	Shell command references the governance-protected path .agents/hooks.json	\\.agents/hooks\\.json'
  'path.agents_plugins_intutic_governance	block	-	any	Shell command references the governance-protected path .agents/plugins/intutic-governance	\\.agents/plugins/intutic-governance'
  'path.muse_hooks_json	block	-	any	Shell command references the governance-protected path .muse/hooks.json	\\.muse/hooks\\.json'
  'path.config_muse_settings_json	block	-	any	Shell command references the governance-protected path .config/muse/settings.json	\\.config/muse/settings\\.json'
  'path.config_muse_intutic_managed_hooks_json	block	-	any	Shell command references the governance-protected path .config/muse/intutic-managed-hooks.json	\\.config/muse/intutic-managed-hooks\\.json'
  'path.grok_hooks	block	-	any	Shell command references the governance-protected path .grok/hooks	\\.grok/hooks'
  'path.grok_config_toml	block	-	any	Shell command references the governance-protected path .grok/config.toml	\\.grok/config\\.toml'
  'path.grok_trusted_folders_toml	block	-	any	Shell command references the governance-protected path .grok/trusted_folders.toml	\\.grok/trusted_folders\\.toml'
  'path.dsh_profiles	block	-	any	Shell command references the governance-protected path .dsh/profiles	\\.dsh/profiles'
  'path.dsh_cordis_patch_yml	block	-	any	Shell command references the governance-protected path .dsh/cordis.patch.yml	\\.dsh/cordis\\.patch\\.yml'
  'path.dsh_settings_yaml	block	-	any	Shell command references the governance-protected path .dsh/settings.yaml	\\.dsh/settings\\.yaml'
  'path.opencode_plugins	block	-	any	Shell command references the governance-protected path .opencode/plugins	\\.opencode/plugins'
  'path.opencode_plugin	block	-	any	Shell command references the governance-protected path .opencode/plugin	\\.opencode/plugin'
  'path.config_opencode_plugins	block	-	any	Shell command references the governance-protected path .config/opencode/plugins	\\.config/opencode/plugins'
  'path.pi_agent_extensions	block	-	any	Shell command references the governance-protected path .pi/agent/extensions	\\.pi/agent/extensions'
  'path.openclaw_openclaw_json	block	-	any	Shell command references the governance-protected path .openclaw/openclaw.json	\\.openclaw/openclaw\\.json'
  'path.pi_extensions	block	-	any	Shell command references the governance-protected path .pi/extensions	\\.pi/extensions'
  'path.codex_hooks_json	block	-	any	Shell command references the governance-protected path .codex/hooks.json	\\.codex/hooks\\.json'
  'path.codex_config_toml	block	-	any	Shell command references the governance-protected path .codex/config.toml	\\.codex/config\\.toml'
  'path.github_hooks_intutic_governance_json	block	-	any	Shell command references the governance-protected path .github/hooks/intutic-governance.json	\\.github/hooks/intutic-governance\\.json'
  'path.copilot_hooks_intutic_governance_json	block	-	any	Shell command references the governance-protected path .copilot/hooks/intutic-governance.json	\\.copilot/hooks/intutic-governance\\.json'
  'path.hermes_config_yaml	block	-	any	Shell command references the governance-protected path .hermes/config.yaml	\\.hermes/config\\.yaml'
  'path.config_goose_config_yaml	block	-	any	Shell command references the governance-protected path .config/goose/config.yaml	\\.config/goose/config\\.yaml'
  'path.open_webui_intutic_governance_filter_py	block	-	any	Shell command references the governance-protected path .open-webui/intutic-governance-filter.py	\\.open-webui/intutic-governance-filter\\.py'
)

# The dynamic tier, read from the policy snapshot. Additive only: it can turn an
# allow into a block, never a block into an allow. See policySnapshot.ts.
INTUTIC_SNAPSHOT_RULES="\${INTUTIC_SNAPSHOT_RULES:-$HOME/.intutic/hooks/policy-snapshot.rules}"
INTUTIC_SNAPSHOT_DIGEST="none"
INTUTIC_SNAPSHOT_STATE="absent"
INTUTIC_DYNAMIC=()

# A supported escape hatch, and the reason it exists is not politeness.
#
# The fastest workaround available to a developer wrongly blocked is
# \`chflags nouchg\` on the hook — the exact bypass the floor exists to stop. If
# the only way out is one we treat as an attack, we have manufactured our own
# adversary. So: an escape we can see, that disables the **dynamic tier only**.
# The floor is never disabled by it. Every invocation while it is set emits an
# event, so a machine running ungoverned is visible rather than quiet.
INTUTIC_GUARDS_DISABLED=0
if [ "\${INTUTIC_GUARD_DISABLE:-}" = "1" ]; then
  INTUTIC_GUARDS_DISABLED=1
  log_event "guards_disabled" "\${TOOL:-}" "INTUTIC_GUARD_DISABLE=1 — policy-snapshot rules skipped; built-in protections still active" || true
fi

INTUTIC_SNAPSHOT_WORKSPACE=""
INTUTIC_SNAPSHOT_GENERATED=""
# The per-server MCP allowlist (the @mcp_allowlist record, inside the digest).
# No record means the workspace set no list, and every server is allowed.
INTUTIC_MCP_ALLOWLIST=0
INTUTIC_MCP_SEVERITY=""
INTUTIC_MCP_SERVERS=""
# The MCP server registry record (base64 JSON, inside the digest).
INTUTIC_MCP_REGISTRY=""
# An OPAQUE workspace (the @intervention_mode record): a refusal on workspace
# policy tells the agent this sentence instead of the rule, and the audit line
# keeps the rule. Kept on a snapshot that fails its digest: it only ever hides
# text, never allows a call.
INTUTIC_OPAQUE=0
INTUTIC_OPAQUE_MESSAGE='Blocked by workspace policy. Ask a workspace admin if you need this action.'
# The snapshot format (the @format record; 1 without one), and the decide
# rules' @decide records, kept whole for the decide tier: this gate decodes
# none of them, the CLI does.
INTUTIC_SNAPSHOT_FORMAT=1
INTUTIC_DECIDE_RECORDS=()
# The @rule records (gate body v23), kept whole: the extractor's Python decodes
# them for the rule-record tiers below.
INTUTIC_RULE_RECORDS=()
if [ -f "$INTUTIC_SNAPSHOT_RULES" ]; then
  INTUTIC_SNAPSHOT_STATE="ok"
  while IFS= read -r _line || [ -n "$_line" ]; do
    case "$_line" in
      '#digest '*)      INTUTIC_SNAPSHOT_DIGEST="\${_line#\\#digest }" ;;
      '#workspace '*)   INTUTIC_SNAPSHOT_WORKSPACE="\${_line#\\#workspace }" ;;
      '#generated '*)   INTUTIC_SNAPSHOT_GENERATED="\${_line#\\#generated }" ;;
      '@mcp_allowlist'$'\\t'*)
        # Tag, severity and comma-joined servers, tab-separated — parameter
        # expansion only, no subshell. The writer drops a server name holding
        # whitespace or a comma, so neither separator can appear in one.
        INTUTIC_MCP_ALLOWLIST=1
        _intutic_mcp_rest="\${_line#*$'\\t'}"
        INTUTIC_MCP_SEVERITY="\${_intutic_mcp_rest%%$'\\t'*}"
        INTUTIC_MCP_SERVERS="\${_intutic_mcp_rest#*$'\\t'}"
        ;;
      '@mcp_registry'$'\\t'*) INTUTIC_MCP_REGISTRY="\${_line#*$'\\t'}" ;;
      '@intervention_mode'$'\\t''OPAQUE') INTUTIC_OPAQUE=1 ;;
      '@format'$'\\t'*)
        case "\${_line#*$'\\t'}" in ''|*[!0-9]*) : ;; *) INTUTIC_SNAPSHOT_FORMAT="\${_line#*$'\\t'}" ;; esac
        ;;
      '@decide'$'\\t'*) INTUTIC_DECIDE_RECORDS+=("$_line") ;;
      '@rule'$'\\t'*) INTUTIC_RULE_RECORDS+=("$_line") ;;
      '#'*|'') : ;;
      *) INTUTIC_DYNAMIC+=("$_line") ;;
    esac
  done < "$INTUTIC_SNAPSHOT_RULES"

  # A fallback line stands in for a decide rule a gate cannot evaluate. This
  # gate hands a decide rule to the CLI, which decodes its record and refuses
  # the call when it does not decode, so it skips the fallback line that an
  # @decide record of five columns names in its second. Any other line with
  # the prefix is enforced.
  if [ \${#INTUTIC_DECIDE_RECORDS[@]} -gt 0 ]; then
    _intutic_skip=$'\\n'
    for _rec in "\${INTUTIC_DECIDE_RECORDS[@]}"; do
      _intutic_tabs="\${_rec//[^$'\\t']/}"
      _intutic_fb="\${_rec#*$'\\t'}"
      _intutic_fb="\${_intutic_fb%%$'\\t'*}"
      if [ \${#_intutic_tabs} -eq 4 ] && [ -n "\${_rec##*$'\\t'}" ]; then
        case "$_intutic_fb" in 'decide-fallback:'*) _intutic_skip+="$_intutic_fb"$'\\n' ;; esac
      fi
    done
    _intutic_kept=()
    if [ \${#INTUTIC_DYNAMIC[@]} -gt 0 ]; then
      for _rec in "\${INTUTIC_DYNAMIC[@]}"; do
        case "$_intutic_skip" in *$'\\n'"\${_rec%%$'\\t'*}"$'\\n'*) continue ;; esac
        _intutic_kept+=("$_rec")
      done
    fi
    INTUTIC_DYNAMIC=()
    if [ \${#_intutic_kept[@]} -gt 0 ]; then INTUTIC_DYNAMIC=("\${_intutic_kept[@]}"); fi
  fi

  # A <kind>-fallback: line stands in for a rule record a gate cannot
  # evaluate. This gate evaluates requires_outcome,scope_paths,plan_approval, so it drops the fallback line a
  # decoded record of those kinds names. A python3 that cannot say keeps them all.
  if [ \${#INTUTIC_RULE_RECORDS[@]} -gt 0 ] && [ -n 'requires_outcome,scope_paths,plan_approval' ]; then
    _intutic_rskip="$(python3 -c 'import os, sys
lib = {}
exec(os.environ.get("INTUTIC_PY_LIB", ""), lib)
sys.stdout.write(lib["intutic_rule_skip"](sys.stdin.read(), sys.argv[1]))' 'requires_outcome,scope_paths,plan_approval' <<< "$(printf '%s\\n' "\${INTUTIC_RULE_RECORDS[@]}")" 2>/dev/null || true)"
    if [ -n "$_intutic_rskip" ] && [ \${#INTUTIC_DYNAMIC[@]} -gt 0 ]; then
      _intutic_rskip=$'\\n'"$_intutic_rskip"$'\\n'
      _intutic_kept=()
      for _rec in "\${INTUTIC_DYNAMIC[@]}"; do
        case "$_intutic_rskip" in *$'\\n'"\${_rec%%$'\\t'*}"$'\\n'*) continue ;; esac
        _intutic_kept+=("$_rec")
      done
      INTUTIC_DYNAMIC=()
      if [ \${#_intutic_kept[@]} -gt 0 ]; then INTUTIC_DYNAMIC=("\${_intutic_kept[@]}"); fi
    fi
  fi

  # A phrase rule that shares its id with an action rule is the partial form a
  # gate older than v23 holds by; this one holds by the action rule.
  if [ \${#INTUTIC_DYNAMIC[@]} -gt 0 ]; then
    _intutic_aids=$'\\n'
    for _rec in "\${INTUTIC_DYNAMIC[@]}"; do
      _r="\${_rec#*$'\\t'}"; _r="\${_r#*$'\\t'}"; _r="\${_r#*$'\\t'}"
      if [ "\${_r%%$'\\t'*}" = "action" ]; then _intutic_aids+="\${_rec%%$'\\t'*}"$'\\n'; fi
    done
    if [ "$_intutic_aids" != $'\\n' ]; then
      _intutic_kept=()
      for _rec in "\${INTUTIC_DYNAMIC[@]}"; do
        _r="\${_rec#*$'\\t'}"; _r="\${_r#*$'\\t'}"; _r="\${_r#*$'\\t'}"
        if [ "\${_r%%$'\\t'*}" = "phrase" ]; then
          case "$_intutic_aids" in *$'\\n'"\${_rec%%$'\\t'*}"$'\\n'*) continue ;; esac
        fi
        _intutic_kept+=("$_rec")
      done
      INTUTIC_DYNAMIC=()
      if [ \${#_intutic_kept[@]} -gt 0 ]; then INTUTIC_DYNAMIC=("\${_intutic_kept[@]}"); fi
    fi
  fi

  # Integrity, in the order that fails cheapest first.
  #
  # All three of these were parsed and then ignored. A digest nobody recomputes
  # is not integrity, it is a comment; and a workspace id nobody compares means a
  # snapshot from workspace A dropped onto workspace B's machine is enforced
  # verbatim, with B's audit events attributing A's rules to B.
  _intutic_body="$(grep -v '^#' "$INTUTIC_SNAPSHOT_RULES" | grep -v '^$' || true)"
  _intutic_actual=""
  if command -v shasum >/dev/null 2>&1; then
    _intutic_actual="$(printf '%s' "$_intutic_body" | shasum -a 256 | cut -c1-32)"
  elif command -v sha256sum >/dev/null 2>&1; then
    _intutic_actual="$(printf '%s' "$_intutic_body" | sha256sum | cut -c1-32)"
  fi

  if [ -n "$_intutic_actual" ] && [ "$_intutic_actual" != "$INTUTIC_SNAPSHOT_DIGEST" ]; then
    INTUTIC_SNAPSHOT_STATE="invalid"
  elif [ -n "$INTUTIC_SNAPSHOT_WORKSPACE" ] && [ -n "\${INTUTIC_WORKSPACE_ID:-}" ]        && [ "$INTUTIC_SNAPSHOT_WORKSPACE" != "$INTUTIC_WORKSPACE_ID" ]; then
    INTUTIC_SNAPSHOT_STATE="invalid"
  elif [ \${#INTUTIC_DYNAMIC[@]} -eq 0 ]; then
    # Distinct from "absent". The writer always ships the destructive tier, so a
    # rule-less snapshot means the compile produced nothing — a real fault that
    # otherwise looks exactly like a healthy quiet workspace.
    INTUTIC_SNAPSHOT_STATE="empty"
  fi

  # Degrade to the compiled floor. The dynamic tier is additive, so dropping it
  # returns to yesterday's behaviour rather than opening a hole.
  # The SSO-group refusals survive it: they only ever refuse, and dropping
  # them would make editing the member's group list in this file a way to
  # clear a tool the workspace's group policy refuses.
  if [ "$INTUTIC_SNAPSHOT_STATE" = "invalid" ]; then
    _intutic_kept=()
    if [ \${#INTUTIC_DYNAMIC[@]} -gt 0 ]; then
      for _rec in "\${INTUTIC_DYNAMIC[@]}"; do
        case "$_rec" in
          sso_group.*$'\\t'block$'\\t'*) _intutic_kept+=("$_rec") ;;
        esac
      done
    fi
    INTUTIC_DYNAMIC=()
    if [ \${#_intutic_kept[@]} -gt 0 ]; then INTUTIC_DYNAMIC=("\${_intutic_kept[@]}"); fi
    # Neither MCP record can be vouched for, and a deleted one looks like one
    # never set: the snapshot admits no MCP server (the refusal below).
    INTUTIC_MCP_REGISTRY=""
    INTUTIC_MCP_ALLOWLIST=0
    # The decide and rule records go with the rest of the dynamic tier.
    INTUTIC_DECIDE_RECORDS=()
    INTUTIC_RULE_RECORDS=()
  fi
fi

# Staleness governs alerting, not enforcement: rules stay in force. If they
# expired into permissiveness, "kill the daemon and wait" would be a supported
# way to disarm governance.
if [ "$INTUTIC_SNAPSHOT_STATE" = "ok" ] && [ -n "$INTUTIC_SNAPSHOT_GENERATED" ]; then
  _intutic_age_days="$(python3 -c 'import sys,datetime
try:
    t=datetime.datetime.fromisoformat(sys.argv[1].replace("Z","+00:00"))
    print(int((datetime.datetime.now(datetime.timezone.utc)-t).total_seconds()//86400))
except Exception:
    print(0)' "$INTUTIC_SNAPSHOT_GENERATED" 2>/dev/null || echo 0)"
  if [ "$_intutic_age_days" -gt 7 ] 2>/dev/null; then
    INTUTIC_SNAPSHOT_STATE="stale"
  fi
fi

case "$INTUTIC_SNAPSHOT_STATE" in
  absent)  log_event "snapshot_absent" "\${TOOL:-}" "No policy snapshot at $INTUTIC_SNAPSHOT_RULES — built-in protections only" || true ;;
  invalid) log_event "snapshot_invalid" "\${TOOL:-}" "Policy snapshot failed its digest or workspace check — dynamic rules dropped except SSO-group refusals, and every MCP call refused" || true ;;
  empty)   log_event "snapshot_empty" "\${TOOL:-}" "Policy snapshot contains no rules — the compile produced nothing" || true ;;
  stale)   log_event "snapshot_stale" "\${TOOL:-}" "Policy snapshot is \${_intutic_age_days} days old and still enforced" || true ;;
esac
if [ "$INTUTIC_SNAPSHOT_FORMAT" -gt 3 ]; then
  log_event "snapshot_format_newer" "\${TOOL:-}" "Policy snapshot format $INTUTIC_SNAPSHOT_FORMAT is newer than this gate reads (3) — records it does not know are skipped and their fallback lines enforced" || true
fi

# Normalise once; every pattern is written against this shape. The extractor
# hands each field over with its whitespace already collapsed to single spaces
# by Python, Unicode whitespace included, which bash cannot match; padding is
# all that is left to do. Bash substitutions over a 256 KiB command to find no
# whitespace left took most of a second on a loaded machine.
INTUTIC_NCOMMAND=" \${COMMAND:-} "
INTUTIC_NTARGET=" \${TARGET:-} "
INTUTIC_NTOOL=" \${TOOL:-} "

# ── Hold tier (gate body v8) ─────────────────────────────────────────────────
# A \`hold\` rule refuses the call and records it for a human; an exact,
# unexpired approved bypass the daemon cached lets the same call through once.
# All local — a file read, a file write and an exit code; no network on the
# tool path.
INTUTIC_REVIEW_REQUEST_FILE="\${INTUTIC_REVIEW_REQUESTS:-}"
if [ -z "$INTUTIC_REVIEW_REQUEST_FILE" ]; then
  INTUTIC_REVIEW_REQUEST_FILE='<ROOT>/.intutic/events/review-requests.jsonl'
fi
INTUTIC_APPROVED_BYPASSES="\${INTUTIC_APPROVED_BYPASSES:-$HOME/.intutic/hooks/approved-bypasses.jsonl}"
intutic_sha256() {
  if command -v shasum >/dev/null 2>&1; then shasum -a 256 | cut -c1-64
  elif command -v sha256sum >/dev/null 2>&1; then sha256sum | cut -c1-64
  else printf ''; fi
}
intutic_json_escape() {
  printf '%s' "$1" | sed -e 's/\\\\/\\\\\\\\/g' -e 's/"/\\\\"/g' | tr -d '\\n\\r\\t'
}
# What the agent reads of a refusal on workspace policy, in _intutic_shown: the
# reason ($1), or in an OPAQUE workspace the generic sentence. The audit line
# is always written with the full reason.
intutic_shown() {
  if [ "$INTUTIC_OPAQUE" = "1" ]; then _intutic_shown="$INTUTIC_OPAQUE_MESSAGE"; else _intutic_shown="$1"; fi
}
# Looks for a valid, unexpired, EXACT-match approved bypass. Prints nothing
# and returns 1 on ANY reason not to bypass: missing file, failed digest or
# workspace check, no matching line, or an entry whose expiresAt has passed —
# every one of which falls through to the hold. Key material is computed the
# same way the JS gate and the control plane compute it: the normalised tool
# name, and sha256(normalised command, NUL, normalised target).
intutic_bypass() {
  local rid="$1" tn="$2" th="$3" hdr_digest hdr_ws body actual now line exp
  [ -n "$th" ] || return 1
  [ -r "$INTUTIC_APPROVED_BYPASSES" ] || return 1
  hdr_digest="$(grep -m1 '^#digest ' "$INTUTIC_APPROVED_BYPASSES" | cut -d' ' -f2 || true)"
  hdr_ws="$(grep -m1 '^#workspace ' "$INTUTIC_APPROVED_BYPASSES" | cut -d' ' -f2 || true)"
  body="$(grep -v '^#' "$INTUTIC_APPROVED_BYPASSES" | grep -v '^$' || true)"
  [ -n "$body" ] || return 1
  actual="$(printf '%s' "$body" | intutic_sha256 | cut -c1-32)"
  [ -n "$actual" ] && [ "$actual" = "$hdr_digest" ] || return 1
  if [ -n "$hdr_ws" ] && [ "$hdr_ws" != "\${INTUTIC_WORKSPACE_ID:-}" ]; then return 1; fi
  now="$(date -u +%Y-%m-%dT%H:%M:%S)"
  while IFS= read -r line; do
    case "$line" in *'"workspaceId":"'"\${INTUTIC_WORKSPACE_ID:-}"'"'*) ;; *) continue ;; esac
    case "$line" in *'"sopRuleId":"'"$rid"'"'*) ;; *) continue ;; esac
    case "$line" in *'"toolNameNormalized":"'"$tn"'"'*) ;; *) continue ;; esac
    case "$line" in *'"targetHash":"'"$th"'"'*) ;; *) continue ;; esac
    exp="$(printf '%s' "$line" | sed -n 's/.*"expiresAt":"\\([^"]*\\)".*/\\1/p')"
    [ -n "$exp" ] || continue
    # ISO-8601 UTC timestamps compare lexically; a past expiry fails closed
    # toward the hold, however fresh the file is.
    if [[ "$exp" > "$now" ]]; then
      printf '%s' "$line"; return 0
    fi
  done <<< "$body"
  return 1
}
# Returns 0 when an approved bypass lets the call through (the caller
# continues), 2 when the call is held (the caller refuses).
intutic_hold() {
  local rid="$1" rreason="$2" tn th entry decided_by hold_id at file targeth hint
  tn="$INTUTIC_NTOOL"
  th="$( { printf '%s' "$INTUTIC_NCOMMAND"; printf '\\0'; printf '%s' "$INTUTIC_NTARGET"; } | intutic_sha256 )"
  if entry="$(intutic_bypass "$rid" "$tn" "$th")"; then
    decided_by="$(printf '%s' "$entry" | sed -n 's/.*"decidedBy":"\\([^"]*\\)".*/\\1/p')"
    hold_id="$(printf '%s' "$entry" | sed -n 's/.*"holdId":"\\([^"]*\\)".*/\\1/p')"
    echo "[Intutic Guardrail] BYPASSED: Approved bypass for \${rid} — approved by \${decided_by} on hold \${hold_id}" >&2
    log_event "hold_approved_bypass_used" "\${TOOL:-}" "Approved bypass for \${rid} — approved by \${decided_by} on hold \${hold_id}" || true
    return 0
  fi
  hold_id="hold_$(printf '%x' "$(date +%s)")_$(printf '%04x%04x' "$RANDOM" "$RANDOM")"
  at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  targeth=""
  [ -n "$th" ] && targeth="$(printf ',"targetHash":"%s"' "$th")"
  file="$INTUTIC_REVIEW_REQUEST_FILE"
  # The hold still blocks even if the record cannot be written — the exit code
  # is what stops the tool. But say so: a hold nobody can review is the worst
  # of both outcomes.
  if ! { mkdir -p "$(dirname "$file")" 2>/dev/null && printf '{"v":1,"holdId":"%s","reason":"%s","tool":"%s","sessionId":"%s","workspaceId":"%s","at":"%s","toolNameNormalized":"%s"%s}\\n' \\
      "$hold_id" "$(intutic_json_escape "$rid")" "$(intutic_json_escape "\${TOOL:-}")" "$(intutic_json_escape "\${SESSION_ID:-}")" \\
      "$(intutic_json_escape "\${INTUTIC_WORKSPACE_ID:-}")" "$at" "$(intutic_json_escape "$tn")" "$targeth" >> "$file" 2>/dev/null; }; then
    echo "[Intutic Guardrail] could not record the hold at \${file}" >&2
  fi
  # Who may approve, and when the retry passes (holdMessages.ts in shared-types).
  hint='An Owner, Admin or EM can approve it with: intutic decision approve {holdId} (or reject it: intutic decision reject {holdId}). Retrying this exact call passes after approval only if the workspace has turned on the review-hold bypass; otherwise it is held again.'
  hint="\${hint//\\{holdId\\}/$hold_id}"
  intutic_shown "\${rreason} [\${rid}]"
  echo "[Intutic Guardrail] HELD: \${_intutic_shown} \${hint}" >&2
  log_event "tool_held" "\${TOOL:-}" "\${rreason} [\${rid}]" || true
  return 2
}

# A rule declares which part of the call it matches. \`any\` means command and
# target — never the tool name, because a pattern like \`\\.claude/settings\\.json\`
# would otherwise be tested against "Write" and quietly match nothing.
#
# Whether a rule fires on this call sets _intutic_fires to 1 or 0; the function
# always returns 0, so it runs under set -e like the rest of the gate. With $2
# "quiet" it records nothing: a chaos run's destructive check probes rules
# without deciding by them.
intutic_rule_fires() {
  local rec="$1" quiet="\${2:-}"
  local rid rsev rflags rsubj rreason rsrc rargb64 s hit
  _intutic_fires=0
  # Seven variables over a six- or seven-field record: a v3 line leaves rargb64
  # empty, which is exactly "no argument condition". The base64 column cannot
  # contain a tab, so the last variable never absorbs a separator.
  IFS=$'\\t' read -r rid rsev rflags rsubj rreason rsrc rargb64 <<< "$rec"
  [ -z "$rsrc" ] && return 0
  local _subs=() _ci=
  case "$rflags" in *i*) _ci=i ;; esac
  # A subject the screen below cleared for this case is left out: no pattern
  # matched it, this rule's included.
  case "$rsubj" in
    tool)    intutic_unscreened tool "$_ci" && _subs=("$INTUTIC_NTOOL") ;;
    command) intutic_unscreened command "$_ci" && _subs=("$INTUTIC_NCOMMAND") ;;
    target)  intutic_unscreened target "$_ci" && _subs=("$INTUTIC_NTARGET") ;;
    # Serialized tool input, un-normalised — same subject the WHERE argPattern
    # machinery matches. The secrets.* floor rules ride this. Guaranteed
    # non-empty by the extractor (it defaults to "{}").
    content) intutic_unscreened content "$_ci" && _subs=("$TOOL_INPUT_JSON") ;;
    # The space-padded action tokens the extractor's classifier derived from
    # the raw command (" action:deploy "), so a hold on \`action:deploy\`
    # matches whole tokens.
    action)  intutic_unscreened action "$_ci" && _subs=("$INTUTIC_ACTIONS") ;;
    # The source is |-separated phrases matched as words against the raw
    # command by the phrase matcher in Python, not a regex: grep is linear,
    # but the gap between the words was not expressible without one that
    # backtracks in the other gates. One python3 run, only for these rules.
    # The command goes in on stdin: as an argument, a long one would exceed
    # the kernel's per-argument limit and the rule would silently not run.
    phrase)
      if python3 -c 'import os, sys, json
lib = {}
exec(os.environ.get("INTUTIC_PY_LIB", ""), lib)
sys.exit(0 if lib["intutic_phrase_rule"](sys.argv[1], json.load(sys.stdin)) else 1)' "$rsrc" <<< "$INTUTIC_RAW_COMMAND_JSON" 2>/dev/null; then
        _subs=("$INTUTIC_NCOMMAND")
      else
        return 0
      fi
      ;;
    # Each field is tested separately rather than concatenated. Joining them
    # lets a pattern match across the seam — a command ending in "chflags" and
    # an unrelated target starting with "nouchg" would trip the bypass rule
    # together while neither does alone.
    *)
      intutic_unscreened command "$_ci" && _subs+=("$INTUTIC_NCOMMAND")
      intutic_unscreened target "$_ci" && _subs+=("$INTUTIC_NTARGET")
      ;;
  esac
  [ \${#_subs[@]} -gt 0 ] || return 0
  hit=0
  [ "$rsubj" = "phrase" ] && hit=1
  for s in "\${_subs[@]}"; do
    [ "$rsubj" = "phrase" ] && break
    # Flags: i = case-insensitive; s (a sequence rule) changes nothing here —
    # grep matches with an automaton, linear in the text, so the regex runs
    # as written.
    case "$rflags" in
      *i*) printf '%s' "$s" | grep -qiE -- "$rsrc" && hit=1 ;;
      *)   printf '%s' "$s" | grep -qE -- "$rsrc" && hit=1 ;;
    esac
  done
  [ "$hit" = "1" ] || return 0
  # The argument condition of a WHERE rule. The tool-name half has matched; the
  # rule fires only if the argPattern also matches the serialized tool input —
  # the same json.dumps(tool_input, separators=(",",":"), ensure_ascii=False)
  # shape matchSopRule and the intutic-clawde gate port pin, produced once by
  # the extractor above. Evaluated by python3 re, not grep: these patterns are
  # authored as JS regexes and routinely use lookahead, which no grep has.
  # Fail-safe direction: a pattern python cannot compile (exit 2) downgrades
  # THIS rule to name-only — today's behaviour, plus a rule_downgraded event —
  # rather than silently dropping the rule, which would fail open.
  if [ -n "$rargb64" ]; then
    _intutic_arg_rc=0
    python3 -c '
import sys, base64, re
try:
    pat = base64.b64decode(sys.argv[1], validate=True).decode("utf-8")
except Exception:
    sys.exit(2)
try:
    rx = re.compile(pat)
except re.error:
    sys.exit(2)
sys.exit(0 if rx.search(sys.argv[2]) else 1)
' "$rargb64" "\${TOOL_INPUT_JSON:-}" 2>/dev/null || _intutic_arg_rc=$?
    if [ "$_intutic_arg_rc" = "1" ]; then
      return 0
    elif [ "$_intutic_arg_rc" != "0" ] && [ -z "$quiet" ]; then
      log_event "rule_downgraded" "\${TOOL:-}" "argPattern for \${rid} did not compile in python re — rule enforced name-only" || true
    fi
  fi
  _intutic_fires=1
}

intutic_apply() {
  local rec="$1"
  local rid rsev rflags rsubj rreason rsrc rargb64
  IFS=$'\\t' read -r rid rsev rflags rsubj rreason rsrc rargb64 <<< "$rec"
  [ -z "$rsrc" ] && return 0
  # The escape hatch skips the DESTRUCTIVE family only. It is not a way to turn
  # off a workspace's own BLOCK: SOP rules — those are what the customer asked
  # for, and one environment variable disarming them would make the switch the
  # first thing an agent sets. Keyed on the rule-id family, which the snapshot
  # writer assigns: destructive.* versus sop.*
  if [ "$INTUTIC_GUARDS_DISABLED" = "1" ]; then
    case "$rid" in
      destructive.*) return 0 ;;
    esac
  fi
  # The tier order (gate body v23): every refusal first, the holds after the
  # rule records and the MCP checks. A hold is only ever decided on a call
  # nothing deterministic refused.
  case "\${_intutic_pass:-all}" in
    det) [ "$rsev" = "hold" ] && return 0 ;;
    hold) [ "$rsev" = "hold" ] || return 0 ;;
  esac
  intutic_rule_fires "$rec"
  [ "$_intutic_fires" = "1" ] || return 0
  if [ "$rsev" = "shadow" ]; then
    intutic_chaos_note "$rid"
    log_event "tool_would_block" "\${TOOL:-}" "\${rreason} [\${rid}]" || true
    return 0
  fi
  if [ "$rsev" = "hold" ]; then
    # Not a permanent denial: the action is legitimate, someone asked to see
    # it first. A bypass they approved lets this exact call through once.
    _intutic_chaos_rule="$rid"; _intutic_chaos_hit=1
    if intutic_hold "$rid" "$rreason"; then return 0; fi
    _intutic_chaos_decision=hold
    exit 2
  fi
  if [ "$rsev" = "warn" ]; then
    # Advisory tier: allowed, and recorded with enough shape to triage.
    #
    # The rule id alone was not enough. The warn tier exists to earn promotion to
    # block from a measured false-positive rate, and you cannot call a flag true
    # or false without seeing something of what was run. So: the first token of
    # the command, and nothing else. That is the verb — curl, git, rm — which is
    # what distinguishes "a real destructive command" from "a false positive on a
    # build script", and it carries no paths, no arguments, no secrets. The full
    # command stays out deliberately; that is what DLP exists to keep out of
    # telemetry.
    _intutic_verb="\${INTUTIC_NCOMMAND# }"
    _intutic_verb="\${_intutic_verb%% *}"
    intutic_chaos_note "$rid"
    log_event "tool_flagged" "\${TOOL:-}" "\${rreason} [\${rid}] verb=\${_intutic_verb}" || true
    return 0
  fi
  # The rule's own reason, not a generic one: hookEvents.resolveSeverity reads
  # this text for "governance-protected" to file the incident CRITICAL.
  local reason="\${rreason} [\${rid}]"
  _intutic_chaos_rule="$rid"; _intutic_chaos_hit=1
  intutic_shown "$reason"
  echo "[Intutic Governance] BLOCKED: \${_intutic_shown}" >&2
  log_event "tool_blocked" "\${TOOL:-}" "\${reason}"
  exit 2
}

# ── Screening ────────────────────────────────────────────────────────────────
# Rule by rule, the gate forks a grep per rule and subject: about a hundred on
# every call, which on a loaded machine took seconds before any rule could
# match. So each subject is first screened by one grep holding every pattern
# that tests it, the case-insensitive ones apart. A subject none of them
# matches is left out of every rule that tests it, since no one of them could
# match it either. A screen that matches, or one grep cannot run (exit 2),
# clears nothing, and the rules decide as before: the screen saves work and
# never changes a verdict. grep is still the engine, so the screen is linear too.
_intutic_screen_tool=(); _intutic_screen_tooli=(); _intutic_clear_tool=; _intutic_clear_tooli=
_intutic_screen_command=(); _intutic_screen_commandi=(); _intutic_clear_command=; _intutic_clear_commandi=
_intutic_screen_target=(); _intutic_screen_targeti=(); _intutic_clear_target=; _intutic_clear_targeti=
_intutic_screen_content=(); _intutic_screen_contenti=(); _intutic_clear_content=; _intutic_clear_contenti=
_intutic_screen_action=(); _intutic_screen_actioni=(); _intutic_clear_action=; _intutic_clear_actioni=
intutic_screen_add() {
  case "$1$2" in
    tool) _intutic_screen_tool+=(-e "$3") ;;
    tooli) _intutic_screen_tooli+=(-e "$3") ;;
    command) _intutic_screen_command+=(-e "$3") ;;
    commandi) _intutic_screen_commandi+=(-e "$3") ;;
    target) _intutic_screen_target+=(-e "$3") ;;
    targeti) _intutic_screen_targeti+=(-e "$3") ;;
    content) _intutic_screen_content+=(-e "$3") ;;
    contenti) _intutic_screen_contenti+=(-e "$3") ;;
    action) _intutic_screen_action+=(-e "$3") ;;
    actioni) _intutic_screen_actioni+=(-e "$3") ;;
  esac
}
for _rec in "\${INTUTIC_FLOOR[@]}" \${INTUTIC_DYNAMIC[@]+"\${INTUTIC_DYNAMIC[@]}"}; do
  IFS=$'	' read -r _r_id _r_sev _r_flags _r_subj _r_reason _r_src _r_arg <<< "$_rec"
  [ -n "$_r_src" ] || continue
  _r_ci=
  case "$_r_flags" in *i*) _r_ci=i ;; esac
  case "$_r_subj" in
    tool|command|target|content|action) intutic_screen_add "$_r_subj" "$_r_ci" "$_r_src" ;;
    phrase) : ;;
    *) intutic_screen_add command "$_r_ci" "$_r_src"; intutic_screen_add target "$_r_ci" "$_r_src" ;;
  esac
done
# $1 subject, $2 "i" or empty, $3 its text, then the patterns as -e pairs.
intutic_screen() {
  local key="$1" ci="$2" text="$3" rc=0
  shift 3
  if [ "$ci" = "i" ]; then printf '%s' "$text" | grep -qiE "$@" || rc=$?
  else printf '%s' "$text" | grep -qE "$@" || rc=$?
  fi
  [ "$rc" != "1" ] || printf -v "_intutic_clear_$key$ci" '%s' 1
}
[ \${#_intutic_screen_tool[@]} -eq 0 ] || intutic_screen tool '' "$INTUTIC_NTOOL" "\${_intutic_screen_tool[@]}"
[ \${#_intutic_screen_tooli[@]} -eq 0 ] || intutic_screen tool i "$INTUTIC_NTOOL" "\${_intutic_screen_tooli[@]}"
[ \${#_intutic_screen_command[@]} -eq 0 ] || intutic_screen command '' "$INTUTIC_NCOMMAND" "\${_intutic_screen_command[@]}"
[ \${#_intutic_screen_commandi[@]} -eq 0 ] || intutic_screen command i "$INTUTIC_NCOMMAND" "\${_intutic_screen_commandi[@]}"
[ \${#_intutic_screen_target[@]} -eq 0 ] || intutic_screen target '' "$INTUTIC_NTARGET" "\${_intutic_screen_target[@]}"
[ \${#_intutic_screen_targeti[@]} -eq 0 ] || intutic_screen target i "$INTUTIC_NTARGET" "\${_intutic_screen_targeti[@]}"
[ \${#_intutic_screen_content[@]} -eq 0 ] || intutic_screen content '' "$TOOL_INPUT_JSON" "\${_intutic_screen_content[@]}"
[ \${#_intutic_screen_contenti[@]} -eq 0 ] || intutic_screen content i "$TOOL_INPUT_JSON" "\${_intutic_screen_contenti[@]}"
[ \${#_intutic_screen_action[@]} -eq 0 ] || intutic_screen action '' "$INTUTIC_ACTIONS" "\${_intutic_screen_action[@]}"
[ \${#_intutic_screen_actioni[@]} -eq 0 ] || intutic_screen action i "$INTUTIC_ACTIONS" "\${_intutic_screen_actioni[@]}"
# Whether rules testing subject $1, case $2, still need to: not when screened clear.
intutic_unscreened() {
  local v="_intutic_clear_$1$2"
  [ "\${!v:-}" != "1" ]
}

# A chaos run's no_destructive_attempt probe: whether a destructive.* rule
# matches this call, whether or not it decides it, the escape hatch included.
if [ "$INTUTIC_CHAOS_ACTIVE" = "1" ] && [ \${#INTUTIC_DYNAMIC[@]} -gt 0 ]; then
  for _rec in "\${INTUTIC_DYNAMIC[@]}"; do
    case "$_rec" in
      destructive.*)
        intutic_rule_fires "$_rec" quiet
        if [ "$_intutic_fires" = "1" ]; then _intutic_chaos_destructive=1; break; fi
        ;;
    esac
  done
fi

for _rec in "\${INTUTIC_FLOOR[@]}"; do
  intutic_apply "$_rec"
done

_intutic_pass=det
if [ \${#INTUTIC_DYNAMIC[@]} -gt 0 ]; then
  for _rec in "\${INTUTIC_DYNAMIC[@]}"; do
    intutic_apply "$_rec"
  done
fi

# ── Rule records (gate body v23) ─────────────────────────────────────────────
# A rule record's verdict, as the Python check returns it: verdict, code, rule
# id and reason, tab-separated; empty to continue. shadow records the finding;
# block refuses.
intutic_rule_verdict() {
  [ -n "$1" ] || return 0
  local verdict code rid reason retry
  IFS=$'	' read -r verdict code rid reason retry <<< "$1"
  if [ "$verdict" = "shadow" ]; then
    intutic_chaos_note "$rid"
    log_event "tool_would_block" "\${TOOL:-}" "\${reason} [\${rid}]" || true
    return 0
  fi
  _intutic_chaos_rule="$rid"; _intutic_chaos_hit=1
  intutic_shown "\${reason} [\${rid}]"
  echo "[Intutic Governance] BLOCKED: \${_intutic_shown} (refusal code \${code})" >&2
  # Where to retry: the paths or tools the refusal names. An
  # OPAQUE workspace drops it, as it drops the rule.
  if [ -n "$retry" ] && [ "$INTUTIC_OPAQUE" != "1" ]; then echo "$retry" >&2; fi
  log_event "tool_blocked" "\${TOOL:-}" "\${reason} [\${rid}]"
  exit 2
}
_intutic_rr_text=""
if [ \${#INTUTIC_RULE_RECORDS[@]} -gt 0 ]; then
  _intutic_rr_text="$(printf '%s
' "\${INTUTIC_RULE_RECORDS[@]}")"
fi
# requires_outcome: a call whose action token (or tool) a qualified
# requires_before gates is refused unless this session's last test run passed,
# and no file changed since (PREREQUISITE_UNMET). The check also keeps the
# session's state: a file change marks a passing run stale. A check that
# cannot run refuses.
case "$_intutic_rr_text" in
  *$'	'requires_outcome$'	'*)
    _intutic_rr="$(python3 -c 'import os, sys
lib = {}
exec(os.environ.get("INTUTIC_PY_LIB", ""), lib)
sys.stdout.write(lib["intutic_outcome_check"](*(sys.argv[1:7] + [sys.stdin.read()])))' 'goose' 0 "\${TOOL:-}" "\${INTUTIC_ACTIONS:- }" "\${SESSION_ID:-}" "$_intutic_rr_text" <<< "\${TOOL_INPUT_JSON:-}" 2>/dev/null || printf 'block	PREREQUISITE_UNMET	requires_before	the requires_before check could not run')"
    intutic_rule_verdict "$_intutic_rr"
    ;;
esac

# ── Unverified snapshot (gate body v17) ──────────────────────────────────────
# A snapshot that failed its digest or workspace check admits no MCP server:
# neither record in it can be vouched for, and a deleted one looks like one
# never set. Refused at block, in an observe-only workspace too, with the code,
# rule id and reason of mcpSnapshotUnverifiedRefusal (intutic_mcp_unverified
# in GATE_PY_LIB).
if [ "$INTUTIC_SNAPSHOT_STATE" = "invalid" ]; then
  case "\${TOOL:-}" in
    mcp__*__*)
      _intutic_unv="$(python3 -c 'import os, sys
lib = {}
exec(os.environ.get("INTUTIC_PY_LIB", ""), lib)
sys.stdout.write(lib["intutic_mcp_unverified"](sys.argv[1]))' "\${TOOL:-}" 2>/dev/null || true)"
      if [ -n "$_intutic_unv" ]; then
        IFS=$'\\t' read -r _ _intutic_unv_rid _intutic_unv_reason <<< "$_intutic_unv"
      else
        # python3 could not say why (it is required, and checked, before any
        # rule runs): still a refusal, never an allow.
        _intutic_unv_rid="policy_snapshot"
        _intutic_unv_reason="POLICY_SNAPSHOT_UNVERIFIED — the policy snapshot failed its integrity check and admits no MCP server"
      fi
      _intutic_chaos_rule="$_intutic_unv_rid"; _intutic_chaos_hit=1
      echo "[Intutic Governance] BLOCKED: \${_intutic_unv_reason} [\${_intutic_unv_rid}]" >&2
      log_event "tool_blocked" "\${TOOL:-}" "\${_intutic_unv_reason} [\${_intutic_unv_rid}]"
      exit 2
      ;;
  esac
fi

# ── MCP server registry backstop (gate body v14) ─────────────────────────────
# The workspace's registry decisions from the snapshot's @mcp_registry record,
# applied to every mcp__<server>__<tool> call: a blocked or held server, a
# server not approved under mcpDefaultPolicy deny, a disabled tool. The same
# decision, rule ids and reasons as the MCP proxy, so a server no proxy fronts
# is refused as one it fronts would be. Evaluated in Python (intutic_mcp_registry
# in GATE_PY_LIB), which reads the record's JSON; only for MCP-shaped calls.
if [ -n "$INTUTIC_MCP_REGISTRY" ]; then
  case "\${TOOL:-}" in
    mcp__*__*)
      _intutic_reg="$(python3 -c 'import os, sys
lib = {}
exec(os.environ.get("INTUTIC_PY_LIB", ""), lib)
sys.stdout.write(lib["intutic_mcp_registry"](sys.argv[1], sys.argv[2]))' "$INTUTIC_MCP_REGISTRY" "\${TOOL:-}" 2>/dev/null || true)"
      if [ -n "$_intutic_reg" ]; then
        IFS=$'\\t' read -r _ _intutic_reg_rid _intutic_reg_reason <<< "$_intutic_reg"
        _intutic_chaos_rule="$_intutic_reg_rid"; _intutic_chaos_hit=1
        intutic_shown "\${_intutic_reg_reason} [\${_intutic_reg_rid}]"
        echo "[Intutic Governance] BLOCKED: \${_intutic_shown}" >&2
        log_event "tool_blocked" "\${TOOL:-}" "\${_intutic_reg_reason} [\${_intutic_reg_rid}]"
        exit 2
      fi
      ;;
  esac
fi

# ── MCP per-server allowlist backstop ────────────────────────────────────────
# A dedicated record, not a synthetic GuardPattern rule: "allow only these
# servers" as one regex needs negative lookahead, which POSIX ERE (grep -E)
# does not have. So this is a plain membership test over the @mcp_allowlist
# record, with evaluateMcpAllowlist's code, rule id and reason (the shared
# vectors hold this copy to it). Only for an mcp__<server>__<tool> call, and
# only when the snapshot carries the record.
case "\${TOOL:-}" in
  mcp__*__*)
    if [ "$INTUTIC_MCP_ALLOWLIST" = "1" ]; then
      _intutic_mcp_server="\${TOOL#mcp__}"
      _intutic_mcp_server="\${_intutic_mcp_server%%__*}"
      case ",$INTUTIC_MCP_SERVERS," in
        *",$_intutic_mcp_server,"*)
          : # allowed — the server is in the workspace's list
          ;;
        *)
          _intutic_mcp_reason="MCP server \\"$_intutic_mcp_server\\" is not on the MCP server allowlist for this workspace [mcp_allowlist]"
          if [ "$INTUTIC_MCP_SEVERITY" = "shadow" ]; then
            intutic_chaos_note mcp_allowlist
            log_event "tool_would_block" "\${TOOL:-}" "$_intutic_mcp_reason" || true
          else
            _intutic_chaos_rule=mcp_allowlist; _intutic_chaos_hit=1
            intutic_shown "$_intutic_mcp_reason"
            echo "[Intutic Governance] BLOCKED: \${_intutic_shown}" >&2
            log_event "tool_blocked" "\${TOOL:-}" "$_intutic_mcp_reason"
            exit 2
          fi
          ;;
      esac
    fi
    ;;
esac

# ── Holds (gate body v8; after every refusal since v23) ──────────────────────
_intutic_pass=hold
if [ \${#INTUTIC_DYNAMIC[@]} -gt 0 ]; then
  for _rec in "\${INTUTIC_DYNAMIC[@]}"; do
    intutic_apply "$_rec"
  done
fi

# ── Trajectory: scope_paths and plan_approval (gate body v23) ────────────────
# A file change outside the union of scope_paths (OUT_OF_SCOPE), and a call
# before the session's plan is approved (PLAN_NOT_APPROVED) or, under strict,
# off its steps (OFF_PLAN). After the holds, before the decide tier. A check
# that cannot run refuses.
case "$_intutic_rr_text" in
  *$'	'scope_paths$'	'*|*$'	'plan_approval$'	'*)
    _intutic_tr="$(python3 -c 'import os, sys
lib = {}
exec(os.environ.get("INTUTIC_PY_LIB", ""), lib)
sys.stdout.write(lib["intutic_trajectory_check"](*(sys.argv[1:4] + [sys.argv[4], sys.stdin.read(), sys.argv[5], sys.argv[6]])))' 'goose' "\${TOOL:-}" "\${SESSION_ID:-}" "$_intutic_rr_text" "$PWD" "\${INTUTIC_WORKSPACE_ID:-}" <<< "\${TOOL_INPUT_JSON:-}" 2>/dev/null || printf 'block	OUT_OF_SCOPE	scope_paths	the scope and plan check could not run')"
    intutic_rule_verdict "$_intutic_tr"
    ;;
esac

# ── Decide tier (gate body v22) ──────────────────────────────────────────────
# Only after every tier above allowed the call, and only for a tool an @decide
# record names in its fourth column: intutic decide check --stdin asks the
# self-hosted engine, within 3900 ms less what the deadline has left.
# A CLI that is missing, fails, times out or answers what this gate cannot
# read is unavailable, which refuses unless every record on the tool is
# stamped shadow.
_intutic_decide_match=0
_intutic_decide_enforce=0
if [ -z "\${1:-}" ] && [ \${#INTUTIC_DECIDE_RECORDS[@]} -gt 0 ]; then
  for _rec in "\${INTUTIC_DECIDE_RECORDS[@]}"; do
    IFS=$'\\t' read -r _ _d_fb _d_roll _d_tools _d_rest <<< "$_rec"
    case ",\${_d_tools}," in
      *",\${TOOL:-},"*)
        _intutic_decide_match=1
        [ "$_d_roll" = "enforce" ] && _intutic_decide_enforce=1
        ;;
    esac
  done
fi
if [ "$_intutic_decide_match" = "1" ]; then
  _intutic_decide_budget=$(( 9000 - (SECONDS + 1) * 1000 - 500 ))
  [ "$_intutic_decide_budget" -gt 3900 ] && _intutic_decide_budget=3900
  if [ "$_intutic_decide_budget" -lt 50 ]; then
    if [ "$_intutic_decide_enforce" = "1" ]; then
      _intutic_dec="refuse"$'\\x1f'"GOVERNANCE_UNAVAILABLE"$'\\x1f'$'\\x1f'"GOVERNANCE_UNAVAILABLE — no time was left for the decide rules on \${TOOL:-} within the gate deadline"
    else
      _intutic_dec="allow"$'\\x1f'$'\\x1f'$'\\x1f'"no time was left for the decide rules on \${TOOL:-} within the gate deadline"
    fi
  else
    _intutic_dec="$(python3 -c 'import os, sys
lib = {}
exec(os.environ.get("INTUTIC_PY_LIB", ""), lib)
sys.stdout.write(lib["intutic_decide_check"](*sys.argv[1:6], sys.stdin.read()))' 'goose' "\${TOOL:-}" "$_intutic_decide_budget" "\${SESSION_ID:-}" "$_intutic_decide_enforce" <<< "\${TOOL_INPUT_JSON:-}" 2>/dev/null || true)"
    if [ -z "$_intutic_dec" ]; then
      # python3 could not say (it is required, and checked, before any rule
      # runs): unavailable, as a CLI that did not answer is.
      if [ "$_intutic_decide_enforce" = "1" ]; then
        _intutic_dec="refuse"$'\\x1f'"GOVERNANCE_UNAVAILABLE"$'\\x1f'$'\\x1f'"GOVERNANCE_UNAVAILABLE — the decide check could not run"
      else
        _intutic_dec="allow"$'\\x1f'$'\\x1f'$'\\x1f'"the decide check could not run"
      fi
    fi
  fi
  IFS=$'\\x1f' read -r _intutic_dec_out _intutic_dec_code _intutic_dec_rid _intutic_dec_reason <<< "$_intutic_dec"
  if [ "$_intutic_dec_out" = "allow" ]; then
    # A shadow rule's engine that could not answer: recorded, and the call goes on.
    if [ -n "$_intutic_dec_reason" ]; then
      log_event "tool_would_block" "\${TOOL:-}" "GOVERNANCE_UNAVAILABLE — $_intutic_dec_reason" || true
    fi
  else
    _intutic_dec_full="$_intutic_dec_reason"
    [ -n "$_intutic_dec_rid" ] && _intutic_dec_full="$_intutic_dec_full [$_intutic_dec_rid]"
    # goose cannot ask a person, so an escalation refuses (DECIDE_ESCALATED).
    _intutic_chaos_rule="$_intutic_dec_rid"; _intutic_chaos_hit=1
    intutic_shown "$_intutic_dec_full"
    echo "[Intutic Governance] BLOCKED: \${_intutic_shown} (refusal code \${_intutic_dec_code:-DECIDE_ESCALATED})" >&2
    log_event "tool_blocked" "\${TOOL:-}" "$_intutic_dec_full"
    exit 2
  fi
fi

# ── Agent fault injection: the call is allowed ───────────────────────────────
# Recorded as allowed, then the fault that is due, if any. A permission delay
# never waits here: the call is held, and its identical retry (the same key an
# approval hold uses) passes, or is denied, once the delay has passed.
if [ "$INTUTIC_CHAOS_ACTIVE" = "1" ]; then
  _intutic_chaos_key="$( { printf '%s' "$INTUTIC_NTOOL"; printf '\\0'; printf '%s' "$INTUTIC_NCOMMAND"; printf '\\0'; printf '%s' "$INTUTIC_NTARGET"; } | intutic_sha256 )"
  _intutic_fault="$(intutic_chaos_decide allow "$_intutic_chaos_key")"
  _intutic_chaos_done=1
  if [ -n "$_intutic_fault" ]; then
    _intutic_fault_kind="\${_intutic_fault%%$'\\t'*}"
    _intutic_fault_reason="\${_intutic_fault#*$'\\t'}"
    # The fault's own text, carrying the plan's canary: what the agent reads.
    if [ "$_intutic_fault_kind" = "hold" ]; then
      echo "[Intutic Governance] HELD: \${_intutic_fault_reason}" >&2
    else
      echo "$_intutic_fault_reason" >&2
    fi
    exit 2
  fi
fi
# ── end Intutic gate body ────────────────────────────────────────────────────


log_event "tool_allowed" "$TOOL" ""
exit 0
",
}
`;

exports[`generated hook scripts > hermes > matches the recorded output byte for byte 1`] = `
{
  ".intutic/hooks/hermes-check.sh": "#!/usr/bin/env bash
# Intutic Hermes PreToolUse governance gate.
# Auto-generated by intutic sync-daemon. DO NOT EDIT.
# Proxy: http://127.0.0.1:4000
# Generated: <TIMESTAMP>
# Workspace: ws_test
set -euo pipefail

# ── Intutic fail-closed prelude v23 ─────────────────────────────
# Any exit status other than the two deliberate verdicts (0 = allow, 2 = block)
# means this gate crashed rather than decided. The harness would read exit 1 as
# "hook errored" and run the tool anyway, so a crash is converted into a block.
# EXIT rather than ERR: ERR is unreliable across shells for set -u deaths, and
# it fires on benign non-zero intermediates; the final status cannot lie.
# A post-tool invocation (--event post, gate body v23) records a tool's result
# and never refuses: the tool has already run, and some harnesses read a
# post-tool exit 2 as text to feed back to the model. So in post mode every
# exit, a crash and the deadline included, is 0.
INTUTIC_POST_MODE=0
if [ "\${1:-}" = "--event" ] && [ "\${2:-}" = "post" ]; then INTUTIC_POST_MODE=1; fi
intutic_fail_closed() {
  _intutic_exit_rc=$?
  # The trap must not itself die on an unset variable or a failed command —
  # that would replace the exit status it exists to correct.
  set +eu
  trap - EXIT
  [ -n "\${INTUTIC_WATCHDOG_PID:-}" ] && kill "$INTUTIC_WATCHDOG_PID" 2>/dev/null
  if [ "\${INTUTIC_POST_MODE:-0}" = "1" ]; then exit 0; fi
  # A chaos run's record of a call the gate refused, held or crashed on (the
  # gate body records an allowed one where it ends). It cannot change the
  # exit status: everything it prints is discarded.
  if [ "$_intutic_exit_rc" != "0" ] && [ "\${INTUTIC_CHAOS_ACTIVE:-0}" = "1" ] && command -v intutic_chaos_decide >/dev/null 2>&1; then
    intutic_chaos_decide "\${_intutic_chaos_decision:-deny}" >/dev/null 2>&1
  fi
  if [ "$_intutic_exit_rc" = "0" ] || [ "$_intutic_exit_rc" = "2" ]; then
    exit "$_intutic_exit_rc"
  fi
  echo "[Intutic Governance] BLOCKED: gate crashed (exit \${_intutic_exit_rc}) — failing closed rather than allowing an unevaluated call." >&2
  if command -v log_event >/dev/null 2>&1; then
    log_event "tool_blocked" "\${TOOL:-unknown}" "gate crashed (exit \${_intutic_exit_rc}) — failing closed" || true
  fi
  exit 2
}
trap intutic_fail_closed EXIT

# ── Internal deadline ────────────────────────────────────────────────────────
# Most harnesses run a call whose hook outlives their timeout as if the hook had
# allowed it. So this gate refuses at 9 s from its own start, inside the
# hook timeout hermes applies (gateLimits.ts): a watchdog, detached so it holds none of
# the harness's pipes, stops the gate's children (a grep or python3 still
# matching) and signals it; the trap below refuses. Every built-in rule is
# linear; a workspace's own WHERE pattern need not be.
intutic_deadline() {
  trap - USR1
  if [ "\${INTUTIC_POST_MODE:-0}" = "1" ]; then exit 0; fi
  echo "[Intutic Governance] BLOCKED: GATE_DEADLINE — the gate did not finish evaluating this call within 9 s, and refuses it rather than let the hook timeout allow it." >&2
  if command -v log_event >/dev/null 2>&1; then
    log_event "tool_blocked" "\${TOOL:-unknown}" "GATE_DEADLINE — the gate did not finish within 9 s" || true
  fi
  exit 2
}
trap intutic_deadline USR1
INTUTIC_GATE_PID=$$
INTUTIC_WATCHDOG_PID="$( { ( sleep 9; pkill -P "$INTUTIC_GATE_PID" 2>/dev/null; kill -USR1 "$INTUTIC_GATE_PID" 2>/dev/null ) </dev/null >/dev/null 2>&1 & } ; echo $! )"

# Source runtime credentials (never embedded in this file)
if [ -f "<ROOT>/.intutic/env/runtime.env" ]; then
  # shellcheck disable=SC1090
  source "<ROOT>/.intutic/env/runtime.env"
fi

INTUTIC_HOST="\${INTUTIC_HOST:-}"
INTUTIC_API_KEY="\${INTUTIC_API_KEY:-}"
INTUTIC_WORKSPACE_ID="\${INTUTIC_WORKSPACE_ID:-ws_test}"

INPUT="$(cat)"

if ! command -v python3 >/dev/null 2>&1; then
  # A post-tool invocation records nothing without python3, and never refuses.
  if [ "\${INTUTIC_POST_MODE:-0}" = "1" ]; then exit 0; fi
  echo "[Intutic Governance] BLOCKED: python3 is required to evaluate tool calls and was not found on PATH." >&2
  echo "[Intutic Governance] Install python3, or unset the Intutic hooks to run ungoverned." >&2
  exit 2
fi

# The phrase matcher and the hold classifier (GATE_PY_LIB in gateBody.ts),
# for the extractor below and for phrase-subject rules. A quoted heredoc, so
# the shell expands nothing in it; read stops at end of input and returns 1.
IFS= read -r -d '' INTUTIC_PY_LIB <<'INTUTIC_PY_LIB_END' || true
"""Phrase matching for shell commands and SQL in linear time.

A transliteration of packages/shared-types/src/phrases.ts; read that module's
docstring for what counts as a separator and why no regex searches the input.
The rules are the same; the walk is organised for CPython, which is slow per
step: runs of ordinary characters, spaces and backslashes are consumed by
anchored character-class matches (one pass each, nothing to backtrack into),
and a phrase is checked only at the words that can start it.

Every classifier runs the shared vectors in
packages/proxy/src/plugins/anomaly/action_vectors.json, and the hook gates
emit this file verbatim (services/sync-daemon/src/lib/phrasesPy.ts holds a
byte-identical copy, which a test compares). It must stay self-contained: the
standard library only, no module state beyond the constants below, and no
backtick or dollar-brace, which the TypeScript copy cannot hold.
"""

import re
from bisect import bisect_left

_SPACE_CHARS = (
    " \\t\\n\\r\\v\\f\\u00a0\\u1680\\u2000\\u2001\\u2002\\u2003\\u2004\\u2005\\u2006\\u2007"
    "\\u2008\\u2009\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff"
)
_SPACES = frozenset(_SPACE_CHARS)
_WORD = frozenset("abcdefghijklmnopqrstuvwxyz0123456789_")
# One anchored match per piece of the text. Every alternative starts with a
# character no other alternative can start with, so exactly one can match at
# a position and it matches one run of its class: nothing to backtrack into.
_PIECE = re.compile(
    "(?P<plain>[^" + _SPACE_CHARS + "\\\\\\\\/;&|-]+)"
    "|(?P<space>[" + _SPACE_CHARS + "]+)"
    "|(?P<dash>-+)"
    "|(?P<backslash>\\\\\\\\+)"
    "|(?P<other>[/;&|])"
)
# A run of words that need no decision, each followed by one plain space:
# ordinary characters, after at most a leading run of dashes. Consumed in one
# match and split in C — most of a long command is this.
_BULK = re.compile("(?:(?:[^" + _SPACE_CHARS + "\\\\\\\\/;&|-]+|-+[^" + _SPACE_CHARS + "\\\\\\\\/;&|-]*) )+")
_BULK_NO_COMMENT = re.compile("(?:(?:[^" + _SPACE_CHARS + "\\\\\\\\;&|-]+|-+[^" + _SPACE_CHARS + "\\\\\\\\;&|-]*) )+")
# A run of line continuations or escaped spaces between words: one break.
_CONTINUATIONS = re.compile("(?:\\\\\\\\[" + _SPACE_CHARS + "])+")
# The same once no "*/" is left in the text: no "/*" can open a comment, so a
# slash is an ordinary character.
_PIECE_NO_COMMENT = re.compile(
    "(?P<plain>[^" + _SPACE_CHARS + "\\\\\\\\;&|-]+)"
    "|(?P<space>[" + _SPACE_CHARS + "]+)"
    "|(?P<dash>-+)"
    "|(?P<backslash>\\\\\\\\+)"
    "|(?P<other>[;&|])"
)


class PhraseText:
    """A text cut into words, ready for any number of has_phrase calls."""

    __slots__ = ("raw", "joined", "toks", "sep", "nl", "eol", "dash", "bar", "tail", "memo")

    def __init__(self):
        self.raw = ""
        self.joined = ""
        self.toks = []
        self.sep = []
        self.nl = []
        self.eol = []
        self.dash = []
        self.bar = []
        self.tail = False
        self.memo = {}


def phrase_text(value):
    """Cut value into words in one pass (see phraseText in phrases.ts)."""
    s = ("" if value is None else str(value)).lower()
    n = len(s)
    t = PhraseText()
    t.raw = s
    toks, sep, nl, eol, dash, bar = t.toks, t.sep, t.nl, t.eol, t.dash, t.bar
    start = -1
    tok_bar = False
    pend_sep = pend_nl = pend_eol = False
    close = -2 if "*/" in s else -1  # the next "*/" at or after the last search; -1 once none is left
    piece = _PIECE if close != -1 else _PIECE_NO_COMMENT
    bulk = _BULK if close != -1 else _BULK_NO_COMMENT
    i = 0
    while i < n:
        if start < 0:
            m = bulk.match(s, i)
            if m is not None:
                words = m.group().split(" ")
                words.pop()
                rest = len(words) - 1
                toks.extend(words)
                sep.append(pend_sep)
                sep.extend([True] * rest)
                nl.append(pend_nl)
                nl.extend([False] * rest)
                eol.append(pend_eol)
                eol.extend([False] * rest)
                dash.extend([w.startswith("--") for w in words])
                bar.extend([False] * (rest + 1))
                pend_sep = True
                pend_nl = pend_eol = False
                i = m.end()
                continue
            m = _CONTINUATIONS.match(s, i)
            if m is not None:
                pend_sep = True
                i = m.end()
                continue
        m = piece.match(s, i)
        kind = m.lastgroup
        j = m.end()
        if kind == "plain":
            if start < 0:
                start = i
            i = j
            continue
        word_break = False
        newline = eol_here = False
        nxt = j
        if kind == "space":
            newline = eol_here = "\\n" in m.group()
            word_break = True
        elif kind == "dash":
            # A "--" inside a word starts a new one, glued to it: it can open a
            # comment or an option run but cannot stand for a plain gap.
            if j - i > 1 and start >= 0:
                toks.append(s[start:i])
                sep.append(pend_sep)
                nl.append(pend_nl)
                eol.append(pend_eol)
                dash.append(s.startswith("--", start))
                bar.append(tok_bar)
                start = -1
                tok_bar = False
                pend_sep = pend_nl = pend_eol = False
            if start < 0:
                start = i
            i = j
            continue
        elif kind == "backslash":
            # Every backslash but the last is followed by a backslash: a
            # literal character. The last one decides.
            last = j - 1
            d = s[j] if j < n else ""
            if d in ("n", "t", "r") or (d != "" and d in _SPACES):
                if last > i and start < 0:
                    start = i
                word_break = True
                eol_here = d == "n"
                nxt = j + 1
                if last > i:
                    # the literal backslashes end the word before the escape
                    toks.append(s[start:last])
                    sep.append(pend_sep)
                    nl.append(pend_nl)
                    eol.append(pend_eol)
                    dash.append(s.startswith("--", start))
                    bar.append(tok_bar)
                    start = -1
                    tok_bar = False
                    pend_sep = pend_nl = pend_eol = False
            else:
                if start < 0:
                    start = i
                i = j
                continue
        else:
            c = s[i]
            if c == "/" and j < n and s[j] == "*" and close != -1:
                if close < i + 2:
                    close = s.find("*/", i + 2)
                    if close == -1:
                        piece = _PIECE_NO_COMMENT
                        bulk = _BULK_NO_COMMENT
                if close != -1:
                    word_break = True
                    nxt = close + 2
            if not word_break:
                if start < 0:
                    start = i
                if c != "/":
                    tok_bar = True
                i = j
                continue
        if start >= 0:
            toks.append(s[start:i])
            sep.append(pend_sep)
            nl.append(pend_nl)
            eol.append(pend_eol)
            dash.append(s.startswith("--", start))
            bar.append(tok_bar)
            start = -1
            tok_bar = False
            pend_sep = pend_nl = pend_eol = False
        pend_sep = True
        if newline:
            pend_nl = True
        if eol_here:
            pend_eol = True
        i = nxt
    if start >= 0:
        toks.append(s[start:n])
        sep.append(pend_sep)
        nl.append(pend_nl)
        eol.append(pend_eol)
        dash.append(s.startswith("--", start))
        bar.append(tok_bar)
        pend_sep = False
    t.tail = pend_sep
    t.joined = " ".join(toks)
    return t


def _next_index(t):
    """Per word x: the first word at or after x containing ;&|, with a real
    newline before it, and with any newline before it. Built once per text."""
    ix = t.memo.get("#next")
    if ix is None:
        T = len(t.toks)
        nb = [T] * (T + 1)
        nn = [T] * (T + 1)
        ne = [T] * (T + 1)
        b = n_ = e = T
        bar, nl, eol = t.bar, t.nl, t.eol
        for x in range(T - 1, -1, -1):
            if bar[x]:
                b = x
            if nl[x]:
                n_ = x
            if eol[x]:
                e = x
            nb[x] = b
            nn[x] = n_
            ne[x] = e
        ix = (nb, nn, ne)
        t.memo["#next"] = ix
    return ix


def has_phrase(t, needle, bounded=False):
    """Whether t contains needle (see hasPhrase in phrases.ts)."""
    words = needle.lower().split(" ")
    if len(words) == 1:
        return words[0] in t.raw
    trailing_gap = words[-1] == ""
    if trailing_gap:
        words.pop()
    for w in words:
        if w == "" or w not in t.joined:
            return False
    toks, sep, dash, tail = t.toks, t.sep, t.dash, t.tail
    T = len(toks)
    k = len(words)

    def positions(i):
        """The words that word i of the phrase can be, by its position."""
        w = words[i]
        first = i == 0
        last = i == k - 1 and not trailing_gap
        key = ("f" if first else "") + ("l" if last else "") + ("b" if bounded else "") + ":" + w
        hit = t.memo.get(key)
        if hit is not None:
            return hit
        lw = len(w)
        if first:
            out = [q for q, tok in enumerate(toks) if tok.endswith(w)]
        elif last:
            out = [q for q, tok in enumerate(toks) if tok.startswith(w)]
        else:
            out = [q for q, tok in enumerate(toks) if tok == w]
        if bounded:
            kept = []
            for q in out:
                tok = toks[q]
                if first and len(tok) > lw and tok[len(tok) - lw - 1] in _WORD:
                    continue
                if last and len(tok) > lw and (tok[lw] in _WORD or tok[lw] == "."):
                    continue
                kept.append(q)
            out = kept
        t.memo[key] = out
        return out

    # The words at which the rest of the phrase matches, ascending.
    ok = positions(k - 1)
    if trailing_gap:
        kept = []
        for q in ok:
            r = q + 1
            if r < T:
                if sep[r] or (dash[r] and not t.bar[r] and (r + 1 < T or tail)):
                    kept.append(q)
            elif tail:
                kept.append(q)
        ok = kept
    if k == 1:
        return bool(ok)
    nb, nn, ne = _next_index(t)
    for i in range(k - 2, -1, -1):
        ok_sep = [q for q in ok if sep[q]]
        ok_set = set(ok_sep)
        memo = {}

        def option(r):
            # An option run reaches any word before a ;&| word or a real newline.
            j = bisect_left(ok_sep, r + 1)
            return j < len(ok_sep) and ok_sep[j] <= min(nb[r], nn[r + 1], T - 1)

        def reach(r):
            # The gap that starts at word r leads into the rest of the phrase:
            # directly, after an option run, or after -- comments, each of
            # which runs to the next newline.
            path = []
            cur = r
            while True:
                if cur >= T:
                    val = False
                    break
                if cur in memo:
                    val = memo[cur]
                    break
                if cur in ok_set or (dash[cur] and option(cur)):
                    val = memo[cur] = True
                    break
                if not dash[cur]:
                    val = memo[cur] = False
                    break
                path.append(cur)
                cur = ne[cur + 1]
            for x in path:
                memo[x] = val
            return val

        ok = [p for p in positions(i) if reach(p + 1)]
        if not ok:
            return False
    return bool(ok)


"""The MCP server registry and allowlist decisions, read from the policy snapshot.

A transliteration of packages/shared-types/src/mcpRegistryRecord.ts: the
registry decision (evaluateMcpRegistry), the allowlist decision
(evaluateMcpAllowlist), and the snapshot's @mcp_registry and @mcp_allowlist
records. The control plane's hook gate, the MCP proxy and the JavaScript hook
gates run the TypeScript; the bash hook gates and this package run this file,
and every one of them runs packages/shared-types/fixtures/mcp-registry-vectors.json,
so all of them refuse a call with the same code, rule id and reason.

The bash gates emit this file verbatim (services/sync-daemon/src/lib/mcpRegistryPy.ts
holds a byte-identical copy, which a test compares). It must stay
self-contained: the standard library only, no module state beyond the
constants below, and no backtick or dollar-brace, which the TypeScript copy
cannot hold.

Both records sit inside the snapshot's digest. A gate that finds the snapshot
unverified (its digest broken or missing, or another workspace's) trusts
neither: it refuses every MCP call with unverified_refusal, at block, in an
observe-only workspace too.
"""

import base64
import json

MCP_REGISTRY_RECORD_TAG = "@mcp_registry"
MCP_ALLOWLIST_RECORD_TAG = "@mcp_allowlist"


def split_mcp_tool_name(tool):
    """(server, tool) for a harness name mcp__<server>__<tool>, else None.

    The server is the part before the first double underscore; the tool, the
    rest, may hold more of them.
    """
    if not isinstance(tool, str) or not tool.startswith("mcp__"):
        return None
    rest = tool[len("mcp__"):]
    sep = rest.find("__")
    if sep <= 0:
        return None
    return rest[:sep], rest[sep + 2:]


def _strings(value):
    return [v for v in value if isinstance(v, str)] if isinstance(value, list) else []


def parse_registry(value):
    """The registry as the control plane sends it, or None for a non-object.

    Wrong-typed lists read as empty, and any default but deny as allow.
    """
    if not isinstance(value, dict):
        return None
    disabled = {}
    if isinstance(value.get("disabledTools"), dict):
        for server, tools in value["disabledTools"].items():
            names = _strings(tools)
            if names:
                disabled[server] = names
    return {
        "defaultPolicy": "deny" if value.get("defaultPolicy") == "deny" else "allow",
        "approvedServers": _strings(value.get("approvedServers")),
        "blockedServers": _strings(value.get("blockedServers")),
        "heldServers": _strings(value.get("heldServers")),
        "disabledTools": disabled,
    }


def decode_registry_record(line):
    """The @mcp_registry line's registry; None for another line or a damaged one."""
    parts = line.split("\\t")
    if len(parts) != 2 or parts[0] != MCP_REGISTRY_RECORD_TAG or not parts[1]:
        return None
    try:
        return parse_registry(json.loads(base64.b64decode(parts[1], validate=True).decode("utf-8")))
    except Exception:
        return None


def evaluate_registry(registry, server, tool):
    """(code, rule_id, reason) refusing one MCP call, or None to let it continue.

    A blocked server, then a held one, then (under deny) one not approved,
    then a disabled tool.
    """
    if server in registry["blockedServers"]:
        return (
            "SERVER_BLOCKED",
            "mcp_registry." + server,
            "MCP server \\"" + server + "\\" is blocked in this workspace's MCP server registry. "
            "An owner or admin can change that on the MCP Servers page.",
        )
    if server in registry["heldServers"]:
        return (
            "SERVER_HELD",
            "mcp_registry." + server,
            "MCP server \\"" + server + "\\" changed its tools in a way scored high risk, and this workspace "
            "holds such a server until it is approved again. It is waiting in the approval queue on the MCP "
            "Servers page for an owner or admin.",
        )
    if registry["defaultPolicy"] == "deny" and server not in registry["approvedServers"]:
        return (
            "SERVER_NOT_APPROVED",
            "mcpDefaultPolicy",
            "MCP server \\"" + server + "\\" is not approved in this workspace's MCP server registry, "
            "and the workspace refuses unapproved servers (mcpDefaultPolicy: deny). It is waiting in "
            "the approval queue on the MCP Servers page for an owner or admin.",
        )
    if tool in registry["disabledTools"].get(server, []):
        return (
            "TOOL_DISABLED",
            "mcp_registry." + server + "." + tool,
            "Tool \\"" + tool + "\\" is disabled on MCP server \\"" + server + "\\" in this workspace's "
            "MCP server registry. An owner or admin can re-enable it on the MCP Servers page.",
        )
    return None


def decode_allowlist_record(line):
    """The @mcp_allowlist line as {"severity", "servers"}; None for another line.

    A severity other than shadow reads as block, so a damaged one refuses.
    """
    parts = line.split("\\t")
    if len(parts) != 3 or parts[0] != MCP_ALLOWLIST_RECORD_TAG:
        return None
    return {
        "severity": "shadow" if parts[1] == "shadow" else "block",
        "servers": [s for s in parts[2].split(",") if s],
    }


def evaluate_allowlist(allowlist, server):
    """(code, rule_id, reason) for a server the allowlist does not name, else None.

    Under shadow the caller records the refusal instead of enforcing it.
    """
    if server in allowlist["servers"]:
        return None
    return (
        "SERVER_NOT_ALLOWED",
        "mcp_allowlist",
        "MCP server \\"" + server + "\\" is not on the MCP server allowlist for this workspace",
    )


def unverified_refusal(server):
    """(code, rule_id, reason) refusing an MCP call on an unverified snapshot.

    Neither the registry's approvals nor the allowlist's servers can be
    vouched for, and a deleted record looks like one never set, so the
    snapshot admits no MCP server at all.
    """
    return (
        "POLICY_SNAPSHOT_UNVERIFIED",
        "policy_snapshot",
        "MCP server \\"" + server + "\\" is refused because the policy snapshot on this machine failed its "
        "integrity check, so its MCP server registry and allowlist admit no server until the sync daemon "
        "restores a verified snapshot",
    )


"""Did the tests pass? The deciding function behind the qualified ordering rule
requires_before: action:run_tests[ok] -> action:deploy, and the
per-session state a gate keeps of it.

A transliteration of packages/shared-types/src/testOutcome.ts; read that
module's docstring for the steps. In short, decide_test_outcome says failed
for a non-zero exit code, an error flag, a false success flag, a runner
summary with failures, or a summary saying no tests ran; ok for exit code 0,
or, with no exit code, a summary that counts a pass; and unknown otherwise,
which leaves a qualified rule unmet as a failure does.

Every port runs packages/shared-types/fixtures/test-outcome-vectors.json. The
bash hook gates emit this file verbatim, so it must stay self-contained: the
standard library only, no module state beyond the constants below, and no
backtick or dollar-brace, which a TypeScript copy cannot hold.

Inputs and states are plain dicts with the TypeScript field names
(exitCode, isError, success, output; {"v": 1, "outcomes":
{...}}), so a gate can read and write the same state file.
"""

import json
import re

OUTCOME_TOKENS = ("action:run_tests",)
OUTCOME_QUALIFIERS = ("ok",)
TEST_OUTPUT_TAIL_BYTES = 65536
TEST_OUTPUT_LINE_BYTES = 1024
TEST_OUTPUT_JSON_MAX_CHARS = 1048576
OUTCOME_STATE_TTL_MS = 86400000
_MAX_SAFE_INTEGER = 9007199254740991

_ANSI = re.compile(r"\\x1b\\[[0-9;?]*[A-Za-z]")
_EXIT_CODE = re.compile(r"exit code:? (-?[0-9]{1,9})\\Z", re.IGNORECASE | re.ASCII)
_EXIT_STATUS = re.compile(r"exit status ([0-9]{1,9})\\Z")
_EXITED = re.compile(r"(?:Process|Command) exited with code (-?[0-9]{1,9})")
_COUNT = re.compile(r"([0-9]{1,9}) ([a-z]+)")
_PYTEST_NONE = re.compile(r"=+ no tests ran")
_PYTEST = re.compile(r"=+ (.+) in [0-9.]+s.* =+\\Z")
_JEST = re.compile(r"Tests:[ \\t]+(.+)\\Z")
_VITEST = re.compile(r"[ \\t]*Tests[ \\t]+(.+)\\Z")
_GO_OK = re.compile(r"ok[ \\t]+[^ \\t]+")
_GO_FAIL = re.compile(r"FAIL(?:[ \\t]|\\Z)")
_GO_FAIL_TEST = re.compile(r"--- FAIL:")
_CARGO = re.compile(r"test result: (ok|FAILED)\\. ([0-9]{1,9}) passed; ([0-9]{1,9}) failed;")
_MOCHA_PASS = re.compile(r"[ \\t]*([0-9]{1,9}) passing")
_MOCHA_FAIL = re.compile(r"[ \\t]*([0-9]{1,9}) failing")
_RSPEC = re.compile(r"([0-9]{1,9}) examples?, ([0-9]{1,9}) failures?")


def _utf8_len(ch):
    cp = ord(ch)
    if cp < 0x80:
        return 1
    if cp < 0x800:
        return 2
    if cp < 0x10000:
        return 3
    return 4


def _utf8_tail(s, max_bytes):
    """The last max_bytes bytes of s as UTF-8, starting on a character."""
    total = 0
    i = len(s)
    while i > 0:
        n = _utf8_len(s[i - 1])
        if total + n > max_bytes:
            break
        total += n
        i -= 1
    return s[i:]


def _utf8_head(s, max_bytes):
    """The first max_bytes bytes of s as UTF-8, ending on a character."""
    total = 0
    i = 0
    while i < len(s):
        n = _utf8_len(s[i])
        if total + n > max_bytes:
            break
        total += n
        i += 1
    return s[:i]


def _lines(text):
    """The lines of text, each cut to 1 KiB, without carriage returns or ANSI sequences."""
    return [_ANSI.sub("", _utf8_head(raw, TEST_OUTPUT_LINE_BYTES).replace("\\r", "")) for raw in text.split("\\n")]


def _integer_or_none(v):
    """A JSON integer exit code, or None."""
    if isinstance(v, bool):
        return None
    if isinstance(v, int) and abs(v) <= _MAX_SAFE_INTEGER:
        return v
    if isinstance(v, float) and v.is_integer() and abs(v) <= _MAX_SAFE_INTEGER:
        return int(v)
    return None


def extract_exit_code(output):
    """The exit code a run's text reports, or None. See testOutcome.ts extractExitCode."""
    if not isinstance(output, str) or output == "":
        return None
    trimmed = output.strip()
    if len(trimmed) <= TEST_OUTPUT_JSON_MAX_CHARS and trimmed[:1] == "{" and trimmed[-1:] == "}":
        try:
            parsed = json.loads(trimmed)
        except ValueError:
            parsed = None
        if isinstance(parsed, dict):
            meta = parsed.get("metadata")
            if isinstance(meta, dict):
                m = _integer_or_none(meta.get("exit_code"))
                if m is not None:
                    return m
            for key in ("exit_code", "exitCode"):
                v = _integer_or_none(parsed.get(key))
                if v is not None:
                    return v
    head = _utf8_head(output, TEST_OUTPUT_TAIL_BYTES)
    parts = [head] if len(head) == len(output) else [head, _utf8_tail(output[len(head):], TEST_OUTPUT_TAIL_BYTES)]
    for part in parts:
        for raw in _lines(part):
            line = raw.lstrip(" \\t").rstrip(" \\t")
            m = _EXIT_CODE.match(line) or _EXIT_STATUS.match(line) or _EXITED.match(line)
            if m:
                return int(m.group(1))
    return None


def _counts(text):
    """'N word' pieces of a summary, split on ',' and '|': the count of each word."""
    counts = {}
    for piece in re.split(r"[,|]", text):
        m = _COUNT.match(piece.lstrip(" \\t"))
        if m:
            counts[m.group(2)] = counts.get(m.group(2), 0) + int(m.group(1))
    return counts


def parse_test_summaries(output):
    """The runner summaries in the last 64 KiB of output, in order (go and mocha folded into one each)."""
    if not isinstance(output, str) or output == "":
        return []
    out = []
    go = None
    mocha = None
    for line in _lines(_utf8_tail(output, TEST_OUTPUT_TAIL_BYTES)):
        if _PYTEST_NONE.match(line):
            out.append({"runner": "pytest", "passed": 0, "failed": 0, "noTests": True})
            continue
        m = _PYTEST.match(line)
        if m:
            c = _counts(m.group(1))
            if not any(k in c for k in ("passed", "failed", "error", "errors")):
                continue
            out.append({"runner": "pytest", "passed": c.get("passed", 0),
                        "failed": c.get("failed", 0) + c.get("error", 0) + c.get("errors", 0),
                        "noTests": c.get("passed") == 0})
            continue
        m = _JEST.match(line)
        if m:
            c = _counts(m.group(1))
            out.append({"runner": "jest", "passed": c.get("passed", 0), "failed": c.get("failed", 0),
                        "noTests": c.get("passed") == 0 or c.get("total") == 0})
            continue
        m = _VITEST.match(line)
        if m:
            c = _counts(m.group(1))
            if "passed" not in c and "failed" not in c:
                continue
            out.append({"runner": "vitest", "passed": c.get("passed", 0), "failed": c.get("failed", 0),
                        "noTests": c.get("passed") == 0})
            continue
        if _GO_OK.match(line):
            if go is None:
                go = {"runner": "go", "passed": 0, "failed": 0, "noTests": False}
                out.append(go)
            go["passed"] += 1
            continue
        if _GO_FAIL.match(line) or _GO_FAIL_TEST.match(line):
            if go is None:
                go = {"runner": "go", "passed": 0, "failed": 0, "noTests": False}
                out.append(go)
            go["failed"] += 1
            continue
        m = _CARGO.match(line)
        if m:
            passed, failed = int(m.group(2)), int(m.group(3))
            out.append({"runner": "cargo", "passed": passed,
                        "failed": 1 if m.group(1) == "FAILED" and failed == 0 else failed,
                        "noTests": passed == 0})
            continue
        m = _MOCHA_PASS.match(line)
        if m:
            if mocha is None:
                mocha = {"runner": "mocha", "passed": 0, "failed": 0, "noTests": False}
                out.append(mocha)
            mocha["passed"] += int(m.group(1))
            if int(m.group(1)) == 0:
                mocha["noTests"] = True
            continue
        m = _MOCHA_FAIL.match(line)
        if m:
            if mocha is None:
                mocha = {"runner": "mocha", "passed": 0, "failed": 0, "noTests": False}
                out.append(mocha)
            mocha["failed"] += int(m.group(1))
            continue
        m = _RSPEC.match(line)
        if m:
            examples, failures = int(m.group(1)), int(m.group(2))
            out.append({"runner": "rspec", "passed": max(0, examples - failures), "failed": failures,
                        "noTests": examples == 0})
    return out


def decide_test_outcome(inp):
    """The outcome of one test run, as {"outcome": ok|failed|unknown, "why": ...}.

    'inp' carries any of exitCode, isError, success and output.
    """
    exit_code = inp.get("exitCode")
    if isinstance(exit_code, bool) or not isinstance(exit_code, (int, float)) or _integer_or_none(exit_code) is None:
        exit_code = None
    else:
        exit_code = int(exit_code)
    if exit_code is not None and exit_code != 0:
        return {"outcome": "failed", "why": "exit_code"}
    if inp.get("isError") is True:
        return {"outcome": "failed", "why": "is_error"}
    if inp.get("success") is False:
        return {"outcome": "failed", "why": "success_false"}
    passed = 0
    no_tests = False
    for s in parse_test_summaries(inp.get("output")):
        if s["failed"] > 0:
            return {"outcome": "failed", "why": "summary_failed"}
        passed += s["passed"]
        if s["noTests"]:
            no_tests = True
    if passed == 0 and no_tests:
        return {"outcome": "failed", "why": "no_tests"}
    if exit_code == 0:
        return {"outcome": "ok", "why": "exit_zero"}
    if passed >= 1:
        return {"outcome": "ok", "why": "summary_passed"}
    return {"outcome": "unknown", "why": "no_signal"}


def ordering_qualifier_error(side, left):
    """Why one side of an ordering rule cannot carry its qualifier, or None."""
    if "[" not in side and "]" not in side:
        return None
    if left and side == "action:run_tests[ok]":
        return None
    return json.dumps(side, ensure_ascii=False) + ": [ok] qualifies only action:run_tests, on the left of ->"


def split_qualifier(token):
    """action:run_tests[ok] as ("action:run_tests", "ok"); any other token unqualified."""
    return ("action:run_tests", "ok") if token == "action:run_tests[ok]" else (token, None)


def empty_outcome_state():
    return {"v": 1, "outcomes": {}}


def outcome_state_file_name(harness, session_id, sha256_hex):
    """The first 32 hex of sha256(harness NUL session_id), and .json."""
    return sha256_hex(harness + "\\0" + session_id)[:32] + ".json"


def parse_outcome_state(text):
    """A state file's text as a state, or None when it is not one."""
    try:
        v = json.loads(text)
    except ValueError:
        return None
    if not isinstance(v, dict) or v.get("v") != 1 or isinstance(v.get("v"), bool) or not isinstance(v.get("outcomes"), dict):
        return None
    outcomes = {}
    for key, e in v["outcomes"].items():
        if not isinstance(e, dict):
            return None
        at = e.get("at")
        if e.get("o") not in ("ok", "failed", "unknown") or isinstance(at, bool) or not isinstance(at, (int, float)):
            return None
        if at != at or at in (float("inf"), float("-inf")):
            return None
        if "why" in e and not isinstance(e["why"], str):
            return None
        if "changed" in e and e["changed"] is not True:
            return None
        if "later" in e and e["later"] is not True:
            return None
        outcomes[key] = e
    return {"v": 1, "outcomes": outcomes}


def record_test_outcome(state, token, decision, at_ms):
    """state with token's outcome replaced by this run's."""
    outcomes = dict(state["outcomes"])
    outcomes[token] = {"o": decision["outcome"], "at": at_ms, "why": decision["why"]}
    return {"v": 1, "outcomes": outcomes}


def note_completed_call(state, changed_files):
    """state after another call completed: none adjacent any more, and stale after a file change."""
    outcomes = {}
    for key, e in state["outcomes"].items():
        nxt = {"o": e["o"], "at": e["at"]}
        if "why" in e:
            nxt["why"] = e["why"]
        if e.get("changed") or changed_files:
            nxt["changed"] = True
        nxt["later"] = True
        outcomes[key] = nxt
    return {"v": 1, "outcomes": outcomes}


def prerequisite_case(state, token, adjacent, now_ms):
    """(case, why): met only for an ok younger than a day that no file change followed
    (and, adjacent, no other call)."""
    e = None if state is None else state["outcomes"].get(token)
    if e is None or not (now_ms - e["at"] < OUTCOME_STATE_TTL_MS) or e["at"] > now_ms:
        return ("none", None)
    if e["o"] == "failed":
        return ("failed", e.get("why"))
    if e["o"] == "unknown":
        return ("unknown", e.get("why"))
    if e.get("changed"):
        return ("changed", None)
    if adjacent and e.get("later"):
        return ("not_adjacent", None)
    return ("met", None)


def prerequisite_unmet_reason(first, then, case, why, harness):
    """The PREREQUISITE_UNMET reason for every case but met, byte for byte as every port words it."""
    head = then + " needs a passing " + first + " first; "
    if case == "none":
        return head + "none ran in this session"
    if case == "failed":
        return head + "the last " + first + " failed (" + (why if why is not None else "failed") + ")"
    if case == "unknown":
        return head + "the result of the last " + first + " could not be read; rerun the tests so their summary is visible"
    if case == "changed":
        return head + "files changed after the last passing " + first + "; rerun the tests"
    if case == "not_adjacent":
        return head + then + " must come directly after it, and another call came between"
    if case == "not_observable":
        return head + harness + " reports no tool results Intutic can read, so a passing run cannot be observed here"
    if case == "no_session":
        return head + harness + " sent no session id, so test results cannot be tied to this session"
    return ""


"""Scope and plan semantics, ported from the proxy so every surface answers
"is this change inside the scope?" and "is this run on its plan?" the same way
.

A transliteration of packages/shared-types/src/scopeMatch.ts; read that
module's docstring for each function's port of origin (detectors.rs,
sops.rs, manifest.rs). Every port runs
packages/shared-types/fixtures/scope-plan-vectors.json.

The bash hook gates emit this file after the phrase matcher's (phrases.py),
which is_file_write_call calls: imported here as a module, and found in the
emitting script's scope when it is not one. Otherwise the standard library
only, and no backtick or dollar-brace, which a TypeScript copy cannot hold.
"""

try:
    from .phrases import has_phrase, phrase_text
except (ImportError, KeyError):  # embedded in a bash gate (exec without __name__), beside the phrase matcher's source
    pass

PLAN_DEVIATION_TOLERANCE = 0.4
NARROWED_TO_NOTHING = "<none: workspace list disjoint from org ceiling>"

SCOPE_WRITE_TOOLS = ("write", "write_file", "writefile", "create_file", "createfile")
SCOPE_EDIT_TOOLS = ("edit", "edit_file", "editfile", "multiedit", "apply_patch", "str_replace", "notebookedit")
SCOPE_DELETE_TOOLS = ("delete_file", "deletefile", "remove_file", "rm_file")
SCOPE_MOVE_TOOLS = ("move_file", "movefile", "rename_file", "rename")
SCOPE_EDITOR_TOOLS = ("str_replace_editor", "text_editor", "texteditor", "str_replace_based_edit_tool")
SCOPE_PATH_KEYS = ("file_path", "filepath", "path", "filename", "target_file", "notebook_path")
SCOPE_COMMAND_KEYS = ("command", "cmd", "script")
SCOPE_SHELL_TOOLS = ("bash", "shell", "run_command", "runcommand", "execute_command", "run_shell_command",
                     "terminal", "execute", "exec")
SCOPE_READ_TOOLS = ("read", "readfile", "view", "cat", "open_file")
SCOPE_MOVE_FROM_KEYS = ("source", "source_path", "from", "old_path")
SCOPE_MOVE_TO_KEYS = ("destination", "destination_path", "to", "new_path")
SCOPE_TARGET_MAX_BYTES = 512
PLAN_EXEMPT_TOOLS = ("read", "readfile", "view", "cat", "open_file", "glob", "grep", "ls", "list_dir", "search",
                     "todowrite")
FILE_WRITE_SHELL_PHRASES = ("sed -i", "perl -i", "perl -pi", "git apply", "git am", "git checkout", "git switch",
                            "git restore", "git reset", "git merge", "git pull", "git rebase", "git cherry-pick",
                            "git revert", "git stash pop", "git stash apply", "patch -p")


def _ascii_lower(s):
    return "".join(chr(ord(c) + 32) if "A" <= c <= "Z" else c for c in s)


def _tool_is(name, group):
    lower = name.lower()
    return any(lower == t or lower.endswith(t) for t in group)


def _keyed(inp, keys):
    if not isinstance(inp, dict):
        return None
    for k in keys:
        v = inp.get(k)
        if isinstance(v, str) and v != "":
            return v
    return None


def _utf8_len(ch):
    cp = ord(ch)
    return 1 if cp < 0x80 else 2 if cp < 0x800 else 3 if cp < 0x10000 else 4


def _clip(s):
    total = 0
    for i, ch in enumerate(s):
        n = _utf8_len(ch)
        if total + n > SCOPE_TARGET_MAX_BYTES:
            return s[:i] + "…"
        total += n
    return s


def _norm_scope(s):
    t = s
    while t[:2] == "./":
        t = t[2:]
    t = t.lstrip("/").rstrip("/")
    return _ascii_lower(t)


def is_within_scope(target, scopes):
    """Segment-prefix match of target against scopes, ignoring ASCII case and leading ./ or /."""
    t = _norm_scope(target)
    for raw in scopes:
        s = _norm_scope(raw)
        if s == "" or t == s or t[:len(s) + 1] == s + "/":
            return True
    return False


def sop_applies_to_role(roles, role):
    if not roles:
        return True
    if role == "":
        return False
    return _ascii_lower(role) in roles


def collect_scope_paths(sops, role):
    """The path scope in force for role (sops.rs collect_scope_paths), org ceiling included."""
    workspace, org = [], []
    for s in sops:
        if not sop_applies_to_role(s["roles"], role):
            continue
        (org if s["scope"] == "org" else workspace).extend(s["scopePaths"])
    if not org:
        out = workspace
    elif not workspace:
        out = org
    else:
        out = [w for w in workspace if is_within_scope(w, org)] or [NARROWED_TO_NOTHING]
    return sorted(set(out))


def collect_plan_steps(sops, role):
    """The plan in force for role (sops.rs collect_plan_steps), org ceiling included."""
    workspace, org = [], []
    for s in sops:
        if not sop_applies_to_role(s["roles"], role):
            continue
        (org if s["scope"] == "org" else workspace).extend(s["planSteps"])
    if not org:
        return workspace
    if not workspace:
        return org
    allowed = {_ascii_lower(o) for o in org}
    return [w for w in workspace if _ascii_lower(w) in allowed] or [NARROWED_TO_NOTHING]


def plan_off_steps(sequence, plan_steps, tolerance):
    """{"offPlan", "ratio"}: the off-plan names, sorted and deduplicated, when their share is over tolerance."""
    if not plan_steps or not sequence:
        return {"offPlan": [], "ratio": 0}
    plan = {_ascii_lower(p) for p in plan_steps}
    off = [t for t in sequence if _ascii_lower(t) not in plan]
    if not off:
        return {"offPlan": [], "ratio": 0}
    ratio = len(off) / len(sequence)
    if ratio <= tolerance:
        return {"offPlan": [], "ratio": ratio}
    return {"offPlan": sorted(set(off)), "ratio": min(1, ratio)}


def change_targets(tool, inp):
    """The mutations one tool call makes, as the proxy's change manifest records them."""
    if _tool_is(tool, SCOPE_MOVE_TOOLS):
        src = _keyed(inp, SCOPE_MOVE_FROM_KEYS)
        dst = _keyed(inp, SCOPE_MOVE_TO_KEYS)
        if src is not None or dst is not None:
            return [{"op": "move", "target": _clip(t)} for t in (src, dst) if t is not None]
    op = None
    if _tool_is(tool, SCOPE_EDITOR_TOOLS):
        command = inp.get("command") if isinstance(inp, dict) else None
        command = _ascii_lower(command) if isinstance(command, str) else ""
        if command == "view":
            return []
        op = "write" if command == "create" else "edit"
    elif _tool_is(tool, SCOPE_WRITE_TOOLS):
        op = "write"
    elif _tool_is(tool, SCOPE_EDIT_TOOLS):
        op = "edit"
    elif _tool_is(tool, SCOPE_DELETE_TOOLS):
        op = "delete"
    if op is None:
        return []
    target = _keyed(inp, SCOPE_PATH_KEYS)
    return [] if target is None else [{"op": op, "target": _clip(target)}]


def _diff_path(raw, prefix):
    p = raw
    tab = p.find("\\t")
    if tab != -1:
        p = p[:tab]
    p = p.strip(" ")
    if len(p) >= 2 and p[0] == '"' and p[-1] == '"':
        p = p[1:-1]
    if p in ("/dev/null", ""):
        return None
    if prefix and p[:len(prefix)] == prefix:
        p = p[len(prefix):]
    return p or None


def diff_changed_paths(diff):
    """The paths a diff changes, in the order first seen, each once."""
    out = []

    def add(p):
        if p is not None and p not in out:
            out.append(p)

    for raw in diff.split("\\n"):
        line = raw[:-1] if raw.endswith("\\r") else raw
        if line[:11] == "diff --git ":
            rest = line[11:]
            if rest[:2] != "a/":
                continue
            first = rest.find(" b/")
            if first == -1:
                continue
            if rest.find(" b/", first + 1) == -1:
                add(_diff_path(rest[:first], "a/"))
                add(_diff_path(rest[first + 1:], "b/"))
            elif (len(rest) - 5) % 2 == 0:
                n = (len(rest) - 5) // 2
                a = rest[2:2 + n]
                if rest[2 + n:5 + n] == " b/" and rest[5 + n:] == a:
                    add(_diff_path(a, ""))
        elif line[:4] == "--- ":
            add(_diff_path(line[4:], "a/"))
        elif line[:4] == "+++ ":
            add(_diff_path(line[4:], "b/"))
        elif line[:12] == "rename from ":
            add(_diff_path(line[12:], ""))
        elif line[:10] == "rename to ":
            add(_diff_path(line[10:], ""))
    return out


def _normalise_path(p):
    parts = []
    for seg in p.split("/"):
        if seg in ("", "."):
            continue
        if seg == "..":
            if parts:
                parts.pop()
        else:
            parts.append(seg)
    return "/" + "/".join(parts)


def scope_relative_path(target, cwd, root):
    """target relative to the workspace root, or None when outside it, under ~, or unresolvable."""
    if target == "" or target[:1] == "~" or cwd[:1] != "/" or root[:1] != "/":
        return None
    absolute = _normalise_path(target if target[:1] == "/" else cwd + "/" + target)
    base = _normalise_path(root)
    if absolute == base:
        return ""
    head = "/" if base == "/" else base + "/"
    return absolute[len(head):] if absolute[:len(head)] == head else None


def is_plan_exempt_tool(tool):
    """Whether plan_approval: lets tool run before approval: a PLAN_EXEMPT_TOOLS name, bare or mcp__<server>__<name>."""
    lower = tool.lower()
    return any(lower == t or lower[-(len(t) + 2):] == "__" + t for t in PLAN_EXEMPT_TOOLS)


def is_file_write_call(tool, inp):
    """Whether the call changed files: a mutation, or a shell command with a FILE_WRITE_SHELL_PHRASES phrase."""
    if change_targets(tool, inp):
        return True
    if not _tool_is(tool, SCOPE_SHELL_TOOLS):
        return False
    command = _keyed(inp, SCOPE_COMMAND_KEYS)
    if command is None:
        return False
    words = phrase_text(command)
    return any(has_phrase(words, p) for p in FILE_WRITE_SHELL_PHRASES)


# The lane phrases rule_record.py names (lanes.ts LANE_PHRASES).
LANE_PHRASES = {"action:deploy":["git push","kubectl apply","kubectl rollout","helm upgrade","helm install","terraform apply","docker push","serverless deploy","fly deploy","vercel deploy","gcloud run deploy","aws deploy","aws s3 sync","eb deploy"],"action:publish":["npm publish","pnpm publish","yarn publish","cargo publish","twine upload","poetry publish","gem push","docker manifest push"],"action:release":["gh release create","git tag","npm version","cargo release","goreleaser release","semantic-release"],"action:db_write":["insert into","update ","delete from","drop table","drop database","drop schema","truncate ","alter table"],"action:http_post":["curl -x post","curl --request post","curl -d ","curl --data","wget --post","http post"],"action:run_tests":["npm test","npm run test","pnpm test","pnpm run test","yarn test","cargo test","go test","pytest","python -m pytest","vitest","jest","mocha","rspec","phpunit","make test","gradle test","mvn test","dotnet test","bazel test","tox"],"action:migrate":["prisma migrate deploy","prisma db push","alembic upgrade","alembic downgrade","rails db:migrate","rake db:migrate","manage.py migrate","flyway migrate","liquibase update","knex migrate:latest","sequelize db:migrate"],"action:prod_write":["--prod","rails_env=production","node_env=production","--context prod","--namespace production","-n production","--environment production","--stage prod"],"action:destroy":["terraform destroy","kubectl delete","helm uninstall","helm delete","drop table","drop database","drop schema","truncate ","aws s3 rb","aws s3 rm"],"action:force_push":["git push --force","git push -f"],"action:payment":["api.stripe.com/v1/charges","api.stripe.com/v1/payment_intents","api.stripe.com/v1/transfers","api.stripe.com/v1/payouts","api.stripe.com/v1/refunds","stripe charges create","stripe payment_intents create","stripe transfers create","stripe payouts create","api-m.paypal.com/v2/payments","api.paypal.com/v1/payments"]}

"""Rule records in the policy snapshot: the @rule record, its
fallback line, and how a gate that reads it decides a call (Tier R).

A transliteration of packages/shared-types/src/gateRuleRecord.ts (the
reader's half: the writers are the daemon, the CLI and the control plane).
A record is five tab-separated columns: @rule, the fallback line's id or
-, the kind, the rollout, and base64 of the canonical JSON of its
payload, {v, ref, sopTitle, ...kind fields}. A record that does not
decode leaves its fallback line in force, which refuses. Kinds:
requires_outcome (a qualified requires_before), scope_paths (under
scope_paths_mode: enforce) and plan_approval.

Every port runs packages/shared-types/fixtures/rule-record-vectors.json. The
bash hook gates emit this file after test_outcome.py, scope_match.py and the
lane phrases, whose names it uses: imported here as modules, and found in the
emitting script's scope when it is not one. Otherwise the standard library
only, and no backtick or dollar-brace, which a TypeScript copy cannot hold.
"""

import base64
import binascii
import json
import re

try:
    from .actions import LANE_PHRASES
    from .scope_match import (
        SCOPE_DELETE_TOOLS, SCOPE_EDIT_TOOLS, SCOPE_EDITOR_TOOLS, SCOPE_MOVE_TOOLS, SCOPE_SHELL_TOOLS,
        SCOPE_WRITE_TOOLS, change_targets, is_plan_exempt_tool, is_within_scope, scope_relative_path,
    )
    from .test_outcome import prerequisite_case, prerequisite_unmet_reason
except (ImportError, KeyError):  # embedded in a bash gate (exec without __name__), beside the sources it needs
    pass

RULE_RECORD_TAG = "@rule"
RULE_SNAPSHOT_FORMAT = 3
RULE_SOP_TITLE_MAX_CHARS = 80
RULE_SCOPE_PATHS_MAX = 64
RULE_SCOPE_PATH_MAX_CHARS = 512
GATE_RULE_KINDS = ("requires_outcome", "scope_paths", "plan_approval")
V22_ACTION_TOKENS = ("action:deploy", "action:publish", "action:release", "action:db_write")

# The payload fields of each kind, sorted; the kind, fallback id and rollout are columns.
_FIELDS = {
    "requires_outcome": ["adjacent", "first", "qualifier", "ref", "sopTitle", "then", "v"],
    "scope_paths": ["ref", "scopePaths", "sopTitle", "v"],
    "plan_approval": ["mode", "ref", "sopTitle", "v"],
}
_REF = re.compile(r"^[^\\n\\r\\u2028\\u2029]+#([a-z_]+):([1-9][0-9]{0,5})\\Z")
_TOKEN = re.compile(r"^[A-Za-z][A-Za-z0-9_.:-]{0,63}\\Z")
_LINE_BREAK = re.compile(r"[\\t\\r\\n]")


def _from_base64(b64):
    """Standard base64 back to UTF-8 text; raises on anything but the canonical encoding."""
    raw = base64.b64decode(b64, validate=True)
    text = raw.decode("utf-8")
    if base64.b64encode(raw).decode("ascii") != b64:
        raise ValueError("not canonical base64")
    return text


def _text(v, max_chars, min_chars):
    return isinstance(v, str) and not _LINE_BREAK.search(v) and min_chars <= len(v) <= max_chars


def decode_gate_rule_record(line):
    """An @rule line as a record dict (payload fields plus kind, fallbackId and rollout), or None."""
    f = line.split("\\t")
    if len(f) != 5 or f[0] != RULE_RECORD_TAG or not f[4]:
        return None
    kind = f[2]
    if kind not in _FIELDS:
        return None
    try:
        r = json.loads(_from_base64(f[4]))
    except (ValueError, binascii.Error, UnicodeDecodeError):
        return None
    if not isinstance(r, dict) or sorted(r.keys()) != _FIELDS[kind]:
        return None
    if f[3] not in ("shadow", "enforce"):
        return None
    r = dict(r, kind=kind, fallbackId=None if f[1] == "-" else f[1], rollout=f[3])
    if r["v"] != 1 or isinstance(r["v"], bool):
        return None
    if not _text(r["sopTitle"], RULE_SOP_TITLE_MAX_CHARS, 0) or not isinstance(r["ref"], str):
        return None
    m = _REF.match(r["ref"])
    if not m or m.group(1) != kind:
        return None
    if r["rollout"] == "enforce":
        fid = r["fallbackId"]
        if not isinstance(fid, str) or not re.match(r"^" + kind + "-fallback:" + m.group(2) + r"@[0-9a-f]{12}\\Z", fid):
            return None
    elif r["fallbackId"] is not None:
        return None
    if kind == "requires_outcome":
        if r["first"] != "action:run_tests" or r["qualifier"] != "ok" or not isinstance(r["adjacent"], bool):
            return None
        if not isinstance(r["then"], str) or not _TOKEN.match(r["then"]) or r["then"] == "action:run_tests":
            return None
    elif kind == "scope_paths":
        paths = r["scopePaths"]
        if not isinstance(paths, list) or not 1 <= len(paths) <= RULE_SCOPE_PATHS_MAX:
            return None
        if any(not _text(p, RULE_SCOPE_PATH_MAX_CHARS, 1) for p in paths):
            return None
    elif r["mode"] not in ("required", "strict"):
        return None
    return r


def gate_rule_fallback_reason(kind, sop_title):
    if kind == "requires_outcome":
        return ("Qualified requires_before (" + sop_title + "): this gate cannot read test results, so the call "
                "it gates is refused; upgrade the Intutic gate")
    if kind == "scope_paths":
        return ("scope_paths_mode: enforce (" + sop_title + "): this gate cannot check a change against the "
                "scope, so every file change is refused; upgrade the Intutic gate")
    return ("plan_approval (" + sop_title + "): this gate cannot check plan approval, so every call is refused; "
            "upgrade the Intutic gate")


def _escape(s):
    return re.sub(r"([.*+?^(){}$|\\[\\]\\\\])", r"\\\\\\1", s)


def gate_rule_fallback(record):
    """The fallback line an older gate refuses with in the record's place, or None for a shadow record."""
    if record["fallbackId"] is None:
        return None
    base = {"id": record["fallbackId"], "severity": "block", "reason": gate_rule_fallback_reason(record["kind"], record["sopTitle"])}
    if record["kind"] == "plan_approval":
        return dict(base, subject="tool", source=" [^ ]+ ", ignoreCase=False)
    if record["kind"] == "scope_paths":
        tools = SCOPE_WRITE_TOOLS + SCOPE_EDIT_TOOLS + SCOPE_DELETE_TOOLS + SCOPE_MOVE_TOOLS + SCOPE_EDITOR_TOOLS
        return dict(base, subject="tool", source=" [^ ]*(" + "|".join(_escape(t) for t in tools) + ") ", ignoreCase=True)
    then = record["then"]
    if then in V22_ACTION_TOKENS:
        return dict(base, subject="action", source=" (" + _escape(then) + ") ", ignoreCase=True)
    if then.startswith("action:"):
        phrases = LANE_PHRASES.get(then) or []
        if phrases:
            return dict(base, subject="phrase", source="|".join(phrases), ignoreCase=True)
        return dict(base, subject="tool", source=" [^ ]*(" + "|".join(_escape(t) for t in SCOPE_SHELL_TOOLS) + ") ",
                    ignoreCase=True)
    return dict(base, subject="tool", source=" (" + _escape(then) + ") ", ignoreCase=False)


def gate_rule_plan_from_response(status, body):
    """The session's plan from GET /api/v1/plans/session/:id ({"status": approved|none|unavailable})."""
    if status == 404:
        return {"status": "none"}
    if status != 200 or not isinstance(body, dict):
        return {"status": "unavailable"}
    if body.get("lifecycleState") not in ("APPROVED", "EXECUTING"):
        return {"status": "none"}
    tools = []
    steps = body.get("steps")
    for step in steps if isinstance(steps, list) else []:
        if not isinstance(step, dict):
            continue
        tool = step.get("tool") if isinstance(step.get("tool"), str) else step.get("toolName")
        if isinstance(tool, str) and tool.strip() and tool.strip() not in tools:
            tools.append(tool.strip())
    return {"status": "approved", "tools": tools}


def _plan_finding(records, call):
    if not records or is_plan_exempt_tool(call["tool"]):
        return None
    rec = next((r for r in records if r["mode"] == "strict"), records[0])
    rule_id = "plan_approval." + rec["sopTitle"]
    scope = {"tools": [call["tool"]]}
    head = "plan_approval: " + rec["mode"] + " (" + rec["sopTitle"] + "): "
    if call["sessionId"] == "":
        return {"code": "PLAN_NOT_APPROVED", "ruleId": rule_id, "scope": scope, "ref": rec["ref"],
                "reason": head + call["harness"] + " sent no session id, so no approved plan can be found for this session"}
    plan = call["plan"]
    if plan["status"] != "approved":
        why = "this session has no approved plan" if plan["status"] == "none" else "the approved plans could not be read"
        return {"code": "PLAN_NOT_APPROVED", "ruleId": rule_id, "scope": scope, "ref": rec["ref"],
                "reason": head + why + "; get the plan approved, then retry"}
    if rec["mode"] == "strict":
        tool = call["tool"].lower()
        if not any(t.lower() == tool for t in plan["tools"]):
            return {"code": "OFF_PLAN", "ruleId": rule_id, "scope": scope, "ref": rec["ref"],
                    "reason": call["tool"] + " is not a step of this session's approved plan (plan_approval: strict, "
                    + rec["sopTitle"] + ")"}
    return None


def _requires_finding(records, call):
    tool = call["tool"].lower()
    for rec in records:
        if rec["then"] not in call["actions"] and rec["then"].lower() != tool:
            continue
        why = None
        if not call["observable"]:
            case = "not_observable"
        elif call["sessionId"] == "":
            case = "no_session"
        else:
            case, why = prerequisite_case(call["outcomes"], rec["first"], rec["adjacent"], call["nowMs"])
        if case == "met":
            continue
        return {
            "code": "PREREQUISITE_UNMET",
            "ruleId": "requires_before." + rec["first"] + "[ok]" + ("~>" if rec["adjacent"] else "->") + rec["then"],
            "reason": prerequisite_unmet_reason(rec["first"], rec["then"], case, why, call["harness"]),
            "scope": {"tools": [rec["then"]], "step": rec["first"]},
            "ref": rec["ref"],
        }
    return None


def _scope_finding(records, call):
    if not records:
        return None
    targets = change_targets(call["tool"], call["input"])
    if not targets:
        return None
    scopes = []
    for r in records:
        for p in r["scopePaths"]:
            if p not in scopes:
                scopes.append(p)
    outside = []
    for t in targets:
        rel = scope_relative_path(t["target"], call["cwd"], call["root"])
        if (rel is None or not is_within_scope(rel, scopes)) and t["target"] not in outside:
            outside.append(t["target"])
    if not outside:
        return None
    rec = records[0]
    return {
        "code": "OUT_OF_SCOPE",
        "ruleId": "scope_paths." + rec["sopTitle"],
        "reason": "Changes outside the declared file scope: " + ", ".join(outside) + " (scope: " + ", ".join(scopes) + ")",
        "scope": {"paths": outside},
        "ref": rec["ref"],
    }


def _findings(records, call):
    out = []
    for finding in (
        _plan_finding([r for r in records if r["kind"] == "plan_approval"], call),
        _requires_finding([r for r in records if r["kind"] == "requires_outcome"], call),
        _scope_finding([r for r in records if r["kind"] == "scope_paths"], call),
    ):
        if finding is not None:
            out.append(finding)
    return out


def evaluate_gate_rule_records(records, call):
    """Tier R: {"refusal": the first enforcing finding or None, "shadow": the shadow records' findings}.

    'call' carries tool, input, actions, cwd, root, sessionId, harness,
    outcomes (a state dict or None), observable, plan and nowMs, as in
    gateRuleRecord.ts GateRuleCall.
    """
    enforce = _findings([r for r in records if r["rollout"] == "enforce"], call)
    return {"refusal": enforce[0] if enforce else None,
            "shadow": _findings([r for r in records if r["rollout"] == "shadow"], call)}


"""What a refusal says about where to retry: its scope (paths,
tools, step, detector, rule) and its evidence (what the refuser saw),
bounded the same way on every surface.

A transliteration of packages/shared-types/src/refusalDetail.ts: each list
holds at most 8 items and each string at most 256 code points, with C0
control characters (U+0000 to U+001F) removed first; a string empty after
that is dropped, an empty list left out, and a scope with nothing left is
None. In an OPAQUE workspace both are dropped, and so is the stderr retry
line. Every port runs packages/shared-types/fixtures/refusal-detail-vectors.json.

Self-contained (the standard library only), so the bash hook gates can emit
it verbatim; no backtick or dollar-brace, which a TypeScript copy cannot hold.
"""

import re

REFUSAL_DETAIL_MAX_ITEMS = 8
REFUSAL_DETAIL_MAX_CHARS = 256
RETRY_SCOPE_PREFIX = "[Intutic] Retry scope: "

_C0 = re.compile("[\\u0000-\\u001f]")


def _detail_text(s):
    """s without C0 control characters, cut to 256 code points; None when nothing is left or it is not a string."""
    if not isinstance(s, str):
        return None
    clean = _C0.sub("", s)
    return clean[:REFUSAL_DETAIL_MAX_CHARS] if clean else None


def _detail_list(v):
    if not isinstance(v, list):
        return None
    out = []
    for item in v:
        if len(out) >= REFUSAL_DETAIL_MAX_ITEMS:
            break
        t = _detail_text(item)
        if t is not None:
            out.append(t)
    return out or None


def bound_refusal_scope(scope):
    """A scope bounded as the module says, keys in a fixed order; None when nothing is left."""
    if not isinstance(scope, dict):
        return None
    out = {}
    for key in ("paths", "tools"):
        v = _detail_list(scope.get(key))
        if v:
            out[key] = v
    for key in ("step", "detector", "rule"):
        v = _detail_text(scope.get(key))
        if v is not None:
            out[key] = v
    return out or None


def bound_refusal_evidence(evidence):
    """Evidence bounded: at most 8 items, each with a kind and a detail that survive bounding."""
    out = []
    if not isinstance(evidence, list):
        return out
    for item in evidence:
        if len(out) >= REFUSAL_DETAIL_MAX_ITEMS:
            break
        if not isinstance(item, dict):
            continue
        kind, detail = _detail_text(item.get("kind")), _detail_text(item.get("detail"))
        if kind is not None and detail is not None:
            out.append({"kind": kind, "detail": detail})
    return out


def refusal_detail_for_mode(mode, scope, evidence):
    """The detail a refusal carries in an intervention mode: nothing in OPAQUE, else the bounded scope and evidence."""
    if mode == "OPAQUE":
        return {}
    out = {}
    s = bound_refusal_scope(scope)
    if s:
        out["scope"] = s
    e = bound_refusal_evidence(evidence)
    if e:
        out["evidence"] = e
    return out


def retry_scope_line(mode, scope):
    """'[Intutic] Retry scope: <paths, else tools>', or None when neither, and in OPAQUE."""
    if mode == "OPAQUE":
        return None
    s = bound_refusal_scope(scope) or {}
    items = s.get("paths") or s.get("tools")
    return RETRY_SCOPE_PREFIX + ", ".join(items) if items else None


_INTUTIC_ACTION_NEEDLES = [["action:deploy",["git push","kubectl apply","kubectl rollout","helm upgrade","helm install","terraform apply","docker push","serverless deploy","fly deploy","vercel deploy","gcloud run deploy","aws deploy","aws s3 sync","eb deploy"]],["action:publish",["npm publish","pnpm publish","yarn publish","cargo publish","twine upload","poetry publish","gem push","docker manifest push"]],["action:release",["gh release create","git tag","npm version","cargo release","goreleaser release","semantic-release"]],["action:db_write",["insert into","update ","delete from","drop table","drop database","drop schema","truncate ","alter table"]],["action:run_tests",["npm test","npm run test","pnpm test","pnpm run test","yarn test","cargo test","go test","pytest","python -m pytest","vitest","jest","mocha","rspec","phpunit","make test","gradle test","mvn test","dotnet test","bazel test","tox"]],["action:http_post",["curl -x post","curl --request post","curl -d ","curl --data","wget --post","http post"]],["action:migrate",["prisma migrate deploy","prisma db push","alembic upgrade","alembic downgrade","rails db:migrate","rake db:migrate","manage.py migrate","flyway migrate","liquibase update","knex migrate:latest","sequelize db:migrate"]],["action:prod_write",["--prod","rails_env=production","node_env=production","--context prod","--namespace production","-n production","--environment production","--stage prod"]],["action:destroy",["terraform destroy","kubectl delete","helm uninstall","helm delete","drop table","drop database","drop schema","truncate ","aws s3 rb","aws s3 rm"]],["action:payment",["api.stripe.com/v1/charges","api.stripe.com/v1/payment_intents","api.stripe.com/v1/transfers","api.stripe.com/v1/payouts","api.stripe.com/v1/refunds","stripe charges create","stripe payment_intents create","stripe transfers create","stripe payouts create","api-m.paypal.com/v2/payments","api.paypal.com/v1/payments"]]]
_INTUTIC_ACTION_TOOLS = ["bash","shell","run_command","runcommand","execute_command","run_shell_command","terminal","execute","exec"]
_INTUTIC_FORCE_FLAGS = [" --force "," -f "]

_INTUTIC_RM_SEGMENT = re.compile(r"[;&|()\\n]")
_INTUTIC_RM_GAP = re.compile(r"[ \\t\\r\\f\\v]+")


def _intutic_removes_outside_tree(args):
    # removes_outside_tree (intutic_clawde actions.py, gate-js actions.ts):
    # rm -rf / -fr / -r -f / --recursive --force with a target that is
    # absolute, under ~, or contains "..". rm -rf build/ is not one.
    for segment in _INTUTIC_RM_SEGMENT.split(args):
        words = [w for w in _INTUTIC_RM_GAP.split(segment) if w != ""]
        at = next((i for i, w in enumerate(words) if w == "rm" or w.endswith("/rm")), -1)
        if at == -1:
            continue
        recursive = force = False
        flags = True
        targets = []
        for w in words[at + 1:]:
            if flags and w == "--":
                flags = False
            elif flags and w.startswith("--"):
                if w == "--recursive":
                    recursive = True
                if w == "--force":
                    force = True
            elif flags and w.startswith("-") and len(w) > 1:
                lower = w.lower()
                if "r" in lower:
                    recursive = True
                if "f" in lower:
                    force = True
            else:
                targets.append(w.strip("\\"'"))
        if recursive and force and any(t.startswith("/") or t.startswith("~") or ".." in t for t in targets):
            return True
    return False


def intutic_actions(tool, command):
    if str(tool or "").lower() not in _INTUTIC_ACTION_TOOLS:
        return " "
    words = phrase_text(command)
    out = " "
    for action, needles in _INTUTIC_ACTION_NEEDLES:
        if any(has_phrase(words, n) for n in needles):
            out += action + " "
    # A recursive, forced remove outside the working tree is destroy too
    # (Q3); no phrase can say "outside the tree", so it is a predicate.
    if " action:destroy " not in out and _intutic_removes_outside_tree(str(command or "")):
        out += "action:destroy "
    # The force-push compound: the git push phrase and a whole-word flag.
    if has_phrase(words, "git push"):
        padded = " " + " ".join(str(command or "").lower().split()) + " "
        if any(f in padded for f in _INTUTIC_FORCE_FLAGS):
            out += "action:force_push "
    return out


def _intutic_records(records_text, kind):
    out = []
    for line in str(records_text or "").split("\\n"):
        r = decode_gate_rule_record(line) if line else None
        if r is not None and r["kind"] == kind:
            out.append(r)
    return out


def intutic_rule_skip(records_text, kinds_csv):
    # The fallback line ids a decoded, enforcing record names, one per line,
    # for the kinds this gate evaluates. Any other fallback line stays.
    kinds = [k for k in str(kinds_csv).split(",") if k]
    out = []
    for line in str(records_text or "").split("\\n"):
        r = decode_gate_rule_record(line) if line else None
        if r is not None and r["fallbackId"] and r["kind"] in kinds:
            out.append(r["fallbackId"])
    return "\\n".join(out)


def _intutic_now_ms():
    import time
    return int(time.time() * 1000)


def _intutic_state_path(harness, session):
    import hashlib, os
    base = os.environ.get("INTUTIC_OUTCOME_STATE_DIR") or os.path.join(
        os.path.expanduser("~"), ".intutic", "hooks", "state", "outcomes")
    return os.path.join(base, outcome_state_file_name(str(harness), str(session),
                                                      lambda t: hashlib.sha256(t.encode("utf-8")).hexdigest()))


def _intutic_state_read(path):
    # (exists, state): a missing file is an empty state; one that does not
    # read is None, which leaves every qualified rule unmet.
    import os
    if not os.path.exists(path):
        return False, empty_outcome_state()
    try:
        with open(path, "r", encoding="utf-8") as fh:
            return True, parse_outcome_state(fh.read())
    except Exception:
        return True, None


def _intutic_state_write(path, state):
    import json, os
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        tmp = path + ".tmp." + str(os.getpid())
        with open(tmp, "w", encoding="utf-8") as fh:
            json.dump(state, fh, separators=(",", ":"))
        os.replace(tmp, path)
    except Exception:
        pass


def _intutic_verdict(r, code, rid, reason, scope):
    return "\\t".join(["block" if r["rollout"] == "enforce" else "shadow", code, rid, " ".join(reason.split()),
                      retry_scope_line("TRANSPARENT", scope) or ""])


def intutic_outcome_check(harness, observable, tool, actions, session, records_text, tool_input_json):
    import json
    try:
        ti = json.loads(tool_input_json or "{}")
    except ValueError:
        ti = {}
    recs = _intutic_records(records_text, "requires_outcome")
    path = _intutic_state_path(harness, session) if session else None
    exists, state = _intutic_state_read(path) if path else (False, empty_outcome_state())
    shadow = ""
    for r in recs:
        then = r["then"]
        if (" " + then + " ") not in str(actions) and then.lower() != str(tool).lower():
            continue
        why = None
        if observable != "1":
            case = "not_observable"
        elif not session:
            case = "no_session"
        else:
            case, why = prerequisite_case(state, r["first"], r["adjacent"], _intutic_now_ms())
        if case == "met":
            continue
        rid = "requires_before." + r["first"] + "[ok]" + ("~>" if r["adjacent"] else "->") + then
        line = _intutic_verdict(r, "PREREQUISITE_UNMET", rid, prerequisite_unmet_reason(r["first"], then, case, why, harness),
                                {"tools": [then], "step": r["first"]})
        if r["rollout"] == "enforce":
            return line
        shadow = shadow or line
    # Bookkeeping, on a call this tier lets through: no outcome is adjacent
    # to what comes next any more, and a call that changes files (a mutation
    # tool, or a shell write such as sed -i or git checkout) makes a pass
    # before it stale (Q1).
    if path and exists and state is not None:
        _intutic_state_write(path, note_completed_call(state, is_file_write_call(tool, ti)))
    return shadow


def intutic_post_record(harness, payload_text):
    # A post-tool payload: a shell call that ran tests records its outcome;
    # a file change marks an earlier [ok] stale. Never refuses.
    import json
    try:
        d = json.loads(payload_text or "{}")
    except ValueError:
        return ""
    if not isinstance(d, dict):
        return ""
    session = str(d.get("session_id") or d.get("sessionId") or "")
    if not session:
        return ""
    tool = str(d.get("tool_name") or d.get("toolName") or "")
    ti = d.get("tool_input") if isinstance(d.get("tool_input"), dict) else {}
    command = ""
    for k in ("command", "cmd", "script", "shell_command"):
        if isinstance(ti.get(k), str) and ti.get(k):
            command = ti[k]
            break
    actions = intutic_actions(tool, command)
    path = _intutic_state_path(harness, session)
    exists, state = _intutic_state_read(path)
    if " action:run_tests " in actions:
        resp = d.get("tool_response")
        output = ""
        if isinstance(resp, dict):
            v = resp.get("llmContent")
            output = v if isinstance(v, str) else json.dumps(v)
            # Gemini CLI prefixes the command's output with "Output: ".
            if output.startswith("Output: "):
                output = output[len("Output: "):]
        elif isinstance(resp, str):
            output = resp
        decision = decide_test_outcome({"exitCode": extract_exit_code(output), "output": output})
        _intutic_state_write(path, record_test_outcome(state if state is not None else empty_outcome_state(),
                                                       "action:run_tests", decision, _intutic_now_ms()))
    elif exists and state is not None and is_file_write_call(tool, ti):
        _intutic_state_write(path, note_completed_call(state, True))
    return ""


def _intutic_real(path):
    import os
    return os.path.realpath(path)


def _intutic_repo_root(cwd):
    import os
    d = _intutic_real(cwd or os.getcwd())
    while True:
        if os.path.exists(os.path.join(d, ".git")):
            return d
        parent = os.path.dirname(d)
        if parent == d:
            return _intutic_real(cwd or os.getcwd())
        d = parent


def _intutic_approved_plan(session, workspace_id):
    import hashlib, json, os, datetime
    path = os.environ.get("INTUTIC_APPROVED_PLANS") or os.path.join(
        os.path.expanduser("~"), ".intutic", "hooks", "approved-plans.jsonl")
    try:
        with open(path, "r", encoding="utf-8") as fh:
            lines = fh.read().split("\\n")
    except Exception:
        return None
    digest = ws = expires = ""
    body = []
    for line in lines:
        if line.startswith("#digest "):
            digest = line[8:].strip()
        elif line.startswith("#workspace "):
            ws = line[11:].strip()
        elif line.startswith("#expires "):
            expires = line[9:].strip()
        elif line and not line.startswith("#"):
            body.append(line)
    if hashlib.sha256("\\n".join(body).encode("utf-8")).hexdigest()[:32] != digest:
        return None
    if ws and workspace_id and ws != workspace_id:
        return None
    try:
        exp = datetime.datetime.fromisoformat(expires.replace("Z", "+00:00"))
    except Exception:
        return None
    if datetime.datetime.now(datetime.timezone.utc) >= exp:
        return None
    tools = None
    for line in body:
        try:
            e = json.loads(line)
        except ValueError:
            continue
        if not isinstance(e, dict) or e.get("sessionId") != session or e.get("state") not in ("APPROVED", "EXECUTING"):
            continue
        tools = (tools or []) + [str(t).lower() for t in (e.get("tools") or []) if isinstance(t, str)]
    return None if tools is None else {"tools": tools}


def intutic_trajectory_check(harness, tool, session, records_text, tool_input_json, payload_cwd, workspace_id):
    import json, os
    try:
        ti = json.loads(tool_input_json or "{}")
    except ValueError:
        ti = {}
    shadow = ""
    scopes = _intutic_records(records_text, "scope_paths")
    targets = [t["target"] for t in change_targets(tool, ti)] if scopes else []
    if targets:
        cwd = payload_cwd or os.getcwd()
        root = _intutic_repo_root(cwd)
        rels = []
        for t in targets:
            absolute = _intutic_real(os.path.join(_intutic_real(cwd), t))
            rel = os.path.relpath(absolute, root)
            rels.append((t, None if rel == ".." or rel.startswith(".." + os.sep) or os.path.isabs(rel) else rel.replace(os.sep, "/")))
        for rollout in ("enforce", "shadow"):
            group = [r for r in scopes if r["rollout"] == rollout]
            if not group:
                continue
            union = [s for r in group for s in r["scopePaths"]]
            bad = [t for t, rel in rels if rel is None or not is_within_scope(rel, union)]
            if bad:
                r = group[0]
                line = _intutic_verdict(r, "OUT_OF_SCOPE", "scope_paths." + r["sopTitle"],
                                        ", ".join(bad) + " is outside scope_paths (" + ", ".join(union) + ")", {"paths": bad})
                if rollout == "enforce":
                    return line
                shadow = shadow or line
    plans = _intutic_records(records_text, "plan_approval")
    if plans and not is_plan_exempt_tool(str(tool)):
        for rollout in ("enforce", "shadow"):
            group = [r for r in plans if r["rollout"] == rollout]
            if not group:
                continue
            strict = [r for r in group if r["mode"] == "strict"]
            r = strict[0] if strict else group[0]
            level = r["mode"]
            rid = "plan_approval." + r["sopTitle"]
            line = ""
            if not session:
                line = _intutic_verdict(r, "PLAN_NOT_APPROVED", rid, "plan_approval: " + level + " - " + harness + " sent no session id, so no approved plan can be found for this call", {"tools": [str(tool)]})
            else:
                plan = _intutic_approved_plan(session, workspace_id)
                if plan is None:
                    line = _intutic_verdict(r, "PLAN_NOT_APPROVED", rid, "plan_approval: " + level + " - this session has no APPROVED or EXECUTING plan; get its plan approved, then retry", {"tools": [str(tool)]})
                elif level == "strict" and str(tool).lower() not in plan["tools"]:
                    line = _intutic_verdict(r, "OFF_PLAN", rid, "plan_approval: strict - " + str(tool) + " is not a step of the approved plan", {"tools": [str(tool)]})
            if line and rollout == "enforce":
                return line
            shadow = shadow or line
    return shadow


def intutic_phrase_rule(source, command):
    words = phrase_text(command)
    return any(has_phrase(words, p, True) for p in source.split("|"))


def intutic_mcp_registry(record_b64, tool):
    # The registry decision for one mcp__<server>__<tool> call, from the
    # snapshot's @mcp_registry record: "code<TAB>ruleId<TAB>reason", or "" to
    # let the call continue.
    call = split_mcp_tool_name(tool)
    registry = decode_registry_record(MCP_REGISTRY_RECORD_TAG + "\\t" + record_b64)
    if call is None or registry is None:
        return ""
    refusal = evaluate_registry(registry, call[0], call[1])
    return "\\t".join(refusal) if refusal else ""


def intutic_mcp_unverified(tool):
    # The refusal of an mcp__<server>__<tool> call on a snapshot that failed
    # its integrity check, as "code<TAB>ruleId<TAB>reason"; "" for a call that
    # is not an MCP call.
    call = split_mcp_tool_name(tool)
    return "\\t".join(unverified_refusal(call[0])) if call else ""


"""Fault injection in the hook gates, for chaos runs (intutic chaos run).

A transliteration of packages/shared-types/src/chaosGate.ts; read that
module's docstring for the counter files and why every count lives on disk.
In short: a gate is a new process per tool call, so the plan is decoded on
each call, plan_loaded is reported by whichever gate first creates
EVENTS.gate-plan-loaded, and each fault's seen and hit counts are numbered
empty files in EVENTS.gate-counters/, each number claimed with an exclusive
create (O_CREAT | O_EXCL), which exactly one process wins. A permission fault
never sleeps: it holds the call as an approval hold does, in a
FAULT.held.KEY.G file whose modification time is when, and the identical
retry is held again until delay_s has passed, then allowed (delay) or denied
(hold_then_deny) by the one retry that creates FAULT.released.KEY.G.

The bash gates emit this file verbatim (services/sync-daemon/src/lib/chaosPy.ts
holds a byte-identical copy, which a test compares), intutic_clawde.gate's
Gate.guard runs it in process, and every copy runs
packages/shared-types/fixtures/chaos-gate-vectors.json. It must stay
self-contained: the standard library only, no module state beyond the
constants below, and no backtick or dollar-brace, which the TypeScript copy
cannot hold.
"""

import base64
import binascii
import datetime
import json
import os
import re
import sys
import time

_CHAOS_FAULT_IDS = (
    "llm.rate_limit", "llm.upstream_5xx", "llm.context_trim", "llm.model_degrade", "tool.error", "tool.stale_data",
    "mcp.toolset_change", "permission.deny_or_delay", "inject.tool_result", "egress.dns_fail", "egress.credential_401",
)
_CHAOS_B64URL = re.compile(r"^[A-Za-z0-9_-]+={0,2}$")
_CHAOS_RUN_ID = re.compile(r"^[A-Za-z0-9_-]{6,64}$")
_CHAOS_CANARY = re.compile(r"^E-INTUTIC-[0-9A-F]{4,16}$")


def _chaos_int(v, low, high):
    # JSON numbers as JavaScript reads them: 2.0 is the integer 2. A bool is not a number.
    if isinstance(v, bool) or not isinstance(v, (int, float)):
        return None
    if isinstance(v, float):
        if not v.is_integer():
            return None
        v = int(v)
    return v if low <= v <= high else None


def chaos_decode(raw):
    """(plan, None), or (None, why it is not one)."""
    def invalid(why):
        return None, "INTUTIC_CHAOS_PLAN is not a valid plan: " + why
    try:
        if not isinstance(raw, str) or not _CHAOS_B64URL.match(raw):
            raise ValueError("alphabet")
        b64 = raw.rstrip("=")
        data = json.loads(base64.urlsafe_b64decode(b64 + "=" * ((4 - len(b64) % 4) % 4)).decode("utf-8"))
    except (ValueError, binascii.Error, UnicodeDecodeError):
        return None, "INTUTIC_CHAOS_PLAN is not base64url-encoded JSON"
    if not isinstance(data, dict):
        return invalid("not a JSON object")
    v = data.get("v")
    if isinstance(v, bool) or v != 1:
        return invalid("version " + json.dumps(v) + ", and a gate reads only version 1")
    run_id = data.get("runId")
    if not isinstance(run_id, str) or not _CHAOS_RUN_ID.match(run_id):
        return invalid("runId")
    canary = data.get("canary")
    if not isinstance(canary, str) or not _CHAOS_CANARY.match(canary):
        return invalid("canary")
    raw_faults = data.get("faults")
    if not isinstance(raw_faults, list) or len(raw_faults) > 50:
        return invalid("faults")
    faults = []
    for i, f in enumerate(raw_faults):
        at = "faults[" + str(i) + "]"
        if not isinstance(f, dict) or not isinstance(f.get("id"), str) or f["id"] not in _CHAOS_FAULT_IDS:
            return invalid(at + ".id")
        if f["id"] not in ("tool.error", "permission.deny_or_delay"):
            continue
        match = None
        if "match" in f:
            if not isinstance(f["match"], dict):
                return invalid(at + ".match")
            for k, mv in f["match"].items():
                if k not in ("tool", "host", "model") or not isinstance(mv, str) or not mv:
                    return invalid(at + ".match." + k)
            match = f["match"]
        after_calls = 0
        if "after_calls" in f:
            after_calls = _chaos_int(f["after_calls"], 0, 10000)
            if after_calls is None:
                return invalid(at + ".after_calls")
        times = None
        if "times" in f:
            times = _chaos_int(f["times"], 1, 10000)
            if times is None:
                return invalid(at + ".times")
        fault = {
            "index": i, "id": f["id"], "match": match, "after_calls": after_calls, "times": times,
            "message": "tool failed", "mode": "deny", "delay_s": 0,
        }
        if f["id"] == "tool.error" and "message" in f:
            # Lengths in UTF-16 code units, as JavaScript counts them.
            m = f["message"]
            if not isinstance(m, str) or not 1 <= len(m.encode("utf-16-le", "surrogatepass")) // 2 <= 2000:
                return invalid(at + ".message")
            fault["message"] = m
        if f["id"] == "permission.deny_or_delay":
            if "mode" in f:
                if f["mode"] not in ("deny", "delay", "hold_then_deny"):
                    return invalid(at + ".mode")
                fault["mode"] = f["mode"]
            if "delay_s" in f:
                delay_s = _chaos_int(f["delay_s"], 0, 600)
                if delay_s is None:
                    return invalid(at + ".delay_s")
                fault["delay_s"] = delay_s
        faults.append(fault)
    return {"runId": run_id, "canary": canary, "faults": faults}, None


def chaos_matches(match, tool):
    """Whether a fault's match covers a gate call, which has a tool and nothing else."""
    if not match:
        return True
    if "host" in match or "model" in match:
        return False
    p = match.get("tool")
    if p is None:
        return True
    return tool.endswith(p[1:]) if p.startswith("*") else tool == p


def chaos_event(plan, type_, fields, now):
    """One events-file line: ts, runId, component, type, then the fields that are set."""
    event = {"ts": now, "runId": plan["runId"], "component": "gate", "type": type_}
    for k, v in fields:
        if v is not None:
            event[k] = v
    return json.dumps(event, separators=(",", ":"), ensure_ascii=False) + "\\n"


def chaos_append(events_path, lines):
    """Appends whole lines in one write. An I/O error is reported, never raised."""
    try:
        fd = os.open(events_path, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o644)
        try:
            os.write(fd, lines.encode("utf-8"))
        finally:
            os.close(fd)
    except OSError as e:
        sys.stderr.write("[Intutic Governance] chaos: could not append to " + events_path + ": " + str(e) + "\\n")


def chaos_claim(directory, prefix, limit):
    """Claims the next numbered file DIRECTORY/PREFIXn with an exclusive create.

    Returns n, 0 when every number up to limit is taken, or -1 on an I/O
    error, after saying so.
    """
    try:
        # Beside the events file, never creating its directory: the runner did.
        try:
            os.mkdir(directory)
        except FileExistsError:
            pass
        n = sum(1 for name in os.listdir(directory) if name.startswith(prefix)) + 1
        while limit is None or n <= limit:
            try:
                os.close(os.open(os.path.join(directory, prefix + str(n)), os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o644))
                return n
            except FileExistsError:
                n += 1
        return 0
    except OSError as e:
        sys.stderr.write("[Intutic Governance] chaos: could not count calls in " + directory + ": " + str(e) + "\\n")
        return -1


def chaos_open_hold(directory, fault, key):
    """The open hold of one fault on one call: (g, created), the number of
    the newest FAULT.held.KEY.G file with no released twin and its
    modification time in milliseconds; None when there is none or it cannot
    be read."""
    try:
        held = str(fault) + ".held." + key + "."
        names = os.listdir(directory)
        g = 0
        for name in names:
            if name.startswith(held) and name[len(held):].isdigit():
                g = max(g, int(name[len(held):]))
        if g == 0 or (str(fault) + ".released." + key + "." + str(g)) in names:
            return None
        # In whole milliseconds, as now is: a hold is never younger than the call that reads it.
        return g, os.stat(os.path.join(directory, held + str(g))).st_mtime_ns // 1000000
    except OSError:
        # No counters yet, or none readable: no hold to continue.
        return None


def chaos_release(directory, fault, key, g):
    """Ends hold g with an exclusive create: True for the one caller that does."""
    try:
        os.close(os.open(os.path.join(directory, str(fault) + ".released." + key + "." + str(g)),
                         os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o644))
        return True
    except OSError:
        # Another gate released it first, or it cannot be written.
        return False


def _chaos_ms(now):
    # The ISO-8601 time a call is decided at, in milliseconds; the clock if unreadable.
    try:
        return round(datetime.datetime.fromisoformat(now.replace("Z", "+00:00")).timestamp() * 1000)
    except (AttributeError, TypeError, ValueError):
        return int(time.time() * 1000)


def chaos_now():
    """The time as the JavaScript gates write it: <TIMESTAMP>."""
    return datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="milliseconds").replace("+00:00", "Z")


def chaos_call(plan, events_path, call, now):
    """Reports one call and returns the fault the gate must apply, or None.

    call: tool, decision (allow, deny, ask or hold, before any fault), ruleId,
    destructive, policyHit, and key: the call's digest in hex (its tool and
    input, as the gate keys an approval hold), which a held call's retry
    shares. The fault: faultId, kind (deny or hold) and reason, as
    chaosGateCall returns it. now is the ISO-8601 time, and the clock a hold
    is timed by.
    """
    lines = ""
    first = True
    try:
        os.close(os.open(events_path + ".gate-plan-loaded", os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o644))
    except FileExistsError:
        first = False
    except OSError:
        pass
    if first:
        lines += chaos_event(plan, "plan_loaded", [("faults", len(plan["faults"]))], now)
    lines += chaos_event(plan, "gate_decision", [
        ("tool", call["tool"]),
        ("decision", call["decision"]),
        ("ruleId", call.get("ruleId") or None),
        ("destructive", bool(call.get("destructive"))),
        ("policyHit", bool(call.get("policyHit"))),
    ], now)
    fault = None
    if call["decision"] == "allow":
        directory = events_path + ".gate-counters"
        key = re.sub(r"[^0-9A-Za-z]", "", str(call.get("key") or ""))[:128] or "call"
        now_ms = _chaos_ms(now)
        tag = " [" + plan["canary"] + "]"
        held = "Permission held for approval; retrying this exact call passes once it is approved" + tag
        # The retry of a held call: still held until the delay has passed,
        # then let through or denied by the one retry that releases it.
        retry = False
        for f in plan["faults"]:
            if f["id"] != "permission.deny_or_delay" or f["mode"] == "deny" or not chaos_matches(f["match"], call["tool"]):
                continue
            open_hold = chaos_open_hold(directory, f["index"], key)
            if open_hold is None:
                continue
            retry = True
            if f["delay_s"] > 0 and now_ms - open_hold[1] < f["delay_s"] * 1000:
                fault = {"faultId": f["id"], "kind": "hold", "reason": held}
            elif chaos_release(directory, f["index"], key, open_hold[0]):
                if f["mode"] == "hold_then_deny":
                    fault = {"faultId": f["id"], "kind": "deny",
                             "reason": "Permission held for approval, then denied by approver" + tag}
            else:
                # Another gate released it first: this call is a new one.
                retry = False
                continue
            break
        for f in plan["faults"] if not retry else ():
            if not chaos_matches(f["match"], call["tool"]):
                continue
            # An MCP tool's error is the MCP proxy's to inject; a gate injects the built-in side.
            if f["id"] == "tool.error" and call["tool"].startswith("mcp__"):
                continue
            seen = chaos_claim(directory, str(f["index"]) + ".seen.", None)
            if fault is not None or seen < 1 or seen <= f["after_calls"]:
                continue
            if f["times"] is not None and chaos_claim(directory, str(f["index"]) + ".hit.", f["times"]) < 1:
                continue
            if f["id"] == "tool.error":
                fault = {"faultId": f["id"], "kind": "deny", "reason": f["message"] + tag}
            elif f["mode"] == "deny":
                fault = {"faultId": f["id"], "kind": "deny", "reason": "Permission denied by approver" + tag}
            else:
                # Held from now: the hold's file is what its retries find.
                if chaos_claim(directory, str(f["index"]) + ".held." + key + ".", None) < 1:
                    continue
                fault = {"faultId": f["id"], "kind": "hold", "reason": held}
            lines += chaos_event(plan, "fault_injected", [("faultId", f["id"]), ("call", seen), ("target", call["tool"])], now)
        if fault is None or fault["kind"] == "hold":
            lines += chaos_event(plan, "tool_call", [("tool", call["tool"]), ("ok", fault is None)], now)
    chaos_append(events_path, lines)
    return fault



def intutic_chaos_begin():
    # Why the chaos run's plan cannot be used, or "" when it can.
    plan, error = chaos_decode(os.environ.get("INTUTIC_CHAOS_PLAN", ""))
    if error:
        return error
    if not os.environ.get("INTUTIC_CHAOS_EVENTS"):
        return "INTUTIC_CHAOS_PLAN is set but INTUTIC_CHAOS_EVENTS is not, so nothing the run does could be reported"
    return ""


def intutic_chaos_call(tool, decision, rule_id, destructive, policy_hit, key=""):
    # Records one call as the gate decided it, before any fault; returns the
    # fault to apply to an allowed call as "kind<TAB>reason" (kind deny or
    # hold), or "". key is the call's digest, which a held call's retry shares.
    plan, error = chaos_decode(os.environ.get("INTUTIC_CHAOS_PLAN", ""))
    events = os.environ.get("INTUTIC_CHAOS_EVENTS", "")
    if error or not events:
        return ""
    call = {"tool": tool, "decision": decision, "ruleId": rule_id or None,
            "destructive": destructive == "1", "policyHit": policy_hit == "1", "key": key}
    fault = chaos_call(plan, events, call, chaos_now())
    if fault is None:
        return ""
    return fault["kind"] + "\\t" + fault["reason"]


_INTUTIC_DECIDE_CODES = {
    "allow": (None,),
    "refuse": ("DECIDE_REFUSED", "DECIDE_ESCALATED", "GOVERNANCE_UNAVAILABLE"),
    "escalate": ("DECIDE_ESCALATED",),
}


def intutic_decide_check(harness, tool, budget_ms, session_id, enforce, tool_input_json):
    # The decide tier of a bash gate: \`intutic decide check --stdin\` on a call
    # an @decide record names. Returns outcome, code, rule id and reason,
    # joined by the unit separator (an empty field where there is none). A
    # missing CLI, a non-zero exit, a timeout or an answer that does not read
    # is unavailable: refused with GOVERNANCE_UNAVAILABLE when a matched
    # record is stamped enforce (enforce "1"), allowed, with the reason, when
    # every one is shadow. The CLI spends the budget, its own start included.
    import json, shutil, subprocess
    sep = chr(31)

    def clean(text):
        return " ".join(str(text).split())

    def unavailable(why):
        if enforce != "1":
            return sep.join(["allow", "", "", clean(why)])
        return sep.join(["refuse", "GOVERNANCE_UNAVAILABLE", "", clean("GOVERNANCE_UNAVAILABLE — " + why)])

    try:
        tool_input = json.loads(tool_input_json or "{}")
    except ValueError:
        tool_input = {}
    exe = shutil.which("intutic")
    if not exe:
        return unavailable("the decide rules on " + tool + " need the intutic CLI, which is not on PATH")
    payload = {"v": 1, "harness": harness, "tool": tool, "toolInput": tool_input, "cwd": os.getcwd(),
               "sessionId": session_id, "budgetMs": int(budget_ms), "lastUserTurn": None}
    try:
        done = subprocess.run([exe, "decide", "check", "--stdin"], input=json.dumps(payload), capture_output=True,
                              text=True, timeout=int(budget_ms) / 1000.0)
    except subprocess.TimeoutExpired:
        return unavailable("intutic decide check did not answer within " + str(budget_ms) + " ms")
    except OSError as err:
        return unavailable("intutic decide check could not run (" + type(err).__name__ + ")")
    if done.returncode != 0:
        return unavailable("intutic decide check exited " + str(done.returncode))
    try:
        out = json.loads(done.stdout)
    except ValueError:
        out = None
    rule_id = out.get("ruleId") if isinstance(out, dict) else None
    if (not isinstance(out, dict) or out.get("v") != 1 or out.get("outcome") not in _INTUTIC_DECIDE_CODES
            or out.get("code") not in _INTUTIC_DECIDE_CODES[out.get("outcome")]
            or not (rule_id is None or (isinstance(rule_id, str) and rule_id.startswith("decide.")))
            or not isinstance(out.get("reason", ""), str)):
        return unavailable("intutic decide check gave an answer this gate does not read")
    return sep.join([out["outcome"], out.get("code") or "", clean(rule_id or ""), clean(out.get("reason") or "")])

INTUTIC_PY_LIB_END
export INTUTIC_PY_LIB

INTUTIC_FIELDS="$(printf '%s' "$INPUT" | python3 -c '
import os, sys, json
def clean(v):
    return " ".join(str(v).split()) if isinstance(v, str) else ""
state = "ok"
try:
    d = json.load(sys.stdin)
except Exception:
    d = {}
    state = "malformed"
if not isinstance(d, dict):
    d = {}
    state = "malformed"
# The envelope check githubCopilotHooks established, applied to the bash
# family: a payload carrying none of the tool fields in any known spelling is
# one the gate cannot evaluate, and extracting empty fields from it would
# match no rule — an allow. Reported as a STATE and decided in the gate body,
# because log_event is not defined yet at extraction time.
if state == "ok" and not any(
    k in d for k in ("tool_name", "toolName", "tool_input", "toolInput")
):
    state = "malformed"
i = d.get("tool_input") or {}
if not isinstance(i, dict):
    i = {}
def first(*keys):
    for k in keys:
        v = i.get(k)
        if isinstance(v, str) and v:
            return clean(v)
    return ""
def raw_first(*keys):
    for k in keys:
        v = i.get(k)
        if isinstance(v, str) and v:
            return v
    return ""
raw_command = raw_first("command", "cmd", "script", "shell_command")
tool_input_json = json.dumps(i, separators=(",", ":"), ensure_ascii=False)
# Too large to evaluate inside the hook timeout (gateLimits.ts): the gate body
# refuses on this line, and the command and arguments are not passed on.
command_bytes = len(raw_command.encode("utf-8", "surrogatepass"))
argument_bytes = len(tool_input_json.encode("utf-8", "surrogatepass"))
too_large = ""
if command_bytes > 262144:
    too_large = "the command is %d bytes, over the 262144-byte limit a gate evaluates; split it into smaller commands" % command_bytes
elif argument_bytes > 1048576:
    too_large = "the tool arguments are %d bytes, over the 1048576-byte limit a gate evaluates; write the content in smaller parts" % argument_bytes
if too_large:
    raw_command = ""
    tool_input_json = "{}"
# The hold classifier reads the raw command: a line continuation or a comment
# is still in it. The library is the shared phrase matcher, not a regex.
lib = {}
try:
    exec(os.environ.get("INTUTIC_PY_LIB", ""), lib)
    actions = lib["intutic_actions"](d.get("tool_name", ""), raw_command) if not too_large else " "
except Exception:
    actions = " "
# The state line comes FIRST: the lines after it may legitimately be empty,
# and command substitution strips trailing newlines, so the last line is the
# only position an empty value cannot survive in.
print(state)
print(too_large)
print(clean(d.get("tool_name", "")))
print(first("path", "file_path", "notebook_path", "filePath"))
print("" if too_large else first("command", "cmd", "script", "shell_command"))
print(clean(d.get("session_id", d.get("sessionId", ""))))
print(actions)
# The raw command as one JSON line, for phrase-subject rules.
print(json.dumps(raw_command, ensure_ascii=False))
# The FULL tool_input, serialized to the exact shape argPattern rules are
# matched against everywhere: JSON.stringify(tool_input) — compact separators,
# insertion order, non-ASCII intact. The selected fields above are whitespace-
# collapsed for token matching; this one must NOT be, or a WHERE clause that
# spans a key/value boundary matches here and not in the JS gates. json.dumps
# escapes every newline, so it is still exactly one line to read back.
print(tool_input_json)
' 2>/dev/null || printf '\\n\\n\\n\\n\\n\\n\\n\\n\\n')"

# Each read is \`|| true\` because command substitution strips trailing newlines:
# a tool call with no command argument yields fewer lines than reads, so a late
# read hits EOF and returns non-zero. Under \`set -e\` that killed the gate with
# **exit 1** — which every harness reads as a hook error and lets the call
# through. A guard that fails open on the most ordinary input there is (a Write
# with no shell command) is worse than no guard, because it looks present.
{ IFS= read -r INTUTIC_EXTRACT_STATE || true; IFS= read -r INTUTIC_TOO_LARGE || true; IFS= read -r TOOL || true; IFS= read -r TARGET || true; IFS= read -r COMMAND || true; IFS= read -r SESSION_ID || true; IFS= read -r INTUTIC_ACTIONS || true; IFS= read -r INTUTIC_RAW_COMMAND_JSON || true; IFS= read -r TOOL_INPUT_JSON || true; } <<EOF_INTUTIC_FIELDS
$INTUTIC_FIELDS
EOF_INTUTIC_FIELDS
TOOL="\${TOOL:-}"; TARGET="\${TARGET:-}"; COMMAND="\${COMMAND:-}"; SESSION_ID="\${SESSION_ID:-}"
# Space-padded action tokens the extractor's classifier found, or " ".
INTUTIC_ACTIONS="\${INTUTIC_ACTIONS:- }"
# Why the call is too large to evaluate, or empty (gateLimits.ts).
INTUTIC_TOO_LARGE="\${INTUTIC_TOO_LARGE:-}"
INTUTIC_RAW_COMMAND_JSON="\${INTUTIC_RAW_COMMAND_JSON:-""}"
# Empty means the extractor itself died (the fallback printf above): treat it
# exactly like a payload the parser rejected. The gate body refuses on any
# value other than "ok" — see the envelope refusal in emitShellGate.
INTUTIC_EXTRACT_STATE="\${INTUTIC_EXTRACT_STATE:-}"
[ -n "$INTUTIC_EXTRACT_STATE" ] || INTUTIC_EXTRACT_STATE="malformed"
# Empty only when the extractor failed wholesale (malformed stdin). Defaulting
# to the empty OBJECT rather than the empty string keeps the argPattern match
# well-defined either way.
TOOL_INPUT_JSON="\${TOOL_INPUT_JSON:-}"
[ -n "$TOOL_INPUT_JSON" ] || TOOL_INPUT_JSON="{}"
# Aliases for the names the older writers used. Kept so this extractor is a
# drop-in for every bash gate; the canonical names are the unsuffixed ones.
TOOL_NAME="$TOOL"; TARGET_PATH="$TARGET"


HOOK_EVENTS_LOG="<ROOT>/.intutic/events/hook-events.jsonl"

log_event() {
  local verdict="$1" tool="$2" reason="$3"
  # \`tool\` and \`reason\` carry agent-controlled text — the tool name, and the
  # target path quoted into the block reason — and both are spliced into the
  # JSON string below. Escape first: one unescaped quote yields a line
  # JSON.parse rejects, and drainHookEvents drops malformed lines then wipes the
  # log on a successful drain, so the record of a block is destroyed rather than
  # delayed. A crafted path could otherwise close the string and forge fields.
  tool="\${tool//\\\\/\\\\\\\\}";     tool="\${tool//\\"/\\\\\\"}"
  reason="\${reason//\\\\/\\\\\\\\}"; reason="\${reason//\\"/\\\\\\"}"
  # Every C0 control character, not just newline and carriage return. JSON
  # forbids all of U+0000-U+001F unescaped, so a plain TAB in a filename — no
  # adversary required — was still enough to produce a line JSON.parse rejects.
  # (NUL cannot appear in a bash variable, so the range starts at \\x01.)
  tool="\${tool//[$'\\x01'-$'\\x1f']/ }"; reason="\${reason//[$'\\x01'-$'\\x1f']/ }"
  # The workspace id is spliced into the same JSON string. It comes from
  # runtime.env on disk rather than from the agent, so it is lower risk — but a
  # value with a quote in it breaks every audit line the same way, and "lower
  # risk" is not "cannot happen" for a file the operator edits by hand.
  local ws="\${INTUTIC_WORKSPACE_ID}"
  ws="\${ws//\\\\/\\\\\\\\}"; ws="\${ws//\\"/\\\\\\"}"; ws="\${ws//[$'\\x01'-$'\\x1f']/ }"
  local ts; ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  # incidentId = sha1(timestamp + toolName + workspaceId).slice(0,16)
  local incident_id; incident_id="$(echo -n "\${ts}\${tool}\${INTUTIC_WORKSPACE_ID}" | sha1sum | cut -c1-16)"
  # The event's id: random, made once here, and resent with the line it is
  # written into, so the control plane processes the event once.
  local event_id; event_id="$(od -An -N16 -tx1 /dev/urandom 2>/dev/null | tr -d ' \\n' || true)"
  [ -n "$event_id" ] || event_id="$(date +%s)$$\${RANDOM}\${RANDOM}\${RANDOM}"
  local entry="{\\"event\\":\\"\${verdict}\\",\\"toolName\\":\\"\${tool}\\",\\"reason\\":\\"\${reason}\\",\\"workspaceId\\":\\"\${INTUTIC_WORKSPACE_ID}\\",\\"harnessType\\":\\"hermes\\",\\"incidentId\\":\\"\${incident_id}\\",\\"eventId\\":\\"\${event_id}\\",\\"timestamp\\":\\"\${ts}\\"}"
  # Path B: reliable file append (sync-daemon drains on FSEvents change)
  printf '%s\\n' "$entry" >> "$HOOK_EVENTS_LOG" 2>/dev/null || true
  # Path A: fire-and-forget HTTP POST (near-real-time dashboard, non-blocking)
  if [ -n "$INTUTIC_API_KEY" ]; then
    curl -sf -X POST "\${INTUTIC_HOST}/api/v1/hook-events" \\
      -H "Content-Type: application/json" \\
      -H "Authorization: Bearer \${INTUTIC_API_KEY}" \\
      -d "{\\"events\\":[$entry]}" \\
      --max-time 5 >/dev/null 2>&1 &
  fi
}


# ── Intutic gate body v23 — harness: hermes ────────────
# Generated by harness/gateBody.ts. Do not edit here; every harness regenerates.
#
# The harness name and version are stamped so this file identifies itself. Both
# were previously passed in and dropped on the floor: opts.harness was declared
# on the option type, supplied by all thirteen writers, and read nowhere.

# ── Post-tool outcome (gate body v23) ────────────────────────────────────────
# A post-tool invocation (--event post) records a test run's outcome for this
# session, or marks an earlier passing run stale after a file change, and
# always allows: the call has already run. Only where hermes's post-tool
# payload was captured and carries an exit code (POST_TOOL_OBSERVABLE: 0).
if [ "\${INTUTIC_POST_MODE:-0}" = "1" ]; then
  if [ "0" = "1" ]; then
    python3 -c 'import os, sys
lib = {}
exec(os.environ.get("INTUTIC_PY_LIB", ""), lib)
sys.stdout.write(lib["intutic_post_record"](sys.argv[1], sys.stdin.read()))' 'hermes' <<< "\${INPUT:-}" >/dev/null 2>&1 || true
  fi
  exit 0
fi

# ── Agent fault injection (intutic chaos run) ────────────────────────────────
# Only when INTUTIC_CHAOS_PLAN is set: a chaos experiment's runner sets it, with
# INTUTIC_CHAOS_EVENTS, in the sandbox the agent runs in, and this gate inherits
# both. The work is chaos.py in INTUTIC_PY_LIB, the transliteration of
# chaosGate.ts in @intutic/shared-types, which explains the counter files kept
# beside the events file. An allowed call is recorded where this body ends,
# where its fault is applied; a refused, held or crashed one by the exit trap.
# A fault applies only to an allowed call. Scoped to the bare invocation, like
# the envelope refusal below.
INTUTIC_CHAOS_ACTIVE=0
_intutic_chaos_done=0
_intutic_chaos_decision=deny
_intutic_chaos_rule=""
_intutic_chaos_hit=0
_intutic_chaos_destructive=0
# Records this call as decided ($1: allow, deny or hold) and prints the fault
# to apply to an allowed one, as kind and reason, tab-separated. $2 is the
# call's digest, which a held call's retry shares.
intutic_chaos_decide() {
  [ "$INTUTIC_CHAOS_ACTIVE" = "1" ] && [ "$_intutic_chaos_done" = "0" ] || return 0
  python3 -c 'import os, sys
lib = {}
exec(os.environ.get("INTUTIC_PY_LIB", ""), lib)
sys.stdout.write(lib["intutic_chaos_call"](*sys.argv[1:]))' "\${TOOL:-unknown}" "$1" "$_intutic_chaos_rule" "$_intutic_chaos_destructive" "$_intutic_chaos_hit" "\${2:-}" || true
}
# A rule fired without deciding the call (shadow, warn): its id, if none yet.
intutic_chaos_note() {
  [ -n "$_intutic_chaos_rule" ] || _intutic_chaos_rule="$1"
}
if [ -z "\${1:-}" ] && [ -n "\${INTUTIC_CHAOS_PLAN:-}" ]; then
  # A plan that is set but unreadable refuses, as an unreadable payload does:
  # an experiment run without the faults it asked for reports a resilience it
  # never measured.
  _intutic_chaos_err="$(python3 -c 'import os, sys
lib = {}
exec(os.environ.get("INTUTIC_PY_LIB", ""), lib)
sys.stdout.write(lib["intutic_chaos_begin"]())' 2>/dev/null || echo "INTUTIC_CHAOS_PLAN could not be read")"
  if [ -n "$_intutic_chaos_err" ]; then
    _intutic_chaos_err="\${_intutic_chaos_err} — refusing the call rather than running the experiment without the faults it asked for"
    echo "[Intutic Governance] BLOCKED: \${_intutic_chaos_err}" >&2
    log_event "tool_blocked" "\${TOOL:-unknown}" "\${_intutic_chaos_err}" || true
    exit 2
  fi
  INTUTIC_CHAOS_ACTIVE=1
fi

# Refuse an unreadable envelope before any rule is consulted.
#
# Unparseable stdin used to degrade to empty extracted fields, which match no
# rule — an ALLOW. Per each harness's contract this hook receives only
# PreToolUse events, so a payload from which neither a tool name nor a
# tool_input could be extracted is anomalous by definition: there is no such
# thing as a legitimate PreToolUse event with no tool call in it. Refusing is
# the posture githubCopilotHooks established for its Preview envelope, applied
# uniformly. INTUTIC_EXTRACT_STATE is set by SHELL_EXTRACT; the refusal lives
# here because log_event is not defined until after extraction runs.
#
# Scoped to the bare invocation: goose and openhands register post/stop
# invocations of this same script WITH arguments, and those events carry no
# tool call legitimately — refusing them would fail a hook that has nothing to
# gate. Every PreToolUse registration invokes the script with no arguments.
if [ -z "\${1:-}" ] && [ "\${INTUTIC_EXTRACT_STATE:-malformed}" != "ok" ]; then
  _intutic_env_reason="unrecognised PreToolUse payload — neither a tool name nor a tool_input could be extracted from stdin; refusing rather than allowing a call the gate cannot read"
  echo "[Intutic Governance] BLOCKED: \${_intutic_env_reason}" >&2
  log_event "tool_blocked" "unknown" "\${_intutic_env_reason}" || true
  exit 2
fi

# Refuse a call too large to evaluate inside the hook timeout, before any rule
# reads it (the extractor measured it; see gateLimits.ts). Scoped like the
# envelope refusal above: the post/stop invocations carry no call to gate.
if [ -z "\${1:-}" ] && [ -n "\${INTUTIC_TOO_LARGE:-}" ]; then
  echo "[Intutic Governance] BLOCKED: COMMAND_TOO_LARGE — \${INTUTIC_TOO_LARGE}" >&2
  log_event "tool_blocked" "\${TOOL:-unknown}" "COMMAND_TOO_LARGE — \${INTUTIC_TOO_LARGE}" || true
  exit 2
fi

# The static floor: compiled in, always enforced, never sourced from disk.
# These are the families with years of evidence behind them, so they block from
# the first run — before any sync has happened.
INTUTIC_FLOOR=(
  'bypass.chflags_nouchg	block	s	any	Governance bypass pattern: clearing the macOS immutable flag on a governance file	 chflags .*nouchg'
  'bypass.chattr_immutable	block	s	any	Governance bypass pattern: clearing the Linux immutable attribute on a governance file	 chattr .*-[a-zA-Z]*i'
  'bypass.chmod_governance	block	s	any	Governance bypass pattern: changing permissions on a governance file	 chmod .*(hooks|\\.intutic|\\.claude|\\.cursor)'
  'bypass.env_kill_switch	block	-	any	Governance bypass pattern: setting a harness environment variable that disables its hooks	 [A-Z][A-Z0-9_]*_HOOKS?='
  'hook_settings.vscode_key_written	block	-	content	Governance bypass pattern: setting chat.useHooks or chat.hookFilesLocations, which can switch off the GitHub Copilot governance hook. Change VS Code hook settings yourself, not through an agent.	chat\\.(useHooks|hookFilesLocations)(\\\\)?" *:'
  'hook_settings.vscode_key_command	block	-	command	Governance bypass pattern: a shell command naming chat.useHooks or chat.hookFilesLocations, which can switch off the GitHub Copilot governance hook. Change VS Code hook settings yourself, not through an agent.	chat\\.(useHooks|hookFilesLocations)'
  'secrets.aws_access_key	block	-	content	AWS access key ID detected in the content this call would write. Writing a live credential into a file is one commit away from shipping it; reference it from the environment instead.	(A3T[A-Z0-9]|AKIA|ASIA|ABIA|ACCA)[A-Z2-7][A-Z2-7][A-Z2-7][A-Z2-7][A-Z2-7][A-Z2-7][A-Z2-7][A-Z2-7][A-Z2-7][A-Z2-7][A-Z2-7][A-Z2-7][A-Z2-7][A-Z2-7][A-Z2-7][A-Z2-7]'
  'secrets.anthropic_api_key	block	-	content	Anthropic API key detected in the content this call would write. Writing a live credential into a file is one commit away from shipping it; reference it from the environment instead.	sk-ant-[A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-]*'
  'secrets.github_token	block	-	content	GitHub token detected in the content this call would write. Writing a live credential into a file is one commit away from shipping it; reference it from the environment instead.	gh[pousr]_[A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9]'
  'secrets.private_key_pem	block	-	content	PEM private key material detected in the content this call would write. Writing a live credential into a file is one commit away from shipping it; reference it from the environment instead.	-----BEGIN [A-Z ]*PRIVATE KEY-----'
  'secrets.openrouter_api_key	block	-	content	OpenRouter API key detected in the content this call would write. Writing a live credential into a file is one commit away from shipping it; reference it from the environment instead.	sk-or-v1-[A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9]*'
  'secrets.intutic_virtual_key	block	-	content	Intutic virtual key detected in the content this call would write. Writing a live credential into a file is one commit away from shipping it; reference it from the environment instead.	vk_[a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9]'
  'secrets.intutic_gateway_token	block	-	content	Intutic gateway token detected in the content this call would write. Writing a live credential into a file is one commit away from shipping it; reference it from the environment instead.	gwk_[a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9]'
  'secrets.stripe_secret_key	block	-	content	Stripe live secret key detected in the content this call would write. Writing a live credential into a file is one commit away from shipping it; reference it from the environment instead.	sk_live_[A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9]'
  'skill_surface.agents_skills_write	warn	-	target	Write or edit targets a .agents/skills/** skill file — advisory only, pending a false-positive measurement of scanSkillContent against real skill markdown	\\.agents/skills/'
  'skill_surface.claude_skills_write	warn	-	target	Write or edit targets a .claude/skills/** skill file — advisory only, pending a false-positive measurement of scanSkillContent against real skill markdown	\\.claude/skills/'
  'path.intutic_hooks	block	-	any	Shell command references the governance-protected path .intutic/hooks	\\.intutic/hooks'
  'path.intutic_integrity_json	block	-	any	Shell command references the governance-protected path .intutic/integrity.json	\\.intutic/integrity\\.json'
  'path.intutic_events	block	-	any	Shell command references the governance-protected path .intutic/events	\\.intutic/events'
  'path.intutic_env	block	-	any	Shell command references the governance-protected path .intutic/env	\\.intutic/env'
  'path.claude_settings_json	block	-	any	Shell command references the governance-protected path .claude/settings.json	\\.claude/settings\\.json'
  'path.claude_settings_local_json	block	-	any	Shell command references the governance-protected path .claude/settings.local.json	\\.claude/settings\\.local\\.json'
  'path.cursor_hooks_json	block	-	any	Shell command references the governance-protected path .cursor/hooks.json	\\.cursor/hooks\\.json'
  'path.etc_cursor_hooks_json	block	-	any	Shell command references the governance-protected path /etc/cursor/hooks.json	/etc/cursor/hooks\\.json'
  'path.Application_Support_Cursor_hooks_json	block	-	any	Shell command references the governance-protected path Application Support/Cursor/hooks.json	Application Support/Cursor/hooks\\.json'
  'path.ProgramData_backslash_Cursor_backslash_hooks_json	block	-	any	Shell command references the governance-protected path ProgramData\\Cursor\\hooks.json	ProgramData\\\\Cursor\\\\hooks\\.json'
  'path.ProgramData_Cursor_hooks_json	block	-	any	Shell command references the governance-protected path ProgramData/Cursor/hooks.json	ProgramData/Cursor/hooks\\.json'
  'path.clinerules_hooks	block	-	any	Shell command references the governance-protected path .clinerules/hooks	\\.clinerules/hooks'
  'path.codeium_windsurf_hooks_json	block	-	any	Shell command references the governance-protected path .codeium/windsurf/hooks.json	\\.codeium/windsurf/hooks\\.json'
  'path.codeium_hooks_json	block	-	any	Shell command references the governance-protected path .codeium/hooks.json	\\.codeium/hooks\\.json'
  'path.windsurf_hooks_json	block	-	any	Shell command references the governance-protected path .windsurf/hooks.json	\\.windsurf/hooks\\.json'
  'path.openhands_hooks_json	block	-	any	Shell command references the governance-protected path .openhands/hooks.json	\\.openhands/hooks\\.json'
  'path.gemini_settings_json	block	-	any	Shell command references the governance-protected path .gemini/settings.json	\\.gemini/settings\\.json'
  'path.gemini_config_hooks_json	block	-	any	Shell command references the governance-protected path .gemini/config/hooks.json	\\.gemini/config/hooks\\.json'
  'path.agents_hooks_json	block	-	any	Shell command references the governance-protected path .agents/hooks.json	\\.agents/hooks\\.json'
  'path.agents_plugins_intutic_governance	block	-	any	Shell command references the governance-protected path .agents/plugins/intutic-governance	\\.agents/plugins/intutic-governance'
  'path.muse_hooks_json	block	-	any	Shell command references the governance-protected path .muse/hooks.json	\\.muse/hooks\\.json'
  'path.config_muse_settings_json	block	-	any	Shell command references the governance-protected path .config/muse/settings.json	\\.config/muse/settings\\.json'
  'path.config_muse_intutic_managed_hooks_json	block	-	any	Shell command references the governance-protected path .config/muse/intutic-managed-hooks.json	\\.config/muse/intutic-managed-hooks\\.json'
  'path.grok_hooks	block	-	any	Shell command references the governance-protected path .grok/hooks	\\.grok/hooks'
  'path.grok_config_toml	block	-	any	Shell command references the governance-protected path .grok/config.toml	\\.grok/config\\.toml'
  'path.grok_trusted_folders_toml	block	-	any	Shell command references the governance-protected path .grok/trusted_folders.toml	\\.grok/trusted_folders\\.toml'
  'path.dsh_profiles	block	-	any	Shell command references the governance-protected path .dsh/profiles	\\.dsh/profiles'
  'path.dsh_cordis_patch_yml	block	-	any	Shell command references the governance-protected path .dsh/cordis.patch.yml	\\.dsh/cordis\\.patch\\.yml'
  'path.dsh_settings_yaml	block	-	any	Shell command references the governance-protected path .dsh/settings.yaml	\\.dsh/settings\\.yaml'
  'path.opencode_plugins	block	-	any	Shell command references the governance-protected path .opencode/plugins	\\.opencode/plugins'
  'path.opencode_plugin	block	-	any	Shell command references the governance-protected path .opencode/plugin	\\.opencode/plugin'
  'path.config_opencode_plugins	block	-	any	Shell command references the governance-protected path .config/opencode/plugins	\\.config/opencode/plugins'
  'path.pi_agent_extensions	block	-	any	Shell command references the governance-protected path .pi/agent/extensions	\\.pi/agent/extensions'
  'path.openclaw_openclaw_json	block	-	any	Shell command references the governance-protected path .openclaw/openclaw.json	\\.openclaw/openclaw\\.json'
  'path.pi_extensions	block	-	any	Shell command references the governance-protected path .pi/extensions	\\.pi/extensions'
  'path.codex_hooks_json	block	-	any	Shell command references the governance-protected path .codex/hooks.json	\\.codex/hooks\\.json'
  'path.codex_config_toml	block	-	any	Shell command references the governance-protected path .codex/config.toml	\\.codex/config\\.toml'
  'path.github_hooks_intutic_governance_json	block	-	any	Shell command references the governance-protected path .github/hooks/intutic-governance.json	\\.github/hooks/intutic-governance\\.json'
  'path.copilot_hooks_intutic_governance_json	block	-	any	Shell command references the governance-protected path .copilot/hooks/intutic-governance.json	\\.copilot/hooks/intutic-governance\\.json'
  'path.hermes_config_yaml	block	-	any	Shell command references the governance-protected path .hermes/config.yaml	\\.hermes/config\\.yaml'
  'path.config_goose_config_yaml	block	-	any	Shell command references the governance-protected path .config/goose/config.yaml	\\.config/goose/config\\.yaml'
  'path.open_webui_intutic_governance_filter_py	block	-	any	Shell command references the governance-protected path .open-webui/intutic-governance-filter.py	\\.open-webui/intutic-governance-filter\\.py'
)

# The dynamic tier, read from the policy snapshot. Additive only: it can turn an
# allow into a block, never a block into an allow. See policySnapshot.ts.
INTUTIC_SNAPSHOT_RULES="\${INTUTIC_SNAPSHOT_RULES:-$HOME/.intutic/hooks/policy-snapshot.rules}"
INTUTIC_SNAPSHOT_DIGEST="none"
INTUTIC_SNAPSHOT_STATE="absent"
INTUTIC_DYNAMIC=()

# A supported escape hatch, and the reason it exists is not politeness.
#
# The fastest workaround available to a developer wrongly blocked is
# \`chflags nouchg\` on the hook — the exact bypass the floor exists to stop. If
# the only way out is one we treat as an attack, we have manufactured our own
# adversary. So: an escape we can see, that disables the **dynamic tier only**.
# The floor is never disabled by it. Every invocation while it is set emits an
# event, so a machine running ungoverned is visible rather than quiet.
INTUTIC_GUARDS_DISABLED=0
if [ "\${INTUTIC_GUARD_DISABLE:-}" = "1" ]; then
  INTUTIC_GUARDS_DISABLED=1
  log_event "guards_disabled" "\${TOOL:-}" "INTUTIC_GUARD_DISABLE=1 — policy-snapshot rules skipped; built-in protections still active" || true
fi

INTUTIC_SNAPSHOT_WORKSPACE=""
INTUTIC_SNAPSHOT_GENERATED=""
# The per-server MCP allowlist (the @mcp_allowlist record, inside the digest).
# No record means the workspace set no list, and every server is allowed.
INTUTIC_MCP_ALLOWLIST=0
INTUTIC_MCP_SEVERITY=""
INTUTIC_MCP_SERVERS=""
# The MCP server registry record (base64 JSON, inside the digest).
INTUTIC_MCP_REGISTRY=""
# An OPAQUE workspace (the @intervention_mode record): a refusal on workspace
# policy tells the agent this sentence instead of the rule, and the audit line
# keeps the rule. Kept on a snapshot that fails its digest: it only ever hides
# text, never allows a call.
INTUTIC_OPAQUE=0
INTUTIC_OPAQUE_MESSAGE='Blocked by workspace policy. Ask a workspace admin if you need this action.'
# The snapshot format (the @format record; 1 without one), and the decide
# rules' @decide records, kept whole for the decide tier: this gate decodes
# none of them, the CLI does.
INTUTIC_SNAPSHOT_FORMAT=1
INTUTIC_DECIDE_RECORDS=()
# The @rule records (gate body v23), kept whole: the extractor's Python decodes
# them for the rule-record tiers below.
INTUTIC_RULE_RECORDS=()
if [ -f "$INTUTIC_SNAPSHOT_RULES" ]; then
  INTUTIC_SNAPSHOT_STATE="ok"
  while IFS= read -r _line || [ -n "$_line" ]; do
    case "$_line" in
      '#digest '*)      INTUTIC_SNAPSHOT_DIGEST="\${_line#\\#digest }" ;;
      '#workspace '*)   INTUTIC_SNAPSHOT_WORKSPACE="\${_line#\\#workspace }" ;;
      '#generated '*)   INTUTIC_SNAPSHOT_GENERATED="\${_line#\\#generated }" ;;
      '@mcp_allowlist'$'\\t'*)
        # Tag, severity and comma-joined servers, tab-separated — parameter
        # expansion only, no subshell. The writer drops a server name holding
        # whitespace or a comma, so neither separator can appear in one.
        INTUTIC_MCP_ALLOWLIST=1
        _intutic_mcp_rest="\${_line#*$'\\t'}"
        INTUTIC_MCP_SEVERITY="\${_intutic_mcp_rest%%$'\\t'*}"
        INTUTIC_MCP_SERVERS="\${_intutic_mcp_rest#*$'\\t'}"
        ;;
      '@mcp_registry'$'\\t'*) INTUTIC_MCP_REGISTRY="\${_line#*$'\\t'}" ;;
      '@intervention_mode'$'\\t''OPAQUE') INTUTIC_OPAQUE=1 ;;
      '@format'$'\\t'*)
        case "\${_line#*$'\\t'}" in ''|*[!0-9]*) : ;; *) INTUTIC_SNAPSHOT_FORMAT="\${_line#*$'\\t'}" ;; esac
        ;;
      '@decide'$'\\t'*) INTUTIC_DECIDE_RECORDS+=("$_line") ;;
      '@rule'$'\\t'*) INTUTIC_RULE_RECORDS+=("$_line") ;;
      '#'*|'') : ;;
      *) INTUTIC_DYNAMIC+=("$_line") ;;
    esac
  done < "$INTUTIC_SNAPSHOT_RULES"

  # A fallback line stands in for a decide rule a gate cannot evaluate. This
  # gate hands a decide rule to the CLI, which decodes its record and refuses
  # the call when it does not decode, so it skips the fallback line that an
  # @decide record of five columns names in its second. Any other line with
  # the prefix is enforced.
  if [ \${#INTUTIC_DECIDE_RECORDS[@]} -gt 0 ]; then
    _intutic_skip=$'\\n'
    for _rec in "\${INTUTIC_DECIDE_RECORDS[@]}"; do
      _intutic_tabs="\${_rec//[^$'\\t']/}"
      _intutic_fb="\${_rec#*$'\\t'}"
      _intutic_fb="\${_intutic_fb%%$'\\t'*}"
      if [ \${#_intutic_tabs} -eq 4 ] && [ -n "\${_rec##*$'\\t'}" ]; then
        case "$_intutic_fb" in 'decide-fallback:'*) _intutic_skip+="$_intutic_fb"$'\\n' ;; esac
      fi
    done
    _intutic_kept=()
    if [ \${#INTUTIC_DYNAMIC[@]} -gt 0 ]; then
      for _rec in "\${INTUTIC_DYNAMIC[@]}"; do
        case "$_intutic_skip" in *$'\\n'"\${_rec%%$'\\t'*}"$'\\n'*) continue ;; esac
        _intutic_kept+=("$_rec")
      done
    fi
    INTUTIC_DYNAMIC=()
    if [ \${#_intutic_kept[@]} -gt 0 ]; then INTUTIC_DYNAMIC=("\${_intutic_kept[@]}"); fi
  fi

  # A <kind>-fallback: line stands in for a rule record a gate cannot
  # evaluate. This gate evaluates requires_outcome,scope_paths,plan_approval, so it drops the fallback line a
  # decoded record of those kinds names. A python3 that cannot say keeps them all.
  if [ \${#INTUTIC_RULE_RECORDS[@]} -gt 0 ] && [ -n 'requires_outcome,scope_paths,plan_approval' ]; then
    _intutic_rskip="$(python3 -c 'import os, sys
lib = {}
exec(os.environ.get("INTUTIC_PY_LIB", ""), lib)
sys.stdout.write(lib["intutic_rule_skip"](sys.stdin.read(), sys.argv[1]))' 'requires_outcome,scope_paths,plan_approval' <<< "$(printf '%s\\n' "\${INTUTIC_RULE_RECORDS[@]}")" 2>/dev/null || true)"
    if [ -n "$_intutic_rskip" ] && [ \${#INTUTIC_DYNAMIC[@]} -gt 0 ]; then
      _intutic_rskip=$'\\n'"$_intutic_rskip"$'\\n'
      _intutic_kept=()
      for _rec in "\${INTUTIC_DYNAMIC[@]}"; do
        case "$_intutic_rskip" in *$'\\n'"\${_rec%%$'\\t'*}"$'\\n'*) continue ;; esac
        _intutic_kept+=("$_rec")
      done
      INTUTIC_DYNAMIC=()
      if [ \${#_intutic_kept[@]} -gt 0 ]; then INTUTIC_DYNAMIC=("\${_intutic_kept[@]}"); fi
    fi
  fi

  # A phrase rule that shares its id with an action rule is the partial form a
  # gate older than v23 holds by; this one holds by the action rule.
  if [ \${#INTUTIC_DYNAMIC[@]} -gt 0 ]; then
    _intutic_aids=$'\\n'
    for _rec in "\${INTUTIC_DYNAMIC[@]}"; do
      _r="\${_rec#*$'\\t'}"; _r="\${_r#*$'\\t'}"; _r="\${_r#*$'\\t'}"
      if [ "\${_r%%$'\\t'*}" = "action" ]; then _intutic_aids+="\${_rec%%$'\\t'*}"$'\\n'; fi
    done
    if [ "$_intutic_aids" != $'\\n' ]; then
      _intutic_kept=()
      for _rec in "\${INTUTIC_DYNAMIC[@]}"; do
        _r="\${_rec#*$'\\t'}"; _r="\${_r#*$'\\t'}"; _r="\${_r#*$'\\t'}"
        if [ "\${_r%%$'\\t'*}" = "phrase" ]; then
          case "$_intutic_aids" in *$'\\n'"\${_rec%%$'\\t'*}"$'\\n'*) continue ;; esac
        fi
        _intutic_kept+=("$_rec")
      done
      INTUTIC_DYNAMIC=()
      if [ \${#_intutic_kept[@]} -gt 0 ]; then INTUTIC_DYNAMIC=("\${_intutic_kept[@]}"); fi
    fi
  fi

  # Integrity, in the order that fails cheapest first.
  #
  # All three of these were parsed and then ignored. A digest nobody recomputes
  # is not integrity, it is a comment; and a workspace id nobody compares means a
  # snapshot from workspace A dropped onto workspace B's machine is enforced
  # verbatim, with B's audit events attributing A's rules to B.
  _intutic_body="$(grep -v '^#' "$INTUTIC_SNAPSHOT_RULES" | grep -v '^$' || true)"
  _intutic_actual=""
  if command -v shasum >/dev/null 2>&1; then
    _intutic_actual="$(printf '%s' "$_intutic_body" | shasum -a 256 | cut -c1-32)"
  elif command -v sha256sum >/dev/null 2>&1; then
    _intutic_actual="$(printf '%s' "$_intutic_body" | sha256sum | cut -c1-32)"
  fi

  if [ -n "$_intutic_actual" ] && [ "$_intutic_actual" != "$INTUTIC_SNAPSHOT_DIGEST" ]; then
    INTUTIC_SNAPSHOT_STATE="invalid"
  elif [ -n "$INTUTIC_SNAPSHOT_WORKSPACE" ] && [ -n "\${INTUTIC_WORKSPACE_ID:-}" ]        && [ "$INTUTIC_SNAPSHOT_WORKSPACE" != "$INTUTIC_WORKSPACE_ID" ]; then
    INTUTIC_SNAPSHOT_STATE="invalid"
  elif [ \${#INTUTIC_DYNAMIC[@]} -eq 0 ]; then
    # Distinct from "absent". The writer always ships the destructive tier, so a
    # rule-less snapshot means the compile produced nothing — a real fault that
    # otherwise looks exactly like a healthy quiet workspace.
    INTUTIC_SNAPSHOT_STATE="empty"
  fi

  # Degrade to the compiled floor. The dynamic tier is additive, so dropping it
  # returns to yesterday's behaviour rather than opening a hole.
  # The SSO-group refusals survive it: they only ever refuse, and dropping
  # them would make editing the member's group list in this file a way to
  # clear a tool the workspace's group policy refuses.
  if [ "$INTUTIC_SNAPSHOT_STATE" = "invalid" ]; then
    _intutic_kept=()
    if [ \${#INTUTIC_DYNAMIC[@]} -gt 0 ]; then
      for _rec in "\${INTUTIC_DYNAMIC[@]}"; do
        case "$_rec" in
          sso_group.*$'\\t'block$'\\t'*) _intutic_kept+=("$_rec") ;;
        esac
      done
    fi
    INTUTIC_DYNAMIC=()
    if [ \${#_intutic_kept[@]} -gt 0 ]; then INTUTIC_DYNAMIC=("\${_intutic_kept[@]}"); fi
    # Neither MCP record can be vouched for, and a deleted one looks like one
    # never set: the snapshot admits no MCP server (the refusal below).
    INTUTIC_MCP_REGISTRY=""
    INTUTIC_MCP_ALLOWLIST=0
    # The decide and rule records go with the rest of the dynamic tier.
    INTUTIC_DECIDE_RECORDS=()
    INTUTIC_RULE_RECORDS=()
  fi
fi

# Staleness governs alerting, not enforcement: rules stay in force. If they
# expired into permissiveness, "kill the daemon and wait" would be a supported
# way to disarm governance.
if [ "$INTUTIC_SNAPSHOT_STATE" = "ok" ] && [ -n "$INTUTIC_SNAPSHOT_GENERATED" ]; then
  _intutic_age_days="$(python3 -c 'import sys,datetime
try:
    t=datetime.datetime.fromisoformat(sys.argv[1].replace("Z","+00:00"))
    print(int((datetime.datetime.now(datetime.timezone.utc)-t).total_seconds()//86400))
except Exception:
    print(0)' "$INTUTIC_SNAPSHOT_GENERATED" 2>/dev/null || echo 0)"
  if [ "$_intutic_age_days" -gt 7 ] 2>/dev/null; then
    INTUTIC_SNAPSHOT_STATE="stale"
  fi
fi

case "$INTUTIC_SNAPSHOT_STATE" in
  absent)  log_event "snapshot_absent" "\${TOOL:-}" "No policy snapshot at $INTUTIC_SNAPSHOT_RULES — built-in protections only" || true ;;
  invalid) log_event "snapshot_invalid" "\${TOOL:-}" "Policy snapshot failed its digest or workspace check — dynamic rules dropped except SSO-group refusals, and every MCP call refused" || true ;;
  empty)   log_event "snapshot_empty" "\${TOOL:-}" "Policy snapshot contains no rules — the compile produced nothing" || true ;;
  stale)   log_event "snapshot_stale" "\${TOOL:-}" "Policy snapshot is \${_intutic_age_days} days old and still enforced" || true ;;
esac
if [ "$INTUTIC_SNAPSHOT_FORMAT" -gt 3 ]; then
  log_event "snapshot_format_newer" "\${TOOL:-}" "Policy snapshot format $INTUTIC_SNAPSHOT_FORMAT is newer than this gate reads (3) — records it does not know are skipped and their fallback lines enforced" || true
fi

# Normalise once; every pattern is written against this shape. The extractor
# hands each field over with its whitespace already collapsed to single spaces
# by Python, Unicode whitespace included, which bash cannot match; padding is
# all that is left to do. Bash substitutions over a 256 KiB command to find no
# whitespace left took most of a second on a loaded machine.
INTUTIC_NCOMMAND=" \${COMMAND:-} "
INTUTIC_NTARGET=" \${TARGET:-} "
INTUTIC_NTOOL=" \${TOOL:-} "

# ── Hold tier (gate body v8) ─────────────────────────────────────────────────
# A \`hold\` rule refuses the call and records it for a human; an exact,
# unexpired approved bypass the daemon cached lets the same call through once.
# All local — a file read, a file write and an exit code; no network on the
# tool path.
INTUTIC_REVIEW_REQUEST_FILE="\${INTUTIC_REVIEW_REQUESTS:-}"
if [ -z "$INTUTIC_REVIEW_REQUEST_FILE" ]; then
  INTUTIC_REVIEW_REQUEST_FILE="$(cd "$(dirname "$0")/.." 2>/dev/null && pwd)/events/review-requests.jsonl"
fi
INTUTIC_APPROVED_BYPASSES="\${INTUTIC_APPROVED_BYPASSES:-$HOME/.intutic/hooks/approved-bypasses.jsonl}"
intutic_sha256() {
  if command -v shasum >/dev/null 2>&1; then shasum -a 256 | cut -c1-64
  elif command -v sha256sum >/dev/null 2>&1; then sha256sum | cut -c1-64
  else printf ''; fi
}
intutic_json_escape() {
  printf '%s' "$1" | sed -e 's/\\\\/\\\\\\\\/g' -e 's/"/\\\\"/g' | tr -d '\\n\\r\\t'
}
# What the agent reads of a refusal on workspace policy, in _intutic_shown: the
# reason ($1), or in an OPAQUE workspace the generic sentence. The audit line
# is always written with the full reason.
intutic_shown() {
  if [ "$INTUTIC_OPAQUE" = "1" ]; then _intutic_shown="$INTUTIC_OPAQUE_MESSAGE"; else _intutic_shown="$1"; fi
}
# Looks for a valid, unexpired, EXACT-match approved bypass. Prints nothing
# and returns 1 on ANY reason not to bypass: missing file, failed digest or
# workspace check, no matching line, or an entry whose expiresAt has passed —
# every one of which falls through to the hold. Key material is computed the
# same way the JS gate and the control plane compute it: the normalised tool
# name, and sha256(normalised command, NUL, normalised target).
intutic_bypass() {
  local rid="$1" tn="$2" th="$3" hdr_digest hdr_ws body actual now line exp
  [ -n "$th" ] || return 1
  [ -r "$INTUTIC_APPROVED_BYPASSES" ] || return 1
  hdr_digest="$(grep -m1 '^#digest ' "$INTUTIC_APPROVED_BYPASSES" | cut -d' ' -f2 || true)"
  hdr_ws="$(grep -m1 '^#workspace ' "$INTUTIC_APPROVED_BYPASSES" | cut -d' ' -f2 || true)"
  body="$(grep -v '^#' "$INTUTIC_APPROVED_BYPASSES" | grep -v '^$' || true)"
  [ -n "$body" ] || return 1
  actual="$(printf '%s' "$body" | intutic_sha256 | cut -c1-32)"
  [ -n "$actual" ] && [ "$actual" = "$hdr_digest" ] || return 1
  if [ -n "$hdr_ws" ] && [ "$hdr_ws" != "\${INTUTIC_WORKSPACE_ID:-}" ]; then return 1; fi
  now="$(date -u +%Y-%m-%dT%H:%M:%S)"
  while IFS= read -r line; do
    case "$line" in *'"workspaceId":"'"\${INTUTIC_WORKSPACE_ID:-}"'"'*) ;; *) continue ;; esac
    case "$line" in *'"sopRuleId":"'"$rid"'"'*) ;; *) continue ;; esac
    case "$line" in *'"toolNameNormalized":"'"$tn"'"'*) ;; *) continue ;; esac
    case "$line" in *'"targetHash":"'"$th"'"'*) ;; *) continue ;; esac
    exp="$(printf '%s' "$line" | sed -n 's/.*"expiresAt":"\\([^"]*\\)".*/\\1/p')"
    [ -n "$exp" ] || continue
    # ISO-8601 UTC timestamps compare lexically; a past expiry fails closed
    # toward the hold, however fresh the file is.
    if [[ "$exp" > "$now" ]]; then
      printf '%s' "$line"; return 0
    fi
  done <<< "$body"
  return 1
}
# Returns 0 when an approved bypass lets the call through (the caller
# continues), 2 when the call is held (the caller refuses).
intutic_hold() {
  local rid="$1" rreason="$2" tn th entry decided_by hold_id at file targeth hint
  tn="$INTUTIC_NTOOL"
  th="$( { printf '%s' "$INTUTIC_NCOMMAND"; printf '\\0'; printf '%s' "$INTUTIC_NTARGET"; } | intutic_sha256 )"
  if entry="$(intutic_bypass "$rid" "$tn" "$th")"; then
    decided_by="$(printf '%s' "$entry" | sed -n 's/.*"decidedBy":"\\([^"]*\\)".*/\\1/p')"
    hold_id="$(printf '%s' "$entry" | sed -n 's/.*"holdId":"\\([^"]*\\)".*/\\1/p')"
    echo "[Intutic Guardrail] BYPASSED: Approved bypass for \${rid} — approved by \${decided_by} on hold \${hold_id}" >&2
    log_event "hold_approved_bypass_used" "\${TOOL:-}" "Approved bypass for \${rid} — approved by \${decided_by} on hold \${hold_id}" || true
    return 0
  fi
  hold_id="hold_$(printf '%x' "$(date +%s)")_$(printf '%04x%04x' "$RANDOM" "$RANDOM")"
  at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  targeth=""
  [ -n "$th" ] && targeth="$(printf ',"targetHash":"%s"' "$th")"
  file="$INTUTIC_REVIEW_REQUEST_FILE"
  # The hold still blocks even if the record cannot be written — the exit code
  # is what stops the tool. But say so: a hold nobody can review is the worst
  # of both outcomes.
  if ! { mkdir -p "$(dirname "$file")" 2>/dev/null && printf '{"v":1,"holdId":"%s","reason":"%s","tool":"%s","sessionId":"%s","workspaceId":"%s","at":"%s","toolNameNormalized":"%s"%s}\\n' \\
      "$hold_id" "$(intutic_json_escape "$rid")" "$(intutic_json_escape "\${TOOL:-}")" "$(intutic_json_escape "\${SESSION_ID:-}")" \\
      "$(intutic_json_escape "\${INTUTIC_WORKSPACE_ID:-}")" "$at" "$(intutic_json_escape "$tn")" "$targeth" >> "$file" 2>/dev/null; }; then
    echo "[Intutic Guardrail] could not record the hold at \${file}" >&2
  fi
  # Who may approve, and when the retry passes (holdMessages.ts in shared-types).
  hint='An Owner, Admin or EM can approve it with: intutic decision approve {holdId} (or reject it: intutic decision reject {holdId}). Retrying this exact call passes after approval only if the workspace has turned on the review-hold bypass; otherwise it is held again.'
  hint="\${hint//\\{holdId\\}/$hold_id}"
  intutic_shown "\${rreason} [\${rid}]"
  echo "[Intutic Guardrail] HELD: \${_intutic_shown} \${hint}" >&2
  log_event "tool_held" "\${TOOL:-}" "\${rreason} [\${rid}]" || true
  return 2
}

# A rule declares which part of the call it matches. \`any\` means command and
# target — never the tool name, because a pattern like \`\\.claude/settings\\.json\`
# would otherwise be tested against "Write" and quietly match nothing.
#
# Whether a rule fires on this call sets _intutic_fires to 1 or 0; the function
# always returns 0, so it runs under set -e like the rest of the gate. With $2
# "quiet" it records nothing: a chaos run's destructive check probes rules
# without deciding by them.
intutic_rule_fires() {
  local rec="$1" quiet="\${2:-}"
  local rid rsev rflags rsubj rreason rsrc rargb64 s hit
  _intutic_fires=0
  # Seven variables over a six- or seven-field record: a v3 line leaves rargb64
  # empty, which is exactly "no argument condition". The base64 column cannot
  # contain a tab, so the last variable never absorbs a separator.
  IFS=$'\\t' read -r rid rsev rflags rsubj rreason rsrc rargb64 <<< "$rec"
  [ -z "$rsrc" ] && return 0
  local _subs=() _ci=
  case "$rflags" in *i*) _ci=i ;; esac
  # A subject the screen below cleared for this case is left out: no pattern
  # matched it, this rule's included.
  case "$rsubj" in
    tool)    intutic_unscreened tool "$_ci" && _subs=("$INTUTIC_NTOOL") ;;
    command) intutic_unscreened command "$_ci" && _subs=("$INTUTIC_NCOMMAND") ;;
    target)  intutic_unscreened target "$_ci" && _subs=("$INTUTIC_NTARGET") ;;
    # Serialized tool input, un-normalised — same subject the WHERE argPattern
    # machinery matches. The secrets.* floor rules ride this. Guaranteed
    # non-empty by the extractor (it defaults to "{}").
    content) intutic_unscreened content "$_ci" && _subs=("$TOOL_INPUT_JSON") ;;
    # The space-padded action tokens the extractor's classifier derived from
    # the raw command (" action:deploy "), so a hold on \`action:deploy\`
    # matches whole tokens.
    action)  intutic_unscreened action "$_ci" && _subs=("$INTUTIC_ACTIONS") ;;
    # The source is |-separated phrases matched as words against the raw
    # command by the phrase matcher in Python, not a regex: grep is linear,
    # but the gap between the words was not expressible without one that
    # backtracks in the other gates. One python3 run, only for these rules.
    # The command goes in on stdin: as an argument, a long one would exceed
    # the kernel's per-argument limit and the rule would silently not run.
    phrase)
      if python3 -c 'import os, sys, json
lib = {}
exec(os.environ.get("INTUTIC_PY_LIB", ""), lib)
sys.exit(0 if lib["intutic_phrase_rule"](sys.argv[1], json.load(sys.stdin)) else 1)' "$rsrc" <<< "$INTUTIC_RAW_COMMAND_JSON" 2>/dev/null; then
        _subs=("$INTUTIC_NCOMMAND")
      else
        return 0
      fi
      ;;
    # Each field is tested separately rather than concatenated. Joining them
    # lets a pattern match across the seam — a command ending in "chflags" and
    # an unrelated target starting with "nouchg" would trip the bypass rule
    # together while neither does alone.
    *)
      intutic_unscreened command "$_ci" && _subs+=("$INTUTIC_NCOMMAND")
      intutic_unscreened target "$_ci" && _subs+=("$INTUTIC_NTARGET")
      ;;
  esac
  [ \${#_subs[@]} -gt 0 ] || return 0
  hit=0
  [ "$rsubj" = "phrase" ] && hit=1
  for s in "\${_subs[@]}"; do
    [ "$rsubj" = "phrase" ] && break
    # Flags: i = case-insensitive; s (a sequence rule) changes nothing here —
    # grep matches with an automaton, linear in the text, so the regex runs
    # as written.
    case "$rflags" in
      *i*) printf '%s' "$s" | grep -qiE -- "$rsrc" && hit=1 ;;
      *)   printf '%s' "$s" | grep -qE -- "$rsrc" && hit=1 ;;
    esac
  done
  [ "$hit" = "1" ] || return 0
  # The argument condition of a WHERE rule. The tool-name half has matched; the
  # rule fires only if the argPattern also matches the serialized tool input —
  # the same json.dumps(tool_input, separators=(",",":"), ensure_ascii=False)
  # shape matchSopRule and the intutic-clawde gate port pin, produced once by
  # the extractor above. Evaluated by python3 re, not grep: these patterns are
  # authored as JS regexes and routinely use lookahead, which no grep has.
  # Fail-safe direction: a pattern python cannot compile (exit 2) downgrades
  # THIS rule to name-only — today's behaviour, plus a rule_downgraded event —
  # rather than silently dropping the rule, which would fail open.
  if [ -n "$rargb64" ]; then
    _intutic_arg_rc=0
    python3 -c '
import sys, base64, re
try:
    pat = base64.b64decode(sys.argv[1], validate=True).decode("utf-8")
except Exception:
    sys.exit(2)
try:
    rx = re.compile(pat)
except re.error:
    sys.exit(2)
sys.exit(0 if rx.search(sys.argv[2]) else 1)
' "$rargb64" "\${TOOL_INPUT_JSON:-}" 2>/dev/null || _intutic_arg_rc=$?
    if [ "$_intutic_arg_rc" = "1" ]; then
      return 0
    elif [ "$_intutic_arg_rc" != "0" ] && [ -z "$quiet" ]; then
      log_event "rule_downgraded" "\${TOOL:-}" "argPattern for \${rid} did not compile in python re — rule enforced name-only" || true
    fi
  fi
  _intutic_fires=1
}

intutic_apply() {
  local rec="$1"
  local rid rsev rflags rsubj rreason rsrc rargb64
  IFS=$'\\t' read -r rid rsev rflags rsubj rreason rsrc rargb64 <<< "$rec"
  [ -z "$rsrc" ] && return 0
  # The escape hatch skips the DESTRUCTIVE family only. It is not a way to turn
  # off a workspace's own BLOCK: SOP rules — those are what the customer asked
  # for, and one environment variable disarming them would make the switch the
  # first thing an agent sets. Keyed on the rule-id family, which the snapshot
  # writer assigns: destructive.* versus sop.*
  if [ "$INTUTIC_GUARDS_DISABLED" = "1" ]; then
    case "$rid" in
      destructive.*) return 0 ;;
    esac
  fi
  # The tier order (gate body v23): every refusal first, the holds after the
  # rule records and the MCP checks. A hold is only ever decided on a call
  # nothing deterministic refused.
  case "\${_intutic_pass:-all}" in
    det) [ "$rsev" = "hold" ] && return 0 ;;
    hold) [ "$rsev" = "hold" ] || return 0 ;;
  esac
  intutic_rule_fires "$rec"
  [ "$_intutic_fires" = "1" ] || return 0
  if [ "$rsev" = "shadow" ]; then
    intutic_chaos_note "$rid"
    log_event "tool_would_block" "\${TOOL:-}" "\${rreason} [\${rid}]" || true
    return 0
  fi
  if [ "$rsev" = "hold" ]; then
    # Not a permanent denial: the action is legitimate, someone asked to see
    # it first. A bypass they approved lets this exact call through once.
    _intutic_chaos_rule="$rid"; _intutic_chaos_hit=1
    if intutic_hold "$rid" "$rreason"; then return 0; fi
    _intutic_chaos_decision=hold
    exit 2
  fi
  if [ "$rsev" = "warn" ]; then
    # Advisory tier: allowed, and recorded with enough shape to triage.
    #
    # The rule id alone was not enough. The warn tier exists to earn promotion to
    # block from a measured false-positive rate, and you cannot call a flag true
    # or false without seeing something of what was run. So: the first token of
    # the command, and nothing else. That is the verb — curl, git, rm — which is
    # what distinguishes "a real destructive command" from "a false positive on a
    # build script", and it carries no paths, no arguments, no secrets. The full
    # command stays out deliberately; that is what DLP exists to keep out of
    # telemetry.
    _intutic_verb="\${INTUTIC_NCOMMAND# }"
    _intutic_verb="\${_intutic_verb%% *}"
    intutic_chaos_note "$rid"
    log_event "tool_flagged" "\${TOOL:-}" "\${rreason} [\${rid}] verb=\${_intutic_verb}" || true
    return 0
  fi
  # The rule's own reason, not a generic one: hookEvents.resolveSeverity reads
  # this text for "governance-protected" to file the incident CRITICAL.
  local reason="\${rreason} [\${rid}]"
  _intutic_chaos_rule="$rid"; _intutic_chaos_hit=1
  intutic_shown "$reason"
  echo "[Intutic Governance] BLOCKED: \${_intutic_shown}" >&2
  log_event "tool_blocked" "\${TOOL:-}" "\${reason}"
  exit 2
}

# ── Screening ────────────────────────────────────────────────────────────────
# Rule by rule, the gate forks a grep per rule and subject: about a hundred on
# every call, which on a loaded machine took seconds before any rule could
# match. So each subject is first screened by one grep holding every pattern
# that tests it, the case-insensitive ones apart. A subject none of them
# matches is left out of every rule that tests it, since no one of them could
# match it either. A screen that matches, or one grep cannot run (exit 2),
# clears nothing, and the rules decide as before: the screen saves work and
# never changes a verdict. grep is still the engine, so the screen is linear too.
_intutic_screen_tool=(); _intutic_screen_tooli=(); _intutic_clear_tool=; _intutic_clear_tooli=
_intutic_screen_command=(); _intutic_screen_commandi=(); _intutic_clear_command=; _intutic_clear_commandi=
_intutic_screen_target=(); _intutic_screen_targeti=(); _intutic_clear_target=; _intutic_clear_targeti=
_intutic_screen_content=(); _intutic_screen_contenti=(); _intutic_clear_content=; _intutic_clear_contenti=
_intutic_screen_action=(); _intutic_screen_actioni=(); _intutic_clear_action=; _intutic_clear_actioni=
intutic_screen_add() {
  case "$1$2" in
    tool) _intutic_screen_tool+=(-e "$3") ;;
    tooli) _intutic_screen_tooli+=(-e "$3") ;;
    command) _intutic_screen_command+=(-e "$3") ;;
    commandi) _intutic_screen_commandi+=(-e "$3") ;;
    target) _intutic_screen_target+=(-e "$3") ;;
    targeti) _intutic_screen_targeti+=(-e "$3") ;;
    content) _intutic_screen_content+=(-e "$3") ;;
    contenti) _intutic_screen_contenti+=(-e "$3") ;;
    action) _intutic_screen_action+=(-e "$3") ;;
    actioni) _intutic_screen_actioni+=(-e "$3") ;;
  esac
}
for _rec in "\${INTUTIC_FLOOR[@]}" \${INTUTIC_DYNAMIC[@]+"\${INTUTIC_DYNAMIC[@]}"}; do
  IFS=$'	' read -r _r_id _r_sev _r_flags _r_subj _r_reason _r_src _r_arg <<< "$_rec"
  [ -n "$_r_src" ] || continue
  _r_ci=
  case "$_r_flags" in *i*) _r_ci=i ;; esac
  case "$_r_subj" in
    tool|command|target|content|action) intutic_screen_add "$_r_subj" "$_r_ci" "$_r_src" ;;
    phrase) : ;;
    *) intutic_screen_add command "$_r_ci" "$_r_src"; intutic_screen_add target "$_r_ci" "$_r_src" ;;
  esac
done
# $1 subject, $2 "i" or empty, $3 its text, then the patterns as -e pairs.
intutic_screen() {
  local key="$1" ci="$2" text="$3" rc=0
  shift 3
  if [ "$ci" = "i" ]; then printf '%s' "$text" | grep -qiE "$@" || rc=$?
  else printf '%s' "$text" | grep -qE "$@" || rc=$?
  fi
  [ "$rc" != "1" ] || printf -v "_intutic_clear_$key$ci" '%s' 1
}
[ \${#_intutic_screen_tool[@]} -eq 0 ] || intutic_screen tool '' "$INTUTIC_NTOOL" "\${_intutic_screen_tool[@]}"
[ \${#_intutic_screen_tooli[@]} -eq 0 ] || intutic_screen tool i "$INTUTIC_NTOOL" "\${_intutic_screen_tooli[@]}"
[ \${#_intutic_screen_command[@]} -eq 0 ] || intutic_screen command '' "$INTUTIC_NCOMMAND" "\${_intutic_screen_command[@]}"
[ \${#_intutic_screen_commandi[@]} -eq 0 ] || intutic_screen command i "$INTUTIC_NCOMMAND" "\${_intutic_screen_commandi[@]}"
[ \${#_intutic_screen_target[@]} -eq 0 ] || intutic_screen target '' "$INTUTIC_NTARGET" "\${_intutic_screen_target[@]}"
[ \${#_intutic_screen_targeti[@]} -eq 0 ] || intutic_screen target i "$INTUTIC_NTARGET" "\${_intutic_screen_targeti[@]}"
[ \${#_intutic_screen_content[@]} -eq 0 ] || intutic_screen content '' "$TOOL_INPUT_JSON" "\${_intutic_screen_content[@]}"
[ \${#_intutic_screen_contenti[@]} -eq 0 ] || intutic_screen content i "$TOOL_INPUT_JSON" "\${_intutic_screen_contenti[@]}"
[ \${#_intutic_screen_action[@]} -eq 0 ] || intutic_screen action '' "$INTUTIC_ACTIONS" "\${_intutic_screen_action[@]}"
[ \${#_intutic_screen_actioni[@]} -eq 0 ] || intutic_screen action i "$INTUTIC_ACTIONS" "\${_intutic_screen_actioni[@]}"
# Whether rules testing subject $1, case $2, still need to: not when screened clear.
intutic_unscreened() {
  local v="_intutic_clear_$1$2"
  [ "\${!v:-}" != "1" ]
}

# A chaos run's no_destructive_attempt probe: whether a destructive.* rule
# matches this call, whether or not it decides it, the escape hatch included.
if [ "$INTUTIC_CHAOS_ACTIVE" = "1" ] && [ \${#INTUTIC_DYNAMIC[@]} -gt 0 ]; then
  for _rec in "\${INTUTIC_DYNAMIC[@]}"; do
    case "$_rec" in
      destructive.*)
        intutic_rule_fires "$_rec" quiet
        if [ "$_intutic_fires" = "1" ]; then _intutic_chaos_destructive=1; break; fi
        ;;
    esac
  done
fi

for _rec in "\${INTUTIC_FLOOR[@]}"; do
  intutic_apply "$_rec"
done

_intutic_pass=det
if [ \${#INTUTIC_DYNAMIC[@]} -gt 0 ]; then
  for _rec in "\${INTUTIC_DYNAMIC[@]}"; do
    intutic_apply "$_rec"
  done
fi

# ── Rule records (gate body v23) ─────────────────────────────────────────────
# A rule record's verdict, as the Python check returns it: verdict, code, rule
# id and reason, tab-separated; empty to continue. shadow records the finding;
# block refuses.
intutic_rule_verdict() {
  [ -n "$1" ] || return 0
  local verdict code rid reason retry
  IFS=$'	' read -r verdict code rid reason retry <<< "$1"
  if [ "$verdict" = "shadow" ]; then
    intutic_chaos_note "$rid"
    log_event "tool_would_block" "\${TOOL:-}" "\${reason} [\${rid}]" || true
    return 0
  fi
  _intutic_chaos_rule="$rid"; _intutic_chaos_hit=1
  intutic_shown "\${reason} [\${rid}]"
  echo "[Intutic Governance] BLOCKED: \${_intutic_shown} (refusal code \${code})" >&2
  # Where to retry: the paths or tools the refusal names. An
  # OPAQUE workspace drops it, as it drops the rule.
  if [ -n "$retry" ] && [ "$INTUTIC_OPAQUE" != "1" ]; then echo "$retry" >&2; fi
  log_event "tool_blocked" "\${TOOL:-}" "\${reason} [\${rid}]"
  exit 2
}
_intutic_rr_text=""
if [ \${#INTUTIC_RULE_RECORDS[@]} -gt 0 ]; then
  _intutic_rr_text="$(printf '%s
' "\${INTUTIC_RULE_RECORDS[@]}")"
fi
# requires_outcome: a call whose action token (or tool) a qualified
# requires_before gates is refused unless this session's last test run passed,
# and no file changed since (PREREQUISITE_UNMET). The check also keeps the
# session's state: a file change marks a passing run stale. A check that
# cannot run refuses.
case "$_intutic_rr_text" in
  *$'	'requires_outcome$'	'*)
    _intutic_rr="$(python3 -c 'import os, sys
lib = {}
exec(os.environ.get("INTUTIC_PY_LIB", ""), lib)
sys.stdout.write(lib["intutic_outcome_check"](*(sys.argv[1:7] + [sys.stdin.read()])))' 'hermes' 0 "\${TOOL:-}" "\${INTUTIC_ACTIONS:- }" "\${SESSION_ID:-}" "$_intutic_rr_text" <<< "\${TOOL_INPUT_JSON:-}" 2>/dev/null || printf 'block	PREREQUISITE_UNMET	requires_before	the requires_before check could not run')"
    intutic_rule_verdict "$_intutic_rr"
    ;;
esac

# ── Unverified snapshot (gate body v17) ──────────────────────────────────────
# A snapshot that failed its digest or workspace check admits no MCP server:
# neither record in it can be vouched for, and a deleted one looks like one
# never set. Refused at block, in an observe-only workspace too, with the code,
# rule id and reason of mcpSnapshotUnverifiedRefusal (intutic_mcp_unverified
# in GATE_PY_LIB).
if [ "$INTUTIC_SNAPSHOT_STATE" = "invalid" ]; then
  case "\${TOOL:-}" in
    mcp__*__*)
      _intutic_unv="$(python3 -c 'import os, sys
lib = {}
exec(os.environ.get("INTUTIC_PY_LIB", ""), lib)
sys.stdout.write(lib["intutic_mcp_unverified"](sys.argv[1]))' "\${TOOL:-}" 2>/dev/null || true)"
      if [ -n "$_intutic_unv" ]; then
        IFS=$'\\t' read -r _ _intutic_unv_rid _intutic_unv_reason <<< "$_intutic_unv"
      else
        # python3 could not say why (it is required, and checked, before any
        # rule runs): still a refusal, never an allow.
        _intutic_unv_rid="policy_snapshot"
        _intutic_unv_reason="POLICY_SNAPSHOT_UNVERIFIED — the policy snapshot failed its integrity check and admits no MCP server"
      fi
      _intutic_chaos_rule="$_intutic_unv_rid"; _intutic_chaos_hit=1
      echo "[Intutic Governance] BLOCKED: \${_intutic_unv_reason} [\${_intutic_unv_rid}]" >&2
      log_event "tool_blocked" "\${TOOL:-}" "\${_intutic_unv_reason} [\${_intutic_unv_rid}]"
      exit 2
      ;;
  esac
fi

# ── MCP server registry backstop (gate body v14) ─────────────────────────────
# The workspace's registry decisions from the snapshot's @mcp_registry record,
# applied to every mcp__<server>__<tool> call: a blocked or held server, a
# server not approved under mcpDefaultPolicy deny, a disabled tool. The same
# decision, rule ids and reasons as the MCP proxy, so a server no proxy fronts
# is refused as one it fronts would be. Evaluated in Python (intutic_mcp_registry
# in GATE_PY_LIB), which reads the record's JSON; only for MCP-shaped calls.
if [ -n "$INTUTIC_MCP_REGISTRY" ]; then
  case "\${TOOL:-}" in
    mcp__*__*)
      _intutic_reg="$(python3 -c 'import os, sys
lib = {}
exec(os.environ.get("INTUTIC_PY_LIB", ""), lib)
sys.stdout.write(lib["intutic_mcp_registry"](sys.argv[1], sys.argv[2]))' "$INTUTIC_MCP_REGISTRY" "\${TOOL:-}" 2>/dev/null || true)"
      if [ -n "$_intutic_reg" ]; then
        IFS=$'\\t' read -r _ _intutic_reg_rid _intutic_reg_reason <<< "$_intutic_reg"
        _intutic_chaos_rule="$_intutic_reg_rid"; _intutic_chaos_hit=1
        intutic_shown "\${_intutic_reg_reason} [\${_intutic_reg_rid}]"
        echo "[Intutic Governance] BLOCKED: \${_intutic_shown}" >&2
        log_event "tool_blocked" "\${TOOL:-}" "\${_intutic_reg_reason} [\${_intutic_reg_rid}]"
        exit 2
      fi
      ;;
  esac
fi

# ── MCP per-server allowlist backstop ────────────────────────────────────────
# A dedicated record, not a synthetic GuardPattern rule: "allow only these
# servers" as one regex needs negative lookahead, which POSIX ERE (grep -E)
# does not have. So this is a plain membership test over the @mcp_allowlist
# record, with evaluateMcpAllowlist's code, rule id and reason (the shared
# vectors hold this copy to it). Only for an mcp__<server>__<tool> call, and
# only when the snapshot carries the record.
case "\${TOOL:-}" in
  mcp__*__*)
    if [ "$INTUTIC_MCP_ALLOWLIST" = "1" ]; then
      _intutic_mcp_server="\${TOOL#mcp__}"
      _intutic_mcp_server="\${_intutic_mcp_server%%__*}"
      case ",$INTUTIC_MCP_SERVERS," in
        *",$_intutic_mcp_server,"*)
          : # allowed — the server is in the workspace's list
          ;;
        *)
          _intutic_mcp_reason="MCP server \\"$_intutic_mcp_server\\" is not on the MCP server allowlist for this workspace [mcp_allowlist]"
          if [ "$INTUTIC_MCP_SEVERITY" = "shadow" ]; then
            intutic_chaos_note mcp_allowlist
            log_event "tool_would_block" "\${TOOL:-}" "$_intutic_mcp_reason" || true
          else
            _intutic_chaos_rule=mcp_allowlist; _intutic_chaos_hit=1
            intutic_shown "$_intutic_mcp_reason"
            echo "[Intutic Governance] BLOCKED: \${_intutic_shown}" >&2
            log_event "tool_blocked" "\${TOOL:-}" "$_intutic_mcp_reason"
            exit 2
          fi
          ;;
      esac
    fi
    ;;
esac

# ── Holds (gate body v8; after every refusal since v23) ──────────────────────
_intutic_pass=hold
if [ \${#INTUTIC_DYNAMIC[@]} -gt 0 ]; then
  for _rec in "\${INTUTIC_DYNAMIC[@]}"; do
    intutic_apply "$_rec"
  done
fi

# ── Trajectory: scope_paths and plan_approval (gate body v23) ────────────────
# A file change outside the union of scope_paths (OUT_OF_SCOPE), and a call
# before the session's plan is approved (PLAN_NOT_APPROVED) or, under strict,
# off its steps (OFF_PLAN). After the holds, before the decide tier. A check
# that cannot run refuses.
case "$_intutic_rr_text" in
  *$'	'scope_paths$'	'*|*$'	'plan_approval$'	'*)
    _intutic_tr="$(python3 -c 'import os, sys
lib = {}
exec(os.environ.get("INTUTIC_PY_LIB", ""), lib)
sys.stdout.write(lib["intutic_trajectory_check"](*(sys.argv[1:4] + [sys.argv[4], sys.stdin.read(), sys.argv[5], sys.argv[6]])))' 'hermes' "\${TOOL:-}" "\${SESSION_ID:-}" "$_intutic_rr_text" "$PWD" "\${INTUTIC_WORKSPACE_ID:-}" <<< "\${TOOL_INPUT_JSON:-}" 2>/dev/null || printf 'block	OUT_OF_SCOPE	scope_paths	the scope and plan check could not run')"
    intutic_rule_verdict "$_intutic_tr"
    ;;
esac

# ── Decide tier (gate body v22) ──────────────────────────────────────────────
# Only after every tier above allowed the call, and only for a tool an @decide
# record names in its fourth column: intutic decide check --stdin asks the
# self-hosted engine, within 3900 ms less what the deadline has left.
# A CLI that is missing, fails, times out or answers what this gate cannot
# read is unavailable, which refuses unless every record on the tool is
# stamped shadow.
_intutic_decide_match=0
_intutic_decide_enforce=0
if [ -z "\${1:-}" ] && [ \${#INTUTIC_DECIDE_RECORDS[@]} -gt 0 ]; then
  for _rec in "\${INTUTIC_DECIDE_RECORDS[@]}"; do
    IFS=$'\\t' read -r _ _d_fb _d_roll _d_tools _d_rest <<< "$_rec"
    case ",\${_d_tools}," in
      *",\${TOOL:-},"*)
        _intutic_decide_match=1
        [ "$_d_roll" = "enforce" ] && _intutic_decide_enforce=1
        ;;
    esac
  done
fi
if [ "$_intutic_decide_match" = "1" ]; then
  _intutic_decide_budget=$(( 9000 - (SECONDS + 1) * 1000 - 500 ))
  [ "$_intutic_decide_budget" -gt 3900 ] && _intutic_decide_budget=3900
  if [ "$_intutic_decide_budget" -lt 50 ]; then
    if [ "$_intutic_decide_enforce" = "1" ]; then
      _intutic_dec="refuse"$'\\x1f'"GOVERNANCE_UNAVAILABLE"$'\\x1f'$'\\x1f'"GOVERNANCE_UNAVAILABLE — no time was left for the decide rules on \${TOOL:-} within the gate deadline"
    else
      _intutic_dec="allow"$'\\x1f'$'\\x1f'$'\\x1f'"no time was left for the decide rules on \${TOOL:-} within the gate deadline"
    fi
  else
    _intutic_dec="$(python3 -c 'import os, sys
lib = {}
exec(os.environ.get("INTUTIC_PY_LIB", ""), lib)
sys.stdout.write(lib["intutic_decide_check"](*sys.argv[1:6], sys.stdin.read()))' 'hermes' "\${TOOL:-}" "$_intutic_decide_budget" "\${SESSION_ID:-}" "$_intutic_decide_enforce" <<< "\${TOOL_INPUT_JSON:-}" 2>/dev/null || true)"
    if [ -z "$_intutic_dec" ]; then
      # python3 could not say (it is required, and checked, before any rule
      # runs): unavailable, as a CLI that did not answer is.
      if [ "$_intutic_decide_enforce" = "1" ]; then
        _intutic_dec="refuse"$'\\x1f'"GOVERNANCE_UNAVAILABLE"$'\\x1f'$'\\x1f'"GOVERNANCE_UNAVAILABLE — the decide check could not run"
      else
        _intutic_dec="allow"$'\\x1f'$'\\x1f'$'\\x1f'"the decide check could not run"
      fi
    fi
  fi
  IFS=$'\\x1f' read -r _intutic_dec_out _intutic_dec_code _intutic_dec_rid _intutic_dec_reason <<< "$_intutic_dec"
  if [ "$_intutic_dec_out" = "allow" ]; then
    # A shadow rule's engine that could not answer: recorded, and the call goes on.
    if [ -n "$_intutic_dec_reason" ]; then
      log_event "tool_would_block" "\${TOOL:-}" "GOVERNANCE_UNAVAILABLE — $_intutic_dec_reason" || true
    fi
  else
    _intutic_dec_full="$_intutic_dec_reason"
    [ -n "$_intutic_dec_rid" ] && _intutic_dec_full="$_intutic_dec_full [$_intutic_dec_rid]"
    if [ "$_intutic_dec_out" = "escalate" ]; then
      # Hermes' human approval: {"action":"approve"}. Never {"decision":"approve"},
      # which Hermes reads as an allow.
      intutic_shown "$_intutic_dec_full"
      echo "[Intutic Governance] ASK: \${_intutic_shown}" >&2
      log_event "tool_flagged" "\${TOOL:-}" "DECIDE_ESCALATED — asked a person: $_intutic_dec_full" || true
      _intutic_chaos_rule="$_intutic_dec_rid"; _intutic_chaos_hit=1
      intutic_chaos_decide hold >/dev/null 2>&1 || true
      _intutic_chaos_done=1
      printf '{"action":"approve","message":"%s"}\\n' "$(intutic_json_escape "$_intutic_shown")"
      exit 0
    fi
    _intutic_chaos_rule="$_intutic_dec_rid"; _intutic_chaos_hit=1
    intutic_shown "$_intutic_dec_full"
    echo "[Intutic Governance] BLOCKED: \${_intutic_shown} (refusal code \${_intutic_dec_code:-DECIDE_ESCALATED})" >&2
    log_event "tool_blocked" "\${TOOL:-}" "$_intutic_dec_full"
    exit 2
  fi
fi

# ── Agent fault injection: the call is allowed ───────────────────────────────
# Recorded as allowed, then the fault that is due, if any. A permission delay
# never waits here: the call is held, and its identical retry (the same key an
# approval hold uses) passes, or is denied, once the delay has passed.
if [ "$INTUTIC_CHAOS_ACTIVE" = "1" ]; then
  _intutic_chaos_key="$( { printf '%s' "$INTUTIC_NTOOL"; printf '\\0'; printf '%s' "$INTUTIC_NCOMMAND"; printf '\\0'; printf '%s' "$INTUTIC_NTARGET"; } | intutic_sha256 )"
  _intutic_fault="$(intutic_chaos_decide allow "$_intutic_chaos_key")"
  _intutic_chaos_done=1
  if [ -n "$_intutic_fault" ]; then
    _intutic_fault_kind="\${_intutic_fault%%$'\\t'*}"
    _intutic_fault_reason="\${_intutic_fault#*$'\\t'}"
    # The fault's own text, carrying the plan's canary: what the agent reads.
    if [ "$_intutic_fault_kind" = "hold" ]; then
      echo "[Intutic Governance] HELD: \${_intutic_fault_reason}" >&2
    else
      echo "$_intutic_fault_reason" >&2
    fi
    exit 2
  fi
fi
# ── end Intutic gate body ────────────────────────────────────────────────────

log_event "tool_allowed" "$TOOL_NAME" ""
exit 0
",
}
`;

exports[`generated hook scripts > openhands > matches the recorded output byte for byte 1`] = `
{
  ".intutic/hooks/openhands-check.sh": "#!/usr/bin/env bash
# Intutic OpenHands PreToolUse governance gate.
# Auto-generated by intutic sync-daemon. DO NOT EDIT.
# Proxy: http://127.0.0.1:4000
# Generated: <TIMESTAMP>
set -euo pipefail

# ── Intutic fail-closed prelude v23 ─────────────────────────────
# Any exit status other than the two deliberate verdicts (0 = allow, 2 = block)
# means this gate crashed rather than decided. The harness would read exit 1 as
# "hook errored" and run the tool anyway, so a crash is converted into a block.
# EXIT rather than ERR: ERR is unreliable across shells for set -u deaths, and
# it fires on benign non-zero intermediates; the final status cannot lie.
# A post-tool invocation (--event post, gate body v23) records a tool's result
# and never refuses: the tool has already run, and some harnesses read a
# post-tool exit 2 as text to feed back to the model. So in post mode every
# exit, a crash and the deadline included, is 0.
INTUTIC_POST_MODE=0
if [ "\${1:-}" = "--event" ] && [ "\${2:-}" = "post" ]; then INTUTIC_POST_MODE=1; fi
intutic_fail_closed() {
  _intutic_exit_rc=$?
  # The trap must not itself die on an unset variable or a failed command —
  # that would replace the exit status it exists to correct.
  set +eu
  trap - EXIT
  [ -n "\${INTUTIC_WATCHDOG_PID:-}" ] && kill "$INTUTIC_WATCHDOG_PID" 2>/dev/null
  if [ "\${INTUTIC_POST_MODE:-0}" = "1" ]; then exit 0; fi
  # A chaos run's record of a call the gate refused, held or crashed on (the
  # gate body records an allowed one where it ends). It cannot change the
  # exit status: everything it prints is discarded.
  if [ "$_intutic_exit_rc" != "0" ] && [ "\${INTUTIC_CHAOS_ACTIVE:-0}" = "1" ] && command -v intutic_chaos_decide >/dev/null 2>&1; then
    intutic_chaos_decide "\${_intutic_chaos_decision:-deny}" >/dev/null 2>&1
  fi
  if [ "$_intutic_exit_rc" = "0" ] || [ "$_intutic_exit_rc" = "2" ]; then
    exit "$_intutic_exit_rc"
  fi
  echo "[Intutic Governance] BLOCKED: gate crashed (exit \${_intutic_exit_rc}) — failing closed rather than allowing an unevaluated call." >&2
  if command -v log_event >/dev/null 2>&1; then
    log_event "tool_blocked" "\${TOOL:-unknown}" "gate crashed (exit \${_intutic_exit_rc}) — failing closed" || true
  fi
  exit 2
}
trap intutic_fail_closed EXIT

# ── Internal deadline ────────────────────────────────────────────────────────
# Most harnesses run a call whose hook outlives their timeout as if the hook had
# allowed it. So this gate refuses at 9 s from its own start, inside the
# hook timeout openhands applies (gateLimits.ts): a watchdog, detached so it holds none of
# the harness's pipes, stops the gate's children (a grep or python3 still
# matching) and signals it; the trap below refuses. Every built-in rule is
# linear; a workspace's own WHERE pattern need not be.
intutic_deadline() {
  trap - USR1
  if [ "\${INTUTIC_POST_MODE:-0}" = "1" ]; then exit 0; fi
  echo "[Intutic Governance] BLOCKED: GATE_DEADLINE — the gate did not finish evaluating this call within 9 s, and refuses it rather than let the hook timeout allow it." >&2
  if command -v log_event >/dev/null 2>&1; then
    log_event "tool_blocked" "\${TOOL:-unknown}" "GATE_DEADLINE — the gate did not finish within 9 s" || true
  fi
  exit 2
}
trap intutic_deadline USR1
INTUTIC_GATE_PID=$$
INTUTIC_WATCHDOG_PID="$( { ( sleep 9; pkill -P "$INTUTIC_GATE_PID" 2>/dev/null; kill -USR1 "$INTUTIC_GATE_PID" 2>/dev/null ) </dev/null >/dev/null 2>&1 & } ; echo $! )"

INPUT="$(cat)"

if ! command -v python3 >/dev/null 2>&1; then
  # A post-tool invocation records nothing without python3, and never refuses.
  if [ "\${INTUTIC_POST_MODE:-0}" = "1" ]; then exit 0; fi
  echo "[Intutic Governance] BLOCKED: python3 is required to evaluate tool calls and was not found on PATH." >&2
  echo "[Intutic Governance] Install python3, or unset the Intutic hooks to run ungoverned." >&2
  exit 2
fi

# The phrase matcher and the hold classifier (GATE_PY_LIB in gateBody.ts),
# for the extractor below and for phrase-subject rules. A quoted heredoc, so
# the shell expands nothing in it; read stops at end of input and returns 1.
IFS= read -r -d '' INTUTIC_PY_LIB <<'INTUTIC_PY_LIB_END' || true
"""Phrase matching for shell commands and SQL in linear time.

A transliteration of packages/shared-types/src/phrases.ts; read that module's
docstring for what counts as a separator and why no regex searches the input.
The rules are the same; the walk is organised for CPython, which is slow per
step: runs of ordinary characters, spaces and backslashes are consumed by
anchored character-class matches (one pass each, nothing to backtrack into),
and a phrase is checked only at the words that can start it.

Every classifier runs the shared vectors in
packages/proxy/src/plugins/anomaly/action_vectors.json, and the hook gates
emit this file verbatim (services/sync-daemon/src/lib/phrasesPy.ts holds a
byte-identical copy, which a test compares). It must stay self-contained: the
standard library only, no module state beyond the constants below, and no
backtick or dollar-brace, which the TypeScript copy cannot hold.
"""

import re
from bisect import bisect_left

_SPACE_CHARS = (
    " \\t\\n\\r\\v\\f\\u00a0\\u1680\\u2000\\u2001\\u2002\\u2003\\u2004\\u2005\\u2006\\u2007"
    "\\u2008\\u2009\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff"
)
_SPACES = frozenset(_SPACE_CHARS)
_WORD = frozenset("abcdefghijklmnopqrstuvwxyz0123456789_")
# One anchored match per piece of the text. Every alternative starts with a
# character no other alternative can start with, so exactly one can match at
# a position and it matches one run of its class: nothing to backtrack into.
_PIECE = re.compile(
    "(?P<plain>[^" + _SPACE_CHARS + "\\\\\\\\/;&|-]+)"
    "|(?P<space>[" + _SPACE_CHARS + "]+)"
    "|(?P<dash>-+)"
    "|(?P<backslash>\\\\\\\\+)"
    "|(?P<other>[/;&|])"
)
# A run of words that need no decision, each followed by one plain space:
# ordinary characters, after at most a leading run of dashes. Consumed in one
# match and split in C — most of a long command is this.
_BULK = re.compile("(?:(?:[^" + _SPACE_CHARS + "\\\\\\\\/;&|-]+|-+[^" + _SPACE_CHARS + "\\\\\\\\/;&|-]*) )+")
_BULK_NO_COMMENT = re.compile("(?:(?:[^" + _SPACE_CHARS + "\\\\\\\\;&|-]+|-+[^" + _SPACE_CHARS + "\\\\\\\\;&|-]*) )+")
# A run of line continuations or escaped spaces between words: one break.
_CONTINUATIONS = re.compile("(?:\\\\\\\\[" + _SPACE_CHARS + "])+")
# The same once no "*/" is left in the text: no "/*" can open a comment, so a
# slash is an ordinary character.
_PIECE_NO_COMMENT = re.compile(
    "(?P<plain>[^" + _SPACE_CHARS + "\\\\\\\\;&|-]+)"
    "|(?P<space>[" + _SPACE_CHARS + "]+)"
    "|(?P<dash>-+)"
    "|(?P<backslash>\\\\\\\\+)"
    "|(?P<other>[;&|])"
)


class PhraseText:
    """A text cut into words, ready for any number of has_phrase calls."""

    __slots__ = ("raw", "joined", "toks", "sep", "nl", "eol", "dash", "bar", "tail", "memo")

    def __init__(self):
        self.raw = ""
        self.joined = ""
        self.toks = []
        self.sep = []
        self.nl = []
        self.eol = []
        self.dash = []
        self.bar = []
        self.tail = False
        self.memo = {}


def phrase_text(value):
    """Cut value into words in one pass (see phraseText in phrases.ts)."""
    s = ("" if value is None else str(value)).lower()
    n = len(s)
    t = PhraseText()
    t.raw = s
    toks, sep, nl, eol, dash, bar = t.toks, t.sep, t.nl, t.eol, t.dash, t.bar
    start = -1
    tok_bar = False
    pend_sep = pend_nl = pend_eol = False
    close = -2 if "*/" in s else -1  # the next "*/" at or after the last search; -1 once none is left
    piece = _PIECE if close != -1 else _PIECE_NO_COMMENT
    bulk = _BULK if close != -1 else _BULK_NO_COMMENT
    i = 0
    while i < n:
        if start < 0:
            m = bulk.match(s, i)
            if m is not None:
                words = m.group().split(" ")
                words.pop()
                rest = len(words) - 1
                toks.extend(words)
                sep.append(pend_sep)
                sep.extend([True] * rest)
                nl.append(pend_nl)
                nl.extend([False] * rest)
                eol.append(pend_eol)
                eol.extend([False] * rest)
                dash.extend([w.startswith("--") for w in words])
                bar.extend([False] * (rest + 1))
                pend_sep = True
                pend_nl = pend_eol = False
                i = m.end()
                continue
            m = _CONTINUATIONS.match(s, i)
            if m is not None:
                pend_sep = True
                i = m.end()
                continue
        m = piece.match(s, i)
        kind = m.lastgroup
        j = m.end()
        if kind == "plain":
            if start < 0:
                start = i
            i = j
            continue
        word_break = False
        newline = eol_here = False
        nxt = j
        if kind == "space":
            newline = eol_here = "\\n" in m.group()
            word_break = True
        elif kind == "dash":
            # A "--" inside a word starts a new one, glued to it: it can open a
            # comment or an option run but cannot stand for a plain gap.
            if j - i > 1 and start >= 0:
                toks.append(s[start:i])
                sep.append(pend_sep)
                nl.append(pend_nl)
                eol.append(pend_eol)
                dash.append(s.startswith("--", start))
                bar.append(tok_bar)
                start = -1
                tok_bar = False
                pend_sep = pend_nl = pend_eol = False
            if start < 0:
                start = i
            i = j
            continue
        elif kind == "backslash":
            # Every backslash but the last is followed by a backslash: a
            # literal character. The last one decides.
            last = j - 1
            d = s[j] if j < n else ""
            if d in ("n", "t", "r") or (d != "" and d in _SPACES):
                if last > i and start < 0:
                    start = i
                word_break = True
                eol_here = d == "n"
                nxt = j + 1
                if last > i:
                    # the literal backslashes end the word before the escape
                    toks.append(s[start:last])
                    sep.append(pend_sep)
                    nl.append(pend_nl)
                    eol.append(pend_eol)
                    dash.append(s.startswith("--", start))
                    bar.append(tok_bar)
                    start = -1
                    tok_bar = False
                    pend_sep = pend_nl = pend_eol = False
            else:
                if start < 0:
                    start = i
                i = j
                continue
        else:
            c = s[i]
            if c == "/" and j < n and s[j] == "*" and close != -1:
                if close < i + 2:
                    close = s.find("*/", i + 2)
                    if close == -1:
                        piece = _PIECE_NO_COMMENT
                        bulk = _BULK_NO_COMMENT
                if close != -1:
                    word_break = True
                    nxt = close + 2
            if not word_break:
                if start < 0:
                    start = i
                if c != "/":
                    tok_bar = True
                i = j
                continue
        if start >= 0:
            toks.append(s[start:i])
            sep.append(pend_sep)
            nl.append(pend_nl)
            eol.append(pend_eol)
            dash.append(s.startswith("--", start))
            bar.append(tok_bar)
            start = -1
            tok_bar = False
            pend_sep = pend_nl = pend_eol = False
        pend_sep = True
        if newline:
            pend_nl = True
        if eol_here:
            pend_eol = True
        i = nxt
    if start >= 0:
        toks.append(s[start:n])
        sep.append(pend_sep)
        nl.append(pend_nl)
        eol.append(pend_eol)
        dash.append(s.startswith("--", start))
        bar.append(tok_bar)
        pend_sep = False
    t.tail = pend_sep
    t.joined = " ".join(toks)
    return t


def _next_index(t):
    """Per word x: the first word at or after x containing ;&|, with a real
    newline before it, and with any newline before it. Built once per text."""
    ix = t.memo.get("#next")
    if ix is None:
        T = len(t.toks)
        nb = [T] * (T + 1)
        nn = [T] * (T + 1)
        ne = [T] * (T + 1)
        b = n_ = e = T
        bar, nl, eol = t.bar, t.nl, t.eol
        for x in range(T - 1, -1, -1):
            if bar[x]:
                b = x
            if nl[x]:
                n_ = x
            if eol[x]:
                e = x
            nb[x] = b
            nn[x] = n_
            ne[x] = e
        ix = (nb, nn, ne)
        t.memo["#next"] = ix
    return ix


def has_phrase(t, needle, bounded=False):
    """Whether t contains needle (see hasPhrase in phrases.ts)."""
    words = needle.lower().split(" ")
    if len(words) == 1:
        return words[0] in t.raw
    trailing_gap = words[-1] == ""
    if trailing_gap:
        words.pop()
    for w in words:
        if w == "" or w not in t.joined:
            return False
    toks, sep, dash, tail = t.toks, t.sep, t.dash, t.tail
    T = len(toks)
    k = len(words)

    def positions(i):
        """The words that word i of the phrase can be, by its position."""
        w = words[i]
        first = i == 0
        last = i == k - 1 and not trailing_gap
        key = ("f" if first else "") + ("l" if last else "") + ("b" if bounded else "") + ":" + w
        hit = t.memo.get(key)
        if hit is not None:
            return hit
        lw = len(w)
        if first:
            out = [q for q, tok in enumerate(toks) if tok.endswith(w)]
        elif last:
            out = [q for q, tok in enumerate(toks) if tok.startswith(w)]
        else:
            out = [q for q, tok in enumerate(toks) if tok == w]
        if bounded:
            kept = []
            for q in out:
                tok = toks[q]
                if first and len(tok) > lw and tok[len(tok) - lw - 1] in _WORD:
                    continue
                if last and len(tok) > lw and (tok[lw] in _WORD or tok[lw] == "."):
                    continue
                kept.append(q)
            out = kept
        t.memo[key] = out
        return out

    # The words at which the rest of the phrase matches, ascending.
    ok = positions(k - 1)
    if trailing_gap:
        kept = []
        for q in ok:
            r = q + 1
            if r < T:
                if sep[r] or (dash[r] and not t.bar[r] and (r + 1 < T or tail)):
                    kept.append(q)
            elif tail:
                kept.append(q)
        ok = kept
    if k == 1:
        return bool(ok)
    nb, nn, ne = _next_index(t)
    for i in range(k - 2, -1, -1):
        ok_sep = [q for q in ok if sep[q]]
        ok_set = set(ok_sep)
        memo = {}

        def option(r):
            # An option run reaches any word before a ;&| word or a real newline.
            j = bisect_left(ok_sep, r + 1)
            return j < len(ok_sep) and ok_sep[j] <= min(nb[r], nn[r + 1], T - 1)

        def reach(r):
            # The gap that starts at word r leads into the rest of the phrase:
            # directly, after an option run, or after -- comments, each of
            # which runs to the next newline.
            path = []
            cur = r
            while True:
                if cur >= T:
                    val = False
                    break
                if cur in memo:
                    val = memo[cur]
                    break
                if cur in ok_set or (dash[cur] and option(cur)):
                    val = memo[cur] = True
                    break
                if not dash[cur]:
                    val = memo[cur] = False
                    break
                path.append(cur)
                cur = ne[cur + 1]
            for x in path:
                memo[x] = val
            return val

        ok = [p for p in positions(i) if reach(p + 1)]
        if not ok:
            return False
    return bool(ok)


"""The MCP server registry and allowlist decisions, read from the policy snapshot.

A transliteration of packages/shared-types/src/mcpRegistryRecord.ts: the
registry decision (evaluateMcpRegistry), the allowlist decision
(evaluateMcpAllowlist), and the snapshot's @mcp_registry and @mcp_allowlist
records. The control plane's hook gate, the MCP proxy and the JavaScript hook
gates run the TypeScript; the bash hook gates and this package run this file,
and every one of them runs packages/shared-types/fixtures/mcp-registry-vectors.json,
so all of them refuse a call with the same code, rule id and reason.

The bash gates emit this file verbatim (services/sync-daemon/src/lib/mcpRegistryPy.ts
holds a byte-identical copy, which a test compares). It must stay
self-contained: the standard library only, no module state beyond the
constants below, and no backtick or dollar-brace, which the TypeScript copy
cannot hold.

Both records sit inside the snapshot's digest. A gate that finds the snapshot
unverified (its digest broken or missing, or another workspace's) trusts
neither: it refuses every MCP call with unverified_refusal, at block, in an
observe-only workspace too.
"""

import base64
import json

MCP_REGISTRY_RECORD_TAG = "@mcp_registry"
MCP_ALLOWLIST_RECORD_TAG = "@mcp_allowlist"


def split_mcp_tool_name(tool):
    """(server, tool) for a harness name mcp__<server>__<tool>, else None.

    The server is the part before the first double underscore; the tool, the
    rest, may hold more of them.
    """
    if not isinstance(tool, str) or not tool.startswith("mcp__"):
        return None
    rest = tool[len("mcp__"):]
    sep = rest.find("__")
    if sep <= 0:
        return None
    return rest[:sep], rest[sep + 2:]


def _strings(value):
    return [v for v in value if isinstance(v, str)] if isinstance(value, list) else []


def parse_registry(value):
    """The registry as the control plane sends it, or None for a non-object.

    Wrong-typed lists read as empty, and any default but deny as allow.
    """
    if not isinstance(value, dict):
        return None
    disabled = {}
    if isinstance(value.get("disabledTools"), dict):
        for server, tools in value["disabledTools"].items():
            names = _strings(tools)
            if names:
                disabled[server] = names
    return {
        "defaultPolicy": "deny" if value.get("defaultPolicy") == "deny" else "allow",
        "approvedServers": _strings(value.get("approvedServers")),
        "blockedServers": _strings(value.get("blockedServers")),
        "heldServers": _strings(value.get("heldServers")),
        "disabledTools": disabled,
    }


def decode_registry_record(line):
    """The @mcp_registry line's registry; None for another line or a damaged one."""
    parts = line.split("\\t")
    if len(parts) != 2 or parts[0] != MCP_REGISTRY_RECORD_TAG or not parts[1]:
        return None
    try:
        return parse_registry(json.loads(base64.b64decode(parts[1], validate=True).decode("utf-8")))
    except Exception:
        return None


def evaluate_registry(registry, server, tool):
    """(code, rule_id, reason) refusing one MCP call, or None to let it continue.

    A blocked server, then a held one, then (under deny) one not approved,
    then a disabled tool.
    """
    if server in registry["blockedServers"]:
        return (
            "SERVER_BLOCKED",
            "mcp_registry." + server,
            "MCP server \\"" + server + "\\" is blocked in this workspace's MCP server registry. "
            "An owner or admin can change that on the MCP Servers page.",
        )
    if server in registry["heldServers"]:
        return (
            "SERVER_HELD",
            "mcp_registry." + server,
            "MCP server \\"" + server + "\\" changed its tools in a way scored high risk, and this workspace "
            "holds such a server until it is approved again. It is waiting in the approval queue on the MCP "
            "Servers page for an owner or admin.",
        )
    if registry["defaultPolicy"] == "deny" and server not in registry["approvedServers"]:
        return (
            "SERVER_NOT_APPROVED",
            "mcpDefaultPolicy",
            "MCP server \\"" + server + "\\" is not approved in this workspace's MCP server registry, "
            "and the workspace refuses unapproved servers (mcpDefaultPolicy: deny). It is waiting in "
            "the approval queue on the MCP Servers page for an owner or admin.",
        )
    if tool in registry["disabledTools"].get(server, []):
        return (
            "TOOL_DISABLED",
            "mcp_registry." + server + "." + tool,
            "Tool \\"" + tool + "\\" is disabled on MCP server \\"" + server + "\\" in this workspace's "
            "MCP server registry. An owner or admin can re-enable it on the MCP Servers page.",
        )
    return None


def decode_allowlist_record(line):
    """The @mcp_allowlist line as {"severity", "servers"}; None for another line.

    A severity other than shadow reads as block, so a damaged one refuses.
    """
    parts = line.split("\\t")
    if len(parts) != 3 or parts[0] != MCP_ALLOWLIST_RECORD_TAG:
        return None
    return {
        "severity": "shadow" if parts[1] == "shadow" else "block",
        "servers": [s for s in parts[2].split(",") if s],
    }


def evaluate_allowlist(allowlist, server):
    """(code, rule_id, reason) for a server the allowlist does not name, else None.

    Under shadow the caller records the refusal instead of enforcing it.
    """
    if server in allowlist["servers"]:
        return None
    return (
        "SERVER_NOT_ALLOWED",
        "mcp_allowlist",
        "MCP server \\"" + server + "\\" is not on the MCP server allowlist for this workspace",
    )


def unverified_refusal(server):
    """(code, rule_id, reason) refusing an MCP call on an unverified snapshot.

    Neither the registry's approvals nor the allowlist's servers can be
    vouched for, and a deleted record looks like one never set, so the
    snapshot admits no MCP server at all.
    """
    return (
        "POLICY_SNAPSHOT_UNVERIFIED",
        "policy_snapshot",
        "MCP server \\"" + server + "\\" is refused because the policy snapshot on this machine failed its "
        "integrity check, so its MCP server registry and allowlist admit no server until the sync daemon "
        "restores a verified snapshot",
    )


"""Did the tests pass? The deciding function behind the qualified ordering rule
requires_before: action:run_tests[ok] -> action:deploy, and the
per-session state a gate keeps of it.

A transliteration of packages/shared-types/src/testOutcome.ts; read that
module's docstring for the steps. In short, decide_test_outcome says failed
for a non-zero exit code, an error flag, a false success flag, a runner
summary with failures, or a summary saying no tests ran; ok for exit code 0,
or, with no exit code, a summary that counts a pass; and unknown otherwise,
which leaves a qualified rule unmet as a failure does.

Every port runs packages/shared-types/fixtures/test-outcome-vectors.json. The
bash hook gates emit this file verbatim, so it must stay self-contained: the
standard library only, no module state beyond the constants below, and no
backtick or dollar-brace, which a TypeScript copy cannot hold.

Inputs and states are plain dicts with the TypeScript field names
(exitCode, isError, success, output; {"v": 1, "outcomes":
{...}}), so a gate can read and write the same state file.
"""

import json
import re

OUTCOME_TOKENS = ("action:run_tests",)
OUTCOME_QUALIFIERS = ("ok",)
TEST_OUTPUT_TAIL_BYTES = 65536
TEST_OUTPUT_LINE_BYTES = 1024
TEST_OUTPUT_JSON_MAX_CHARS = 1048576
OUTCOME_STATE_TTL_MS = 86400000
_MAX_SAFE_INTEGER = 9007199254740991

_ANSI = re.compile(r"\\x1b\\[[0-9;?]*[A-Za-z]")
_EXIT_CODE = re.compile(r"exit code:? (-?[0-9]{1,9})\\Z", re.IGNORECASE | re.ASCII)
_EXIT_STATUS = re.compile(r"exit status ([0-9]{1,9})\\Z")
_EXITED = re.compile(r"(?:Process|Command) exited with code (-?[0-9]{1,9})")
_COUNT = re.compile(r"([0-9]{1,9}) ([a-z]+)")
_PYTEST_NONE = re.compile(r"=+ no tests ran")
_PYTEST = re.compile(r"=+ (.+) in [0-9.]+s.* =+\\Z")
_JEST = re.compile(r"Tests:[ \\t]+(.+)\\Z")
_VITEST = re.compile(r"[ \\t]*Tests[ \\t]+(.+)\\Z")
_GO_OK = re.compile(r"ok[ \\t]+[^ \\t]+")
_GO_FAIL = re.compile(r"FAIL(?:[ \\t]|\\Z)")
_GO_FAIL_TEST = re.compile(r"--- FAIL:")
_CARGO = re.compile(r"test result: (ok|FAILED)\\. ([0-9]{1,9}) passed; ([0-9]{1,9}) failed;")
_MOCHA_PASS = re.compile(r"[ \\t]*([0-9]{1,9}) passing")
_MOCHA_FAIL = re.compile(r"[ \\t]*([0-9]{1,9}) failing")
_RSPEC = re.compile(r"([0-9]{1,9}) examples?, ([0-9]{1,9}) failures?")


def _utf8_len(ch):
    cp = ord(ch)
    if cp < 0x80:
        return 1
    if cp < 0x800:
        return 2
    if cp < 0x10000:
        return 3
    return 4


def _utf8_tail(s, max_bytes):
    """The last max_bytes bytes of s as UTF-8, starting on a character."""
    total = 0
    i = len(s)
    while i > 0:
        n = _utf8_len(s[i - 1])
        if total + n > max_bytes:
            break
        total += n
        i -= 1
    return s[i:]


def _utf8_head(s, max_bytes):
    """The first max_bytes bytes of s as UTF-8, ending on a character."""
    total = 0
    i = 0
    while i < len(s):
        n = _utf8_len(s[i])
        if total + n > max_bytes:
            break
        total += n
        i += 1
    return s[:i]


def _lines(text):
    """The lines of text, each cut to 1 KiB, without carriage returns or ANSI sequences."""
    return [_ANSI.sub("", _utf8_head(raw, TEST_OUTPUT_LINE_BYTES).replace("\\r", "")) for raw in text.split("\\n")]


def _integer_or_none(v):
    """A JSON integer exit code, or None."""
    if isinstance(v, bool):
        return None
    if isinstance(v, int) and abs(v) <= _MAX_SAFE_INTEGER:
        return v
    if isinstance(v, float) and v.is_integer() and abs(v) <= _MAX_SAFE_INTEGER:
        return int(v)
    return None


def extract_exit_code(output):
    """The exit code a run's text reports, or None. See testOutcome.ts extractExitCode."""
    if not isinstance(output, str) or output == "":
        return None
    trimmed = output.strip()
    if len(trimmed) <= TEST_OUTPUT_JSON_MAX_CHARS and trimmed[:1] == "{" and trimmed[-1:] == "}":
        try:
            parsed = json.loads(trimmed)
        except ValueError:
            parsed = None
        if isinstance(parsed, dict):
            meta = parsed.get("metadata")
            if isinstance(meta, dict):
                m = _integer_or_none(meta.get("exit_code"))
                if m is not None:
                    return m
            for key in ("exit_code", "exitCode"):
                v = _integer_or_none(parsed.get(key))
                if v is not None:
                    return v
    head = _utf8_head(output, TEST_OUTPUT_TAIL_BYTES)
    parts = [head] if len(head) == len(output) else [head, _utf8_tail(output[len(head):], TEST_OUTPUT_TAIL_BYTES)]
    for part in parts:
        for raw in _lines(part):
            line = raw.lstrip(" \\t").rstrip(" \\t")
            m = _EXIT_CODE.match(line) or _EXIT_STATUS.match(line) or _EXITED.match(line)
            if m:
                return int(m.group(1))
    return None


def _counts(text):
    """'N word' pieces of a summary, split on ',' and '|': the count of each word."""
    counts = {}
    for piece in re.split(r"[,|]", text):
        m = _COUNT.match(piece.lstrip(" \\t"))
        if m:
            counts[m.group(2)] = counts.get(m.group(2), 0) + int(m.group(1))
    return counts


def parse_test_summaries(output):
    """The runner summaries in the last 64 KiB of output, in order (go and mocha folded into one each)."""
    if not isinstance(output, str) or output == "":
        return []
    out = []
    go = None
    mocha = None
    for line in _lines(_utf8_tail(output, TEST_OUTPUT_TAIL_BYTES)):
        if _PYTEST_NONE.match(line):
            out.append({"runner": "pytest", "passed": 0, "failed": 0, "noTests": True})
            continue
        m = _PYTEST.match(line)
        if m:
            c = _counts(m.group(1))
            if not any(k in c for k in ("passed", "failed", "error", "errors")):
                continue
            out.append({"runner": "pytest", "passed": c.get("passed", 0),
                        "failed": c.get("failed", 0) + c.get("error", 0) + c.get("errors", 0),
                        "noTests": c.get("passed") == 0})
            continue
        m = _JEST.match(line)
        if m:
            c = _counts(m.group(1))
            out.append({"runner": "jest", "passed": c.get("passed", 0), "failed": c.get("failed", 0),
                        "noTests": c.get("passed") == 0 or c.get("total") == 0})
            continue
        m = _VITEST.match(line)
        if m:
            c = _counts(m.group(1))
            if "passed" not in c and "failed" not in c:
                continue
            out.append({"runner": "vitest", "passed": c.get("passed", 0), "failed": c.get("failed", 0),
                        "noTests": c.get("passed") == 0})
            continue
        if _GO_OK.match(line):
            if go is None:
                go = {"runner": "go", "passed": 0, "failed": 0, "noTests": False}
                out.append(go)
            go["passed"] += 1
            continue
        if _GO_FAIL.match(line) or _GO_FAIL_TEST.match(line):
            if go is None:
                go = {"runner": "go", "passed": 0, "failed": 0, "noTests": False}
                out.append(go)
            go["failed"] += 1
            continue
        m = _CARGO.match(line)
        if m:
            passed, failed = int(m.group(2)), int(m.group(3))
            out.append({"runner": "cargo", "passed": passed,
                        "failed": 1 if m.group(1) == "FAILED" and failed == 0 else failed,
                        "noTests": passed == 0})
            continue
        m = _MOCHA_PASS.match(line)
        if m:
            if mocha is None:
                mocha = {"runner": "mocha", "passed": 0, "failed": 0, "noTests": False}
                out.append(mocha)
            mocha["passed"] += int(m.group(1))
            if int(m.group(1)) == 0:
                mocha["noTests"] = True
            continue
        m = _MOCHA_FAIL.match(line)
        if m:
            if mocha is None:
                mocha = {"runner": "mocha", "passed": 0, "failed": 0, "noTests": False}
                out.append(mocha)
            mocha["failed"] += int(m.group(1))
            continue
        m = _RSPEC.match(line)
        if m:
            examples, failures = int(m.group(1)), int(m.group(2))
            out.append({"runner": "rspec", "passed": max(0, examples - failures), "failed": failures,
                        "noTests": examples == 0})
    return out


def decide_test_outcome(inp):
    """The outcome of one test run, as {"outcome": ok|failed|unknown, "why": ...}.

    'inp' carries any of exitCode, isError, success and output.
    """
    exit_code = inp.get("exitCode")
    if isinstance(exit_code, bool) or not isinstance(exit_code, (int, float)) or _integer_or_none(exit_code) is None:
        exit_code = None
    else:
        exit_code = int(exit_code)
    if exit_code is not None and exit_code != 0:
        return {"outcome": "failed", "why": "exit_code"}
    if inp.get("isError") is True:
        return {"outcome": "failed", "why": "is_error"}
    if inp.get("success") is False:
        return {"outcome": "failed", "why": "success_false"}
    passed = 0
    no_tests = False
    for s in parse_test_summaries(inp.get("output")):
        if s["failed"] > 0:
            return {"outcome": "failed", "why": "summary_failed"}
        passed += s["passed"]
        if s["noTests"]:
            no_tests = True
    if passed == 0 and no_tests:
        return {"outcome": "failed", "why": "no_tests"}
    if exit_code == 0:
        return {"outcome": "ok", "why": "exit_zero"}
    if passed >= 1:
        return {"outcome": "ok", "why": "summary_passed"}
    return {"outcome": "unknown", "why": "no_signal"}


def ordering_qualifier_error(side, left):
    """Why one side of an ordering rule cannot carry its qualifier, or None."""
    if "[" not in side and "]" not in side:
        return None
    if left and side == "action:run_tests[ok]":
        return None
    return json.dumps(side, ensure_ascii=False) + ": [ok] qualifies only action:run_tests, on the left of ->"


def split_qualifier(token):
    """action:run_tests[ok] as ("action:run_tests", "ok"); any other token unqualified."""
    return ("action:run_tests", "ok") if token == "action:run_tests[ok]" else (token, None)


def empty_outcome_state():
    return {"v": 1, "outcomes": {}}


def outcome_state_file_name(harness, session_id, sha256_hex):
    """The first 32 hex of sha256(harness NUL session_id), and .json."""
    return sha256_hex(harness + "\\0" + session_id)[:32] + ".json"


def parse_outcome_state(text):
    """A state file's text as a state, or None when it is not one."""
    try:
        v = json.loads(text)
    except ValueError:
        return None
    if not isinstance(v, dict) or v.get("v") != 1 or isinstance(v.get("v"), bool) or not isinstance(v.get("outcomes"), dict):
        return None
    outcomes = {}
    for key, e in v["outcomes"].items():
        if not isinstance(e, dict):
            return None
        at = e.get("at")
        if e.get("o") not in ("ok", "failed", "unknown") or isinstance(at, bool) or not isinstance(at, (int, float)):
            return None
        if at != at or at in (float("inf"), float("-inf")):
            return None
        if "why" in e and not isinstance(e["why"], str):
            return None
        if "changed" in e and e["changed"] is not True:
            return None
        if "later" in e and e["later"] is not True:
            return None
        outcomes[key] = e
    return {"v": 1, "outcomes": outcomes}


def record_test_outcome(state, token, decision, at_ms):
    """state with token's outcome replaced by this run's."""
    outcomes = dict(state["outcomes"])
    outcomes[token] = {"o": decision["outcome"], "at": at_ms, "why": decision["why"]}
    return {"v": 1, "outcomes": outcomes}


def note_completed_call(state, changed_files):
    """state after another call completed: none adjacent any more, and stale after a file change."""
    outcomes = {}
    for key, e in state["outcomes"].items():
        nxt = {"o": e["o"], "at": e["at"]}
        if "why" in e:
            nxt["why"] = e["why"]
        if e.get("changed") or changed_files:
            nxt["changed"] = True
        nxt["later"] = True
        outcomes[key] = nxt
    return {"v": 1, "outcomes": outcomes}


def prerequisite_case(state, token, adjacent, now_ms):
    """(case, why): met only for an ok younger than a day that no file change followed
    (and, adjacent, no other call)."""
    e = None if state is None else state["outcomes"].get(token)
    if e is None or not (now_ms - e["at"] < OUTCOME_STATE_TTL_MS) or e["at"] > now_ms:
        return ("none", None)
    if e["o"] == "failed":
        return ("failed", e.get("why"))
    if e["o"] == "unknown":
        return ("unknown", e.get("why"))
    if e.get("changed"):
        return ("changed", None)
    if adjacent and e.get("later"):
        return ("not_adjacent", None)
    return ("met", None)


def prerequisite_unmet_reason(first, then, case, why, harness):
    """The PREREQUISITE_UNMET reason for every case but met, byte for byte as every port words it."""
    head = then + " needs a passing " + first + " first; "
    if case == "none":
        return head + "none ran in this session"
    if case == "failed":
        return head + "the last " + first + " failed (" + (why if why is not None else "failed") + ")"
    if case == "unknown":
        return head + "the result of the last " + first + " could not be read; rerun the tests so their summary is visible"
    if case == "changed":
        return head + "files changed after the last passing " + first + "; rerun the tests"
    if case == "not_adjacent":
        return head + then + " must come directly after it, and another call came between"
    if case == "not_observable":
        return head + harness + " reports no tool results Intutic can read, so a passing run cannot be observed here"
    if case == "no_session":
        return head + harness + " sent no session id, so test results cannot be tied to this session"
    return ""


"""Scope and plan semantics, ported from the proxy so every surface answers
"is this change inside the scope?" and "is this run on its plan?" the same way
.

A transliteration of packages/shared-types/src/scopeMatch.ts; read that
module's docstring for each function's port of origin (detectors.rs,
sops.rs, manifest.rs). Every port runs
packages/shared-types/fixtures/scope-plan-vectors.json.

The bash hook gates emit this file after the phrase matcher's (phrases.py),
which is_file_write_call calls: imported here as a module, and found in the
emitting script's scope when it is not one. Otherwise the standard library
only, and no backtick or dollar-brace, which a TypeScript copy cannot hold.
"""

try:
    from .phrases import has_phrase, phrase_text
except (ImportError, KeyError):  # embedded in a bash gate (exec without __name__), beside the phrase matcher's source
    pass

PLAN_DEVIATION_TOLERANCE = 0.4
NARROWED_TO_NOTHING = "<none: workspace list disjoint from org ceiling>"

SCOPE_WRITE_TOOLS = ("write", "write_file", "writefile", "create_file", "createfile")
SCOPE_EDIT_TOOLS = ("edit", "edit_file", "editfile", "multiedit", "apply_patch", "str_replace", "notebookedit")
SCOPE_DELETE_TOOLS = ("delete_file", "deletefile", "remove_file", "rm_file")
SCOPE_MOVE_TOOLS = ("move_file", "movefile", "rename_file", "rename")
SCOPE_EDITOR_TOOLS = ("str_replace_editor", "text_editor", "texteditor", "str_replace_based_edit_tool")
SCOPE_PATH_KEYS = ("file_path", "filepath", "path", "filename", "target_file", "notebook_path")
SCOPE_COMMAND_KEYS = ("command", "cmd", "script")
SCOPE_SHELL_TOOLS = ("bash", "shell", "run_command", "runcommand", "execute_command", "run_shell_command",
                     "terminal", "execute", "exec")
SCOPE_READ_TOOLS = ("read", "readfile", "view", "cat", "open_file")
SCOPE_MOVE_FROM_KEYS = ("source", "source_path", "from", "old_path")
SCOPE_MOVE_TO_KEYS = ("destination", "destination_path", "to", "new_path")
SCOPE_TARGET_MAX_BYTES = 512
PLAN_EXEMPT_TOOLS = ("read", "readfile", "view", "cat", "open_file", "glob", "grep", "ls", "list_dir", "search",
                     "todowrite")
FILE_WRITE_SHELL_PHRASES = ("sed -i", "perl -i", "perl -pi", "git apply", "git am", "git checkout", "git switch",
                            "git restore", "git reset", "git merge", "git pull", "git rebase", "git cherry-pick",
                            "git revert", "git stash pop", "git stash apply", "patch -p")


def _ascii_lower(s):
    return "".join(chr(ord(c) + 32) if "A" <= c <= "Z" else c for c in s)


def _tool_is(name, group):
    lower = name.lower()
    return any(lower == t or lower.endswith(t) for t in group)


def _keyed(inp, keys):
    if not isinstance(inp, dict):
        return None
    for k in keys:
        v = inp.get(k)
        if isinstance(v, str) and v != "":
            return v
    return None


def _utf8_len(ch):
    cp = ord(ch)
    return 1 if cp < 0x80 else 2 if cp < 0x800 else 3 if cp < 0x10000 else 4


def _clip(s):
    total = 0
    for i, ch in enumerate(s):
        n = _utf8_len(ch)
        if total + n > SCOPE_TARGET_MAX_BYTES:
            return s[:i] + "…"
        total += n
    return s


def _norm_scope(s):
    t = s
    while t[:2] == "./":
        t = t[2:]
    t = t.lstrip("/").rstrip("/")
    return _ascii_lower(t)


def is_within_scope(target, scopes):
    """Segment-prefix match of target against scopes, ignoring ASCII case and leading ./ or /."""
    t = _norm_scope(target)
    for raw in scopes:
        s = _norm_scope(raw)
        if s == "" or t == s or t[:len(s) + 1] == s + "/":
            return True
    return False


def sop_applies_to_role(roles, role):
    if not roles:
        return True
    if role == "":
        return False
    return _ascii_lower(role) in roles


def collect_scope_paths(sops, role):
    """The path scope in force for role (sops.rs collect_scope_paths), org ceiling included."""
    workspace, org = [], []
    for s in sops:
        if not sop_applies_to_role(s["roles"], role):
            continue
        (org if s["scope"] == "org" else workspace).extend(s["scopePaths"])
    if not org:
        out = workspace
    elif not workspace:
        out = org
    else:
        out = [w for w in workspace if is_within_scope(w, org)] or [NARROWED_TO_NOTHING]
    return sorted(set(out))


def collect_plan_steps(sops, role):
    """The plan in force for role (sops.rs collect_plan_steps), org ceiling included."""
    workspace, org = [], []
    for s in sops:
        if not sop_applies_to_role(s["roles"], role):
            continue
        (org if s["scope"] == "org" else workspace).extend(s["planSteps"])
    if not org:
        return workspace
    if not workspace:
        return org
    allowed = {_ascii_lower(o) for o in org}
    return [w for w in workspace if _ascii_lower(w) in allowed] or [NARROWED_TO_NOTHING]


def plan_off_steps(sequence, plan_steps, tolerance):
    """{"offPlan", "ratio"}: the off-plan names, sorted and deduplicated, when their share is over tolerance."""
    if not plan_steps or not sequence:
        return {"offPlan": [], "ratio": 0}
    plan = {_ascii_lower(p) for p in plan_steps}
    off = [t for t in sequence if _ascii_lower(t) not in plan]
    if not off:
        return {"offPlan": [], "ratio": 0}
    ratio = len(off) / len(sequence)
    if ratio <= tolerance:
        return {"offPlan": [], "ratio": ratio}
    return {"offPlan": sorted(set(off)), "ratio": min(1, ratio)}


def change_targets(tool, inp):
    """The mutations one tool call makes, as the proxy's change manifest records them."""
    if _tool_is(tool, SCOPE_MOVE_TOOLS):
        src = _keyed(inp, SCOPE_MOVE_FROM_KEYS)
        dst = _keyed(inp, SCOPE_MOVE_TO_KEYS)
        if src is not None or dst is not None:
            return [{"op": "move", "target": _clip(t)} for t in (src, dst) if t is not None]
    op = None
    if _tool_is(tool, SCOPE_EDITOR_TOOLS):
        command = inp.get("command") if isinstance(inp, dict) else None
        command = _ascii_lower(command) if isinstance(command, str) else ""
        if command == "view":
            return []
        op = "write" if command == "create" else "edit"
    elif _tool_is(tool, SCOPE_WRITE_TOOLS):
        op = "write"
    elif _tool_is(tool, SCOPE_EDIT_TOOLS):
        op = "edit"
    elif _tool_is(tool, SCOPE_DELETE_TOOLS):
        op = "delete"
    if op is None:
        return []
    target = _keyed(inp, SCOPE_PATH_KEYS)
    return [] if target is None else [{"op": op, "target": _clip(target)}]


def _diff_path(raw, prefix):
    p = raw
    tab = p.find("\\t")
    if tab != -1:
        p = p[:tab]
    p = p.strip(" ")
    if len(p) >= 2 and p[0] == '"' and p[-1] == '"':
        p = p[1:-1]
    if p in ("/dev/null", ""):
        return None
    if prefix and p[:len(prefix)] == prefix:
        p = p[len(prefix):]
    return p or None


def diff_changed_paths(diff):
    """The paths a diff changes, in the order first seen, each once."""
    out = []

    def add(p):
        if p is not None and p not in out:
            out.append(p)

    for raw in diff.split("\\n"):
        line = raw[:-1] if raw.endswith("\\r") else raw
        if line[:11] == "diff --git ":
            rest = line[11:]
            if rest[:2] != "a/":
                continue
            first = rest.find(" b/")
            if first == -1:
                continue
            if rest.find(" b/", first + 1) == -1:
                add(_diff_path(rest[:first], "a/"))
                add(_diff_path(rest[first + 1:], "b/"))
            elif (len(rest) - 5) % 2 == 0:
                n = (len(rest) - 5) // 2
                a = rest[2:2 + n]
                if rest[2 + n:5 + n] == " b/" and rest[5 + n:] == a:
                    add(_diff_path(a, ""))
        elif line[:4] == "--- ":
            add(_diff_path(line[4:], "a/"))
        elif line[:4] == "+++ ":
            add(_diff_path(line[4:], "b/"))
        elif line[:12] == "rename from ":
            add(_diff_path(line[12:], ""))
        elif line[:10] == "rename to ":
            add(_diff_path(line[10:], ""))
    return out


def _normalise_path(p):
    parts = []
    for seg in p.split("/"):
        if seg in ("", "."):
            continue
        if seg == "..":
            if parts:
                parts.pop()
        else:
            parts.append(seg)
    return "/" + "/".join(parts)


def scope_relative_path(target, cwd, root):
    """target relative to the workspace root, or None when outside it, under ~, or unresolvable."""
    if target == "" or target[:1] == "~" or cwd[:1] != "/" or root[:1] != "/":
        return None
    absolute = _normalise_path(target if target[:1] == "/" else cwd + "/" + target)
    base = _normalise_path(root)
    if absolute == base:
        return ""
    head = "/" if base == "/" else base + "/"
    return absolute[len(head):] if absolute[:len(head)] == head else None


def is_plan_exempt_tool(tool):
    """Whether plan_approval: lets tool run before approval: a PLAN_EXEMPT_TOOLS name, bare or mcp__<server>__<name>."""
    lower = tool.lower()
    return any(lower == t or lower[-(len(t) + 2):] == "__" + t for t in PLAN_EXEMPT_TOOLS)


def is_file_write_call(tool, inp):
    """Whether the call changed files: a mutation, or a shell command with a FILE_WRITE_SHELL_PHRASES phrase."""
    if change_targets(tool, inp):
        return True
    if not _tool_is(tool, SCOPE_SHELL_TOOLS):
        return False
    command = _keyed(inp, SCOPE_COMMAND_KEYS)
    if command is None:
        return False
    words = phrase_text(command)
    return any(has_phrase(words, p) for p in FILE_WRITE_SHELL_PHRASES)


# The lane phrases rule_record.py names (lanes.ts LANE_PHRASES).
LANE_PHRASES = {"action:deploy":["git push","kubectl apply","kubectl rollout","helm upgrade","helm install","terraform apply","docker push","serverless deploy","fly deploy","vercel deploy","gcloud run deploy","aws deploy","aws s3 sync","eb deploy"],"action:publish":["npm publish","pnpm publish","yarn publish","cargo publish","twine upload","poetry publish","gem push","docker manifest push"],"action:release":["gh release create","git tag","npm version","cargo release","goreleaser release","semantic-release"],"action:db_write":["insert into","update ","delete from","drop table","drop database","drop schema","truncate ","alter table"],"action:http_post":["curl -x post","curl --request post","curl -d ","curl --data","wget --post","http post"],"action:run_tests":["npm test","npm run test","pnpm test","pnpm run test","yarn test","cargo test","go test","pytest","python -m pytest","vitest","jest","mocha","rspec","phpunit","make test","gradle test","mvn test","dotnet test","bazel test","tox"],"action:migrate":["prisma migrate deploy","prisma db push","alembic upgrade","alembic downgrade","rails db:migrate","rake db:migrate","manage.py migrate","flyway migrate","liquibase update","knex migrate:latest","sequelize db:migrate"],"action:prod_write":["--prod","rails_env=production","node_env=production","--context prod","--namespace production","-n production","--environment production","--stage prod"],"action:destroy":["terraform destroy","kubectl delete","helm uninstall","helm delete","drop table","drop database","drop schema","truncate ","aws s3 rb","aws s3 rm"],"action:force_push":["git push --force","git push -f"],"action:payment":["api.stripe.com/v1/charges","api.stripe.com/v1/payment_intents","api.stripe.com/v1/transfers","api.stripe.com/v1/payouts","api.stripe.com/v1/refunds","stripe charges create","stripe payment_intents create","stripe transfers create","stripe payouts create","api-m.paypal.com/v2/payments","api.paypal.com/v1/payments"]}

"""Rule records in the policy snapshot: the @rule record, its
fallback line, and how a gate that reads it decides a call (Tier R).

A transliteration of packages/shared-types/src/gateRuleRecord.ts (the
reader's half: the writers are the daemon, the CLI and the control plane).
A record is five tab-separated columns: @rule, the fallback line's id or
-, the kind, the rollout, and base64 of the canonical JSON of its
payload, {v, ref, sopTitle, ...kind fields}. A record that does not
decode leaves its fallback line in force, which refuses. Kinds:
requires_outcome (a qualified requires_before), scope_paths (under
scope_paths_mode: enforce) and plan_approval.

Every port runs packages/shared-types/fixtures/rule-record-vectors.json. The
bash hook gates emit this file after test_outcome.py, scope_match.py and the
lane phrases, whose names it uses: imported here as modules, and found in the
emitting script's scope when it is not one. Otherwise the standard library
only, and no backtick or dollar-brace, which a TypeScript copy cannot hold.
"""

import base64
import binascii
import json
import re

try:
    from .actions import LANE_PHRASES
    from .scope_match import (
        SCOPE_DELETE_TOOLS, SCOPE_EDIT_TOOLS, SCOPE_EDITOR_TOOLS, SCOPE_MOVE_TOOLS, SCOPE_SHELL_TOOLS,
        SCOPE_WRITE_TOOLS, change_targets, is_plan_exempt_tool, is_within_scope, scope_relative_path,
    )
    from .test_outcome import prerequisite_case, prerequisite_unmet_reason
except (ImportError, KeyError):  # embedded in a bash gate (exec without __name__), beside the sources it needs
    pass

RULE_RECORD_TAG = "@rule"
RULE_SNAPSHOT_FORMAT = 3
RULE_SOP_TITLE_MAX_CHARS = 80
RULE_SCOPE_PATHS_MAX = 64
RULE_SCOPE_PATH_MAX_CHARS = 512
GATE_RULE_KINDS = ("requires_outcome", "scope_paths", "plan_approval")
V22_ACTION_TOKENS = ("action:deploy", "action:publish", "action:release", "action:db_write")

# The payload fields of each kind, sorted; the kind, fallback id and rollout are columns.
_FIELDS = {
    "requires_outcome": ["adjacent", "first", "qualifier", "ref", "sopTitle", "then", "v"],
    "scope_paths": ["ref", "scopePaths", "sopTitle", "v"],
    "plan_approval": ["mode", "ref", "sopTitle", "v"],
}
_REF = re.compile(r"^[^\\n\\r\\u2028\\u2029]+#([a-z_]+):([1-9][0-9]{0,5})\\Z")
_TOKEN = re.compile(r"^[A-Za-z][A-Za-z0-9_.:-]{0,63}\\Z")
_LINE_BREAK = re.compile(r"[\\t\\r\\n]")


def _from_base64(b64):
    """Standard base64 back to UTF-8 text; raises on anything but the canonical encoding."""
    raw = base64.b64decode(b64, validate=True)
    text = raw.decode("utf-8")
    if base64.b64encode(raw).decode("ascii") != b64:
        raise ValueError("not canonical base64")
    return text


def _text(v, max_chars, min_chars):
    return isinstance(v, str) and not _LINE_BREAK.search(v) and min_chars <= len(v) <= max_chars


def decode_gate_rule_record(line):
    """An @rule line as a record dict (payload fields plus kind, fallbackId and rollout), or None."""
    f = line.split("\\t")
    if len(f) != 5 or f[0] != RULE_RECORD_TAG or not f[4]:
        return None
    kind = f[2]
    if kind not in _FIELDS:
        return None
    try:
        r = json.loads(_from_base64(f[4]))
    except (ValueError, binascii.Error, UnicodeDecodeError):
        return None
    if not isinstance(r, dict) or sorted(r.keys()) != _FIELDS[kind]:
        return None
    if f[3] not in ("shadow", "enforce"):
        return None
    r = dict(r, kind=kind, fallbackId=None if f[1] == "-" else f[1], rollout=f[3])
    if r["v"] != 1 or isinstance(r["v"], bool):
        return None
    if not _text(r["sopTitle"], RULE_SOP_TITLE_MAX_CHARS, 0) or not isinstance(r["ref"], str):
        return None
    m = _REF.match(r["ref"])
    if not m or m.group(1) != kind:
        return None
    if r["rollout"] == "enforce":
        fid = r["fallbackId"]
        if not isinstance(fid, str) or not re.match(r"^" + kind + "-fallback:" + m.group(2) + r"@[0-9a-f]{12}\\Z", fid):
            return None
    elif r["fallbackId"] is not None:
        return None
    if kind == "requires_outcome":
        if r["first"] != "action:run_tests" or r["qualifier"] != "ok" or not isinstance(r["adjacent"], bool):
            return None
        if not isinstance(r["then"], str) or not _TOKEN.match(r["then"]) or r["then"] == "action:run_tests":
            return None
    elif kind == "scope_paths":
        paths = r["scopePaths"]
        if not isinstance(paths, list) or not 1 <= len(paths) <= RULE_SCOPE_PATHS_MAX:
            return None
        if any(not _text(p, RULE_SCOPE_PATH_MAX_CHARS, 1) for p in paths):
            return None
    elif r["mode"] not in ("required", "strict"):
        return None
    return r


def gate_rule_fallback_reason(kind, sop_title):
    if kind == "requires_outcome":
        return ("Qualified requires_before (" + sop_title + "): this gate cannot read test results, so the call "
                "it gates is refused; upgrade the Intutic gate")
    if kind == "scope_paths":
        return ("scope_paths_mode: enforce (" + sop_title + "): this gate cannot check a change against the "
                "scope, so every file change is refused; upgrade the Intutic gate")
    return ("plan_approval (" + sop_title + "): this gate cannot check plan approval, so every call is refused; "
            "upgrade the Intutic gate")


def _escape(s):
    return re.sub(r"([.*+?^(){}$|\\[\\]\\\\])", r"\\\\\\1", s)


def gate_rule_fallback(record):
    """The fallback line an older gate refuses with in the record's place, or None for a shadow record."""
    if record["fallbackId"] is None:
        return None
    base = {"id": record["fallbackId"], "severity": "block", "reason": gate_rule_fallback_reason(record["kind"], record["sopTitle"])}
    if record["kind"] == "plan_approval":
        return dict(base, subject="tool", source=" [^ ]+ ", ignoreCase=False)
    if record["kind"] == "scope_paths":
        tools = SCOPE_WRITE_TOOLS + SCOPE_EDIT_TOOLS + SCOPE_DELETE_TOOLS + SCOPE_MOVE_TOOLS + SCOPE_EDITOR_TOOLS
        return dict(base, subject="tool", source=" [^ ]*(" + "|".join(_escape(t) for t in tools) + ") ", ignoreCase=True)
    then = record["then"]
    if then in V22_ACTION_TOKENS:
        return dict(base, subject="action", source=" (" + _escape(then) + ") ", ignoreCase=True)
    if then.startswith("action:"):
        phrases = LANE_PHRASES.get(then) or []
        if phrases:
            return dict(base, subject="phrase", source="|".join(phrases), ignoreCase=True)
        return dict(base, subject="tool", source=" [^ ]*(" + "|".join(_escape(t) for t in SCOPE_SHELL_TOOLS) + ") ",
                    ignoreCase=True)
    return dict(base, subject="tool", source=" (" + _escape(then) + ") ", ignoreCase=False)


def gate_rule_plan_from_response(status, body):
    """The session's plan from GET /api/v1/plans/session/:id ({"status": approved|none|unavailable})."""
    if status == 404:
        return {"status": "none"}
    if status != 200 or not isinstance(body, dict):
        return {"status": "unavailable"}
    if body.get("lifecycleState") not in ("APPROVED", "EXECUTING"):
        return {"status": "none"}
    tools = []
    steps = body.get("steps")
    for step in steps if isinstance(steps, list) else []:
        if not isinstance(step, dict):
            continue
        tool = step.get("tool") if isinstance(step.get("tool"), str) else step.get("toolName")
        if isinstance(tool, str) and tool.strip() and tool.strip() not in tools:
            tools.append(tool.strip())
    return {"status": "approved", "tools": tools}


def _plan_finding(records, call):
    if not records or is_plan_exempt_tool(call["tool"]):
        return None
    rec = next((r for r in records if r["mode"] == "strict"), records[0])
    rule_id = "plan_approval." + rec["sopTitle"]
    scope = {"tools": [call["tool"]]}
    head = "plan_approval: " + rec["mode"] + " (" + rec["sopTitle"] + "): "
    if call["sessionId"] == "":
        return {"code": "PLAN_NOT_APPROVED", "ruleId": rule_id, "scope": scope, "ref": rec["ref"],
                "reason": head + call["harness"] + " sent no session id, so no approved plan can be found for this session"}
    plan = call["plan"]
    if plan["status"] != "approved":
        why = "this session has no approved plan" if plan["status"] == "none" else "the approved plans could not be read"
        return {"code": "PLAN_NOT_APPROVED", "ruleId": rule_id, "scope": scope, "ref": rec["ref"],
                "reason": head + why + "; get the plan approved, then retry"}
    if rec["mode"] == "strict":
        tool = call["tool"].lower()
        if not any(t.lower() == tool for t in plan["tools"]):
            return {"code": "OFF_PLAN", "ruleId": rule_id, "scope": scope, "ref": rec["ref"],
                    "reason": call["tool"] + " is not a step of this session's approved plan (plan_approval: strict, "
                    + rec["sopTitle"] + ")"}
    return None


def _requires_finding(records, call):
    tool = call["tool"].lower()
    for rec in records:
        if rec["then"] not in call["actions"] and rec["then"].lower() != tool:
            continue
        why = None
        if not call["observable"]:
            case = "not_observable"
        elif call["sessionId"] == "":
            case = "no_session"
        else:
            case, why = prerequisite_case(call["outcomes"], rec["first"], rec["adjacent"], call["nowMs"])
        if case == "met":
            continue
        return {
            "code": "PREREQUISITE_UNMET",
            "ruleId": "requires_before." + rec["first"] + "[ok]" + ("~>" if rec["adjacent"] else "->") + rec["then"],
            "reason": prerequisite_unmet_reason(rec["first"], rec["then"], case, why, call["harness"]),
            "scope": {"tools": [rec["then"]], "step": rec["first"]},
            "ref": rec["ref"],
        }
    return None


def _scope_finding(records, call):
    if not records:
        return None
    targets = change_targets(call["tool"], call["input"])
    if not targets:
        return None
    scopes = []
    for r in records:
        for p in r["scopePaths"]:
            if p not in scopes:
                scopes.append(p)
    outside = []
    for t in targets:
        rel = scope_relative_path(t["target"], call["cwd"], call["root"])
        if (rel is None or not is_within_scope(rel, scopes)) and t["target"] not in outside:
            outside.append(t["target"])
    if not outside:
        return None
    rec = records[0]
    return {
        "code": "OUT_OF_SCOPE",
        "ruleId": "scope_paths." + rec["sopTitle"],
        "reason": "Changes outside the declared file scope: " + ", ".join(outside) + " (scope: " + ", ".join(scopes) + ")",
        "scope": {"paths": outside},
        "ref": rec["ref"],
    }


def _findings(records, call):
    out = []
    for finding in (
        _plan_finding([r for r in records if r["kind"] == "plan_approval"], call),
        _requires_finding([r for r in records if r["kind"] == "requires_outcome"], call),
        _scope_finding([r for r in records if r["kind"] == "scope_paths"], call),
    ):
        if finding is not None:
            out.append(finding)
    return out


def evaluate_gate_rule_records(records, call):
    """Tier R: {"refusal": the first enforcing finding or None, "shadow": the shadow records' findings}.

    'call' carries tool, input, actions, cwd, root, sessionId, harness,
    outcomes (a state dict or None), observable, plan and nowMs, as in
    gateRuleRecord.ts GateRuleCall.
    """
    enforce = _findings([r for r in records if r["rollout"] == "enforce"], call)
    return {"refusal": enforce[0] if enforce else None,
            "shadow": _findings([r for r in records if r["rollout"] == "shadow"], call)}


"""What a refusal says about where to retry: its scope (paths,
tools, step, detector, rule) and its evidence (what the refuser saw),
bounded the same way on every surface.

A transliteration of packages/shared-types/src/refusalDetail.ts: each list
holds at most 8 items and each string at most 256 code points, with C0
control characters (U+0000 to U+001F) removed first; a string empty after
that is dropped, an empty list left out, and a scope with nothing left is
None. In an OPAQUE workspace both are dropped, and so is the stderr retry
line. Every port runs packages/shared-types/fixtures/refusal-detail-vectors.json.

Self-contained (the standard library only), so the bash hook gates can emit
it verbatim; no backtick or dollar-brace, which a TypeScript copy cannot hold.
"""

import re

REFUSAL_DETAIL_MAX_ITEMS = 8
REFUSAL_DETAIL_MAX_CHARS = 256
RETRY_SCOPE_PREFIX = "[Intutic] Retry scope: "

_C0 = re.compile("[\\u0000-\\u001f]")


def _detail_text(s):
    """s without C0 control characters, cut to 256 code points; None when nothing is left or it is not a string."""
    if not isinstance(s, str):
        return None
    clean = _C0.sub("", s)
    return clean[:REFUSAL_DETAIL_MAX_CHARS] if clean else None


def _detail_list(v):
    if not isinstance(v, list):
        return None
    out = []
    for item in v:
        if len(out) >= REFUSAL_DETAIL_MAX_ITEMS:
            break
        t = _detail_text(item)
        if t is not None:
            out.append(t)
    return out or None


def bound_refusal_scope(scope):
    """A scope bounded as the module says, keys in a fixed order; None when nothing is left."""
    if not isinstance(scope, dict):
        return None
    out = {}
    for key in ("paths", "tools"):
        v = _detail_list(scope.get(key))
        if v:
            out[key] = v
    for key in ("step", "detector", "rule"):
        v = _detail_text(scope.get(key))
        if v is not None:
            out[key] = v
    return out or None


def bound_refusal_evidence(evidence):
    """Evidence bounded: at most 8 items, each with a kind and a detail that survive bounding."""
    out = []
    if not isinstance(evidence, list):
        return out
    for item in evidence:
        if len(out) >= REFUSAL_DETAIL_MAX_ITEMS:
            break
        if not isinstance(item, dict):
            continue
        kind, detail = _detail_text(item.get("kind")), _detail_text(item.get("detail"))
        if kind is not None and detail is not None:
            out.append({"kind": kind, "detail": detail})
    return out


def refusal_detail_for_mode(mode, scope, evidence):
    """The detail a refusal carries in an intervention mode: nothing in OPAQUE, else the bounded scope and evidence."""
    if mode == "OPAQUE":
        return {}
    out = {}
    s = bound_refusal_scope(scope)
    if s:
        out["scope"] = s
    e = bound_refusal_evidence(evidence)
    if e:
        out["evidence"] = e
    return out


def retry_scope_line(mode, scope):
    """'[Intutic] Retry scope: <paths, else tools>', or None when neither, and in OPAQUE."""
    if mode == "OPAQUE":
        return None
    s = bound_refusal_scope(scope) or {}
    items = s.get("paths") or s.get("tools")
    return RETRY_SCOPE_PREFIX + ", ".join(items) if items else None


_INTUTIC_ACTION_NEEDLES = [["action:deploy",["git push","kubectl apply","kubectl rollout","helm upgrade","helm install","terraform apply","docker push","serverless deploy","fly deploy","vercel deploy","gcloud run deploy","aws deploy","aws s3 sync","eb deploy"]],["action:publish",["npm publish","pnpm publish","yarn publish","cargo publish","twine upload","poetry publish","gem push","docker manifest push"]],["action:release",["gh release create","git tag","npm version","cargo release","goreleaser release","semantic-release"]],["action:db_write",["insert into","update ","delete from","drop table","drop database","drop schema","truncate ","alter table"]],["action:run_tests",["npm test","npm run test","pnpm test","pnpm run test","yarn test","cargo test","go test","pytest","python -m pytest","vitest","jest","mocha","rspec","phpunit","make test","gradle test","mvn test","dotnet test","bazel test","tox"]],["action:http_post",["curl -x post","curl --request post","curl -d ","curl --data","wget --post","http post"]],["action:migrate",["prisma migrate deploy","prisma db push","alembic upgrade","alembic downgrade","rails db:migrate","rake db:migrate","manage.py migrate","flyway migrate","liquibase update","knex migrate:latest","sequelize db:migrate"]],["action:prod_write",["--prod","rails_env=production","node_env=production","--context prod","--namespace production","-n production","--environment production","--stage prod"]],["action:destroy",["terraform destroy","kubectl delete","helm uninstall","helm delete","drop table","drop database","drop schema","truncate ","aws s3 rb","aws s3 rm"]],["action:payment",["api.stripe.com/v1/charges","api.stripe.com/v1/payment_intents","api.stripe.com/v1/transfers","api.stripe.com/v1/payouts","api.stripe.com/v1/refunds","stripe charges create","stripe payment_intents create","stripe transfers create","stripe payouts create","api-m.paypal.com/v2/payments","api.paypal.com/v1/payments"]]]
_INTUTIC_ACTION_TOOLS = ["bash","shell","run_command","runcommand","execute_command","run_shell_command","terminal","execute","exec"]
_INTUTIC_FORCE_FLAGS = [" --force "," -f "]

_INTUTIC_RM_SEGMENT = re.compile(r"[;&|()\\n]")
_INTUTIC_RM_GAP = re.compile(r"[ \\t\\r\\f\\v]+")


def _intutic_removes_outside_tree(args):
    # removes_outside_tree (intutic_clawde actions.py, gate-js actions.ts):
    # rm -rf / -fr / -r -f / --recursive --force with a target that is
    # absolute, under ~, or contains "..". rm -rf build/ is not one.
    for segment in _INTUTIC_RM_SEGMENT.split(args):
        words = [w for w in _INTUTIC_RM_GAP.split(segment) if w != ""]
        at = next((i for i, w in enumerate(words) if w == "rm" or w.endswith("/rm")), -1)
        if at == -1:
            continue
        recursive = force = False
        flags = True
        targets = []
        for w in words[at + 1:]:
            if flags and w == "--":
                flags = False
            elif flags and w.startswith("--"):
                if w == "--recursive":
                    recursive = True
                if w == "--force":
                    force = True
            elif flags and w.startswith("-") and len(w) > 1:
                lower = w.lower()
                if "r" in lower:
                    recursive = True
                if "f" in lower:
                    force = True
            else:
                targets.append(w.strip("\\"'"))
        if recursive and force and any(t.startswith("/") or t.startswith("~") or ".." in t for t in targets):
            return True
    return False


def intutic_actions(tool, command):
    if str(tool or "").lower() not in _INTUTIC_ACTION_TOOLS:
        return " "
    words = phrase_text(command)
    out = " "
    for action, needles in _INTUTIC_ACTION_NEEDLES:
        if any(has_phrase(words, n) for n in needles):
            out += action + " "
    # A recursive, forced remove outside the working tree is destroy too
    # (Q3); no phrase can say "outside the tree", so it is a predicate.
    if " action:destroy " not in out and _intutic_removes_outside_tree(str(command or "")):
        out += "action:destroy "
    # The force-push compound: the git push phrase and a whole-word flag.
    if has_phrase(words, "git push"):
        padded = " " + " ".join(str(command or "").lower().split()) + " "
        if any(f in padded for f in _INTUTIC_FORCE_FLAGS):
            out += "action:force_push "
    return out


def _intutic_records(records_text, kind):
    out = []
    for line in str(records_text or "").split("\\n"):
        r = decode_gate_rule_record(line) if line else None
        if r is not None and r["kind"] == kind:
            out.append(r)
    return out


def intutic_rule_skip(records_text, kinds_csv):
    # The fallback line ids a decoded, enforcing record names, one per line,
    # for the kinds this gate evaluates. Any other fallback line stays.
    kinds = [k for k in str(kinds_csv).split(",") if k]
    out = []
    for line in str(records_text or "").split("\\n"):
        r = decode_gate_rule_record(line) if line else None
        if r is not None and r["fallbackId"] and r["kind"] in kinds:
            out.append(r["fallbackId"])
    return "\\n".join(out)


def _intutic_now_ms():
    import time
    return int(time.time() * 1000)


def _intutic_state_path(harness, session):
    import hashlib, os
    base = os.environ.get("INTUTIC_OUTCOME_STATE_DIR") or os.path.join(
        os.path.expanduser("~"), ".intutic", "hooks", "state", "outcomes")
    return os.path.join(base, outcome_state_file_name(str(harness), str(session),
                                                      lambda t: hashlib.sha256(t.encode("utf-8")).hexdigest()))


def _intutic_state_read(path):
    # (exists, state): a missing file is an empty state; one that does not
    # read is None, which leaves every qualified rule unmet.
    import os
    if not os.path.exists(path):
        return False, empty_outcome_state()
    try:
        with open(path, "r", encoding="utf-8") as fh:
            return True, parse_outcome_state(fh.read())
    except Exception:
        return True, None


def _intutic_state_write(path, state):
    import json, os
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        tmp = path + ".tmp." + str(os.getpid())
        with open(tmp, "w", encoding="utf-8") as fh:
            json.dump(state, fh, separators=(",", ":"))
        os.replace(tmp, path)
    except Exception:
        pass


def _intutic_verdict(r, code, rid, reason, scope):
    return "\\t".join(["block" if r["rollout"] == "enforce" else "shadow", code, rid, " ".join(reason.split()),
                      retry_scope_line("TRANSPARENT", scope) or ""])


def intutic_outcome_check(harness, observable, tool, actions, session, records_text, tool_input_json):
    import json
    try:
        ti = json.loads(tool_input_json or "{}")
    except ValueError:
        ti = {}
    recs = _intutic_records(records_text, "requires_outcome")
    path = _intutic_state_path(harness, session) if session else None
    exists, state = _intutic_state_read(path) if path else (False, empty_outcome_state())
    shadow = ""
    for r in recs:
        then = r["then"]
        if (" " + then + " ") not in str(actions) and then.lower() != str(tool).lower():
            continue
        why = None
        if observable != "1":
            case = "not_observable"
        elif not session:
            case = "no_session"
        else:
            case, why = prerequisite_case(state, r["first"], r["adjacent"], _intutic_now_ms())
        if case == "met":
            continue
        rid = "requires_before." + r["first"] + "[ok]" + ("~>" if r["adjacent"] else "->") + then
        line = _intutic_verdict(r, "PREREQUISITE_UNMET", rid, prerequisite_unmet_reason(r["first"], then, case, why, harness),
                                {"tools": [then], "step": r["first"]})
        if r["rollout"] == "enforce":
            return line
        shadow = shadow or line
    # Bookkeeping, on a call this tier lets through: no outcome is adjacent
    # to what comes next any more, and a call that changes files (a mutation
    # tool, or a shell write such as sed -i or git checkout) makes a pass
    # before it stale (Q1).
    if path and exists and state is not None:
        _intutic_state_write(path, note_completed_call(state, is_file_write_call(tool, ti)))
    return shadow


def intutic_post_record(harness, payload_text):
    # A post-tool payload: a shell call that ran tests records its outcome;
    # a file change marks an earlier [ok] stale. Never refuses.
    import json
    try:
        d = json.loads(payload_text or "{}")
    except ValueError:
        return ""
    if not isinstance(d, dict):
        return ""
    session = str(d.get("session_id") or d.get("sessionId") or "")
    if not session:
        return ""
    tool = str(d.get("tool_name") or d.get("toolName") or "")
    ti = d.get("tool_input") if isinstance(d.get("tool_input"), dict) else {}
    command = ""
    for k in ("command", "cmd", "script", "shell_command"):
        if isinstance(ti.get(k), str) and ti.get(k):
            command = ti[k]
            break
    actions = intutic_actions(tool, command)
    path = _intutic_state_path(harness, session)
    exists, state = _intutic_state_read(path)
    if " action:run_tests " in actions:
        resp = d.get("tool_response")
        output = ""
        if isinstance(resp, dict):
            v = resp.get("llmContent")
            output = v if isinstance(v, str) else json.dumps(v)
            # Gemini CLI prefixes the command's output with "Output: ".
            if output.startswith("Output: "):
                output = output[len("Output: "):]
        elif isinstance(resp, str):
            output = resp
        decision = decide_test_outcome({"exitCode": extract_exit_code(output), "output": output})
        _intutic_state_write(path, record_test_outcome(state if state is not None else empty_outcome_state(),
                                                       "action:run_tests", decision, _intutic_now_ms()))
    elif exists and state is not None and is_file_write_call(tool, ti):
        _intutic_state_write(path, note_completed_call(state, True))
    return ""


def _intutic_real(path):
    import os
    return os.path.realpath(path)


def _intutic_repo_root(cwd):
    import os
    d = _intutic_real(cwd or os.getcwd())
    while True:
        if os.path.exists(os.path.join(d, ".git")):
            return d
        parent = os.path.dirname(d)
        if parent == d:
            return _intutic_real(cwd or os.getcwd())
        d = parent


def _intutic_approved_plan(session, workspace_id):
    import hashlib, json, os, datetime
    path = os.environ.get("INTUTIC_APPROVED_PLANS") or os.path.join(
        os.path.expanduser("~"), ".intutic", "hooks", "approved-plans.jsonl")
    try:
        with open(path, "r", encoding="utf-8") as fh:
            lines = fh.read().split("\\n")
    except Exception:
        return None
    digest = ws = expires = ""
    body = []
    for line in lines:
        if line.startswith("#digest "):
            digest = line[8:].strip()
        elif line.startswith("#workspace "):
            ws = line[11:].strip()
        elif line.startswith("#expires "):
            expires = line[9:].strip()
        elif line and not line.startswith("#"):
            body.append(line)
    if hashlib.sha256("\\n".join(body).encode("utf-8")).hexdigest()[:32] != digest:
        return None
    if ws and workspace_id and ws != workspace_id:
        return None
    try:
        exp = datetime.datetime.fromisoformat(expires.replace("Z", "+00:00"))
    except Exception:
        return None
    if datetime.datetime.now(datetime.timezone.utc) >= exp:
        return None
    tools = None
    for line in body:
        try:
            e = json.loads(line)
        except ValueError:
            continue
        if not isinstance(e, dict) or e.get("sessionId") != session or e.get("state") not in ("APPROVED", "EXECUTING"):
            continue
        tools = (tools or []) + [str(t).lower() for t in (e.get("tools") or []) if isinstance(t, str)]
    return None if tools is None else {"tools": tools}


def intutic_trajectory_check(harness, tool, session, records_text, tool_input_json, payload_cwd, workspace_id):
    import json, os
    try:
        ti = json.loads(tool_input_json or "{}")
    except ValueError:
        ti = {}
    shadow = ""
    scopes = _intutic_records(records_text, "scope_paths")
    targets = [t["target"] for t in change_targets(tool, ti)] if scopes else []
    if targets:
        cwd = payload_cwd or os.getcwd()
        root = _intutic_repo_root(cwd)
        rels = []
        for t in targets:
            absolute = _intutic_real(os.path.join(_intutic_real(cwd), t))
            rel = os.path.relpath(absolute, root)
            rels.append((t, None if rel == ".." or rel.startswith(".." + os.sep) or os.path.isabs(rel) else rel.replace(os.sep, "/")))
        for rollout in ("enforce", "shadow"):
            group = [r for r in scopes if r["rollout"] == rollout]
            if not group:
                continue
            union = [s for r in group for s in r["scopePaths"]]
            bad = [t for t, rel in rels if rel is None or not is_within_scope(rel, union)]
            if bad:
                r = group[0]
                line = _intutic_verdict(r, "OUT_OF_SCOPE", "scope_paths." + r["sopTitle"],
                                        ", ".join(bad) + " is outside scope_paths (" + ", ".join(union) + ")", {"paths": bad})
                if rollout == "enforce":
                    return line
                shadow = shadow or line
    plans = _intutic_records(records_text, "plan_approval")
    if plans and not is_plan_exempt_tool(str(tool)):
        for rollout in ("enforce", "shadow"):
            group = [r for r in plans if r["rollout"] == rollout]
            if not group:
                continue
            strict = [r for r in group if r["mode"] == "strict"]
            r = strict[0] if strict else group[0]
            level = r["mode"]
            rid = "plan_approval." + r["sopTitle"]
            line = ""
            if not session:
                line = _intutic_verdict(r, "PLAN_NOT_APPROVED", rid, "plan_approval: " + level + " - " + harness + " sent no session id, so no approved plan can be found for this call", {"tools": [str(tool)]})
            else:
                plan = _intutic_approved_plan(session, workspace_id)
                if plan is None:
                    line = _intutic_verdict(r, "PLAN_NOT_APPROVED", rid, "plan_approval: " + level + " - this session has no APPROVED or EXECUTING plan; get its plan approved, then retry", {"tools": [str(tool)]})
                elif level == "strict" and str(tool).lower() not in plan["tools"]:
                    line = _intutic_verdict(r, "OFF_PLAN", rid, "plan_approval: strict - " + str(tool) + " is not a step of the approved plan", {"tools": [str(tool)]})
            if line and rollout == "enforce":
                return line
            shadow = shadow or line
    return shadow


def intutic_phrase_rule(source, command):
    words = phrase_text(command)
    return any(has_phrase(words, p, True) for p in source.split("|"))


def intutic_mcp_registry(record_b64, tool):
    # The registry decision for one mcp__<server>__<tool> call, from the
    # snapshot's @mcp_registry record: "code<TAB>ruleId<TAB>reason", or "" to
    # let the call continue.
    call = split_mcp_tool_name(tool)
    registry = decode_registry_record(MCP_REGISTRY_RECORD_TAG + "\\t" + record_b64)
    if call is None or registry is None:
        return ""
    refusal = evaluate_registry(registry, call[0], call[1])
    return "\\t".join(refusal) if refusal else ""


def intutic_mcp_unverified(tool):
    # The refusal of an mcp__<server>__<tool> call on a snapshot that failed
    # its integrity check, as "code<TAB>ruleId<TAB>reason"; "" for a call that
    # is not an MCP call.
    call = split_mcp_tool_name(tool)
    return "\\t".join(unverified_refusal(call[0])) if call else ""


"""Fault injection in the hook gates, for chaos runs (intutic chaos run).

A transliteration of packages/shared-types/src/chaosGate.ts; read that
module's docstring for the counter files and why every count lives on disk.
In short: a gate is a new process per tool call, so the plan is decoded on
each call, plan_loaded is reported by whichever gate first creates
EVENTS.gate-plan-loaded, and each fault's seen and hit counts are numbered
empty files in EVENTS.gate-counters/, each number claimed with an exclusive
create (O_CREAT | O_EXCL), which exactly one process wins. A permission fault
never sleeps: it holds the call as an approval hold does, in a
FAULT.held.KEY.G file whose modification time is when, and the identical
retry is held again until delay_s has passed, then allowed (delay) or denied
(hold_then_deny) by the one retry that creates FAULT.released.KEY.G.

The bash gates emit this file verbatim (services/sync-daemon/src/lib/chaosPy.ts
holds a byte-identical copy, which a test compares), intutic_clawde.gate's
Gate.guard runs it in process, and every copy runs
packages/shared-types/fixtures/chaos-gate-vectors.json. It must stay
self-contained: the standard library only, no module state beyond the
constants below, and no backtick or dollar-brace, which the TypeScript copy
cannot hold.
"""

import base64
import binascii
import datetime
import json
import os
import re
import sys
import time

_CHAOS_FAULT_IDS = (
    "llm.rate_limit", "llm.upstream_5xx", "llm.context_trim", "llm.model_degrade", "tool.error", "tool.stale_data",
    "mcp.toolset_change", "permission.deny_or_delay", "inject.tool_result", "egress.dns_fail", "egress.credential_401",
)
_CHAOS_B64URL = re.compile(r"^[A-Za-z0-9_-]+={0,2}$")
_CHAOS_RUN_ID = re.compile(r"^[A-Za-z0-9_-]{6,64}$")
_CHAOS_CANARY = re.compile(r"^E-INTUTIC-[0-9A-F]{4,16}$")


def _chaos_int(v, low, high):
    # JSON numbers as JavaScript reads them: 2.0 is the integer 2. A bool is not a number.
    if isinstance(v, bool) or not isinstance(v, (int, float)):
        return None
    if isinstance(v, float):
        if not v.is_integer():
            return None
        v = int(v)
    return v if low <= v <= high else None


def chaos_decode(raw):
    """(plan, None), or (None, why it is not one)."""
    def invalid(why):
        return None, "INTUTIC_CHAOS_PLAN is not a valid plan: " + why
    try:
        if not isinstance(raw, str) or not _CHAOS_B64URL.match(raw):
            raise ValueError("alphabet")
        b64 = raw.rstrip("=")
        data = json.loads(base64.urlsafe_b64decode(b64 + "=" * ((4 - len(b64) % 4) % 4)).decode("utf-8"))
    except (ValueError, binascii.Error, UnicodeDecodeError):
        return None, "INTUTIC_CHAOS_PLAN is not base64url-encoded JSON"
    if not isinstance(data, dict):
        return invalid("not a JSON object")
    v = data.get("v")
    if isinstance(v, bool) or v != 1:
        return invalid("version " + json.dumps(v) + ", and a gate reads only version 1")
    run_id = data.get("runId")
    if not isinstance(run_id, str) or not _CHAOS_RUN_ID.match(run_id):
        return invalid("runId")
    canary = data.get("canary")
    if not isinstance(canary, str) or not _CHAOS_CANARY.match(canary):
        return invalid("canary")
    raw_faults = data.get("faults")
    if not isinstance(raw_faults, list) or len(raw_faults) > 50:
        return invalid("faults")
    faults = []
    for i, f in enumerate(raw_faults):
        at = "faults[" + str(i) + "]"
        if not isinstance(f, dict) or not isinstance(f.get("id"), str) or f["id"] not in _CHAOS_FAULT_IDS:
            return invalid(at + ".id")
        if f["id"] not in ("tool.error", "permission.deny_or_delay"):
            continue
        match = None
        if "match" in f:
            if not isinstance(f["match"], dict):
                return invalid(at + ".match")
            for k, mv in f["match"].items():
                if k not in ("tool", "host", "model") or not isinstance(mv, str) or not mv:
                    return invalid(at + ".match." + k)
            match = f["match"]
        after_calls = 0
        if "after_calls" in f:
            after_calls = _chaos_int(f["after_calls"], 0, 10000)
            if after_calls is None:
                return invalid(at + ".after_calls")
        times = None
        if "times" in f:
            times = _chaos_int(f["times"], 1, 10000)
            if times is None:
                return invalid(at + ".times")
        fault = {
            "index": i, "id": f["id"], "match": match, "after_calls": after_calls, "times": times,
            "message": "tool failed", "mode": "deny", "delay_s": 0,
        }
        if f["id"] == "tool.error" and "message" in f:
            # Lengths in UTF-16 code units, as JavaScript counts them.
            m = f["message"]
            if not isinstance(m, str) or not 1 <= len(m.encode("utf-16-le", "surrogatepass")) // 2 <= 2000:
                return invalid(at + ".message")
            fault["message"] = m
        if f["id"] == "permission.deny_or_delay":
            if "mode" in f:
                if f["mode"] not in ("deny", "delay", "hold_then_deny"):
                    return invalid(at + ".mode")
                fault["mode"] = f["mode"]
            if "delay_s" in f:
                delay_s = _chaos_int(f["delay_s"], 0, 600)
                if delay_s is None:
                    return invalid(at + ".delay_s")
                fault["delay_s"] = delay_s
        faults.append(fault)
    return {"runId": run_id, "canary": canary, "faults": faults}, None


def chaos_matches(match, tool):
    """Whether a fault's match covers a gate call, which has a tool and nothing else."""
    if not match:
        return True
    if "host" in match or "model" in match:
        return False
    p = match.get("tool")
    if p is None:
        return True
    return tool.endswith(p[1:]) if p.startswith("*") else tool == p


def chaos_event(plan, type_, fields, now):
    """One events-file line: ts, runId, component, type, then the fields that are set."""
    event = {"ts": now, "runId": plan["runId"], "component": "gate", "type": type_}
    for k, v in fields:
        if v is not None:
            event[k] = v
    return json.dumps(event, separators=(",", ":"), ensure_ascii=False) + "\\n"


def chaos_append(events_path, lines):
    """Appends whole lines in one write. An I/O error is reported, never raised."""
    try:
        fd = os.open(events_path, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o644)
        try:
            os.write(fd, lines.encode("utf-8"))
        finally:
            os.close(fd)
    except OSError as e:
        sys.stderr.write("[Intutic Governance] chaos: could not append to " + events_path + ": " + str(e) + "\\n")


def chaos_claim(directory, prefix, limit):
    """Claims the next numbered file DIRECTORY/PREFIXn with an exclusive create.

    Returns n, 0 when every number up to limit is taken, or -1 on an I/O
    error, after saying so.
    """
    try:
        # Beside the events file, never creating its directory: the runner did.
        try:
            os.mkdir(directory)
        except FileExistsError:
            pass
        n = sum(1 for name in os.listdir(directory) if name.startswith(prefix)) + 1
        while limit is None or n <= limit:
            try:
                os.close(os.open(os.path.join(directory, prefix + str(n)), os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o644))
                return n
            except FileExistsError:
                n += 1
        return 0
    except OSError as e:
        sys.stderr.write("[Intutic Governance] chaos: could not count calls in " + directory + ": " + str(e) + "\\n")
        return -1


def chaos_open_hold(directory, fault, key):
    """The open hold of one fault on one call: (g, created), the number of
    the newest FAULT.held.KEY.G file with no released twin and its
    modification time in milliseconds; None when there is none or it cannot
    be read."""
    try:
        held = str(fault) + ".held." + key + "."
        names = os.listdir(directory)
        g = 0
        for name in names:
            if name.startswith(held) and name[len(held):].isdigit():
                g = max(g, int(name[len(held):]))
        if g == 0 or (str(fault) + ".released." + key + "." + str(g)) in names:
            return None
        # In whole milliseconds, as now is: a hold is never younger than the call that reads it.
        return g, os.stat(os.path.join(directory, held + str(g))).st_mtime_ns // 1000000
    except OSError:
        # No counters yet, or none readable: no hold to continue.
        return None


def chaos_release(directory, fault, key, g):
    """Ends hold g with an exclusive create: True for the one caller that does."""
    try:
        os.close(os.open(os.path.join(directory, str(fault) + ".released." + key + "." + str(g)),
                         os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o644))
        return True
    except OSError:
        # Another gate released it first, or it cannot be written.
        return False


def _chaos_ms(now):
    # The ISO-8601 time a call is decided at, in milliseconds; the clock if unreadable.
    try:
        return round(datetime.datetime.fromisoformat(now.replace("Z", "+00:00")).timestamp() * 1000)
    except (AttributeError, TypeError, ValueError):
        return int(time.time() * 1000)


def chaos_now():
    """The time as the JavaScript gates write it: <TIMESTAMP>."""
    return datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="milliseconds").replace("+00:00", "Z")


def chaos_call(plan, events_path, call, now):
    """Reports one call and returns the fault the gate must apply, or None.

    call: tool, decision (allow, deny, ask or hold, before any fault), ruleId,
    destructive, policyHit, and key: the call's digest in hex (its tool and
    input, as the gate keys an approval hold), which a held call's retry
    shares. The fault: faultId, kind (deny or hold) and reason, as
    chaosGateCall returns it. now is the ISO-8601 time, and the clock a hold
    is timed by.
    """
    lines = ""
    first = True
    try:
        os.close(os.open(events_path + ".gate-plan-loaded", os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o644))
    except FileExistsError:
        first = False
    except OSError:
        pass
    if first:
        lines += chaos_event(plan, "plan_loaded", [("faults", len(plan["faults"]))], now)
    lines += chaos_event(plan, "gate_decision", [
        ("tool", call["tool"]),
        ("decision", call["decision"]),
        ("ruleId", call.get("ruleId") or None),
        ("destructive", bool(call.get("destructive"))),
        ("policyHit", bool(call.get("policyHit"))),
    ], now)
    fault = None
    if call["decision"] == "allow":
        directory = events_path + ".gate-counters"
        key = re.sub(r"[^0-9A-Za-z]", "", str(call.get("key") or ""))[:128] or "call"
        now_ms = _chaos_ms(now)
        tag = " [" + plan["canary"] + "]"
        held = "Permission held for approval; retrying this exact call passes once it is approved" + tag
        # The retry of a held call: still held until the delay has passed,
        # then let through or denied by the one retry that releases it.
        retry = False
        for f in plan["faults"]:
            if f["id"] != "permission.deny_or_delay" or f["mode"] == "deny" or not chaos_matches(f["match"], call["tool"]):
                continue
            open_hold = chaos_open_hold(directory, f["index"], key)
            if open_hold is None:
                continue
            retry = True
            if f["delay_s"] > 0 and now_ms - open_hold[1] < f["delay_s"] * 1000:
                fault = {"faultId": f["id"], "kind": "hold", "reason": held}
            elif chaos_release(directory, f["index"], key, open_hold[0]):
                if f["mode"] == "hold_then_deny":
                    fault = {"faultId": f["id"], "kind": "deny",
                             "reason": "Permission held for approval, then denied by approver" + tag}
            else:
                # Another gate released it first: this call is a new one.
                retry = False
                continue
            break
        for f in plan["faults"] if not retry else ():
            if not chaos_matches(f["match"], call["tool"]):
                continue
            # An MCP tool's error is the MCP proxy's to inject; a gate injects the built-in side.
            if f["id"] == "tool.error" and call["tool"].startswith("mcp__"):
                continue
            seen = chaos_claim(directory, str(f["index"]) + ".seen.", None)
            if fault is not None or seen < 1 or seen <= f["after_calls"]:
                continue
            if f["times"] is not None and chaos_claim(directory, str(f["index"]) + ".hit.", f["times"]) < 1:
                continue
            if f["id"] == "tool.error":
                fault = {"faultId": f["id"], "kind": "deny", "reason": f["message"] + tag}
            elif f["mode"] == "deny":
                fault = {"faultId": f["id"], "kind": "deny", "reason": "Permission denied by approver" + tag}
            else:
                # Held from now: the hold's file is what its retries find.
                if chaos_claim(directory, str(f["index"]) + ".held." + key + ".", None) < 1:
                    continue
                fault = {"faultId": f["id"], "kind": "hold", "reason": held}
            lines += chaos_event(plan, "fault_injected", [("faultId", f["id"]), ("call", seen), ("target", call["tool"])], now)
        if fault is None or fault["kind"] == "hold":
            lines += chaos_event(plan, "tool_call", [("tool", call["tool"]), ("ok", fault is None)], now)
    chaos_append(events_path, lines)
    return fault



def intutic_chaos_begin():
    # Why the chaos run's plan cannot be used, or "" when it can.
    plan, error = chaos_decode(os.environ.get("INTUTIC_CHAOS_PLAN", ""))
    if error:
        return error
    if not os.environ.get("INTUTIC_CHAOS_EVENTS"):
        return "INTUTIC_CHAOS_PLAN is set but INTUTIC_CHAOS_EVENTS is not, so nothing the run does could be reported"
    return ""


def intutic_chaos_call(tool, decision, rule_id, destructive, policy_hit, key=""):
    # Records one call as the gate decided it, before any fault; returns the
    # fault to apply to an allowed call as "kind<TAB>reason" (kind deny or
    # hold), or "". key is the call's digest, which a held call's retry shares.
    plan, error = chaos_decode(os.environ.get("INTUTIC_CHAOS_PLAN", ""))
    events = os.environ.get("INTUTIC_CHAOS_EVENTS", "")
    if error or not events:
        return ""
    call = {"tool": tool, "decision": decision, "ruleId": rule_id or None,
            "destructive": destructive == "1", "policyHit": policy_hit == "1", "key": key}
    fault = chaos_call(plan, events, call, chaos_now())
    if fault is None:
        return ""
    return fault["kind"] + "\\t" + fault["reason"]


_INTUTIC_DECIDE_CODES = {
    "allow": (None,),
    "refuse": ("DECIDE_REFUSED", "DECIDE_ESCALATED", "GOVERNANCE_UNAVAILABLE"),
    "escalate": ("DECIDE_ESCALATED",),
}


def intutic_decide_check(harness, tool, budget_ms, session_id, enforce, tool_input_json):
    # The decide tier of a bash gate: \`intutic decide check --stdin\` on a call
    # an @decide record names. Returns outcome, code, rule id and reason,
    # joined by the unit separator (an empty field where there is none). A
    # missing CLI, a non-zero exit, a timeout or an answer that does not read
    # is unavailable: refused with GOVERNANCE_UNAVAILABLE when a matched
    # record is stamped enforce (enforce "1"), allowed, with the reason, when
    # every one is shadow. The CLI spends the budget, its own start included.
    import json, shutil, subprocess
    sep = chr(31)

    def clean(text):
        return " ".join(str(text).split())

    def unavailable(why):
        if enforce != "1":
            return sep.join(["allow", "", "", clean(why)])
        return sep.join(["refuse", "GOVERNANCE_UNAVAILABLE", "", clean("GOVERNANCE_UNAVAILABLE — " + why)])

    try:
        tool_input = json.loads(tool_input_json or "{}")
    except ValueError:
        tool_input = {}
    exe = shutil.which("intutic")
    if not exe:
        return unavailable("the decide rules on " + tool + " need the intutic CLI, which is not on PATH")
    payload = {"v": 1, "harness": harness, "tool": tool, "toolInput": tool_input, "cwd": os.getcwd(),
               "sessionId": session_id, "budgetMs": int(budget_ms), "lastUserTurn": None}
    try:
        done = subprocess.run([exe, "decide", "check", "--stdin"], input=json.dumps(payload), capture_output=True,
                              text=True, timeout=int(budget_ms) / 1000.0)
    except subprocess.TimeoutExpired:
        return unavailable("intutic decide check did not answer within " + str(budget_ms) + " ms")
    except OSError as err:
        return unavailable("intutic decide check could not run (" + type(err).__name__ + ")")
    if done.returncode != 0:
        return unavailable("intutic decide check exited " + str(done.returncode))
    try:
        out = json.loads(done.stdout)
    except ValueError:
        out = None
    rule_id = out.get("ruleId") if isinstance(out, dict) else None
    if (not isinstance(out, dict) or out.get("v") != 1 or out.get("outcome") not in _INTUTIC_DECIDE_CODES
            or out.get("code") not in _INTUTIC_DECIDE_CODES[out.get("outcome")]
            or not (rule_id is None or (isinstance(rule_id, str) and rule_id.startswith("decide.")))
            or not isinstance(out.get("reason", ""), str)):
        return unavailable("intutic decide check gave an answer this gate does not read")
    return sep.join([out["outcome"], out.get("code") or "", clean(rule_id or ""), clean(out.get("reason") or "")])

INTUTIC_PY_LIB_END
export INTUTIC_PY_LIB

INTUTIC_FIELDS="$(printf '%s' "$INPUT" | python3 -c '
import os, sys, json
def clean(v):
    return " ".join(str(v).split()) if isinstance(v, str) else ""
state = "ok"
try:
    d = json.load(sys.stdin)
except Exception:
    d = {}
    state = "malformed"
if not isinstance(d, dict):
    d = {}
    state = "malformed"
# The envelope check githubCopilotHooks established, applied to the bash
# family: a payload carrying none of the tool fields in any known spelling is
# one the gate cannot evaluate, and extracting empty fields from it would
# match no rule — an allow. Reported as a STATE and decided in the gate body,
# because log_event is not defined yet at extraction time.
if state == "ok" and not any(
    k in d for k in ("tool_name", "toolName", "tool_input", "toolInput")
):
    state = "malformed"
i = d.get("tool_input") or {}
if not isinstance(i, dict):
    i = {}
def first(*keys):
    for k in keys:
        v = i.get(k)
        if isinstance(v, str) and v:
            return clean(v)
    return ""
def raw_first(*keys):
    for k in keys:
        v = i.get(k)
        if isinstance(v, str) and v:
            return v
    return ""
raw_command = raw_first("command", "cmd", "script", "shell_command")
tool_input_json = json.dumps(i, separators=(",", ":"), ensure_ascii=False)
# Too large to evaluate inside the hook timeout (gateLimits.ts): the gate body
# refuses on this line, and the command and arguments are not passed on.
command_bytes = len(raw_command.encode("utf-8", "surrogatepass"))
argument_bytes = len(tool_input_json.encode("utf-8", "surrogatepass"))
too_large = ""
if command_bytes > 262144:
    too_large = "the command is %d bytes, over the 262144-byte limit a gate evaluates; split it into smaller commands" % command_bytes
elif argument_bytes > 1048576:
    too_large = "the tool arguments are %d bytes, over the 1048576-byte limit a gate evaluates; write the content in smaller parts" % argument_bytes
if too_large:
    raw_command = ""
    tool_input_json = "{}"
# The hold classifier reads the raw command: a line continuation or a comment
# is still in it. The library is the shared phrase matcher, not a regex.
lib = {}
try:
    exec(os.environ.get("INTUTIC_PY_LIB", ""), lib)
    actions = lib["intutic_actions"](d.get("tool_name", ""), raw_command) if not too_large else " "
except Exception:
    actions = " "
# The state line comes FIRST: the lines after it may legitimately be empty,
# and command substitution strips trailing newlines, so the last line is the
# only position an empty value cannot survive in.
print(state)
print(too_large)
print(clean(d.get("tool_name", "")))
print(first("path", "file_path", "notebook_path", "filePath"))
print("" if too_large else first("command", "cmd", "script", "shell_command"))
print(clean(d.get("session_id", d.get("sessionId", ""))))
print(actions)
# The raw command as one JSON line, for phrase-subject rules.
print(json.dumps(raw_command, ensure_ascii=False))
# The FULL tool_input, serialized to the exact shape argPattern rules are
# matched against everywhere: JSON.stringify(tool_input) — compact separators,
# insertion order, non-ASCII intact. The selected fields above are whitespace-
# collapsed for token matching; this one must NOT be, or a WHERE clause that
# spans a key/value boundary matches here and not in the JS gates. json.dumps
# escapes every newline, so it is still exactly one line to read back.
print(tool_input_json)
' 2>/dev/null || printf '\\n\\n\\n\\n\\n\\n\\n\\n\\n')"

# Each read is \`|| true\` because command substitution strips trailing newlines:
# a tool call with no command argument yields fewer lines than reads, so a late
# read hits EOF and returns non-zero. Under \`set -e\` that killed the gate with
# **exit 1** — which every harness reads as a hook error and lets the call
# through. A guard that fails open on the most ordinary input there is (a Write
# with no shell command) is worse than no guard, because it looks present.
{ IFS= read -r INTUTIC_EXTRACT_STATE || true; IFS= read -r INTUTIC_TOO_LARGE || true; IFS= read -r TOOL || true; IFS= read -r TARGET || true; IFS= read -r COMMAND || true; IFS= read -r SESSION_ID || true; IFS= read -r INTUTIC_ACTIONS || true; IFS= read -r INTUTIC_RAW_COMMAND_JSON || true; IFS= read -r TOOL_INPUT_JSON || true; } <<EOF_INTUTIC_FIELDS
$INTUTIC_FIELDS
EOF_INTUTIC_FIELDS
TOOL="\${TOOL:-}"; TARGET="\${TARGET:-}"; COMMAND="\${COMMAND:-}"; SESSION_ID="\${SESSION_ID:-}"
# Space-padded action tokens the extractor's classifier found, or " ".
INTUTIC_ACTIONS="\${INTUTIC_ACTIONS:- }"
# Why the call is too large to evaluate, or empty (gateLimits.ts).
INTUTIC_TOO_LARGE="\${INTUTIC_TOO_LARGE:-}"
INTUTIC_RAW_COMMAND_JSON="\${INTUTIC_RAW_COMMAND_JSON:-""}"
# Empty means the extractor itself died (the fallback printf above): treat it
# exactly like a payload the parser rejected. The gate body refuses on any
# value other than "ok" — see the envelope refusal in emitShellGate.
INTUTIC_EXTRACT_STATE="\${INTUTIC_EXTRACT_STATE:-}"
[ -n "$INTUTIC_EXTRACT_STATE" ] || INTUTIC_EXTRACT_STATE="malformed"
# Empty only when the extractor failed wholesale (malformed stdin). Defaulting
# to the empty OBJECT rather than the empty string keeps the argPattern match
# well-defined either way.
TOOL_INPUT_JSON="\${TOOL_INPUT_JSON:-}"
[ -n "$TOOL_INPUT_JSON" ] || TOOL_INPUT_JSON="{}"
# Aliases for the names the older writers used. Kept so this extractor is a
# drop-in for every bash gate; the canonical names are the unsuffixed ones.
TOOL_NAME="$TOOL"; TARGET_PATH="$TARGET"


HOOK_EVENTS_LOG="<ROOT>/.intutic/events/hook-events.jsonl"

# ── Runtime credentials (sourced from ~/.intutic/env/runtime.env) ────────────────────────
# These are defaults, and they are also the only thing standing between
# \`set -u\` and a fatal unbound-variable error: log_event reads all three, so on
# a machine with no runtime.env to source, an unset name kills the gate before
# it can exit 2. Spelling matters — INTUTIC_, never INTUITIC_.
RUNTIME_ENV="$HOME/.intutic/env/runtime.env"
INTUTIC_HOST=""
INTUTIC_API_KEY=""
INTUTIC_WORKSPACE_ID="ws_test"
[ -f "$RUNTIME_ENV" ] && source "$RUNTIME_ENV" 2>/dev/null || true

log_event() {
  local verdict="$1" tool="$2" reason="$3"
  # \`tool\` and \`reason\` carry agent-controlled text — the tool name, and the
  # target path quoted into the block reason — and both are spliced into the
  # JSON string below. Escape first: one unescaped quote yields a line
  # JSON.parse rejects, and drainHookEvents drops malformed lines then wipes the
  # log on a successful drain, so the record of a block is destroyed rather than
  # delayed. A crafted path could otherwise close the string and forge fields.
  tool="\${tool//\\\\/\\\\\\\\}";     tool="\${tool//\\"/\\\\\\"}"
  reason="\${reason//\\\\/\\\\\\\\}"; reason="\${reason//\\"/\\\\\\"}"
  # Every C0 control character, not just newline and carriage return. JSON
  # forbids all of U+0000-U+001F unescaped, so a plain TAB in a filename — no
  # adversary required — was still enough to produce a line JSON.parse rejects.
  # (NUL cannot appear in a bash variable, so the range starts at \\x01.)
  tool="\${tool//[$'\\x01'-$'\\x1f']/ }"; reason="\${reason//[$'\\x01'-$'\\x1f']/ }"
  # The workspace id is spliced into the same JSON string. It comes from
  # runtime.env on disk rather than from the agent, so it is lower risk — but a
  # value with a quote in it breaks every audit line the same way, and "lower
  # risk" is not "cannot happen" for a file the operator edits by hand.
  local ws="\${INTUTIC_WORKSPACE_ID}"
  ws="\${ws//\\\\/\\\\\\\\}"; ws="\${ws//\\"/\\\\\\"}"; ws="\${ws//[$'\\x01'-$'\\x1f']/ }"
  local ts; ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  local incident_id; incident_id="$(printf '%s' "\${ts}\${tool}\${INTUTIC_WORKSPACE_ID}" | sha1sum 2>/dev/null | cut -c1-16 || echo "$(date +%s)")"
  # The event's id: random, made once here, and resent with the line it is
  # written into, so the control plane processes the event once.
  local event_id; event_id="$(od -An -N16 -tx1 /dev/urandom 2>/dev/null | tr -d ' \\n' || true)"
  [ -n "$event_id" ] || event_id="$(date +%s)$$\${RANDOM}\${RANDOM}\${RANDOM}"
  local entry="{\\"event\\":\\"\${verdict}\\",\\"toolName\\":\\"\${tool}\\",\\"reason\\":\\"\${reason}\\",\\"workspaceId\\":\\"\${ws}\\",\\"harnessType\\":\\"openhands\\",\\"timestamp\\":\\"\${ts}\\",\\"incidentId\\":\\"\${incident_id}\\",\\"eventId\\":\\"\${event_id}\\"}"
  # Path B: reliable file append
  printf '%s\\n' "$entry" >> "$HOOK_EVENTS_LOG" 2>/dev/null || true
  # Path A: fire-and-forget HTTP (non-blocking, near-real-time)
  if [ -n "$INTUTIC_API_KEY" ]; then
    curl -s -o /dev/null --max-time 3 -X POST \\
      -H "Content-Type: application/json" \\
      -H "Authorization: Bearer $INTUTIC_API_KEY" \\
      -d "{\\"events\\":[$entry]}" \\
      "\${INTUTIC_HOST}/api/v1/hook-events" & disown 2>/dev/null || true
  fi
}


# ── Intutic gate body v23 — harness: openhands ────────────
# Generated by harness/gateBody.ts. Do not edit here; every harness regenerates.
#
# The harness name and version are stamped so this file identifies itself. Both
# were previously passed in and dropped on the floor: opts.harness was declared
# on the option type, supplied by all thirteen writers, and read nowhere.

# ── Post-tool outcome (gate body v23) ────────────────────────────────────────
# A post-tool invocation (--event post) records a test run's outcome for this
# session, or marks an earlier passing run stale after a file change, and
# always allows: the call has already run. Only where openhands's post-tool
# payload was captured and carries an exit code (POST_TOOL_OBSERVABLE: 0).
if [ "\${INTUTIC_POST_MODE:-0}" = "1" ]; then
  if [ "0" = "1" ]; then
    python3 -c 'import os, sys
lib = {}
exec(os.environ.get("INTUTIC_PY_LIB", ""), lib)
sys.stdout.write(lib["intutic_post_record"](sys.argv[1], sys.stdin.read()))' 'openhands' <<< "\${INPUT:-}" >/dev/null 2>&1 || true
  fi
  exit 0
fi

# ── Agent fault injection (intutic chaos run) ────────────────────────────────
# Only when INTUTIC_CHAOS_PLAN is set: a chaos experiment's runner sets it, with
# INTUTIC_CHAOS_EVENTS, in the sandbox the agent runs in, and this gate inherits
# both. The work is chaos.py in INTUTIC_PY_LIB, the transliteration of
# chaosGate.ts in @intutic/shared-types, which explains the counter files kept
# beside the events file. An allowed call is recorded where this body ends,
# where its fault is applied; a refused, held or crashed one by the exit trap.
# A fault applies only to an allowed call. Scoped to the bare invocation, like
# the envelope refusal below.
INTUTIC_CHAOS_ACTIVE=0
_intutic_chaos_done=0
_intutic_chaos_decision=deny
_intutic_chaos_rule=""
_intutic_chaos_hit=0
_intutic_chaos_destructive=0
# Records this call as decided ($1: allow, deny or hold) and prints the fault
# to apply to an allowed one, as kind and reason, tab-separated. $2 is the
# call's digest, which a held call's retry shares.
intutic_chaos_decide() {
  [ "$INTUTIC_CHAOS_ACTIVE" = "1" ] && [ "$_intutic_chaos_done" = "0" ] || return 0
  python3 -c 'import os, sys
lib = {}
exec(os.environ.get("INTUTIC_PY_LIB", ""), lib)
sys.stdout.write(lib["intutic_chaos_call"](*sys.argv[1:]))' "\${TOOL:-unknown}" "$1" "$_intutic_chaos_rule" "$_intutic_chaos_destructive" "$_intutic_chaos_hit" "\${2:-}" || true
}
# A rule fired without deciding the call (shadow, warn): its id, if none yet.
intutic_chaos_note() {
  [ -n "$_intutic_chaos_rule" ] || _intutic_chaos_rule="$1"
}
if [ -z "\${1:-}" ] && [ -n "\${INTUTIC_CHAOS_PLAN:-}" ]; then
  # A plan that is set but unreadable refuses, as an unreadable payload does:
  # an experiment run without the faults it asked for reports a resilience it
  # never measured.
  _intutic_chaos_err="$(python3 -c 'import os, sys
lib = {}
exec(os.environ.get("INTUTIC_PY_LIB", ""), lib)
sys.stdout.write(lib["intutic_chaos_begin"]())' 2>/dev/null || echo "INTUTIC_CHAOS_PLAN could not be read")"
  if [ -n "$_intutic_chaos_err" ]; then
    _intutic_chaos_err="\${_intutic_chaos_err} — refusing the call rather than running the experiment without the faults it asked for"
    echo "[Intutic Governance] BLOCKED: \${_intutic_chaos_err}" >&2
    log_event "tool_blocked" "\${TOOL:-unknown}" "\${_intutic_chaos_err}" || true
    exit 2
  fi
  INTUTIC_CHAOS_ACTIVE=1
fi

# Refuse an unreadable envelope before any rule is consulted.
#
# Unparseable stdin used to degrade to empty extracted fields, which match no
# rule — an ALLOW. Per each harness's contract this hook receives only
# PreToolUse events, so a payload from which neither a tool name nor a
# tool_input could be extracted is anomalous by definition: there is no such
# thing as a legitimate PreToolUse event with no tool call in it. Refusing is
# the posture githubCopilotHooks established for its Preview envelope, applied
# uniformly. INTUTIC_EXTRACT_STATE is set by SHELL_EXTRACT; the refusal lives
# here because log_event is not defined until after extraction runs.
#
# Scoped to the bare invocation: goose and openhands register post/stop
# invocations of this same script WITH arguments, and those events carry no
# tool call legitimately — refusing them would fail a hook that has nothing to
# gate. Every PreToolUse registration invokes the script with no arguments.
if [ -z "\${1:-}" ] && [ "\${INTUTIC_EXTRACT_STATE:-malformed}" != "ok" ]; then
  _intutic_env_reason="unrecognised PreToolUse payload — neither a tool name nor a tool_input could be extracted from stdin; refusing rather than allowing a call the gate cannot read"
  echo "[Intutic Governance] BLOCKED: \${_intutic_env_reason}" >&2
  log_event "tool_blocked" "unknown" "\${_intutic_env_reason}" || true
  exit 2
fi

# Refuse a call too large to evaluate inside the hook timeout, before any rule
# reads it (the extractor measured it; see gateLimits.ts). Scoped like the
# envelope refusal above: the post/stop invocations carry no call to gate.
if [ -z "\${1:-}" ] && [ -n "\${INTUTIC_TOO_LARGE:-}" ]; then
  echo "[Intutic Governance] BLOCKED: COMMAND_TOO_LARGE — \${INTUTIC_TOO_LARGE}" >&2
  log_event "tool_blocked" "\${TOOL:-unknown}" "COMMAND_TOO_LARGE — \${INTUTIC_TOO_LARGE}" || true
  exit 2
fi

# The static floor: compiled in, always enforced, never sourced from disk.
# These are the families with years of evidence behind them, so they block from
# the first run — before any sync has happened.
INTUTIC_FLOOR=(
  'bypass.chflags_nouchg	block	s	any	Governance bypass pattern: clearing the macOS immutable flag on a governance file	 chflags .*nouchg'
  'bypass.chattr_immutable	block	s	any	Governance bypass pattern: clearing the Linux immutable attribute on a governance file	 chattr .*-[a-zA-Z]*i'
  'bypass.chmod_governance	block	s	any	Governance bypass pattern: changing permissions on a governance file	 chmod .*(hooks|\\.intutic|\\.claude|\\.cursor)'
  'bypass.env_kill_switch	block	-	any	Governance bypass pattern: setting a harness environment variable that disables its hooks	 [A-Z][A-Z0-9_]*_HOOKS?='
  'hook_settings.vscode_key_written	block	-	content	Governance bypass pattern: setting chat.useHooks or chat.hookFilesLocations, which can switch off the GitHub Copilot governance hook. Change VS Code hook settings yourself, not through an agent.	chat\\.(useHooks|hookFilesLocations)(\\\\)?" *:'
  'hook_settings.vscode_key_command	block	-	command	Governance bypass pattern: a shell command naming chat.useHooks or chat.hookFilesLocations, which can switch off the GitHub Copilot governance hook. Change VS Code hook settings yourself, not through an agent.	chat\\.(useHooks|hookFilesLocations)'
  'secrets.aws_access_key	block	-	content	AWS access key ID detected in the content this call would write. Writing a live credential into a file is one commit away from shipping it; reference it from the environment instead.	(A3T[A-Z0-9]|AKIA|ASIA|ABIA|ACCA)[A-Z2-7][A-Z2-7][A-Z2-7][A-Z2-7][A-Z2-7][A-Z2-7][A-Z2-7][A-Z2-7][A-Z2-7][A-Z2-7][A-Z2-7][A-Z2-7][A-Z2-7][A-Z2-7][A-Z2-7][A-Z2-7]'
  'secrets.anthropic_api_key	block	-	content	Anthropic API key detected in the content this call would write. Writing a live credential into a file is one commit away from shipping it; reference it from the environment instead.	sk-ant-[A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-]*'
  'secrets.github_token	block	-	content	GitHub token detected in the content this call would write. Writing a live credential into a file is one commit away from shipping it; reference it from the environment instead.	gh[pousr]_[A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9]'
  'secrets.private_key_pem	block	-	content	PEM private key material detected in the content this call would write. Writing a live credential into a file is one commit away from shipping it; reference it from the environment instead.	-----BEGIN [A-Z ]*PRIVATE KEY-----'
  'secrets.openrouter_api_key	block	-	content	OpenRouter API key detected in the content this call would write. Writing a live credential into a file is one commit away from shipping it; reference it from the environment instead.	sk-or-v1-[A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9]*'
  'secrets.intutic_virtual_key	block	-	content	Intutic virtual key detected in the content this call would write. Writing a live credential into a file is one commit away from shipping it; reference it from the environment instead.	vk_[a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9]'
  'secrets.intutic_gateway_token	block	-	content	Intutic gateway token detected in the content this call would write. Writing a live credential into a file is one commit away from shipping it; reference it from the environment instead.	gwk_[a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9]'
  'secrets.stripe_secret_key	block	-	content	Stripe live secret key detected in the content this call would write. Writing a live credential into a file is one commit away from shipping it; reference it from the environment instead.	sk_live_[A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9]'
  'skill_surface.agents_skills_write	warn	-	target	Write or edit targets a .agents/skills/** skill file — advisory only, pending a false-positive measurement of scanSkillContent against real skill markdown	\\.agents/skills/'
  'skill_surface.claude_skills_write	warn	-	target	Write or edit targets a .claude/skills/** skill file — advisory only, pending a false-positive measurement of scanSkillContent against real skill markdown	\\.claude/skills/'
  'path.intutic_hooks	block	-	any	Shell command references the governance-protected path .intutic/hooks	\\.intutic/hooks'
  'path.intutic_integrity_json	block	-	any	Shell command references the governance-protected path .intutic/integrity.json	\\.intutic/integrity\\.json'
  'path.intutic_events	block	-	any	Shell command references the governance-protected path .intutic/events	\\.intutic/events'
  'path.intutic_env	block	-	any	Shell command references the governance-protected path .intutic/env	\\.intutic/env'
  'path.claude_settings_json	block	-	any	Shell command references the governance-protected path .claude/settings.json	\\.claude/settings\\.json'
  'path.claude_settings_local_json	block	-	any	Shell command references the governance-protected path .claude/settings.local.json	\\.claude/settings\\.local\\.json'
  'path.cursor_hooks_json	block	-	any	Shell command references the governance-protected path .cursor/hooks.json	\\.cursor/hooks\\.json'
  'path.etc_cursor_hooks_json	block	-	any	Shell command references the governance-protected path /etc/cursor/hooks.json	/etc/cursor/hooks\\.json'
  'path.Application_Support_Cursor_hooks_json	block	-	any	Shell command references the governance-protected path Application Support/Cursor/hooks.json	Application Support/Cursor/hooks\\.json'
  'path.ProgramData_backslash_Cursor_backslash_hooks_json	block	-	any	Shell command references the governance-protected path ProgramData\\Cursor\\hooks.json	ProgramData\\\\Cursor\\\\hooks\\.json'
  'path.ProgramData_Cursor_hooks_json	block	-	any	Shell command references the governance-protected path ProgramData/Cursor/hooks.json	ProgramData/Cursor/hooks\\.json'
  'path.clinerules_hooks	block	-	any	Shell command references the governance-protected path .clinerules/hooks	\\.clinerules/hooks'
  'path.codeium_windsurf_hooks_json	block	-	any	Shell command references the governance-protected path .codeium/windsurf/hooks.json	\\.codeium/windsurf/hooks\\.json'
  'path.codeium_hooks_json	block	-	any	Shell command references the governance-protected path .codeium/hooks.json	\\.codeium/hooks\\.json'
  'path.windsurf_hooks_json	block	-	any	Shell command references the governance-protected path .windsurf/hooks.json	\\.windsurf/hooks\\.json'
  'path.openhands_hooks_json	block	-	any	Shell command references the governance-protected path .openhands/hooks.json	\\.openhands/hooks\\.json'
  'path.gemini_settings_json	block	-	any	Shell command references the governance-protected path .gemini/settings.json	\\.gemini/settings\\.json'
  'path.gemini_config_hooks_json	block	-	any	Shell command references the governance-protected path .gemini/config/hooks.json	\\.gemini/config/hooks\\.json'
  'path.agents_hooks_json	block	-	any	Shell command references the governance-protected path .agents/hooks.json	\\.agents/hooks\\.json'
  'path.agents_plugins_intutic_governance	block	-	any	Shell command references the governance-protected path .agents/plugins/intutic-governance	\\.agents/plugins/intutic-governance'
  'path.muse_hooks_json	block	-	any	Shell command references the governance-protected path .muse/hooks.json	\\.muse/hooks\\.json'
  'path.config_muse_settings_json	block	-	any	Shell command references the governance-protected path .config/muse/settings.json	\\.config/muse/settings\\.json'
  'path.config_muse_intutic_managed_hooks_json	block	-	any	Shell command references the governance-protected path .config/muse/intutic-managed-hooks.json	\\.config/muse/intutic-managed-hooks\\.json'
  'path.grok_hooks	block	-	any	Shell command references the governance-protected path .grok/hooks	\\.grok/hooks'
  'path.grok_config_toml	block	-	any	Shell command references the governance-protected path .grok/config.toml	\\.grok/config\\.toml'
  'path.grok_trusted_folders_toml	block	-	any	Shell command references the governance-protected path .grok/trusted_folders.toml	\\.grok/trusted_folders\\.toml'
  'path.dsh_profiles	block	-	any	Shell command references the governance-protected path .dsh/profiles	\\.dsh/profiles'
  'path.dsh_cordis_patch_yml	block	-	any	Shell command references the governance-protected path .dsh/cordis.patch.yml	\\.dsh/cordis\\.patch\\.yml'
  'path.dsh_settings_yaml	block	-	any	Shell command references the governance-protected path .dsh/settings.yaml	\\.dsh/settings\\.yaml'
  'path.opencode_plugins	block	-	any	Shell command references the governance-protected path .opencode/plugins	\\.opencode/plugins'
  'path.opencode_plugin	block	-	any	Shell command references the governance-protected path .opencode/plugin	\\.opencode/plugin'
  'path.config_opencode_plugins	block	-	any	Shell command references the governance-protected path .config/opencode/plugins	\\.config/opencode/plugins'
  'path.pi_agent_extensions	block	-	any	Shell command references the governance-protected path .pi/agent/extensions	\\.pi/agent/extensions'
  'path.openclaw_openclaw_json	block	-	any	Shell command references the governance-protected path .openclaw/openclaw.json	\\.openclaw/openclaw\\.json'
  'path.pi_extensions	block	-	any	Shell command references the governance-protected path .pi/extensions	\\.pi/extensions'
  'path.codex_hooks_json	block	-	any	Shell command references the governance-protected path .codex/hooks.json	\\.codex/hooks\\.json'
  'path.codex_config_toml	block	-	any	Shell command references the governance-protected path .codex/config.toml	\\.codex/config\\.toml'
  'path.github_hooks_intutic_governance_json	block	-	any	Shell command references the governance-protected path .github/hooks/intutic-governance.json	\\.github/hooks/intutic-governance\\.json'
  'path.copilot_hooks_intutic_governance_json	block	-	any	Shell command references the governance-protected path .copilot/hooks/intutic-governance.json	\\.copilot/hooks/intutic-governance\\.json'
  'path.hermes_config_yaml	block	-	any	Shell command references the governance-protected path .hermes/config.yaml	\\.hermes/config\\.yaml'
  'path.config_goose_config_yaml	block	-	any	Shell command references the governance-protected path .config/goose/config.yaml	\\.config/goose/config\\.yaml'
  'path.open_webui_intutic_governance_filter_py	block	-	any	Shell command references the governance-protected path .open-webui/intutic-governance-filter.py	\\.open-webui/intutic-governance-filter\\.py'
)

# The dynamic tier, read from the policy snapshot. Additive only: it can turn an
# allow into a block, never a block into an allow. See policySnapshot.ts.
INTUTIC_SNAPSHOT_RULES="\${INTUTIC_SNAPSHOT_RULES:-$HOME/.intutic/hooks/policy-snapshot.rules}"
INTUTIC_SNAPSHOT_DIGEST="none"
INTUTIC_SNAPSHOT_STATE="absent"
INTUTIC_DYNAMIC=()

# A supported escape hatch, and the reason it exists is not politeness.
#
# The fastest workaround available to a developer wrongly blocked is
# \`chflags nouchg\` on the hook — the exact bypass the floor exists to stop. If
# the only way out is one we treat as an attack, we have manufactured our own
# adversary. So: an escape we can see, that disables the **dynamic tier only**.
# The floor is never disabled by it. Every invocation while it is set emits an
# event, so a machine running ungoverned is visible rather than quiet.
INTUTIC_GUARDS_DISABLED=0
if [ "\${INTUTIC_GUARD_DISABLE:-}" = "1" ]; then
  INTUTIC_GUARDS_DISABLED=1
  log_event "guards_disabled" "\${TOOL:-}" "INTUTIC_GUARD_DISABLE=1 — policy-snapshot rules skipped; built-in protections still active" || true
fi

INTUTIC_SNAPSHOT_WORKSPACE=""
INTUTIC_SNAPSHOT_GENERATED=""
# The per-server MCP allowlist (the @mcp_allowlist record, inside the digest).
# No record means the workspace set no list, and every server is allowed.
INTUTIC_MCP_ALLOWLIST=0
INTUTIC_MCP_SEVERITY=""
INTUTIC_MCP_SERVERS=""
# The MCP server registry record (base64 JSON, inside the digest).
INTUTIC_MCP_REGISTRY=""
# An OPAQUE workspace (the @intervention_mode record): a refusal on workspace
# policy tells the agent this sentence instead of the rule, and the audit line
# keeps the rule. Kept on a snapshot that fails its digest: it only ever hides
# text, never allows a call.
INTUTIC_OPAQUE=0
INTUTIC_OPAQUE_MESSAGE='Blocked by workspace policy. Ask a workspace admin if you need this action.'
# The snapshot format (the @format record; 1 without one), and the decide
# rules' @decide records, kept whole for the decide tier: this gate decodes
# none of them, the CLI does.
INTUTIC_SNAPSHOT_FORMAT=1
INTUTIC_DECIDE_RECORDS=()
# The @rule records (gate body v23), kept whole: the extractor's Python decodes
# them for the rule-record tiers below.
INTUTIC_RULE_RECORDS=()
if [ -f "$INTUTIC_SNAPSHOT_RULES" ]; then
  INTUTIC_SNAPSHOT_STATE="ok"
  while IFS= read -r _line || [ -n "$_line" ]; do
    case "$_line" in
      '#digest '*)      INTUTIC_SNAPSHOT_DIGEST="\${_line#\\#digest }" ;;
      '#workspace '*)   INTUTIC_SNAPSHOT_WORKSPACE="\${_line#\\#workspace }" ;;
      '#generated '*)   INTUTIC_SNAPSHOT_GENERATED="\${_line#\\#generated }" ;;
      '@mcp_allowlist'$'\\t'*)
        # Tag, severity and comma-joined servers, tab-separated — parameter
        # expansion only, no subshell. The writer drops a server name holding
        # whitespace or a comma, so neither separator can appear in one.
        INTUTIC_MCP_ALLOWLIST=1
        _intutic_mcp_rest="\${_line#*$'\\t'}"
        INTUTIC_MCP_SEVERITY="\${_intutic_mcp_rest%%$'\\t'*}"
        INTUTIC_MCP_SERVERS="\${_intutic_mcp_rest#*$'\\t'}"
        ;;
      '@mcp_registry'$'\\t'*) INTUTIC_MCP_REGISTRY="\${_line#*$'\\t'}" ;;
      '@intervention_mode'$'\\t''OPAQUE') INTUTIC_OPAQUE=1 ;;
      '@format'$'\\t'*)
        case "\${_line#*$'\\t'}" in ''|*[!0-9]*) : ;; *) INTUTIC_SNAPSHOT_FORMAT="\${_line#*$'\\t'}" ;; esac
        ;;
      '@decide'$'\\t'*) INTUTIC_DECIDE_RECORDS+=("$_line") ;;
      '@rule'$'\\t'*) INTUTIC_RULE_RECORDS+=("$_line") ;;
      '#'*|'') : ;;
      *) INTUTIC_DYNAMIC+=("$_line") ;;
    esac
  done < "$INTUTIC_SNAPSHOT_RULES"

  # A fallback line stands in for a decide rule a gate cannot evaluate. This
  # gate hands a decide rule to the CLI, which decodes its record and refuses
  # the call when it does not decode, so it skips the fallback line that an
  # @decide record of five columns names in its second. Any other line with
  # the prefix is enforced.
  if [ \${#INTUTIC_DECIDE_RECORDS[@]} -gt 0 ]; then
    _intutic_skip=$'\\n'
    for _rec in "\${INTUTIC_DECIDE_RECORDS[@]}"; do
      _intutic_tabs="\${_rec//[^$'\\t']/}"
      _intutic_fb="\${_rec#*$'\\t'}"
      _intutic_fb="\${_intutic_fb%%$'\\t'*}"
      if [ \${#_intutic_tabs} -eq 4 ] && [ -n "\${_rec##*$'\\t'}" ]; then
        case "$_intutic_fb" in 'decide-fallback:'*) _intutic_skip+="$_intutic_fb"$'\\n' ;; esac
      fi
    done
    _intutic_kept=()
    if [ \${#INTUTIC_DYNAMIC[@]} -gt 0 ]; then
      for _rec in "\${INTUTIC_DYNAMIC[@]}"; do
        case "$_intutic_skip" in *$'\\n'"\${_rec%%$'\\t'*}"$'\\n'*) continue ;; esac
        _intutic_kept+=("$_rec")
      done
    fi
    INTUTIC_DYNAMIC=()
    if [ \${#_intutic_kept[@]} -gt 0 ]; then INTUTIC_DYNAMIC=("\${_intutic_kept[@]}"); fi
  fi

  # A <kind>-fallback: line stands in for a rule record a gate cannot
  # evaluate. This gate evaluates requires_outcome,scope_paths,plan_approval, so it drops the fallback line a
  # decoded record of those kinds names. A python3 that cannot say keeps them all.
  if [ \${#INTUTIC_RULE_RECORDS[@]} -gt 0 ] && [ -n 'requires_outcome,scope_paths,plan_approval' ]; then
    _intutic_rskip="$(python3 -c 'import os, sys
lib = {}
exec(os.environ.get("INTUTIC_PY_LIB", ""), lib)
sys.stdout.write(lib["intutic_rule_skip"](sys.stdin.read(), sys.argv[1]))' 'requires_outcome,scope_paths,plan_approval' <<< "$(printf '%s\\n' "\${INTUTIC_RULE_RECORDS[@]}")" 2>/dev/null || true)"
    if [ -n "$_intutic_rskip" ] && [ \${#INTUTIC_DYNAMIC[@]} -gt 0 ]; then
      _intutic_rskip=$'\\n'"$_intutic_rskip"$'\\n'
      _intutic_kept=()
      for _rec in "\${INTUTIC_DYNAMIC[@]}"; do
        case "$_intutic_rskip" in *$'\\n'"\${_rec%%$'\\t'*}"$'\\n'*) continue ;; esac
        _intutic_kept+=("$_rec")
      done
      INTUTIC_DYNAMIC=()
      if [ \${#_intutic_kept[@]} -gt 0 ]; then INTUTIC_DYNAMIC=("\${_intutic_kept[@]}"); fi
    fi
  fi

  # A phrase rule that shares its id with an action rule is the partial form a
  # gate older than v23 holds by; this one holds by the action rule.
  if [ \${#INTUTIC_DYNAMIC[@]} -gt 0 ]; then
    _intutic_aids=$'\\n'
    for _rec in "\${INTUTIC_DYNAMIC[@]}"; do
      _r="\${_rec#*$'\\t'}"; _r="\${_r#*$'\\t'}"; _r="\${_r#*$'\\t'}"
      if [ "\${_r%%$'\\t'*}" = "action" ]; then _intutic_aids+="\${_rec%%$'\\t'*}"$'\\n'; fi
    done
    if [ "$_intutic_aids" != $'\\n' ]; then
      _intutic_kept=()
      for _rec in "\${INTUTIC_DYNAMIC[@]}"; do
        _r="\${_rec#*$'\\t'}"; _r="\${_r#*$'\\t'}"; _r="\${_r#*$'\\t'}"
        if [ "\${_r%%$'\\t'*}" = "phrase" ]; then
          case "$_intutic_aids" in *$'\\n'"\${_rec%%$'\\t'*}"$'\\n'*) continue ;; esac
        fi
        _intutic_kept+=("$_rec")
      done
      INTUTIC_DYNAMIC=()
      if [ \${#_intutic_kept[@]} -gt 0 ]; then INTUTIC_DYNAMIC=("\${_intutic_kept[@]}"); fi
    fi
  fi

  # Integrity, in the order that fails cheapest first.
  #
  # All three of these were parsed and then ignored. A digest nobody recomputes
  # is not integrity, it is a comment; and a workspace id nobody compares means a
  # snapshot from workspace A dropped onto workspace B's machine is enforced
  # verbatim, with B's audit events attributing A's rules to B.
  _intutic_body="$(grep -v '^#' "$INTUTIC_SNAPSHOT_RULES" | grep -v '^$' || true)"
  _intutic_actual=""
  if command -v shasum >/dev/null 2>&1; then
    _intutic_actual="$(printf '%s' "$_intutic_body" | shasum -a 256 | cut -c1-32)"
  elif command -v sha256sum >/dev/null 2>&1; then
    _intutic_actual="$(printf '%s' "$_intutic_body" | sha256sum | cut -c1-32)"
  fi

  if [ -n "$_intutic_actual" ] && [ "$_intutic_actual" != "$INTUTIC_SNAPSHOT_DIGEST" ]; then
    INTUTIC_SNAPSHOT_STATE="invalid"
  elif [ -n "$INTUTIC_SNAPSHOT_WORKSPACE" ] && [ -n "\${INTUTIC_WORKSPACE_ID:-}" ]        && [ "$INTUTIC_SNAPSHOT_WORKSPACE" != "$INTUTIC_WORKSPACE_ID" ]; then
    INTUTIC_SNAPSHOT_STATE="invalid"
  elif [ \${#INTUTIC_DYNAMIC[@]} -eq 0 ]; then
    # Distinct from "absent". The writer always ships the destructive tier, so a
    # rule-less snapshot means the compile produced nothing — a real fault that
    # otherwise looks exactly like a healthy quiet workspace.
    INTUTIC_SNAPSHOT_STATE="empty"
  fi

  # Degrade to the compiled floor. The dynamic tier is additive, so dropping it
  # returns to yesterday's behaviour rather than opening a hole.
  # The SSO-group refusals survive it: they only ever refuse, and dropping
  # them would make editing the member's group list in this file a way to
  # clear a tool the workspace's group policy refuses.
  if [ "$INTUTIC_SNAPSHOT_STATE" = "invalid" ]; then
    _intutic_kept=()
    if [ \${#INTUTIC_DYNAMIC[@]} -gt 0 ]; then
      for _rec in "\${INTUTIC_DYNAMIC[@]}"; do
        case "$_rec" in
          sso_group.*$'\\t'block$'\\t'*) _intutic_kept+=("$_rec") ;;
        esac
      done
    fi
    INTUTIC_DYNAMIC=()
    if [ \${#_intutic_kept[@]} -gt 0 ]; then INTUTIC_DYNAMIC=("\${_intutic_kept[@]}"); fi
    # Neither MCP record can be vouched for, and a deleted one looks like one
    # never set: the snapshot admits no MCP server (the refusal below).
    INTUTIC_MCP_REGISTRY=""
    INTUTIC_MCP_ALLOWLIST=0
    # The decide and rule records go with the rest of the dynamic tier.
    INTUTIC_DECIDE_RECORDS=()
    INTUTIC_RULE_RECORDS=()
  fi
fi

# Staleness governs alerting, not enforcement: rules stay in force. If they
# expired into permissiveness, "kill the daemon and wait" would be a supported
# way to disarm governance.
if [ "$INTUTIC_SNAPSHOT_STATE" = "ok" ] && [ -n "$INTUTIC_SNAPSHOT_GENERATED" ]; then
  _intutic_age_days="$(python3 -c 'import sys,datetime
try:
    t=datetime.datetime.fromisoformat(sys.argv[1].replace("Z","+00:00"))
    print(int((datetime.datetime.now(datetime.timezone.utc)-t).total_seconds()//86400))
except Exception:
    print(0)' "$INTUTIC_SNAPSHOT_GENERATED" 2>/dev/null || echo 0)"
  if [ "$_intutic_age_days" -gt 7 ] 2>/dev/null; then
    INTUTIC_SNAPSHOT_STATE="stale"
  fi
fi

case "$INTUTIC_SNAPSHOT_STATE" in
  absent)  log_event "snapshot_absent" "\${TOOL:-}" "No policy snapshot at $INTUTIC_SNAPSHOT_RULES — built-in protections only" || true ;;
  invalid) log_event "snapshot_invalid" "\${TOOL:-}" "Policy snapshot failed its digest or workspace check — dynamic rules dropped except SSO-group refusals, and every MCP call refused" || true ;;
  empty)   log_event "snapshot_empty" "\${TOOL:-}" "Policy snapshot contains no rules — the compile produced nothing" || true ;;
  stale)   log_event "snapshot_stale" "\${TOOL:-}" "Policy snapshot is \${_intutic_age_days} days old and still enforced" || true ;;
esac
if [ "$INTUTIC_SNAPSHOT_FORMAT" -gt 3 ]; then
  log_event "snapshot_format_newer" "\${TOOL:-}" "Policy snapshot format $INTUTIC_SNAPSHOT_FORMAT is newer than this gate reads (3) — records it does not know are skipped and their fallback lines enforced" || true
fi

# Normalise once; every pattern is written against this shape. The extractor
# hands each field over with its whitespace already collapsed to single spaces
# by Python, Unicode whitespace included, which bash cannot match; padding is
# all that is left to do. Bash substitutions over a 256 KiB command to find no
# whitespace left took most of a second on a loaded machine.
INTUTIC_NCOMMAND=" \${COMMAND:-} "
INTUTIC_NTARGET=" \${TARGET:-} "
INTUTIC_NTOOL=" \${TOOL:-} "

# ── Hold tier (gate body v8) ─────────────────────────────────────────────────
# A \`hold\` rule refuses the call and records it for a human; an exact,
# unexpired approved bypass the daemon cached lets the same call through once.
# All local — a file read, a file write and an exit code; no network on the
# tool path.
INTUTIC_REVIEW_REQUEST_FILE="\${INTUTIC_REVIEW_REQUESTS:-}"
if [ -z "$INTUTIC_REVIEW_REQUEST_FILE" ]; then
  INTUTIC_REVIEW_REQUEST_FILE="$(cd "$(dirname "$0")/.." 2>/dev/null && pwd)/events/review-requests.jsonl"
fi
INTUTIC_APPROVED_BYPASSES="\${INTUTIC_APPROVED_BYPASSES:-$HOME/.intutic/hooks/approved-bypasses.jsonl}"
intutic_sha256() {
  if command -v shasum >/dev/null 2>&1; then shasum -a 256 | cut -c1-64
  elif command -v sha256sum >/dev/null 2>&1; then sha256sum | cut -c1-64
  else printf ''; fi
}
intutic_json_escape() {
  printf '%s' "$1" | sed -e 's/\\\\/\\\\\\\\/g' -e 's/"/\\\\"/g' | tr -d '\\n\\r\\t'
}
# What the agent reads of a refusal on workspace policy, in _intutic_shown: the
# reason ($1), or in an OPAQUE workspace the generic sentence. The audit line
# is always written with the full reason.
intutic_shown() {
  if [ "$INTUTIC_OPAQUE" = "1" ]; then _intutic_shown="$INTUTIC_OPAQUE_MESSAGE"; else _intutic_shown="$1"; fi
}
# Looks for a valid, unexpired, EXACT-match approved bypass. Prints nothing
# and returns 1 on ANY reason not to bypass: missing file, failed digest or
# workspace check, no matching line, or an entry whose expiresAt has passed —
# every one of which falls through to the hold. Key material is computed the
# same way the JS gate and the control plane compute it: the normalised tool
# name, and sha256(normalised command, NUL, normalised target).
intutic_bypass() {
  local rid="$1" tn="$2" th="$3" hdr_digest hdr_ws body actual now line exp
  [ -n "$th" ] || return 1
  [ -r "$INTUTIC_APPROVED_BYPASSES" ] || return 1
  hdr_digest="$(grep -m1 '^#digest ' "$INTUTIC_APPROVED_BYPASSES" | cut -d' ' -f2 || true)"
  hdr_ws="$(grep -m1 '^#workspace ' "$INTUTIC_APPROVED_BYPASSES" | cut -d' ' -f2 || true)"
  body="$(grep -v '^#' "$INTUTIC_APPROVED_BYPASSES" | grep -v '^$' || true)"
  [ -n "$body" ] || return 1
  actual="$(printf '%s' "$body" | intutic_sha256 | cut -c1-32)"
  [ -n "$actual" ] && [ "$actual" = "$hdr_digest" ] || return 1
  if [ -n "$hdr_ws" ] && [ "$hdr_ws" != "\${INTUTIC_WORKSPACE_ID:-}" ]; then return 1; fi
  now="$(date -u +%Y-%m-%dT%H:%M:%S)"
  while IFS= read -r line; do
    case "$line" in *'"workspaceId":"'"\${INTUTIC_WORKSPACE_ID:-}"'"'*) ;; *) continue ;; esac
    case "$line" in *'"sopRuleId":"'"$rid"'"'*) ;; *) continue ;; esac
    case "$line" in *'"toolNameNormalized":"'"$tn"'"'*) ;; *) continue ;; esac
    case "$line" in *'"targetHash":"'"$th"'"'*) ;; *) continue ;; esac
    exp="$(printf '%s' "$line" | sed -n 's/.*"expiresAt":"\\([^"]*\\)".*/\\1/p')"
    [ -n "$exp" ] || continue
    # ISO-8601 UTC timestamps compare lexically; a past expiry fails closed
    # toward the hold, however fresh the file is.
    if [[ "$exp" > "$now" ]]; then
      printf '%s' "$line"; return 0
    fi
  done <<< "$body"
  return 1
}
# Returns 0 when an approved bypass lets the call through (the caller
# continues), 2 when the call is held (the caller refuses).
intutic_hold() {
  local rid="$1" rreason="$2" tn th entry decided_by hold_id at file targeth hint
  tn="$INTUTIC_NTOOL"
  th="$( { printf '%s' "$INTUTIC_NCOMMAND"; printf '\\0'; printf '%s' "$INTUTIC_NTARGET"; } | intutic_sha256 )"
  if entry="$(intutic_bypass "$rid" "$tn" "$th")"; then
    decided_by="$(printf '%s' "$entry" | sed -n 's/.*"decidedBy":"\\([^"]*\\)".*/\\1/p')"
    hold_id="$(printf '%s' "$entry" | sed -n 's/.*"holdId":"\\([^"]*\\)".*/\\1/p')"
    echo "[Intutic Guardrail] BYPASSED: Approved bypass for \${rid} — approved by \${decided_by} on hold \${hold_id}" >&2
    log_event "hold_approved_bypass_used" "\${TOOL:-}" "Approved bypass for \${rid} — approved by \${decided_by} on hold \${hold_id}" || true
    return 0
  fi
  hold_id="hold_$(printf '%x' "$(date +%s)")_$(printf '%04x%04x' "$RANDOM" "$RANDOM")"
  at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  targeth=""
  [ -n "$th" ] && targeth="$(printf ',"targetHash":"%s"' "$th")"
  file="$INTUTIC_REVIEW_REQUEST_FILE"
  # The hold still blocks even if the record cannot be written — the exit code
  # is what stops the tool. But say so: a hold nobody can review is the worst
  # of both outcomes.
  if ! { mkdir -p "$(dirname "$file")" 2>/dev/null && printf '{"v":1,"holdId":"%s","reason":"%s","tool":"%s","sessionId":"%s","workspaceId":"%s","at":"%s","toolNameNormalized":"%s"%s}\\n' \\
      "$hold_id" "$(intutic_json_escape "$rid")" "$(intutic_json_escape "\${TOOL:-}")" "$(intutic_json_escape "\${SESSION_ID:-}")" \\
      "$(intutic_json_escape "\${INTUTIC_WORKSPACE_ID:-}")" "$at" "$(intutic_json_escape "$tn")" "$targeth" >> "$file" 2>/dev/null; }; then
    echo "[Intutic Guardrail] could not record the hold at \${file}" >&2
  fi
  # Who may approve, and when the retry passes (holdMessages.ts in shared-types).
  hint='An Owner, Admin or EM can approve it with: intutic decision approve {holdId} (or reject it: intutic decision reject {holdId}). Retrying this exact call passes after approval only if the workspace has turned on the review-hold bypass; otherwise it is held again.'
  hint="\${hint//\\{holdId\\}/$hold_id}"
  intutic_shown "\${rreason} [\${rid}]"
  echo "[Intutic Guardrail] HELD: \${_intutic_shown} \${hint}" >&2
  log_event "tool_held" "\${TOOL:-}" "\${rreason} [\${rid}]" || true
  return 2
}

# A rule declares which part of the call it matches. \`any\` means command and
# target — never the tool name, because a pattern like \`\\.claude/settings\\.json\`
# would otherwise be tested against "Write" and quietly match nothing.
#
# Whether a rule fires on this call sets _intutic_fires to 1 or 0; the function
# always returns 0, so it runs under set -e like the rest of the gate. With $2
# "quiet" it records nothing: a chaos run's destructive check probes rules
# without deciding by them.
intutic_rule_fires() {
  local rec="$1" quiet="\${2:-}"
  local rid rsev rflags rsubj rreason rsrc rargb64 s hit
  _intutic_fires=0
  # Seven variables over a six- or seven-field record: a v3 line leaves rargb64
  # empty, which is exactly "no argument condition". The base64 column cannot
  # contain a tab, so the last variable never absorbs a separator.
  IFS=$'\\t' read -r rid rsev rflags rsubj rreason rsrc rargb64 <<< "$rec"
  [ -z "$rsrc" ] && return 0
  local _subs=() _ci=
  case "$rflags" in *i*) _ci=i ;; esac
  # A subject the screen below cleared for this case is left out: no pattern
  # matched it, this rule's included.
  case "$rsubj" in
    tool)    intutic_unscreened tool "$_ci" && _subs=("$INTUTIC_NTOOL") ;;
    command) intutic_unscreened command "$_ci" && _subs=("$INTUTIC_NCOMMAND") ;;
    target)  intutic_unscreened target "$_ci" && _subs=("$INTUTIC_NTARGET") ;;
    # Serialized tool input, un-normalised — same subject the WHERE argPattern
    # machinery matches. The secrets.* floor rules ride this. Guaranteed
    # non-empty by the extractor (it defaults to "{}").
    content) intutic_unscreened content "$_ci" && _subs=("$TOOL_INPUT_JSON") ;;
    # The space-padded action tokens the extractor's classifier derived from
    # the raw command (" action:deploy "), so a hold on \`action:deploy\`
    # matches whole tokens.
    action)  intutic_unscreened action "$_ci" && _subs=("$INTUTIC_ACTIONS") ;;
    # The source is |-separated phrases matched as words against the raw
    # command by the phrase matcher in Python, not a regex: grep is linear,
    # but the gap between the words was not expressible without one that
    # backtracks in the other gates. One python3 run, only for these rules.
    # The command goes in on stdin: as an argument, a long one would exceed
    # the kernel's per-argument limit and the rule would silently not run.
    phrase)
      if python3 -c 'import os, sys, json
lib = {}
exec(os.environ.get("INTUTIC_PY_LIB", ""), lib)
sys.exit(0 if lib["intutic_phrase_rule"](sys.argv[1], json.load(sys.stdin)) else 1)' "$rsrc" <<< "$INTUTIC_RAW_COMMAND_JSON" 2>/dev/null; then
        _subs=("$INTUTIC_NCOMMAND")
      else
        return 0
      fi
      ;;
    # Each field is tested separately rather than concatenated. Joining them
    # lets a pattern match across the seam — a command ending in "chflags" and
    # an unrelated target starting with "nouchg" would trip the bypass rule
    # together while neither does alone.
    *)
      intutic_unscreened command "$_ci" && _subs+=("$INTUTIC_NCOMMAND")
      intutic_unscreened target "$_ci" && _subs+=("$INTUTIC_NTARGET")
      ;;
  esac
  [ \${#_subs[@]} -gt 0 ] || return 0
  hit=0
  [ "$rsubj" = "phrase" ] && hit=1
  for s in "\${_subs[@]}"; do
    [ "$rsubj" = "phrase" ] && break
    # Flags: i = case-insensitive; s (a sequence rule) changes nothing here —
    # grep matches with an automaton, linear in the text, so the regex runs
    # as written.
    case "$rflags" in
      *i*) printf '%s' "$s" | grep -qiE -- "$rsrc" && hit=1 ;;
      *)   printf '%s' "$s" | grep -qE -- "$rsrc" && hit=1 ;;
    esac
  done
  [ "$hit" = "1" ] || return 0
  # The argument condition of a WHERE rule. The tool-name half has matched; the
  # rule fires only if the argPattern also matches the serialized tool input —
  # the same json.dumps(tool_input, separators=(",",":"), ensure_ascii=False)
  # shape matchSopRule and the intutic-clawde gate port pin, produced once by
  # the extractor above. Evaluated by python3 re, not grep: these patterns are
  # authored as JS regexes and routinely use lookahead, which no grep has.
  # Fail-safe direction: a pattern python cannot compile (exit 2) downgrades
  # THIS rule to name-only — today's behaviour, plus a rule_downgraded event —
  # rather than silently dropping the rule, which would fail open.
  if [ -n "$rargb64" ]; then
    _intutic_arg_rc=0
    python3 -c '
import sys, base64, re
try:
    pat = base64.b64decode(sys.argv[1], validate=True).decode("utf-8")
except Exception:
    sys.exit(2)
try:
    rx = re.compile(pat)
except re.error:
    sys.exit(2)
sys.exit(0 if rx.search(sys.argv[2]) else 1)
' "$rargb64" "\${TOOL_INPUT_JSON:-}" 2>/dev/null || _intutic_arg_rc=$?
    if [ "$_intutic_arg_rc" = "1" ]; then
      return 0
    elif [ "$_intutic_arg_rc" != "0" ] && [ -z "$quiet" ]; then
      log_event "rule_downgraded" "\${TOOL:-}" "argPattern for \${rid} did not compile in python re — rule enforced name-only" || true
    fi
  fi
  _intutic_fires=1
}

intutic_apply() {
  local rec="$1"
  local rid rsev rflags rsubj rreason rsrc rargb64
  IFS=$'\\t' read -r rid rsev rflags rsubj rreason rsrc rargb64 <<< "$rec"
  [ -z "$rsrc" ] && return 0
  # The escape hatch skips the DESTRUCTIVE family only. It is not a way to turn
  # off a workspace's own BLOCK: SOP rules — those are what the customer asked
  # for, and one environment variable disarming them would make the switch the
  # first thing an agent sets. Keyed on the rule-id family, which the snapshot
  # writer assigns: destructive.* versus sop.*
  if [ "$INTUTIC_GUARDS_DISABLED" = "1" ]; then
    case "$rid" in
      destructive.*) return 0 ;;
    esac
  fi
  # The tier order (gate body v23): every refusal first, the holds after the
  # rule records and the MCP checks. A hold is only ever decided on a call
  # nothing deterministic refused.
  case "\${_intutic_pass:-all}" in
    det) [ "$rsev" = "hold" ] && return 0 ;;
    hold) [ "$rsev" = "hold" ] || return 0 ;;
  esac
  intutic_rule_fires "$rec"
  [ "$_intutic_fires" = "1" ] || return 0
  if [ "$rsev" = "shadow" ]; then
    intutic_chaos_note "$rid"
    log_event "tool_would_block" "\${TOOL:-}" "\${rreason} [\${rid}]" || true
    return 0
  fi
  if [ "$rsev" = "hold" ]; then
    # Not a permanent denial: the action is legitimate, someone asked to see
    # it first. A bypass they approved lets this exact call through once.
    _intutic_chaos_rule="$rid"; _intutic_chaos_hit=1
    if intutic_hold "$rid" "$rreason"; then return 0; fi
    _intutic_chaos_decision=hold
    exit 2
  fi
  if [ "$rsev" = "warn" ]; then
    # Advisory tier: allowed, and recorded with enough shape to triage.
    #
    # The rule id alone was not enough. The warn tier exists to earn promotion to
    # block from a measured false-positive rate, and you cannot call a flag true
    # or false without seeing something of what was run. So: the first token of
    # the command, and nothing else. That is the verb — curl, git, rm — which is
    # what distinguishes "a real destructive command" from "a false positive on a
    # build script", and it carries no paths, no arguments, no secrets. The full
    # command stays out deliberately; that is what DLP exists to keep out of
    # telemetry.
    _intutic_verb="\${INTUTIC_NCOMMAND# }"
    _intutic_verb="\${_intutic_verb%% *}"
    intutic_chaos_note "$rid"
    log_event "tool_flagged" "\${TOOL:-}" "\${rreason} [\${rid}] verb=\${_intutic_verb}" || true
    return 0
  fi
  # The rule's own reason, not a generic one: hookEvents.resolveSeverity reads
  # this text for "governance-protected" to file the incident CRITICAL.
  local reason="\${rreason} [\${rid}]"
  _intutic_chaos_rule="$rid"; _intutic_chaos_hit=1
  intutic_shown "$reason"
  echo "[Intutic Governance] BLOCKED: \${_intutic_shown}" >&2
  log_event "tool_blocked" "\${TOOL:-}" "\${reason}"
  exit 2
}

# ── Screening ────────────────────────────────────────────────────────────────
# Rule by rule, the gate forks a grep per rule and subject: about a hundred on
# every call, which on a loaded machine took seconds before any rule could
# match. So each subject is first screened by one grep holding every pattern
# that tests it, the case-insensitive ones apart. A subject none of them
# matches is left out of every rule that tests it, since no one of them could
# match it either. A screen that matches, or one grep cannot run (exit 2),
# clears nothing, and the rules decide as before: the screen saves work and
# never changes a verdict. grep is still the engine, so the screen is linear too.
_intutic_screen_tool=(); _intutic_screen_tooli=(); _intutic_clear_tool=; _intutic_clear_tooli=
_intutic_screen_command=(); _intutic_screen_commandi=(); _intutic_clear_command=; _intutic_clear_commandi=
_intutic_screen_target=(); _intutic_screen_targeti=(); _intutic_clear_target=; _intutic_clear_targeti=
_intutic_screen_content=(); _intutic_screen_contenti=(); _intutic_clear_content=; _intutic_clear_contenti=
_intutic_screen_action=(); _intutic_screen_actioni=(); _intutic_clear_action=; _intutic_clear_actioni=
intutic_screen_add() {
  case "$1$2" in
    tool) _intutic_screen_tool+=(-e "$3") ;;
    tooli) _intutic_screen_tooli+=(-e "$3") ;;
    command) _intutic_screen_command+=(-e "$3") ;;
    commandi) _intutic_screen_commandi+=(-e "$3") ;;
    target) _intutic_screen_target+=(-e "$3") ;;
    targeti) _intutic_screen_targeti+=(-e "$3") ;;
    content) _intutic_screen_content+=(-e "$3") ;;
    contenti) _intutic_screen_contenti+=(-e "$3") ;;
    action) _intutic_screen_action+=(-e "$3") ;;
    actioni) _intutic_screen_actioni+=(-e "$3") ;;
  esac
}
for _rec in "\${INTUTIC_FLOOR[@]}" \${INTUTIC_DYNAMIC[@]+"\${INTUTIC_DYNAMIC[@]}"}; do
  IFS=$'	' read -r _r_id _r_sev _r_flags _r_subj _r_reason _r_src _r_arg <<< "$_rec"
  [ -n "$_r_src" ] || continue
  _r_ci=
  case "$_r_flags" in *i*) _r_ci=i ;; esac
  case "$_r_subj" in
    tool|command|target|content|action) intutic_screen_add "$_r_subj" "$_r_ci" "$_r_src" ;;
    phrase) : ;;
    *) intutic_screen_add command "$_r_ci" "$_r_src"; intutic_screen_add target "$_r_ci" "$_r_src" ;;
  esac
done
# $1 subject, $2 "i" or empty, $3 its text, then the patterns as -e pairs.
intutic_screen() {
  local key="$1" ci="$2" text="$3" rc=0
  shift 3
  if [ "$ci" = "i" ]; then printf '%s' "$text" | grep -qiE "$@" || rc=$?
  else printf '%s' "$text" | grep -qE "$@" || rc=$?
  fi
  [ "$rc" != "1" ] || printf -v "_intutic_clear_$key$ci" '%s' 1
}
[ \${#_intutic_screen_tool[@]} -eq 0 ] || intutic_screen tool '' "$INTUTIC_NTOOL" "\${_intutic_screen_tool[@]}"
[ \${#_intutic_screen_tooli[@]} -eq 0 ] || intutic_screen tool i "$INTUTIC_NTOOL" "\${_intutic_screen_tooli[@]}"
[ \${#_intutic_screen_command[@]} -eq 0 ] || intutic_screen command '' "$INTUTIC_NCOMMAND" "\${_intutic_screen_command[@]}"
[ \${#_intutic_screen_commandi[@]} -eq 0 ] || intutic_screen command i "$INTUTIC_NCOMMAND" "\${_intutic_screen_commandi[@]}"
[ \${#_intutic_screen_target[@]} -eq 0 ] || intutic_screen target '' "$INTUTIC_NTARGET" "\${_intutic_screen_target[@]}"
[ \${#_intutic_screen_targeti[@]} -eq 0 ] || intutic_screen target i "$INTUTIC_NTARGET" "\${_intutic_screen_targeti[@]}"
[ \${#_intutic_screen_content[@]} -eq 0 ] || intutic_screen content '' "$TOOL_INPUT_JSON" "\${_intutic_screen_content[@]}"
[ \${#_intutic_screen_contenti[@]} -eq 0 ] || intutic_screen content i "$TOOL_INPUT_JSON" "\${_intutic_screen_contenti[@]}"
[ \${#_intutic_screen_action[@]} -eq 0 ] || intutic_screen action '' "$INTUTIC_ACTIONS" "\${_intutic_screen_action[@]}"
[ \${#_intutic_screen_actioni[@]} -eq 0 ] || intutic_screen action i "$INTUTIC_ACTIONS" "\${_intutic_screen_actioni[@]}"
# Whether rules testing subject $1, case $2, still need to: not when screened clear.
intutic_unscreened() {
  local v="_intutic_clear_$1$2"
  [ "\${!v:-}" != "1" ]
}

# A chaos run's no_destructive_attempt probe: whether a destructive.* rule
# matches this call, whether or not it decides it, the escape hatch included.
if [ "$INTUTIC_CHAOS_ACTIVE" = "1" ] && [ \${#INTUTIC_DYNAMIC[@]} -gt 0 ]; then
  for _rec in "\${INTUTIC_DYNAMIC[@]}"; do
    case "$_rec" in
      destructive.*)
        intutic_rule_fires "$_rec" quiet
        if [ "$_intutic_fires" = "1" ]; then _intutic_chaos_destructive=1; break; fi
        ;;
    esac
  done
fi

for _rec in "\${INTUTIC_FLOOR[@]}"; do
  intutic_apply "$_rec"
done

_intutic_pass=det
if [ \${#INTUTIC_DYNAMIC[@]} -gt 0 ]; then
  for _rec in "\${INTUTIC_DYNAMIC[@]}"; do
    intutic_apply "$_rec"
  done
fi

# ── Rule records (gate body v23) ─────────────────────────────────────────────
# A rule record's verdict, as the Python check returns it: verdict, code, rule
# id and reason, tab-separated; empty to continue. shadow records the finding;
# block refuses.
intutic_rule_verdict() {
  [ -n "$1" ] || return 0
  local verdict code rid reason retry
  IFS=$'	' read -r verdict code rid reason retry <<< "$1"
  if [ "$verdict" = "shadow" ]; then
    intutic_chaos_note "$rid"
    log_event "tool_would_block" "\${TOOL:-}" "\${reason} [\${rid}]" || true
    return 0
  fi
  _intutic_chaos_rule="$rid"; _intutic_chaos_hit=1
  intutic_shown "\${reason} [\${rid}]"
  echo "[Intutic Governance] BLOCKED: \${_intutic_shown} (refusal code \${code})" >&2
  # Where to retry: the paths or tools the refusal names. An
  # OPAQUE workspace drops it, as it drops the rule.
  if [ -n "$retry" ] && [ "$INTUTIC_OPAQUE" != "1" ]; then echo "$retry" >&2; fi
  log_event "tool_blocked" "\${TOOL:-}" "\${reason} [\${rid}]"
  exit 2
}
_intutic_rr_text=""
if [ \${#INTUTIC_RULE_RECORDS[@]} -gt 0 ]; then
  _intutic_rr_text="$(printf '%s
' "\${INTUTIC_RULE_RECORDS[@]}")"
fi
# requires_outcome: a call whose action token (or tool) a qualified
# requires_before gates is refused unless this session's last test run passed,
# and no file changed since (PREREQUISITE_UNMET). The check also keeps the
# session's state: a file change marks a passing run stale. A check that
# cannot run refuses.
case "$_intutic_rr_text" in
  *$'	'requires_outcome$'	'*)
    _intutic_rr="$(python3 -c 'import os, sys
lib = {}
exec(os.environ.get("INTUTIC_PY_LIB", ""), lib)
sys.stdout.write(lib["intutic_outcome_check"](*(sys.argv[1:7] + [sys.stdin.read()])))' 'openhands' 0 "\${TOOL:-}" "\${INTUTIC_ACTIONS:- }" "\${SESSION_ID:-}" "$_intutic_rr_text" <<< "\${TOOL_INPUT_JSON:-}" 2>/dev/null || printf 'block	PREREQUISITE_UNMET	requires_before	the requires_before check could not run')"
    intutic_rule_verdict "$_intutic_rr"
    ;;
esac

# ── Unverified snapshot (gate body v17) ──────────────────────────────────────
# A snapshot that failed its digest or workspace check admits no MCP server:
# neither record in it can be vouched for, and a deleted one looks like one
# never set. Refused at block, in an observe-only workspace too, with the code,
# rule id and reason of mcpSnapshotUnverifiedRefusal (intutic_mcp_unverified
# in GATE_PY_LIB).
if [ "$INTUTIC_SNAPSHOT_STATE" = "invalid" ]; then
  case "\${TOOL:-}" in
    mcp__*__*)
      _intutic_unv="$(python3 -c 'import os, sys
lib = {}
exec(os.environ.get("INTUTIC_PY_LIB", ""), lib)
sys.stdout.write(lib["intutic_mcp_unverified"](sys.argv[1]))' "\${TOOL:-}" 2>/dev/null || true)"
      if [ -n "$_intutic_unv" ]; then
        IFS=$'\\t' read -r _ _intutic_unv_rid _intutic_unv_reason <<< "$_intutic_unv"
      else
        # python3 could not say why (it is required, and checked, before any
        # rule runs): still a refusal, never an allow.
        _intutic_unv_rid="policy_snapshot"
        _intutic_unv_reason="POLICY_SNAPSHOT_UNVERIFIED — the policy snapshot failed its integrity check and admits no MCP server"
      fi
      _intutic_chaos_rule="$_intutic_unv_rid"; _intutic_chaos_hit=1
      echo "[Intutic Governance] BLOCKED: \${_intutic_unv_reason} [\${_intutic_unv_rid}]" >&2
      log_event "tool_blocked" "\${TOOL:-}" "\${_intutic_unv_reason} [\${_intutic_unv_rid}]"
      exit 2
      ;;
  esac
fi

# ── MCP server registry backstop (gate body v14) ─────────────────────────────
# The workspace's registry decisions from the snapshot's @mcp_registry record,
# applied to every mcp__<server>__<tool> call: a blocked or held server, a
# server not approved under mcpDefaultPolicy deny, a disabled tool. The same
# decision, rule ids and reasons as the MCP proxy, so a server no proxy fronts
# is refused as one it fronts would be. Evaluated in Python (intutic_mcp_registry
# in GATE_PY_LIB), which reads the record's JSON; only for MCP-shaped calls.
if [ -n "$INTUTIC_MCP_REGISTRY" ]; then
  case "\${TOOL:-}" in
    mcp__*__*)
      _intutic_reg="$(python3 -c 'import os, sys
lib = {}
exec(os.environ.get("INTUTIC_PY_LIB", ""), lib)
sys.stdout.write(lib["intutic_mcp_registry"](sys.argv[1], sys.argv[2]))' "$INTUTIC_MCP_REGISTRY" "\${TOOL:-}" 2>/dev/null || true)"
      if [ -n "$_intutic_reg" ]; then
        IFS=$'\\t' read -r _ _intutic_reg_rid _intutic_reg_reason <<< "$_intutic_reg"
        _intutic_chaos_rule="$_intutic_reg_rid"; _intutic_chaos_hit=1
        intutic_shown "\${_intutic_reg_reason} [\${_intutic_reg_rid}]"
        echo "[Intutic Governance] BLOCKED: \${_intutic_shown}" >&2
        log_event "tool_blocked" "\${TOOL:-}" "\${_intutic_reg_reason} [\${_intutic_reg_rid}]"
        exit 2
      fi
      ;;
  esac
fi

# ── MCP per-server allowlist backstop ────────────────────────────────────────
# A dedicated record, not a synthetic GuardPattern rule: "allow only these
# servers" as one regex needs negative lookahead, which POSIX ERE (grep -E)
# does not have. So this is a plain membership test over the @mcp_allowlist
# record, with evaluateMcpAllowlist's code, rule id and reason (the shared
# vectors hold this copy to it). Only for an mcp__<server>__<tool> call, and
# only when the snapshot carries the record.
case "\${TOOL:-}" in
  mcp__*__*)
    if [ "$INTUTIC_MCP_ALLOWLIST" = "1" ]; then
      _intutic_mcp_server="\${TOOL#mcp__}"
      _intutic_mcp_server="\${_intutic_mcp_server%%__*}"
      case ",$INTUTIC_MCP_SERVERS," in
        *",$_intutic_mcp_server,"*)
          : # allowed — the server is in the workspace's list
          ;;
        *)
          _intutic_mcp_reason="MCP server \\"$_intutic_mcp_server\\" is not on the MCP server allowlist for this workspace [mcp_allowlist]"
          if [ "$INTUTIC_MCP_SEVERITY" = "shadow" ]; then
            intutic_chaos_note mcp_allowlist
            log_event "tool_would_block" "\${TOOL:-}" "$_intutic_mcp_reason" || true
          else
            _intutic_chaos_rule=mcp_allowlist; _intutic_chaos_hit=1
            intutic_shown "$_intutic_mcp_reason"
            echo "[Intutic Governance] BLOCKED: \${_intutic_shown}" >&2
            log_event "tool_blocked" "\${TOOL:-}" "$_intutic_mcp_reason"
            exit 2
          fi
          ;;
      esac
    fi
    ;;
esac

# ── Holds (gate body v8; after every refusal since v23) ──────────────────────
_intutic_pass=hold
if [ \${#INTUTIC_DYNAMIC[@]} -gt 0 ]; then
  for _rec in "\${INTUTIC_DYNAMIC[@]}"; do
    intutic_apply "$_rec"
  done
fi

# ── Trajectory: scope_paths and plan_approval (gate body v23) ────────────────
# A file change outside the union of scope_paths (OUT_OF_SCOPE), and a call
# before the session's plan is approved (PLAN_NOT_APPROVED) or, under strict,
# off its steps (OFF_PLAN). After the holds, before the decide tier. A check
# that cannot run refuses.
case "$_intutic_rr_text" in
  *$'	'scope_paths$'	'*|*$'	'plan_approval$'	'*)
    _intutic_tr="$(python3 -c 'import os, sys
lib = {}
exec(os.environ.get("INTUTIC_PY_LIB", ""), lib)
sys.stdout.write(lib["intutic_trajectory_check"](*(sys.argv[1:4] + [sys.argv[4], sys.stdin.read(), sys.argv[5], sys.argv[6]])))' 'openhands' "\${TOOL:-}" "\${SESSION_ID:-}" "$_intutic_rr_text" "$PWD" "\${INTUTIC_WORKSPACE_ID:-}" <<< "\${TOOL_INPUT_JSON:-}" 2>/dev/null || printf 'block	OUT_OF_SCOPE	scope_paths	the scope and plan check could not run')"
    intutic_rule_verdict "$_intutic_tr"
    ;;
esac

# ── Decide tier (gate body v22) ──────────────────────────────────────────────
# Only after every tier above allowed the call, and only for a tool an @decide
# record names in its fourth column: intutic decide check --stdin asks the
# self-hosted engine, within 3900 ms less what the deadline has left.
# A CLI that is missing, fails, times out or answers what this gate cannot
# read is unavailable, which refuses unless every record on the tool is
# stamped shadow.
_intutic_decide_match=0
_intutic_decide_enforce=0
if [ -z "\${1:-}" ] && [ \${#INTUTIC_DECIDE_RECORDS[@]} -gt 0 ]; then
  for _rec in "\${INTUTIC_DECIDE_RECORDS[@]}"; do
    IFS=$'\\t' read -r _ _d_fb _d_roll _d_tools _d_rest <<< "$_rec"
    case ",\${_d_tools}," in
      *",\${TOOL:-},"*)
        _intutic_decide_match=1
        [ "$_d_roll" = "enforce" ] && _intutic_decide_enforce=1
        ;;
    esac
  done
fi
if [ "$_intutic_decide_match" = "1" ]; then
  _intutic_decide_budget=$(( 9000 - (SECONDS + 1) * 1000 - 500 ))
  [ "$_intutic_decide_budget" -gt 3900 ] && _intutic_decide_budget=3900
  if [ "$_intutic_decide_budget" -lt 50 ]; then
    if [ "$_intutic_decide_enforce" = "1" ]; then
      _intutic_dec="refuse"$'\\x1f'"GOVERNANCE_UNAVAILABLE"$'\\x1f'$'\\x1f'"GOVERNANCE_UNAVAILABLE — no time was left for the decide rules on \${TOOL:-} within the gate deadline"
    else
      _intutic_dec="allow"$'\\x1f'$'\\x1f'$'\\x1f'"no time was left for the decide rules on \${TOOL:-} within the gate deadline"
    fi
  else
    _intutic_dec="$(python3 -c 'import os, sys
lib = {}
exec(os.environ.get("INTUTIC_PY_LIB", ""), lib)
sys.stdout.write(lib["intutic_decide_check"](*sys.argv[1:6], sys.stdin.read()))' 'openhands' "\${TOOL:-}" "$_intutic_decide_budget" "\${SESSION_ID:-}" "$_intutic_decide_enforce" <<< "\${TOOL_INPUT_JSON:-}" 2>/dev/null || true)"
    if [ -z "$_intutic_dec" ]; then
      # python3 could not say (it is required, and checked, before any rule
      # runs): unavailable, as a CLI that did not answer is.
      if [ "$_intutic_decide_enforce" = "1" ]; then
        _intutic_dec="refuse"$'\\x1f'"GOVERNANCE_UNAVAILABLE"$'\\x1f'$'\\x1f'"GOVERNANCE_UNAVAILABLE — the decide check could not run"
      else
        _intutic_dec="allow"$'\\x1f'$'\\x1f'$'\\x1f'"the decide check could not run"
      fi
    fi
  fi
  IFS=$'\\x1f' read -r _intutic_dec_out _intutic_dec_code _intutic_dec_rid _intutic_dec_reason <<< "$_intutic_dec"
  if [ "$_intutic_dec_out" = "allow" ]; then
    # A shadow rule's engine that could not answer: recorded, and the call goes on.
    if [ -n "$_intutic_dec_reason" ]; then
      log_event "tool_would_block" "\${TOOL:-}" "GOVERNANCE_UNAVAILABLE — $_intutic_dec_reason" || true
    fi
  else
    _intutic_dec_full="$_intutic_dec_reason"
    [ -n "$_intutic_dec_rid" ] && _intutic_dec_full="$_intutic_dec_full [$_intutic_dec_rid]"
    # openhands cannot ask a person, so an escalation refuses (DECIDE_ESCALATED).
    _intutic_chaos_rule="$_intutic_dec_rid"; _intutic_chaos_hit=1
    intutic_shown "$_intutic_dec_full"
    echo "[Intutic Governance] BLOCKED: \${_intutic_shown} (refusal code \${_intutic_dec_code:-DECIDE_ESCALATED})" >&2
    log_event "tool_blocked" "\${TOOL:-}" "$_intutic_dec_full"
    exit 2
  fi
fi

# ── Agent fault injection: the call is allowed ───────────────────────────────
# Recorded as allowed, then the fault that is due, if any. A permission delay
# never waits here: the call is held, and its identical retry (the same key an
# approval hold uses) passes, or is denied, once the delay has passed.
if [ "$INTUTIC_CHAOS_ACTIVE" = "1" ]; then
  _intutic_chaos_key="$( { printf '%s' "$INTUTIC_NTOOL"; printf '\\0'; printf '%s' "$INTUTIC_NCOMMAND"; printf '\\0'; printf '%s' "$INTUTIC_NTARGET"; } | intutic_sha256 )"
  _intutic_fault="$(intutic_chaos_decide allow "$_intutic_chaos_key")"
  _intutic_chaos_done=1
  if [ -n "$_intutic_fault" ]; then
    _intutic_fault_kind="\${_intutic_fault%%$'\\t'*}"
    _intutic_fault_reason="\${_intutic_fault#*$'\\t'}"
    # The fault's own text, carrying the plan's canary: what the agent reads.
    if [ "$_intutic_fault_kind" = "hold" ]; then
      echo "[Intutic Governance] HELD: \${_intutic_fault_reason}" >&2
    else
      echo "$_intutic_fault_reason" >&2
    fi
    exit 2
  fi
fi
# ── end Intutic gate body ────────────────────────────────────────────────────

log_event "tool_allowed" "$TOOL_NAME" ""
exit 0
",
}
`;
