# Rust proxy service
target/
**/*.rs.bk
# The workspace root Cargo.lock is the ONE Cargo actually resolves against
# (root Cargo.toml declares packages/proxy as a [workspace] member), so it is
# committed to pin release builds. packages/proxy/Cargo.lock is inert — Cargo
# never reads a member lockfile — and is deliberately untracked.
packages/proxy/Cargo.lock
# Standalone bench fixture crate — not a workspace member, never tracked.
packages/proxy/benches/wasm_guest/Cargo.lock

# Prebuilt proxy binary — the CLI downloads per-platform assets from GitHub
# Releases (see tools/cli/src/commands/connect.ts), so committing a 39.7MB
# single-platform binary here only taxes every clone.
packages/proxy/bin/intutic-proxy

# Docker
docker-compose.override.yml

# Generated docs
docs/api/typescript/
docs/api/openapi.yaml
docs/api/cli.md

