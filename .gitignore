# `git add -A` would have staged it wholesale.
.venv/
venv/
*.egg-info/
build/

# VitePress build cache and output — never committed. 17 `deps_temp_*` cache
# files were tracked before this; they are regenerated on every build and only
# ever produced diff noise.
**/.vitepress/cache/
**/.vitepress/dist/
**/.vitepress/cache_temp/

# Scratch tree for generatedRules.test.ts — rendered rules must sit two levels
# below the SDK root to resolve `../../assembly/index`, and this deliberately
# sits outside `rules/`, which dropInRules.test.ts enumerates.
packages/wasm-sdk/.gen-test/

# Generated by `packages/theme`. `sync-assets.ts` copies the theme's fonts and
# brand marks into apps/docs/public during the theme build, and every path that
# builds the docs runs that first — apps/docs declares `@intutic/theme`, so
# turbo's `^build` orders it, and apps/docs/Dockerfile runs
# `pnpm --filter=@intutic/theme run build` explicitly before the docs build.
#
# 62 of these were tracked here, duplicating files that already live in
# `packages/theme`. A tracked copy of a generated file can drift from its source
# with nothing to notice.
#
# `public/downloads/` is NOT generated and stays tracked.
apps/docs/public/fonts/
apps/docs/public/logo-white.svg
apps/docs/public/logo.svg
apps/docs/public/logo-black.svg
apps/docs/public/favicon.svg

# Architect (architecture-decision copilot) CLI output
graphify-out/
